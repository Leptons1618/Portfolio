---
import Tag from './Tag.astro';
interface Props {
  title: string; slug: string; summary: string;
  tags: string[]; stack: string[]; status: string; year: number;
  repoUrl: string; demoUrl?: string;
  caseStudySlug?: string; heroImage?: string;
}
const { title, slug, summary, tags, status, year, repoUrl, demoUrl, caseStudySlug, heroImage } = Astro.props;
---
<article class="card elev-sm project-card">
  {heroImage && (
    <div class="grayscale card-image"><img src={heroImage} alt={title} loading="lazy" /></div>
  )}
  <span class="card-kicker">{year} · {status}</span>
  <h3 class="card-title"><a href={`/projects/${slug}`}>{title}</a></h3>
  <p class="card-body">{summary}</p>
  <div class="card-tags">
    {tags.slice(0, 4).map(tag => <Tag text={tag} variant="neutral" />)}
  </div>
  <div class="card-meta card-links">
    <span class="link-group">
      <a href={`/projects/${slug}`}>Details</a>
      {caseStudySlug && <a href={`/case-studies/${caseStudySlug}`}>Case Study</a>}
    </span>
    <span class="link-group">
      {demoUrl && <a href={demoUrl} target="_blank" rel="noopener">Demo ↗</a>}
      <a href={repoUrl} target="_blank" rel="noopener">Repo ↗</a>
    </span>
  </div>
</article>
<style>
  .card-image img { width: 100%; height: 160px; object-fit: cover; }
  .card-title a { color: inherit; text-decoration: none; }
  .card-title a:hover { color: var(--color-accent); }
  .card-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .card-links { justify-content: space-between; margin-top: var(--space-2); }
  .link-group { display: inline-flex; gap: var(--space-3); }
</style>
