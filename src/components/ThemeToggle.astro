---
/**
 * Two-state theme switch. Server-rendered in the default (Modernist) state;
 * the inline head script in the layouts has already set `data-theme` before
 * paint, so this script only has to relabel the control and handle clicks.
 */
import { DEFAULT_THEME, THEMES } from '../lib/theme';

const next = THEMES.find(t => t.id !== DEFAULT_THEME)!;
---
<button
  type="button"
  class="btn theme-toggle"
  id="theme-toggle"
  aria-label={`Switch to the ${next.label} theme`}
>
  <span class="theme-toggle-swatch" aria-hidden="true"></span>
  <span id="theme-toggle-label">{next.label}</span>
</button>

<script>
  import { THEMES, THEME_EVENT, applyTheme, currentTheme, selectTheme } from '../lib/theme';

  const button = document.getElementById('theme-toggle')!;
  const label = document.getElementById('theme-toggle-label')!;

  /* The control says where it *goes*, not where it is, so the label is the
     other theme's name. Re-read on the theme event because the identity modal
     can change the theme while this button is on screen. */
  function relabel() {
    const target = THEMES.find(t => t.id !== currentTheme())!;
    label.textContent = target.label;
    button.setAttribute('aria-label', `Switch to the ${target.label} theme`);
  }

  document.addEventListener(THEME_EVENT, relabel);

  /* The pre-paint script has already set `data-theme` from storage, but the
     `<meta>` is still rendered with the default theme's colour — applying the
     current theme once here is what corrects it, and relabels on the way. */
  applyTheme(currentTheme());

  button.addEventListener('click', () => {
    selectTheme(THEMES.find(t => t.id !== currentTheme())!.id);
  });
</script>
