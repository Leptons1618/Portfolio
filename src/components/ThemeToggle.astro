---
/**
 * Two controls, because there are two independent choices — see `theme.ts`.
 *
 * The left one cycles the palette family and says where it *goes*, not where
 * it is. The right one cycles light → dark → follow-the-OS, and says where it
 * *is*, because "follow the OS" is a state you have to be able to see you are
 * in. They are two buttons rather than a dropdown for the reason there are two
 * themes: a `<select>` for a binary is a click to open, a click to choose, and
 * a popover to get wrong.
 *
 * Server-rendered in the default state; the inline head script in the layouts
 * has already set both attributes before paint, so this script only relabels.
 */
import { DEFAULT_THEME, THEMES } from '../lib/theme';

/* The label names where the click goes: the theme after the default, wrapping,
   which is the same arithmetic the client script below runs once it knows the
   stored choice. */
const next = THEMES[(THEMES.findIndex(theme => theme.id === DEFAULT_THEME) + 1) % THEMES.length]!;
---
<div class="theme-controls">
  <button
    type="button"
    class="btn theme-toggle"
    id="theme-toggle"
    aria-label={`Switch to the ${next.label} theme`}
  >
    <span class="theme-toggle-swatch" aria-hidden="true"></span>
    <span id="theme-toggle-label">{next.label}</span>
  </button>

  <button type="button" class="btn btn-icon mode-toggle tap-target" id="mode-toggle" aria-label="Colour mode">
    {/* All three glyphs are rendered and two are hidden, rather than one being
        swapped in by script. Swapping `textContent` on a button is what
        `setBusy` exists to avoid elsewhere, and an SVG built at runtime is a
        flash of nothing on the first paint. */}
    <span class="mode-icon" data-mode-icon="light" aria-hidden="true">☀</span>
    <span class="mode-icon" data-mode-icon="dark" aria-hidden="true" hidden>☾</span>
    <span class="mode-icon" data-mode-icon="system" aria-hidden="true" hidden>◐</span>
  </button>
</div>

<script>
  import {
    MODES,
    THEMES,
    THEME_EVENT,
    currentMode,
    currentTheme,
    selectMode,
    selectTheme,
    syncTheme,
    type ModeChoice,
  } from '../lib/theme';

  const themeBtn = document.getElementById('theme-toggle')!;
  const themeLabel = document.getElementById('theme-toggle-label')!;
  const modeBtn = document.getElementById('mode-toggle')!;

  /**
   * The theme after the one showing, wrapping. Three families now, so the
   * old "find the one that isn't current" lookup is gone — with two themes
   * that was a cycle by luck; this makes it one on purpose.
   */
  function nextTheme(current: string) {
    const index = THEMES.findIndex(theme => theme.id === current);
    return THEMES[(index + 1) % THEMES.length]!;
  }

  const MODE_TITLES: Record<ModeChoice, string> = {
    light: 'Light. Click for dark.',
    dark: 'Dark. Click to follow your system.',
    system: 'Following your system. Click for light.',
  };

  /* Re-read on the theme event because the identity modal can change either
     choice while these buttons are on screen. */
  function relabel() {
    const target = nextTheme(currentTheme());
    themeLabel.textContent = target.label;
    themeBtn.setAttribute('aria-label', `Switch to the ${target.label} theme`);

    const mode = currentMode();
    modeBtn.querySelectorAll<HTMLElement>('.mode-icon').forEach(icon => {
      icon.hidden = icon.dataset.modeIcon !== mode;
    });
    modeBtn.setAttribute('aria-label', MODE_TITLES[mode]);
    modeBtn.title = MODE_TITLES[mode];
  }

  document.addEventListener(THEME_EVENT, relabel);

  /* The pre-paint script set both attributes from storage, but the `<meta>` is
     still rendered with the default — `syncTheme` is what corrects it, and
     relabels on the way. */
  syncTheme();

  themeBtn.addEventListener('click', () => {
    selectTheme(nextTheme(currentTheme()).id);
  });

  modeBtn.addEventListener('click', () => {
    /* light → dark → system → light. Cycling rather than toggling, because
       "give the decision back to my OS" has to be reachable once it has been
       taken away. */
    selectMode(MODES[(MODES.indexOf(currentMode()) + 1) % MODES.length]);
  });

  /* Following the OS means following it *while the page is open*, which is a
     thing a laptop does at sunset. Only repaints the `<meta>`; the CSS media
     query has already handled the palette. */
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => currentMode() === 'system' && syncTheme());
</script>

<style>
  .theme-controls {
    display: inline-flex;
    align-items: center;
    /* 8px, not 4px: both controls grow invisible hit areas below, and the
       pair's expansions are sized to meet exactly at this gap. */
    gap: var(--space-2);
  }

  /* Matched to `.theme-toggle`'s height beside it, which is set by its 11px
     label and 5px padding rather than by `.btn-icon`'s 36px square. */
  .mode-toggle {
    width: 28px;
    height: 28px;
    color: var(--color-text-muted);
    border-color: var(--color-divider);
  }

  /* The shared `.tap-target` utility carries the mechanics; this inset is
     this control's own: 8px up/down takes the 28px box to ~44px, and 4px
     sideways stops exactly at half of the pair's 8px gap — the two
     expansions meet without overlapping. */
  .mode-toggle.tap-target { --tap-expand: -8px -4px; }

  .mode-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .mode-icon {
    font-size: 14px;
    line-height: 1;
  }

  /* Fixed width, so relabelling never resizes the button and shifts the bar.
     The server renders the *default* theme's "next" label and this script
     corrects it once the stored choice is known — on a prerendered page that
     correction lands after paint, and without a reserved width the whole bar
     jumps. 9ch fits the longest label's glyphs ("Blueprint") in this
     monospaced face — but glyphs are not the whole width: the toggle's own
     0.08em letter-spacing is added after every character, the last one
     included, and "Blueprint" is nine characters, so the natural text runs
     0.72em past the ch reservation and the button overflowed it — wider than
     under the themes whose next label is shorter, and the nav's link row,
     pushed by the brand's auto margin, sat a few pixels left in Geometry.
     The reservation carries the tracking: 9 glyphs × 0.08em. */
  #theme-toggle-label {
    display: inline-block;
    min-width: calc(9ch + 0.72em);
  }

  /* The glyph hand-over. `hidden` removes the outgoing icon immediately —
     exits here are instant by design, the right speed for a 28px control —
     and this keyframe greets the incoming one, playing whenever it becomes
     displayed. A keyframe rather than a transition because `display` changes
     cannot transition; the browser replays the animation on every reveal,
     which is exactly the beat wanted. */
  @media (prefers-reduced-motion: no-preference) {
    .mode-icon:not([hidden]) { animation: mode-icon-in 180ms cubic-bezier(0.2, 0, 0, 1); }
  }
  @keyframes mode-icon-in {
    from {
      opacity: 0;
      scale: 0.6;
      filter: blur(3px);
    }
  }
</style>
