---
/**
 * The journal writing surface, shared by the two screens that write a post.
 *
 * `/admin/journal/new` renders it with `slug: null`; `/admin/journal/[slug]`
 * renders it with the post's fields and body read from its row. That split
 * replaced a single screen that was an editor, a "which post am I editing"
 * indicator and the entries list all at once, and had to keep the three in
 * sync in JavaScript. The URL says which post is open now, so this component
 * never has to answer that question — the prop does, once, and the save path
 * reads it back out of the seed.
 *
 * The one rule that survived the move intact: **an open post keeps its slug**,
 * however the title is edited. The slug is the row's primary key and the public
 * URL, so a rename would orphan a live page. `slug` is the row this saves to,
 * and nothing here ever recomputes it.
 *
 * Writing and previewing are a tablist rather than two stacked panels. Both
 * are the same column of the same document at different fidelities, and side
 * by side neither got enough width to read at.
 */
import { Icon } from 'astro-icon/components';
import { POST_STATUSES, postPath, type PostFields } from '../lib/content-store';
import AssistPanel from './AssistPanel.astro';

interface Props {
  /** The post being edited, or `null` for a new one. Also the row's key. */
  slug: string | null;
  /** The row's fields, or `null` for a new post. */
  fields: PostFields | null;
  body: string;
  /** Today, from the server, so the date field has a sane default. */
  today: string;
}

const { slug, fields, body, today } = Astro.props;
const editing = slug !== null;

/* What the script cannot read back off the form. The title, the body and the
   status are server-rendered into the controls themselves, so they are not
   repeated here — the body especially, which would otherwise ship twice.
   `<` is escaped because this lands inside a script element — never write that
   tag literally in a comment here: Vite's dependency scanner matches it in the
   raw `.astro` source and parses the markup after it as JavaScript. */
const seedJson = JSON.stringify({ slug, fields }).replace(/</g, '\\u003c');
---
<div class="admin-head" id="journal-editor">
  <div class="je-id">
    <a class="btn btn-ghost btn-sm je-back" href="/admin/journal">
      <Icon name="lucide:arrow-left" class="admin-nav-icon" />All entries
    </a>
    <p class="admin-eyebrow-mono">{editing ? 'MODULE: EDIT_ENTRY' : 'MODULE: NEW_ENTRY'}</p>
    <h1 class="admin-title-sm" id="editor-heading">
      {editing ? fields!.title : 'Create New Journal Entry'}
    </h1>
    {/* The path, not the heading, is where the slug belongs: the heading
        follows the title as it is typed and the slug deliberately does not, so
        putting it in the h1 said the opposite of what is true. */}
    <p class="je-path">
      <code id="f-slug">{editing ? postPath(slug!) : postPath('untitled')}</code>
      <span class="text-muted je-path-note">
        {editing ? 'the row this saves to — a title edit will not rename it' : 'from the title, until it is first saved'}
      </span>
    </p>
    <span class="text-muted admin-stamp" id="save-stamp">
      {editing
        ? `Opened on ${postPath(slug!)} — the same row a reader would see.`
        : 'Draft mode. Not saved yet.'}
    </span>
  </div>

  <div class="admin-actions">
    <button type="button" class="btn btn-secondary" id="focus-toggle">Focus</button>
    {/* The assistant drafts; it never saves. Everything it produces lands in a
        panel with an Insert button, and the post is written by the same Save
        this screen has always had. */}
    <button type="button" class="btn btn-secondary" id="assist-open">
      <Icon name="lucide:sparkles" class="admin-nav-icon" />Assist
    </button>
    {/* This used to write `localStorage` and nothing else, which made it the
        one button on the surface whose label was a lie: the schema has a
        `draft` status, the entries list has a Draft filter, and pressing "Save
        Draft" put an entry in neither. It saves a row now — status forced to
        draft — so a draft is a draft everywhere. */}
    <button type="button" class="btn btn-secondary" id="save-draft">Save as draft</button>
    <button type="button" class="btn btn-secondary" id="export-md">
      <Icon name="lucide:download" class="admin-nav-icon" />Export .md
    </button>
    <button type="button" class="btn btn-primary" id="commit-md">
      {editing ? 'Save changes' : 'Save to the site'}
    </button>
  </div>
</div>

{/* — unsaved work, offered rather than applied —

    The browser snapshot is a crash guard, and it used to be restored on sight:
    open `/admin/journal/new` and last week's abandoned paragraph was already in
    the fields, with one line of grey mono explaining why and no way to get rid
    of it short of the dashboard's Clear Local Drafts. Every new entry started
    as someone else's old one.

    So it is an offer. Nothing is written into the form until this says so, and
    Discard is right next to it. */}
<div class="je-restore" id="je-restore" role="status" hidden>
  <div class="je-restore-copy">
    <p class="je-restore-title">Unsaved changes are being held in this browser</p>
    <p class="text-muted admin-note" id="je-restore-when"></p>
  </div>
  <div class="je-restore-actions">
    <button type="button" class="btn btn-primary btn-sm" id="je-restore-apply">Restore them</button>
    <button type="button" class="btn btn-secondary btn-sm" id="je-restore-discard">Discard</button>
  </div>
</div>

<div class="editor-grid">
  <div class="editor-col">
    {/* Each field that the assistant can write gets its own button, because
        "ask the assistant to do this to this field" is one intention and
        making it two — open a panel, then find the right task in a list of ten
        — is the thing that stops people using it. The button carries the task
        name; the panel is opened *and run* from it. */}
    <div class="editor-title-row">
      <input
        class="input editor-title"
        id="f-title"
        placeholder="Post Title..."
        value={editing ? fields!.title : ''}
      />
      <button
        type="button"
        class="btn btn-secondary je-spark"
        data-assist-task="titles"
        title="Suggest titles"
        aria-label="Suggest titles"
      >
        <Icon name="lucide:sparkles" class="admin-nav-icon" />
      </button>
    </div>

    <div class="tab-bar" role="tablist" aria-label="Editor view" id="je-tabs">
      <button type="button" class="tab" role="tab" id="je-tab-write" aria-controls="je-panel-write" aria-selected="true">
        <Icon name="lucide:pen-line" class="admin-nav-icon" />Write
      </button>
      <button type="button" class="tab" role="tab" id="je-tab-preview" aria-controls="je-panel-preview" aria-selected="false">
        <Icon name="lucide:eye" class="admin-nav-icon" />Preview
      </button>
    </div>

    <div class="tab-panel" id="je-panel-write" role="tabpanel" aria-labelledby="je-tab-write">
      {/* The toolbar's vocabulary is a `data-md` verb, not a pair of markers.
          Every handler lives in `md-edit.ts` and is tested there (`npm run
          check:editor`); this row only says which verb each button is. `title`
          carries the keyboard shortcut because a shortcut nobody can discover
          is not a shortcut. The glyphs are the characters themselves where a
          character exists — `B` in bold, `1.` for an ordered list — because a
          toolbar that spells out "Numbered list" needs three times the width
          and reads at half the speed. */}
      <div class="md-toolbar" role="toolbar" aria-label="Markdown formatting">
        <div class="md-group">
          <button type="button" class="btn btn-secondary md-btn" data-md="h2" title="Heading 2" aria-label="Heading 2"><strong>H2</strong></button>
          <button type="button" class="btn btn-secondary md-btn" data-md="h3" title="Heading 3" aria-label="Heading 3"><strong>H3</strong></button>
        </div>
        <div class="md-group">
          <button type="button" class="btn btn-secondary md-btn" data-md="bold" title="Bold (Ctrl+B)" aria-label="Bold"><strong>B</strong></button>
          <button type="button" class="btn btn-secondary md-btn" data-md="italic" title="Italic (Ctrl+I)" aria-label="Italic"><em>I</em></button>
          <button type="button" class="btn btn-secondary md-btn" data-md="strike" title="Strikethrough (Ctrl+Shift+X)" aria-label="Strikethrough"><s>S</s></button>
          <button type="button" class="btn btn-secondary md-btn" data-md="code" title="Inline code (Ctrl+E)" aria-label="Inline code">&lt;/&gt;</button>
        </div>
        <div class="md-group">
          <button type="button" class="btn btn-secondary md-btn" data-md="quote" title="Quote" aria-label="Quote">&rdquo;</button>
          <button type="button" class="btn btn-secondary md-btn" data-md="bullet" title="Bulleted list" aria-label="Bulleted list">&bull;</button>
          <button type="button" class="btn btn-secondary md-btn" data-md="ordered" title="Numbered list" aria-label="Numbered list">1.</button>
          <button type="button" class="btn btn-secondary md-btn" data-md="task" title="Task list" aria-label="Task list">&#9745;</button>
        </div>
        <div class="md-group">
          <button type="button" class="btn btn-secondary md-btn" data-md="link" title="Link (Ctrl+K)" aria-label="Link">&nearr;</button>
          <button type="button" class="btn btn-secondary md-btn" data-md="image" title="Image" aria-label="Image">img</button>
          <button type="button" class="btn btn-secondary md-btn" data-md="fence" title="Code block" aria-label="Code block">{ }</button>
          <button type="button" class="btn btn-secondary md-btn" data-md="table" title="Table" aria-label="Table">table</button>
          <button type="button" class="btn btn-secondary md-btn" data-md="rule" title="Divider" aria-label="Divider">&mdash;</button>
        </div>
        <div class="md-group md-group-end">
          <button type="button" class="btn btn-ghost md-btn md-stats-btn" data-md="stats" title="Fill the read time from this count" aria-label="Word count and reading time">
            <span id="md-stats">0 words</span>
          </button>
          <button
            type="button"
            class="btn btn-secondary md-assist"
            data-assist-task="compose"
            title="Write the whole post from a topic"
          >
            <Icon name="lucide:sparkles" class="admin-nav-icon" />Write with AI
          </button>
        </div>
      </div>
      <textarea class="input editor-body" id="f-body" placeholder="Write your post using Markdown...">{body}</textarea>
    </div>

    <div class="tab-panel" id="je-panel-preview" role="tabpanel" aria-labelledby="je-tab-preview" hidden>
      {/* The page's own head, and the page's own body.

         Decision 67 made the body the real renderer; the head was left as a
         lone `h3` at 25px, which is neither the page's title nor its scale
         anywhere. So the pane now renders the same five things the page does —
         hero, tags, title, meta line, summary — with the same classes, which is
         what lets `.post-head` in `global.css` style both. Only the body goes
         to the server; the head is a straight read of the form fields, so it
         updates on every keystroke with no round trip and stays correct while
         signed out. */}
      <div class="card elev-md preview-card">
        <div class="post-head preview-head" id="preview-head">
          <div class="post-figure" id="preview-figure" hidden>
            <div class="grayscale"><img id="preview-hero" alt="" /></div>
          </div>
          <div class="tag-row" id="preview-tags" hidden></div>
          <h1 class="post-title" id="preview-title">Post Title...</h1>
          <p class="text-muted post-meta" id="preview-meta"></p>
          <p class="post-summary" id="preview-summary" hidden></p>
        </div>
        {/* `.prose` and nothing else: the body is styled by the same rules the
            post's own page renders it under, so the pane cannot drift from the
            page by a stylesheet either. */}
        <div class="prose" id="preview-body"></div>
      </div>
      <p class="text-muted admin-note je-preview-note" id="preview-note">
        The post's own renderer: Astro's markdown processor, on the server, the
        same call a save makes. Fenced code is lit in the browser, as it is on the page.
      </p>
    </div>
  </div>

  <aside class="editor-side focus-hide">
    <div class="card elev-sm">
      <p class="admin-eyebrow">Metadata</p>
      <div class="field">
        <div class="je-field-head">
          <label for="f-summary">Summary</label>
          <button
            type="button"
            class="btn btn-ghost je-spark je-spark-sm"
            data-assist-task="summary"
            title="Write the summary from the draft"
          >
            <Icon name="lucide:sparkles" class="admin-nav-icon" />Write it
          </button>
        </div>
        <textarea class="input summary-input" id="f-summary" data-grow placeholder="One line for the card and the meta description."></textarea>
      </div>
      <div class="field">
        <label for="f-date">Publish Date</label>
        <input class="input" type="date" id="f-date" value={today} />
      </div>
      <div class="field">
        <div class="je-field-head">
          <label for="f-tags">Tags (comma separated)</label>
          <button
            type="button"
            class="btn btn-ghost je-spark je-spark-sm"
            data-assist-task="tags"
            title="Suggest tags, reusing ones already on the site"
          >
            <Icon name="lucide:sparkles" class="admin-nav-icon" />Suggest
          </button>
        </div>
        <input class="input" id="f-tags" placeholder="e.g. Design Systems, Astro" />
      </div>
      <div class="field field-row">
        <div>
          <label for="f-readtime">Read time</label>
          <input class="input" id="f-readtime" placeholder="5 min" />
        </div>
        <div>
          <label for="f-duration">Video duration</label>
          <input class="input" id="f-duration" placeholder="14:23" />
        </div>
      </div>
      <div class="field">
        <label>Status</label>
        <div class="seg">
          {POST_STATUSES.map(([value, label]) => (
            <label class="seg-opt">
              <input
                type="radio"
                name="status"
                value={value}
                checked={value === (editing ? fields!.status : 'draft')}
              />{label}
            </label>
          ))}
        </div>
        <p class="text-muted admin-note status-help" id="status-help"></p>
      </div>
    </div>

    <div class="card elev-sm">
      <p class="admin-eyebrow">Thumbnail</p>
      <div class="field">
        <label for="f-hero">Featured image</label>
        <input class="input" id="f-hero" placeholder="/images/post.jpg or https://…" />
      </div>
      <p class="text-muted admin-note">
        <strong>Browse library</strong> picks an image that is already here;
        <strong>Upload image</strong> adds a new one under <code>images/journal/</code> and
        fills the field with the <code>/media/…</code> path it now answers on. An absolute
        URL to somewhere else works too, and is never fetched by this site.
      </p>
    </div>
  </aside>
</div>

{/* — the assistant, over a selection —

    Select a passage in the body and this appears at the pointer. It is the
    smallest possible version of the panel: one instruction, one streamed
    replacement, and a decision.

    It is deliberately **not** live. Every other rewriting task writes into the
    field as it streams, because the field is where the author is looking; this
    one is overwriting a range they chose by hand, and "it is already written,
    press Undo" is the wrong offer for that. Nothing is replaced until Replace
    is pressed, and Discard leaves the draft exactly as it was.

    Both elements are `position: fixed` and placed from the pointer, so they can
    live anywhere in the document. Here, next to the panel they are a smaller
    version of. */}
<button type="button" class="jsel-flag" id="sel-flag" hidden title="Ask the assistant about the selection">
  <Icon name="lucide:sparkles" class="admin-nav-icon" />
</button>

<div class="jsel" id="sel-pop" hidden role="dialog" aria-label="Rewrite the selection">
  <p class="jsel-quote" id="sel-quote"></p>

  <input
    class="input jsel-input"
    id="sel-input"
    placeholder="What should change? e.g. cut this in half"
    autocomplete="off"
  />

  <details class="asx-think" id="sel-think" hidden>
    <summary class="asx-think-summary" id="sel-think-summary">Thinking</summary>
    <pre class="asx-think-body" id="sel-think-body"></pre>
  </details>

  <pre class="jsel-out" id="sel-out" hidden></pre>

  <div class="jsel-row">
    <span class="text-muted jsel-status" id="sel-status"></span>
    <button type="button" class="btn btn-ghost btn-sm" id="sel-cancel">Cancel</button>
    <button type="button" class="btn btn-secondary btn-sm" id="sel-discard" hidden>Discard</button>
    <button type="button" class="btn btn-primary btn-sm" id="sel-apply" hidden>Replace</button>
    <button type="button" class="btn btn-primary btn-sm" id="sel-run">Ask</button>
  </div>
</div>

{/* — the writing assistant —

    A **non-modal** `<dialog>`, docked to the corner, and that is the whole
    design rather than a styling choice. It used to be `showModal()`, which put
    a backdrop over the editor — fine when the assistant's entire output was a
    block of text waiting for Insert, and wrong the moment a task started
    writing into the fields themselves. The point of `/write-whole-post` is that
    the author *watches the form fill in*; a modal is a sheet pulled over the
    only thing worth looking at.

    The panel itself is `AssistPanel.astro` and is the same one the project
    screen renders. What used to be three shelves of buttons is now a
    conversation with commands in it — `/write-whole-post` is the same table
    entry `compose` always was. Everything it produces still ends in the editor
    and nowhere else: `save()` remains the only thing that writes a row. */}
<AssistPanel
  surface="journal"
  sub="Writes into the editor. Nothing is saved until you press Save."
/>

<script is:inline type="application/json" id="journal-editor-seed" set:html={seedJson}></script>

<script>
  import { navigate } from 'astro:transitions/client';
  import { ADMIN_KEYS, onAdminPage, setBusy, toast, trackDirty, undoRing, wireTabs, type DirtyField } from '../lib/admin';
  import {
    buildPostMarkdown,
    createPost,
    postPath,
    slugify as sharedSlugify,
    updatePost,
    type PostFields,
    type PostStatus,
  } from '../lib/content-store';
  import { getToken } from '../lib/github';
  import { formatTag, metaLine } from '../lib/format';
  import { attachImageUpload } from '../lib/image-upload';
  import { copyText } from '../lib/clipboard';
  import {
    continueList,
    indentLines,
    insertFence,
    insertImage,
    insertRule,
    insertTable,
    stats,
    toggleHeading,
    toggleInline,
    toggleLink,
    toggleList,
    type MdEdit,
  } from '../lib/md-edit';
  import { runAssist } from '../lib/ai-store';
  import { mountAssistPanel } from '../lib/assist-panel';
  import {
    ASSIST_MENU,
    ASSIST_TASKS,
    isAssistTask,
    type AssistMenuItem,
    parseDocument,
    parseEdit,
    POST_KEYS,
    type JournalTarget,
    type AssistTask,
    type AssistTaskName,
  } from '../lib/assist-tasks';
  import {
    DiagramError,
    diagramMarkdown,
    diagramName,
    extractMermaid,
    renderMermaid,
    standalone,
    uploadDiagram,
  } from '../lib/diagram';

  /* One module for both screens — `/admin/journal/new` and
     `/admin/journal/<slug>` render the same component, so the difference
     between them is entirely in the seed below. The admin client-routes, so
     this runs on first paint and again on every navigation into either. */
  onAdminPage('#journal-editor', () => {
    const KEY = ADMIN_KEYS.journalDraft;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    interface Seed {
      /** The post being edited, or `null` for a new one. The URL decided this. */
      slug: string | null;
      fields: PostFields | null;
    }
    const seed: Seed = JSON.parse(document.getElementById('journal-editor-seed')!.textContent || '{}');
    const editing = seed.slug;

    const fields = {
      title: $<HTMLInputElement>('f-title'),
      summary: $<HTMLTextAreaElement>('f-summary'),
      date: $<HTMLInputElement>('f-date'),
      tags: $<HTMLInputElement>('f-tags'),
      readTime: $<HTMLInputElement>('f-readtime'),
      duration: $<HTMLInputElement>('f-duration'),
      hero: $<HTMLInputElement>('f-hero'),
      body: $<HTMLTextAreaElement>('f-body'),
    };
    const statusInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="status"]'));
    const slugOut = $('f-slug');
    const heading = $('editor-heading');
    const previewTitle = $('preview-title');
    const previewBody = $('preview-body');
    const previewNote = $('preview-note');

    /* The word count, looked up with the other elements rather than at the
       toolbar, because `render()` reads it and `render()` is called before the
       toolbar's own wiring runs. */
    const statsOut = $('md-stats');
    const stamp = $('save-stamp');
    const commitBtn = $<HTMLButtonElement>('commit-md');

    /* The shared rule — the same one `image-upload.ts` names a file with — plus
       this screen's fallback for a title that slugs to nothing. */
    const slugify = (s: string) => sharedSlugify(s) || 'untitled';

    const STATUS_HELP: Record<string, string> = {
      draft: 'Off the public site in production. Visible here, and in local development.',
      published: 'Live on the site the moment you save — there is no build in between.',
      unpublished: 'Withdrawn: no listing, no page, the URL returns 404. Reversible from here.',
    };

    function currentStatus(): PostStatus {
      return (statusInputs.find(i => i.checked)?.value ?? 'draft') as PostStatus;
    }

    /* An open post keeps its slug however the title is edited, so the image is
       named after whichever of the two is the post's actual identity. */
    attachImageUpload(fields.hero, {
      dir: 'images/journal',
      name: () => `${editing ?? slugify(fields.title.value)}-hero`,
    });

    /* — the preview —

       The pane renders what the post's page will serve, because it *is* what
       the post's page will serve: `/api/preview` runs `renderBody()`, the same
       call `POST /api/content` makes on the way into `body_html`. There is no
       parser in this bundle and no second dialect — and that is also why the
       string is safe to assign here, on a surface holding a GitHub token: raw
       HTML and unsafe link schemes were dealt with by `markdown.ts`'s tree walk
       on the server, and nothing on this side reads the markdown at all.
       Decision 67.

       Debounced, because a render is a round trip per pause in typing rather
       than a regex per keystroke. A run counter — not an abort — is what keeps
       the pane describing the current text: a response already in hand when a
       newer render starts is exactly the one that would paint over it. Nothing
       is fetched at all while the Write tab is showing. */
    const PREVIEW_DEBOUNCE = 350;
    /* Read back off the markup rather than written a second time: the note is
       server-rendered so a reader with no JavaScript still gets the
       explanation, and this is that same sentence, collapsed. */
    const PREVIEW_NOTE = (previewNote.textContent ?? '').replace(/\s+/g, ' ').trim();
    const NO_SESSION =
      'Sign in with GitHub to render the preview — the export and the local snapshot still work.';

    /* — the head —

       The five things `src/pages/journal/[slug].astro` puts above the band, in
       the same order, with the same classes: hero, tags, title, the meta line,
       the summary. `metaLine()` is the page's own helper rather than a
       reimplementation of "date · read time · duration", so a change to the
       order changes both or neither.

       Built with `textContent` and attributes, never `innerHTML`: three of
       these five are author- or model-written strings, and this is a surface
       holding a GitHub token. The tags are the only markup, and they are
       `textContent` spans in a fixed set of classes.

       No server, and that is the point. The head is a projection of fields
       already in the DOM, so it is correct on the first paint, on every
       keystroke, and while signed out — the three cases where the body's round
       trip cannot help. */
    const previewFigure = $('preview-figure');
    const previewHero = $<HTMLImageElement>('preview-hero');
    const previewTags = $('preview-tags');
    const previewMeta = $('preview-meta');
    const previewSummary = $('preview-summary');

    function paintPreviewHead() {
      const title = fields.title.value.trim();
      previewTitle.textContent = title || 'Post Title...';

      const hero = fields.hero.value.trim();
      previewFigure.hidden = !hero;
      if (hero) {
        previewHero.src = hero;
        previewHero.alt = title;
      } else {
        previewHero.removeAttribute('src');
      }

      const tags = fields.tags.value.split(',').map(t => t.trim()).filter(Boolean);
      previewTags.hidden = tags.length === 0;
      previewTags.replaceChildren(
        ...tags.map((tag, i) => {
          const span = document.createElement('span');
          span.className = `tag ${i % 2 === 0 ? 'tag-accent' : 'tag-accent-2'}`;
          span.textContent = formatTag(tag);
          return span;
        }),
      );

      const meta = metaLine({
        date: fields.date.value,
        readTime: fields.readTime.value.trim(),
        videoDuration: fields.duration.value.trim(),
      });
      previewMeta.textContent = meta;
      previewMeta.hidden = !meta;

      const summary = fields.summary.value.trim();
      previewSummary.textContent = summary;
      previewSummary.hidden = !summary;
    }

    let previewing = false;
    let previewTimer: ReturnType<typeof setTimeout> | undefined;
    let previewRun = 0;
    /** The body the pane is currently showing, so an unchanged one costs nothing. */
    let lastRendered: string | null = null;

    function say(text: string, tone?: 'error'): void {
      previewNote.textContent = text;
      if (tone) previewNote.dataset.tone = tone;
      else delete previewNote.dataset.tone;
    }

    async function paintPreview(): Promise<void> {
      paintPreviewHead();

      /* Before anything below can return early: every paint supersedes whatever
         is in flight, so a response for text that is no longer in the textarea
         cannot land on a pane that this paint decided not to touch. */
      const run = (previewRun += 1);
      const token = getToken();
      if (!token) {
        say(NO_SESSION);
        previewBody.replaceChildren();
        delete previewBody.dataset.state;
        lastRendered = null;
        return;
      }

      const markdown = fields.body.value;
      /* Nothing to ask for. A title keystroke, a tab flip and the autosave all
         re-check the same body, and the whole body goes on the wire — so the
         pane is only re-rendered when the text it would render has changed.
         The render this superseded left the pane dimmed and will never land;
         un-dimming it is this branch's whole job. */
      if (markdown === lastRendered) {
        delete previewBody.dataset.state;
        return;
      }

      previewBody.dataset.state = 'rendering';
      try {
        const response = await fetch('/api/preview', {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ markdown }),
        });
        const data = (await response.json().catch(() => ({}))) as { html?: string; error?: string };
        if (!response.ok || typeof data.html !== 'string') {
          throw new Error(data.error ?? `The preview could not be rendered (${response.status}).`);
        }
        /* Superseded while this was in flight: the newer render is the one that
           describes what is in the textarea now. */
        if (run !== previewRun) return;

        lastRendered = markdown;
        previewBody.innerHTML = data.html;
        delete previewBody.dataset.state;
        say(PREVIEW_NOTE);

        /* Fenced code, framed and coloured by the same module the post's page
           mounts, and only fetched once there is a fence to light up. The
           import is cached by the module map, so this is one request for the
           session however many renders ask for it. */
        if (previewBody.querySelector('pre')) {
          void import('../lib/code-fx').then(module => module.mountCode(previewBody)).catch(() => {});
        }
      } catch (error) {
        if (run !== previewRun) return;
        /* The pane keeps the last render it had — a body one pause out of date
           is still worth reading — and the line under it says what happened.
           `lastRendered` is dropped so the next trigger retries rather than
           treating a failure as the current render. */
        lastRendered = null;
        delete previewBody.dataset.state;
        say(error instanceof Error ? error.message : 'The preview could not be rendered.', 'error');
      }
    }

    function render() {
      if (previewing) {
        /* The head is cheap and local, so it is painted on every render and
           only the body waits for the debounce. A title or tag keystroke is
           therefore visible in the preview immediately, rather than 350ms after
           it — and with no round trip at all, which is what makes the head
           correct while signed out. */
        paintPreviewHead();
        clearTimeout(previewTimer);
        previewTimer = setTimeout(() => void paintPreview(), PREVIEW_DEBOUNCE);
      }

      /* A new post's slug follows the title until the first save. An open one
         already has a row, and rewriting the line on every keystroke would
         promise a rename this screen deliberately does not do. */
      if (editing === null) {
        slugOut.textContent = postPath(slugify(fields.title.value));
        heading.textContent = fields.title.value.trim() || 'Create New Journal Entry';
      }
      $('status-help').textContent = STATUS_HELP[currentStatus()] ?? '';

      /* The count, in the same breath as everything else that depends on the
         body. Declared up with the other element lookups and defined as a
         function so this call site is not a temporal-dead-zone trap on the
         first render. */
      const { words, characters, minutes } = stats(fields.body.value);
      statsOut.textContent = `${words.toLocaleString()} words · ${characters.toLocaleString()} chars · ${minutes} min`;
    }

    wireTabs($('je-tabs'), id => {
      previewing = id === 'je-panel-preview';
      /* Cancelled in both directions: leaving the tab drops what was armed
         while it was showing, because nobody is reading a hidden pane and the
         block above promises no render is fetched for one. */
      clearTimeout(previewTimer);
      if (previewing) {
        /* Immediately on arrival, not through the debounce: the author asked
           for this pane, and a pause with nothing in it reads as broken. */
        void paintPreview();
      }
    });

    function snapshot() {
      return {
        title: fields.title.value,
        summary: fields.summary.value,
        date: fields.date.value,
        tags: fields.tags.value,
        readTime: fields.readTime.value,
        duration: fields.duration.value,
        hero: fields.hero.value,
        body: fields.body.value,
        status: currentStatus(),
        /* Which post this draft belongs to. The offer below refuses a snapshot
           whose `editing` does not match this screen, so a half-written new
           entry cannot be resurrected on top of a published post. */
        editing,
        /* When, so the offer can say how old it is. A snapshot with no answer
           to that is a decision made blind. */
        savedAt: Date.now(),
      };
    }

    /** The form as schema-shaped fields, for both the export and the save. */
    function readFields(): PostFields {
      return {
        title: fields.title.value.trim(),
        summary: fields.summary.value.trim(),
        date: fields.date.value,
        tags: fields.tags.value.split(',').map(tag => tag.trim()).filter(Boolean),
        readTime: fields.readTime.value.trim() || undefined,
        videoDuration: fields.duration.value.trim() || undefined,
        heroImage: fields.hero.value.trim() || undefined,
        status: currentStatus(),
      };
    }

    /* The title, the body and the status are server-rendered into the markup —
       they are the three the browser can restore for free. The rest is filled
       in here so an empty optional stays empty rather than printing
       "undefined". */
    if (seed.fields) {
      fields.summary.value = seed.fields.summary ?? '';
      fields.date.value = (seed.fields.date ?? '').slice(0, 10) || fields.date.value;
      fields.tags.value = (seed.fields.tags ?? []).join(', ');
      fields.readTime.value = seed.fields.readTime ?? '';
      fields.duration.value = seed.fields.videoDuration ?? '';
      fields.hero.value = seed.fields.heroImage ?? '';
    }

    /* — the browser snapshot —

       A crash guard, and nothing more: the *saved* state of a post is its row,
       and has been since content moved to D1. This used to be applied on sight,
       which turned every visit to `/admin/journal/new` into last week's
       abandoned paragraph, already in the fields, with no way to clear it short
       of the dashboard's Clear Local Drafts.

       `editing` is part of the snapshot so this can tell which screen it
       belongs to: a draft of the new-entry screen must not reappear on top of a
       post, and a draft of one post must not reappear on another. */
    const restoreBar = $('je-restore');

    function readSnapshot(): Record<string, unknown> | null {
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (!saved || (saved.editing ?? null) !== editing) return null;
        return saved;
      } catch {
        /* A corrupt snapshot is worth less than the space it takes up. */
        localStorage.removeItem(KEY);
        return null;
      }
    }

    function applySnapshot(saved: Record<string, any>) {
      fields.title.value = saved.title ?? '';
      fields.summary.value = saved.summary ?? '';
      if (saved.date) fields.date.value = saved.date;
      fields.tags.value = saved.tags ?? '';
      fields.readTime.value = saved.readTime ?? '';
      fields.duration.value = saved.duration ?? '';
      fields.hero.value = saved.hero ?? '';
      fields.body.value = saved.body ?? '';
      statusInputs.forEach(i => { i.checked = i.value === (saved.status ?? 'draft'); });
      render();
    }

    /* Only worth offering if it actually differs from what is already on
       screen — a snapshot identical to the row it came from is not unsaved
       work, and offering to "restore" it is a bar that never goes away. */
    function differsFromForm(saved: Record<string, any>): boolean {
      const now = snapshot();
      return (['title', 'summary', 'date', 'tags', 'readTime', 'duration', 'hero', 'body', 'status'] as const)
        .some(key => String(saved[key] ?? '') !== String((now as Record<string, unknown>)[key] ?? ''));
    }

    function offerRestore() {
      const saved = readSnapshot();
      if (!saved || !differsFromForm(saved)) {
        restoreBar.hidden = true;
        return;
      }
      const when = typeof saved.savedAt === 'number' ? new Date(saved.savedAt) : null;
      $('je-restore-when').textContent = when
        ? `Last typed ${when.toLocaleString()}. Restoring replaces what is on screen.`
        : 'Restoring replaces what is on screen.';
      restoreBar.hidden = false;
    }

    $<HTMLButtonElement>('je-restore-apply').addEventListener('click', () => {
      const saved = readSnapshot();
      if (saved) applySnapshot(saved as Record<string, any>);
      restoreBar.hidden = true;
      journalDirty?.check();
      toast('Unsaved changes restored. Save to put them on the site.', { tone: 'info' });
    });

    $<HTMLButtonElement>('je-restore-discard').addEventListener('click', () => {
      localStorage.removeItem(KEY);
      restoreBar.hidden = true;
      journalDirty?.check();
      toast('Held changes discarded. The screen is on what is saved.', { tone: 'info' });
    });

    /* Autosaved rather than saved by a button, because the button that said
       "Save Draft" now saves a row and the snapshot has no user-facing job
       left. Debounced: this runs per keystroke over a whole post body. */
    let autosave: ReturnType<typeof setTimeout>;
    function holdLocally() {
      /* Every write path funnels through here — keystrokes, assistant
         streams, Insert applies, undos — and the programmatic ones fire no
         events, so the commit buttons are re-checked here rather than in
         each of them. */
      journalDirty?.check();
      clearTimeout(autosave);
      autosave = setTimeout(() => {
        /* Nothing typed is not work to protect, and writing it would make the
           next visit offer to restore an empty form. */
        if (!fields.title.value.trim() && !fields.body.value.trim()) return;
        localStorage.setItem(KEY, JSON.stringify(snapshot()));
      }, 700);
    }

    Object.values(fields).forEach(el => {
      el.addEventListener('input', render);
      el.addEventListener('input', holdLocally);
    });
    statusInputs.forEach(i => {
      i.addEventListener('change', render);
      i.addEventListener('change', holdLocally);
    });

    /* — the editing verbs —

       One table, one apply. Every button and every shortcut below resolves to
       a function in `md-edit.ts`, which is pure and tested by
       `npm run check:editor`; this block's whole job is turning an edit into a
       textarea write.

       `setRangeText` rather than assigning `.value`, because it is the one
       write path that keeps the browser's undo stack. A markdown editor whose
       Ctrl+Z does not work is not an editor, and the old toolbar was one
       keystroke away from losing the history on every button press.

       Three things every verb has to do, which is why they are here rather than
       in each handler: put the caret back where the author will keep typing,
       re-render (the slug line and the preview), and mark the form dirty.
       `setRangeText` fires no `input` event, so the two listeners the form
       already has would not otherwise run. */
    function applyEdit(edit: MdEdit) {
      fields.body.focus();
      fields.body.setRangeText(edit.insert, edit.from, edit.to, 'end');
      fields.body.setSelectionRange(edit.selStart, edit.selEnd);
      render();
      holdLocally();
      journalDirty?.check();
    }

    type Verb =
      | 'h2' | 'h3' | 'bold' | 'italic' | 'strike' | 'code' | 'link'
      | 'quote' | 'bullet' | 'ordered' | 'task'
      | 'fence' | 'table' | 'image' | 'rule';

    /* Markers as a table rather than three near-identical ternaries in a
       switch: the marker *is* the whole of `toggleInline`'s difference between
       those three verbs. */
    const INLINE_MARKER: Partial<Record<Verb, string>> = {
      bold: '**',
      italic: '_',
      strike: '~~',
      code: '`',
    };

    function runVerb(verb: Verb) {
      const body = fields.body;
      const range = { start: body.selectionStart, end: body.selectionEnd };
      const text = body.value;

      const marker = INLINE_MARKER[verb];
      if (marker) return applyEdit(toggleInline(text, range, marker));
      if (verb === 'link') return applyEdit(toggleLink(text, range));
      if (verb === 'h2') return applyEdit(toggleHeading(text, range, 2));
      if (verb === 'h3') return applyEdit(toggleHeading(text, range, 3));
      if (verb === 'quote' || verb === 'bullet' || verb === 'ordered' || verb === 'task') {
        return applyEdit(toggleList(text, range, verb));
      }
      if (verb === 'fence') return applyEdit(insertFence(text, range));
      if (verb === 'table') return applyEdit(insertTable(text, range));
      if (verb === 'image') return applyEdit(insertImage(text, range));
      if (verb === 'rule') return applyEdit(insertRule(text, range));
    }

    document.querySelectorAll<HTMLButtonElement>('.md-btn[data-md]').forEach(btn => {
      const verb = btn.dataset.md;
      if (!verb || verb === 'stats') return;
      btn.addEventListener('click', () => runVerb(verb as Verb));
    });

    /* The count, and the read time it fills. The read time field is free text
       today, and a model writes it on compose; a number the author did not type
       is a number they can disagree with, so the button fills rather than
       writes. */
    const readTimeField = fields.readTime;
    $('md-stats').closest<HTMLButtonElement>('button')?.addEventListener('click', () => {
      const { minutes } = stats(fields.body.value);
      readTimeField.value = `${minutes} min read`;
      readTimeField.dispatchEvent(new Event('input', { bubbles: true }));
      toast(`Read time set to ${minutes} min.`, { tone: 'success' });
    });


    /* — keyboard —

       The same verbs, so a shortcut and its button cannot drift: both call
       `runVerb`. The bindings are the ones GitHub, Slack and every other
       markdown surface already teach, which is the entire argument for using
       them — a shortcut nobody already knows needs a help panel, and the
       `title` on each button is a cheaper one.

       Ctrl+Shift+P is deliberately *not* the preview toggle: Firefox treats it
       as "open private window" on Windows and it is taken on some Linux
       desktops. Ctrl+Shift+V is the paste. There is no free key left that is
       worth a conflict, so the preview toggle is in the tab bar where it can
       be clicked and reached by Tab. */
    const bodyEl = fields.body;
    let tabTrapped = false;

    bodyEl.addEventListener('keydown', event => {
      const mod = event.ctrlKey || event.metaKey;
      const range = { start: bodyEl.selectionStart, end: bodyEl.selectionEnd };

      if (event.key === 'Escape' && tabTrapped) {
        /* The release. A textarea that eats Tab forever is a keyboard trap, and
           WCAG 2.1.2 is not negotiable for an authoring surface: the standard
           answer is Escape, and it is the only key here that gives the trap up
           without taking a modifier. */
        tabTrapped = false;
        return;
      }

      if (event.key === 'Tab') {
        event.preventDefault();
        tabTrapped = true;
        applyEdit(indentLines(bodyEl.value, range, event.shiftKey));
        return;
      }

      if (event.key === 'Enter' && !mod && !event.shiftKey) {
        const edit = continueList(bodyEl.value, range.start);
        if (edit) {
          event.preventDefault();
          applyEdit(edit);
        }
        return;
      }

      if (!mod) return;
      /* Ctrl+Shift+ combos are checked before the bare ones: `event.shiftKey`
         is set for both, and a Shift+Ctrl+X that fell through to the Ctrl branch
         would strikethrough something the author asked to strikethrough — which
         is right — while a Shift+Ctrl+B that reached the bold branch would not
         be. Checking the modifier set explicitly keeps each combination to one
         meaning. */
      const shift = event.shiftKey;
      const key = event.key.toLowerCase();
      const verb = shift
        ? key === 'x' ? 'strike' : key === 'i' ? 'image' : undefined
        : key === 'b' ? 'bold' : key === 'i' ? 'italic' : key === 'e' ? 'code' : key === 'k' ? 'link' : undefined;

      if (!verb) return;
      event.preventDefault();
      runVerb(verb as Verb);
    });

    /* Forces the status and saves, so a draft ends up where every screen looks
       for one: a `journal` row with `status = 'draft'`, in the entries list,
       under the Draft filter, on the dashboard. */
    const draftBtn = $<HTMLButtonElement>('save-draft');
    draftBtn.addEventListener('click', () => {
      statusInputs.forEach(input => { input.checked = input.value === 'draft'; });
      render();
      void save(draftBtn);
    });

    $<HTMLButtonElement>('export-md').addEventListener('click', () => {
      const name = editing ?? slugify(fields.title.value);
      const blob = new Blob([buildPostMarkdown(readFields(), fields.body.value)], {
        type: 'text/markdown',
      });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${name}.md`;
      a.click();
      URL.revokeObjectURL(url);
      toast(`Downloaded ${name}.md.`, { tone: 'success' });
    });

    /* Save straight to the row the public page renders. The export above stays:
       it is the only path that works when you are not signed in, and the way a
       post leaves this system.

       Two write paths, and which one runs is the URL. A new entry is inserted
       whole — there is nothing to preserve. An open one is patched column by
       column with its body swapped, because the row may carry a column this
       editor has never heard of and rewriting it whole would drop it. Same
       split as the project screens; see `content-store.ts`. */
    if (!getToken()) {
      /* Both save paths write a row, so both need a session. Export and the
         browser snapshot are what still work signed out. */
      for (const button of [commitBtn, draftBtn]) {
        button.disabled = true;
        button.title = 'Sign in with GitHub to save.';
      }
    }

    /* Both commit buttons stay disabled until the draft differs from the
       saved row. Guarded on a session: signed out, the buttons above already
       say why they do nothing, and this must not re-enable them. Reset after
       every good save; the re-checks ride along in `holdLocally()`. */
    const journalDirty = getToken()
      ? trackDirty(
          () => [...Object.values(fields), ...statusInputs] as DirtyField[],
          [commitBtn, draftBtn],
          'No changes to save yet.',
        )
      : null;

    /**
     * The three columns `journal` declares NOT NULL, checked before the round
     * trip rather than after it.
     *
     * The database is the validation now (decision 18), and it does refuse
     * these — but it refuses them in SQLite: saving with an empty summary
     * answered `D1_ERROR: NOT NULL constraint failed: journal.summary:
     * SQLITE_CONSTRAINT`, which is a correct sentence about a blank field a few
     * pixels away and reads as a broken site. `explainConstraint()` on the
     * endpoint turns that into English for anything that gets past here; this
     * is the half that never sends the request at all, and can therefore name
     * the field in the terms this screen uses for it.
     *
     * Keep the two in step: a column that becomes NOT NULL wants a line here.
     */
    function whatIsMissing(post: PostFields): string | null {
      if (!post.title) return 'A title is required — it is also where the slug comes from.';
      if (!post.summary) return 'A summary is required: it is the card body and the meta description.';
      if (!post.date) return 'A publish date is required — it is what orders the listing.';
      return null;
    }

    /* Which field to put the cursor in, for each of the above. Reporting what is
       wrong and leaving the author to find it is half an error message. */
    const FIELD_FOR_ERROR: [keyof typeof fields, () => boolean][] = [
      ['title', () => !fields.title.value.trim()],
      ['summary', () => !fields.summary.value.trim()],
      ['date', () => !fields.date.value],
    ];

    /**
     * Write the post, from whichever button asked.
     *
     * Shared by "Save as draft" and the primary save, which differ only in
     * whether the status is forced first — so there is one write path, one set
     * of required-field checks and one place the busy state is released.
     */
    async function save(button: HTMLButtonElement): Promise<void> {
      const post = readFields();
      const missing = whatIsMissing(post);
      if (missing) {
        stamp.textContent = missing;
        toast(missing, { tone: 'error' });
        const blank = FIELD_FOR_ERROR.find(([, isEmpty]) => isEmpty());
        if (blank) fields[blank[0]].focus();
        return;
      }

      const target = editing ?? slugify(post.title);

      setBusy(button, true, 'Saving…');
      stamp.textContent = `Saving ${postPath(target)}…`;
      const pending = toast(`Saving ${target}…`, { tone: 'pending' });

      try {
        const result = editing
          ? await updatePost(editing, post, fields.body.value)
          : await createPost(target, post, fields.body.value);

        /* The row is the saved state now, so the browser snapshot has nothing
           left to protect — and leaving it would have the restore bar offering
           to put the same content back on the next visit. */
        localStorage.removeItem(KEY);
        /* And the timer that would put it back. Removing the key is not enough:
           a save that completes inside the 700ms debounce leaves a timer armed
           against the DOM this save is about to navigate away from, and it fires
           700ms later and re-writes the snapshot of a post that is already in
           the database. The next visit to `/new` then offers to restore a post
           that was saved, and a second create at the same slug is a 409. */
        clearTimeout(autosave);
        restoreBar.hidden = true;

        /* An unpublished post has no public page, so offering a link to one
           would be offering a 404 — the same reason the entries list only links
           the published state. */
        const live = post.status === 'published';
        pending.update(
          live
            ? `${target} is saved and live.`
            : `${target} is saved as a ${post.status === 'draft' ? 'draft' : post.status} post — in the entries list, not on the public site.`,
          {
            tone: 'success',
            action: live ? { label: 'view live ↗', href: result.url } : undefined,
          },
        );

        if (editing) {
          const link = document.createElement('a');
          link.href = result.url;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = 'view live ↗';
          stamp.replaceChildren(document.createTextNode('Saved — '), link);
          setBusy(button, false);
          /* The row is the form now. After the busy restore, for the same
             reason as everywhere else a save repaints. */
          journalDirty?.reset();
          return;
        }

        /* A new post now exists at a slug, and this screen is still
           `/admin/journal/new` — which is the screen that *creates* one. Press
           save twice and the second one is a duplicate-slug refusal. Which post
           is open is the route (decision 13), so the route has to catch up.
           `navigate()` rather than a location assignment, so it is a client
           route and the toast reporting the save survives the swap. */
        stamp.textContent = `Created ${postPath(target)}. Opening it…`;
        setBusy(button, false);
        await navigate(`/admin/journal/${target}`);
      } catch (error) {
        const text = error instanceof Error ? error.message : 'Save failed.';
        stamp.textContent = text;
        pending.update(text, { tone: 'error' });
        setBusy(button, false);
      }
    }

    commitBtn.addEventListener('click', () => void save(commitBtn));

    /* — the writing assistant —

       Two ways for a task's output to arrive, and which one applies is data on
       the task rather than a branch here: `task.live` names a field, or it is
       absent.

         - **Live.** The text is written into the field *as it streams*, and the
           panel's job shrinks to a progress line and an Undo. `compose` fills
           the whole form this way, which is the feature — a title appearing
           letter by letter, then a summary, then tags, then the body building
           underneath them, is the difference between a tool and a spinner.
         - **Panel.** The output lands in the box with an Insert button, because
           it is a *choice*: five titles, six tags, a paragraph that could go in
           three places. Insert is where the author says which and where.

       Neither writes a row. `save()` is still the only thing that does, and the
       diagram task's upload on Insert is still the one exception — same rule as
       `image-upload.ts`, an unreferenced upload is harmless and a saved post
       pointing at bytes that were never written is not.

       **Every live run is undoable in one press, three runs back.** The
       affected fields are snapshotted before the first token arrives, which is
       the thing that makes writing straight into the form reasonable rather
       than reckless — and the ring is what makes it survive being used the way
       it actually is, which is several tasks in a row before deciding the
       second one was the good one. */
    const assistOpen = $<HTMLButtonElement>('assist-open');

    /* What the last panel run produced, and how to apply it. `apply` is set per
       task because "insert" means four different things — replace the
       selection, append to the body, fill a field, merge tags — and branching
       on the task name at click time would put that knowledge in two places. */
    interface Prepared {
      text: string;
      apply: () => void;
      /** Rendered SVG for the diagram task, shown in the message. */
      svg?: string;
      /**
       * Individually applicable results, rendered as chips.
       *
       * A task whose output is a *list* has no single correct Insert. The panel
       * used to print all five titles and have Insert take the first one, with
       * a comment conceding that the rest were there to be copied — which is a
       * picker that makes the author do the picking by hand. When this is set,
       * the chips are the action and Insert is hidden.
       */
      options?: { label: string; apply: () => void }[];
    }


    /* The range a selection task will replace, taken at the moment the run
       starts rather than when the panel opened. The panel is non-modal now, so
       the author can select text with it already on screen — capturing on open
       would mean the panel had to be closed and reopened to notice. A textarea
       keeps `selectionStart`/`selectionEnd` after it loses focus, which is what
       makes reading them from a button click work at all. */
    let captured = { start: 0, end: 0, text: '' };

    function currentSelection() {
      const body = fields.body;
      return {
        start: body.selectionStart,
        end: body.selectionEnd,
        text: body.value.slice(body.selectionStart, body.selectionEnd),
      };
    }

    /** Put text where the selection was. `setRangeText` keeps the undo stack. */
    function replaceSelection(text: string) {
      const body = fields.body;
      body.focus();
      /* The range was captured when the run *started*, and the panel is
         non-modal: the author can have typed in the thirty seconds a selection
         task takes. Replacing by offset now would destroy whatever moved into
         those offsets, so the text there is checked first and the insert falls
         back to the caret when it is not what we captured. */
      if (body.value.slice(captured.start, captured.end) !== captured.text) {
        const at = body.selectionStart;
        body.setRangeText(text, at, at, 'end');
        toast('The selection moved while the assistant was writing — inserted at the cursor instead.', {
          tone: 'info',
        });
      } else {
        body.setRangeText(text, captured.start, captured.end, 'end');
      }
      render();
      holdLocally();
    }

    /** Append to the end of the body, with a blank line before it. */
    function appendToBody(text: string) {
      const body = fields.body;
      const existing = body.value.replace(/\s+$/, '');
      body.value = existing ? `${existing}\n\n${text.trim()}\n` : `${text.trim()}\n`;
      /* Assigning `.value` fires no event, so the two things an `input`
         listener would have done are done by hand — the same reason
         `image-upload.ts` overrides the value setter on the field it is given. */
      render();
      holdLocally();
    }

    /** One item per line, with any bullet or numbering the model added stripped. */
    const asLines = (text: string) =>
      text
        .split('\n')
        .map(line => line.replace(/^\s*(?:[-*]|\d+[.)])\s*/, '').trim())
        .filter(Boolean);

    /* — live targets —

       Which inputs a live task touches, so the snapshot behind Undo covers
       exactly those and no more. Undoing a summary rewrite must not also revert
       the paragraph the author typed while it was running. */
    const LIVE_FIELDS: Record<JournalTarget, (keyof typeof fields)[]> = {
      document: ['title', 'summary', 'tags', 'readTime', 'body'],
      summary: ['summary'],
      body: ['body'],
    };

    /* Three runs back, not one. Tasks get used in sequence — compose, then
       rewrite the summary, then rewrite it again with a different steer — and
       the one an author wants back is often not the last. `undoRing()` in
       `admin.ts` has the reasoning and the reason it stops at three. */
    const undos = undoRing();

    function takeSnapshot(target: JournalTarget, label: string) {
      const values: Record<string, string> = {};
      for (const key of LIVE_FIELDS[target]) values[key] = fields[key].value;
      undos.push({ label, values });
    }

    /**
     * Drop the snapshot the current run took, if that run changed nothing.
     *
     * A failed or unusable run has already pushed an entry — the snapshot is
     * taken before the first token, because by the time anything is known about
     * the response the fields have been written to. Leaving it would offer Undo
     * for a run that did nothing and push a real snapshot off the end of the
     * ring, which is the one thing a three-deep ring must not do.
     *
     * Compared by value rather than tracked by a flag, so a run that wrote
     * something and *then* failed keeps its entry — that is exactly the case
     * where Undo is the only way back.
     */
    function dropUnusedSnapshot() {
      const entry = undos.peek();
      if (!entry) return;
      const untouched = Object.entries(entry.values).every(
        ([key, value]) => fields[key as keyof typeof fields].value === value,
      );
      if (untouched) undos.pop();
    }

    function undoLive() {
      const entry = undos.pop();
      if (!entry) return;
      for (const [key, value] of Object.entries(entry.values)) {
        fields[key as keyof typeof fields].value = value ?? '';
      }
      render();
      holdLocally();
      const left = undos.depth;
      panel.say(
        left
          ? `Put back the way it was before “${entry.label}”. ${left} more step${left === 1 ? '' : 's'} back.`
          : `Put back the way it was before “${entry.label}”.`,
      );
      toast('Reverted.', { tone: 'success' });
    }

    /**
     * Write a partially-arrived response into the fields it belongs to.
     *
     * Called on every animation frame while a live task streams, and once more
     * when it finishes.
     *
     * A `document` run writes the body **only once `BODY:` has parsed**, and
     * there is no longer any fallback for a response that carried no labels at
     * all. That fallback is what wrote a reasoning model's chain-of-thought
     * into the post; `parseDocument`'s closing comment has the account, and
     * `runTask` now routes an unlabelled response to the panel instead.
     *
     * Every branch here is guarded on a *parsed* field, which is what makes
     * that safe: a run that recognised nothing writes nothing, so there is no
     * half-applied state to unpick.
     *
     * `final` still matters to the two prose targets — a streaming body keeps
     * its trailing whitespace so the caret does not jump, a finished one is
     * trimmed.
     */
    function applyLive(target: JournalTarget, raw: string, final: boolean) {
      if (target === 'document') {
        const doc = parseDocument(raw);
        if (doc.title) fields.title.value = doc.title;
        if (doc.summary) fields.summary.value = doc.summary;
        if (doc.tags) fields.tags.value = doc.tags;
        if (doc.readTime) fields.readTime.value = doc.readTime;
        if (doc.bodyStarted) fields.body.value = doc.body;
      } else if (target === 'summary') {
        /* Models quote a one-line answer about a third of the time, and a
           quoted summary goes into the card and the meta description with the
           quotes in it. */
        fields.summary.value = raw.trim().replace(/^["']|["']$/g, '');
      } else {
        fields.body.value = final ? raw.trim() : raw;
      }
      render();
      holdLocally();
    }

    /** A short, honest description of how far a live run has got. */
    function liveProgress(target: JournalTarget, raw: string): string {
      if (target !== 'document') return `Writing… ${raw.length.toLocaleString()} characters.`;
      const doc = parseDocument(raw);
      const landed = [
        doc.title && 'title',
        doc.summary && 'summary',
        doc.tags && 'tags',
        doc.readTime && 'read time',
        doc.bodyStarted && `body (${doc.body.length.toLocaleString()} characters)`,
      ].filter(Boolean);
      return landed.length ? `Writing… ${landed.join(', ')}.` : 'Writing…';
    }

    /**
     * Turn a panel task's output into something applicable.
     *
     * Every branch returns an `apply` that touches exactly one thing, so the
     * Insert button is never ambiguous about what it is about to change.
     */

    function prepare(task: string, output: string): Prepared {
      switch (task) {
        case 'titles': {
          const suggested = asLines(output);
          const setTitle = (title: string) => () => {
            fields.title.value = title;
            render();
            holdLocally();
            toast('Title set.', { tone: 'success' });
          };
          return {
            text: suggested.join('\n'),
            /* Unreachable while `options` is set, because Insert is hidden —
               but a `Prepared` that sometimes has no `apply` would be a second
               shape for every caller to handle. */
            apply: setTitle(suggested[0] ?? fields.title.value),
            options: suggested.map(title => ({ label: title, apply: setTitle(title) })),
          };
        }

        case 'tags': {
          const suggested = asLines(output);
          /* Merged with what is already there rather than replacing it, in both
             paths: the author's own tags are a deliberate choice and a
             suggestion is not grounds to drop them. Case-insensitively, because
             "Caching" and "caching" are one tag with two spellings and the site
             would otherwise list both. */
          const merge = (incoming: string[]) => () => {
            const existing = fields.tags.value.split(',').map(t => t.trim()).filter(Boolean);
            const seen = new Set(existing.map(t => t.toLowerCase()));
            for (const tag of incoming) {
              if (seen.has(tag.toLowerCase())) continue;
              existing.push(tag);
              seen.add(tag.toLowerCase());
            }
            fields.tags.value = existing.join(', ');
            render();
            holdLocally();
            toast(incoming.length > 1 ? 'Tags merged in.' : `Added "${incoming[0]}".`, {
              tone: 'success',
            });
          };
          return {
            text: suggested.join('\n'),
            apply: merge(suggested),
            /* "Add all" first, because taking the lot is the common case and
               the per-tag chips are for the run that got four right and two
               wrong. */
            options: [
              { label: 'Add all', apply: merge(suggested) },
              ...suggested.map(tag => ({ label: tag, apply: merge([tag]) })),
            ],
          };
        }

        case 'alt': {
          const [alt = '', caption = ''] = asLines(output);
          return {
            text: output.trim(),
            apply: () => {
              const url = fields.hero.value.trim();
              appendToBody(
                url
                  ? `![${alt}](${url})\n*${caption}*`
                  : `> Hero image: ${alt}\n> Caption: ${caption}`,
              );
              toast(
                url ? 'Image line added to the post.' : 'Added as a note — no hero image set yet.',
                { tone: 'info' },
              );
            },
          };
        }

        case 'selection':
        case 'expand':
        case 'tighten':
          return {
            text: output.trim(),
            apply: () => {
              replaceSelection(output.trim());
              toast('Selection replaced.', { tone: 'success' });
            },
          };

        default:
          /* `outline`, and anything added to the table later without a `live`
             target. Appending is the safe default: it cannot destroy what is
             already written. */
          return {
            text: output.trim(),
            apply: () => {
              appendToBody(output.trim());
              toast('Added to the end of the post.', { tone: 'success' });
            },
          };
      }
    }

    /**
     * The diagram path, which is three steps rather than one.
     *
     * The model returns Mermaid, it is rendered here so the author sees the
     * actual picture before committing to it, and only Insert uploads. Nothing
     * reaches the media table until then — an unreferenced upload is harmless,
     * but a library full of rejected drafts is still clutter.
     */
    async function prepareDiagram(output: string): Promise<Prepared> {
      const source = extractMermaid(output);
      const svg = standalone(await renderMermaid(source));

      return {
        text: source,
        /* Rendered by the panel rather than here: `turn.preview()` is the one
           place SVG is written as markup, and it is Mermaid's own output under
           `securityLevel: 'strict'` with `htmlLabels: false`. */
        svg,
        apply: () => {
          const name = diagramName(editing ?? slugify(fields.title.value));
          const pending = toast('Saving the diagram…', { tone: 'pending' });
          void uploadDiagram(svg, name, getToken() ?? '')
            .then(url => {
              appendToBody(
                diagramMarkdown(url, `Diagram: ${fields.title.value || 'the system described above'}`),
              );
              pending.update('Diagram saved and added to the post.', {
                tone: 'success',
                action: { label: 'view ↗', href: url },
              });
            })
            .catch(error => {
              pending.update(
                error instanceof Error ? error.message : 'The diagram could not be saved.',
                { tone: 'error' },
              );
            });
        },
      };
    }


    /**
     * Why this command cannot run yet, or `null`.
     *
     * Returned as the sentence to show rather than a boolean, because the two
     * reasons need two different fixes and "that command did nothing" tells the
     * author neither of them.
     */
    function blockedBecause(item: AssistMenuItem, instruction: string): string | null {
      if (item.needsSelection && !currentSelection().text.trim()) {
        return `Select the part of the draft to work on, then send /${item.command} again.`;
      }
      if (item.needsTopic && !instruction.trim()) {
        return `Say what /${item.command} should work from — type it after the command.`;
      }
      return null;
    }

    /* — running — */

    let assisting: AbortController | null = null;

    /** Undo, as a button on a message, while there is anything to undo. */
    const undoAction = () => {
      const entry = undos.peek();
      if (!entry) return [];
      return [
        {
          label: undos.depth > 1 ? `Undo (${undos.depth})` : 'Undo',
          run: undoLive,
        },
      ];
    };

    /**
     * One command, from the composer to the fields.
     *
     * Two ways for a task's output to arrive, and which one applies is data on
     * the task rather than a branch here: `task.live` names a field, or it is
     * absent.
     *
     *   - **Live.** The text is written into the field *as it streams*, and the
     *     message shrinks to a progress line and an Undo. `/write-whole-post`
     *     fills the whole form this way, which is the feature — a title
     *     appearing letter by letter, then a summary, then tags, then the body
     *     building underneath them, is the difference between a tool and a
     *     spinner.
     *   - **In the message.** The output lands in the bubble with an Insert
     *     button, because it is a *choice*: five titles, six tags, a paragraph
     *     that could go in three places. Insert is where the author says which.
     *
     * Neither writes a row. `save()` is still the only thing that does, and the
     * diagram task's upload on Insert is still the one exception — same rule as
     * `image-upload.ts`: an unreferenced upload is harmless and a saved post
     * pointing at bytes that were never written is not.
     *
     * **Every live run is undoable in one press, three runs back.** The
     * affected fields are snapshotted before the first token arrives, which is
     * what makes writing straight into the form reasonable rather than
     * reckless.
     */
    async function runTask(name: AssistTaskName, instruction: string) {
      const task: AssistTask = ASSIST_TASKS[name];
      const item = ASSIST_MENU.find(entry => entry.name === name) ?? null;

      if (item) {
        const why = blockedBecause(item, instruction);
        if (why) {
          panel.say(why, 'error');
          return;
        }
      }

      const live = (task.live ?? null) as JournalTarget | null;
      /* Taken at the moment the run starts rather than when the panel opened.
         The panel is non-modal, so the author can select text with it already
         on screen. A textarea keeps `selectionStart`/`selectionEnd` after it
         loses focus, which is what makes reading them here work at all. */
      captured = currentSelection();

      const turn = panel.begin(task.label, item?.command ?? null);
      panel.running(true);
      turn.status(live ? 'Writing…' : `${task.label}…`);

      if (live) takeSnapshot(live, task.label);

      /* Only the fields this task declares. The allowlist on the task is what
         keeps "suggest tags" from paying for the whole post body twice over. */
      const source: Record<string, string> = {
        title: fields.title.value,
        summary: fields.summary.value,
        tags: fields.tags.value,
        body: fields.body.value,
        selection: captured.text,
      };
      const context: Record<string, string> = {};
      for (const key of task.context) context[key] = source[key] ?? '';

      assisting?.abort();
      const controller = new AbortController();
      assisting = controller;

      let raw = '';
      let thought = '';
      /* Set from the `done` frame's `stopReason`. `length` means the model was
         cut off by this task's ceiling rather than having finished, which is
         otherwise indistinguishable from a short answer. */
      let truncated = false;
      /* One repaint per frame, not one per token. A live `document` run
         reparses the whole response and rewrites five inputs; at a fast
         provider's token rate that is a few hundred passes a second, all but
         sixty of which are overwritten before anything is painted. */
      let queued = false;
      /* A frame can still be queued when the last chunk lands, and it would run
         *after* the completion handler below — repainting the fields from a
         non-final parse and putting "Writing…" back over the "Done" line. */
      let settled = false;
      const paint = () => {
        if (queued || !live) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (settled || controller.signal.aborted) return;
          applyLive(live, raw, false);
          turn.status(liveProgress(live, raw));
        });
      };

      const again = { label: 'Try again', run: () => void runTask(name, instruction) };
      const copy = (text: string) => ({
        label: 'Copy',
        run: () => void copyText(text).then(() => toast('Copied.', { tone: 'success' })),
      });

      try {
        const output = await runAssist(
          name,
          context,
          instruction,
          {
            onDelta: chunk => {
              raw += chunk;
              if (live) paint();
              else turn.answer(raw);
            },
            /* The model is deliberating rather than the request having stalled.
               It goes into the message's own disclosure and nowhere else —
               `raw` is the answer, and only the answer is ever written into a
               field. */
            onThinking: chunk => {
              thought += chunk;
              turn.thinking(chunk);
            },
            /* A lookup the model made on the way to this answer. It goes in
               the message beside the thinking disclosure and never into a
               field — the same rule, and the same reason: only `delta` is the
               answer. */
            onTool: frame => turn.tool(frame),
            onUsage: frame => turn.usage(frame),
            onDone: reason => {
              truncated = reason === 'length';
            },
          },
          controller.signal,
          /* Only the conversational task carries the transcript. The twelve
             commands are a function of the draft, and paying for the history on
             each of them would be the whole conversation billed twelve times an
             afternoon. The last entry is dropped because it is the message this
             call is *about*, and the route appends it itself. */
          name === 'chat' ? panel.history().slice(0, -1) : undefined,
          /* Read at the start of every run rather than when the panel opened:
             changing the model between two runs is the whole point of having
             the control on the panel. */
          panel.runOptions(),
        );

        /* Names the cause, because there is exactly one that produces this and
           it is not obvious: a model that spent the task's whole token ceiling
           thinking and stopped before writing a word. */
        if (!output.trim()) {
          throw new Error(
            thought
              ? 'The model spent the whole token budget thinking and never wrote an answer. Open Thinking above to read it, then set this provider’s output ceiling on the AI screen, lower the effort in the toolbar above, or pick a model that deliberates less.'
              : 'The model finished without writing anything. Try again, or pick a different model on the AI screen.',
          );
        }
        settled = true;

        const cutOff = () =>
          truncated ? ' It hit this task’s token ceiling, so the end may be cut off.' : '';

        /* A conversation is an answer *or* an edit, and the reply's own shape
           says which — `parseEdit` recognises one that opens with a labelled
           field and nothing else does. "Make the title shorter" answered with a
           shorter title in a panel is the assistant declining the job, so a
           reply in that shape is applied to the fields exactly as a command's
           would be, with the same snapshot behind it.

           An answer is still an answer: prose, no Insert. Nothing said in
           conversation belongs in the post unless the author copies it there,
           and a button that appended it would make asking a question
           indistinguishable from running a command. */
        if (name === 'chat') {
          const edit = parseEdit(output, POST_KEYS);
          /* Labels with nothing under them: recognised, and an edit of nothing.
             It reads as an answer rather than as a run that changed five fields
             to empty — `applyLive` would write none of them anyway. */
          const editing = edit
            ? [...POST_KEYS.head, POST_KEYS.tail]
                .filter(spec =>
                  spec.key === POST_KEYS.tail.key
                    ? edit.tailStarted
                    : Boolean(edit.values[spec.key]),
                )
                .map(spec => spec.key.replace(/([A-Z])/g, ' $1').toLowerCase())
            : [];

          if (editing.length) {
            takeSnapshot('document', 'Chat edit');
            applyLive('document', output, true);
            /* Named from the parse rather than from the response, so this says
               what actually reached a field. `dropUnusedSnapshot` covers the
               model that "changed" a field to what it already said. */
            const written = editing.join(', ');
            dropUnusedSnapshot();
            turn.status(`Updated ${written} in the editor. Nothing is saved until you press Save.${cutOff()}`);
            turn.actions([...undoAction(), again]);
            turn.end(output);
            toast(`Updated ${written}.`, { tone: 'success' });
            return;
          }

          turn.answer(output);
          turn.actions([copy(output), again]);
          if (truncated) turn.note('It ran into this task’s token ceiling.', 'info');
          turn.end(output);
          return;
        }

        if (live) {
          /* A `document` run that recognised no label wrote nothing — every
             branch in `applyLive` is guarded on a parsed field — so there is no
             half-applied state to unpick and nothing for Undo to put back. The
             reply is still worth reading, so it stays in the message rather
             than going into the post. This is the path a model that deliberates
             out loud rather than answering takes, and it used to end with
             several hundred words of that deliberation in the post body. */
          if (live === 'document' && !parseDocument(output).recognised) {
            dropUnusedSnapshot();
            turn.answer(output);
            turn.actions([copy(output), again]);
            turn.note(
              'The model answered without using the field format, so nothing was written to the post.',
              'error',
            );
            turn.end(output);
            toast('Nothing written: the reply was not in the expected format.', { tone: 'error' });
            return;
          }

          applyLive(live, output, true);
          turn.status(
            `Done — it is in the editor. Nothing is saved until you press Save.${cutOff()}`,
          );
          turn.actions([...undoAction(), again]);
          turn.end(output);
          toast(live === 'document' ? 'Draft written into the fields.' : 'Rewritten in place.', {
            tone: 'success',
          });
          return;
        }

        turn.status('Reading it back…');
        const prepared = name === 'diagram' ? await prepareDiagram(output) : prepare(name, output);

        if (prepared.svg) turn.preview(prepared.svg);
        /* The chips *are* the list for a task that produced one, so printing it
           again underneath would be the same five titles twice. */
        if (prepared.options) turn.options(prepared.options);
        else turn.answer(prepared.text);

        turn.actions([
          ...(prepared.options
            ? []
            : [{ label: 'Insert', primary: true, run: () => prepared.apply() }]),
          copy(prepared.text),
          again,
        ]);
        if (truncated) turn.note('It hit this task’s token ceiling, so the end may be cut off.');
        turn.end(prepared.text);
      } catch (error) {
        settled = true;
        if (error instanceof DOMException && error.name === 'AbortError') {
          /* Stopped on purpose. Whatever arrived stays where it was written —
             that is what "live" means — and Undo is still the way back.

             Unless nothing arrived: `applyLive` with an empty response is not a
             no-op for the two prose targets, it assigns `''`, so stopping a
             `/revise-post` the instant it started used to empty the post. */
          if (live) {
            if (raw) {
              applyLive(live, raw, true);
              turn.status(
                `Stopped. ${raw.length.toLocaleString()} characters were written; Undo puts it back.`,
              );
              turn.actions([...undoAction(), again]);
            } else {
              dropUnusedSnapshot();
              turn.status('Stopped before anything was written. Nothing changed.');
              turn.actions([again]);
            }
          } else {
            turn.status(raw ? 'Stopped.' : 'Stopped before anything arrived.');
            turn.actions([again]);
          }
          turn.end(raw);
          return;
        }

        const text =
          error instanceof DiagramError || error instanceof Error
            ? error.message
            : 'The assistant failed.';
        /* A live run that failed part-way has already written into the fields,
           so the snapshot is the only way out and Undo has to stay offered. One
           that failed before writing anything has nothing to offer, and
           `dropUnusedSnapshot` is what tells the two apart. */
        if (live) dropUnusedSnapshot();
        turn.note(text, 'error');
        turn.actions([...undoAction(), again]);
        turn.end(raw);
        toast(text, { tone: 'error' });
      } finally {
        panel.running(false);
        if (assisting === controller) assisting = null;
      }
    }

    /* — the assistant, over a selection —

       A separate, much smaller path from the panel, and separate on purpose:
       the panel is a conversation about the post and this is one edit to one
       range. Sharing the panel's machinery would mean a conversation entry for
       every "cut this in half", and the range would have to survive a dialog
       that can be scrolled, reopened and restored from history.

       The range is captured when the button is *pressed*, not when the run
       finishes, because the author can click into the popup — which moves the
       selection — before the reply arrives. */
    const selFlag = $<HTMLButtonElement>('sel-flag');
    const selPop = $('sel-pop');
    const selQuote = $('sel-quote');
    const selInput = $<HTMLInputElement>('sel-input');
    const selOut = $('sel-out');
    const selStatus = $('sel-status');
    const selRun = $<HTMLButtonElement>('sel-run');
    const selApply = $<HTMLButtonElement>('sel-apply');
    const selDiscard = $<HTMLButtonElement>('sel-discard');
    const selThink = $<HTMLDetailsElement>('sel-think');
    const selThinkBody = $('sel-think-body');
    const selThinkSummary = $('sel-think-summary');

    /** Where the pointer was, so the button appears at the selection. */
    let selPoint = { x: 0, y: 0 };
    let selRange = { start: 0, end: 0, text: '' };
    let selRunning: AbortController | null = null;
    let selResult = '';

    /**
     * Put a fixed element near the pointer, inside the viewport.
     *
     * A textarea gives no geometry for its own selection — there is no range
     * object and no client rect for a run of characters inside one — so the
     * honest options are a mirrored `<div>` that duplicates every one of the
     * field's text metrics, or the pointer. The pointer is where the author
     * just finished dragging, it is right for the gesture that produces a
     * selection nine times out of ten, and it costs eight lines instead of
     * eighty. A keyboard selection gets the field's own top-right corner.
     */
    function place(node: HTMLElement, x: number, y: number) {
      node.style.left = '0px';
      node.style.top = '0px';
      node.hidden = false;
      const box = node.getBoundingClientRect();
      const left = Math.min(Math.max(8, x), window.innerWidth - box.width - 8);
      const top = Math.min(Math.max(8, y), window.innerHeight - box.height - 8);
      node.style.left = `${Math.round(left)}px`;
      node.style.top = `${Math.round(top)}px`;
    }

    function hideSelUi() {
      selFlag.hidden = true;
      selPop.hidden = true;
      selRunning?.abort();
    }

    function offerSelection(x: number, y: number) {
      const current = currentSelection();
      /* Two words is a phrase; two characters is a stray drag, and a button
         that appears every time the caret moves is a button in the way. */
      if (current.text.trim().length < 12) {
        if (selPop.hidden) selFlag.hidden = true;
        return;
      }
      if (!selPop.hidden) return;
      selRange = current;
      selPoint = { x, y };
      place(selFlag, x + 8, y + 8);
    }

    fields.body.addEventListener('mouseup', event => {
      offerSelection(event.clientX, event.clientY);
    });

    fields.body.addEventListener('keyup', event => {
      if (!event.shiftKey) return;
      const box = fields.body.getBoundingClientRect();
      offerSelection(box.right - 48, box.top + 12);
    });

    /* A selection that no longer exists must not leave its button behind. */
    fields.body.addEventListener('blur', () => {
      if (selPop.hidden) selFlag.hidden = true;
    });

    function resetSelThinking() {
      selThink.hidden = true;
      selThink.open = false;
      selThinkBody.textContent = '';
      selThinkSummary.textContent = 'Thinking';
    }

    selFlag.addEventListener('click', () => {
      selFlag.hidden = true;
      selResult = '';
      selOut.hidden = true;
      selOut.textContent = '';
      selApply.hidden = true;
      selDiscard.hidden = true;
      selRun.hidden = false;
      selStatus.textContent = '';
      selInput.value = '';
      resetSelThinking();
      /* Trimmed to a line, because this is a reminder of what is selected, not
         a second copy of the draft. */
      selQuote.textContent =
        selRange.text.length > 160 ? `${selRange.text.slice(0, 160)}…` : selRange.text;
      place(selPop, selPoint.x, selPoint.y + 12);
      selInput.focus();
    });

    async function runSelection() {
      const instruction = selInput.value.trim();
      if (!instruction) {
        selStatus.textContent = 'Say what should change.';
        selInput.focus();
        return;
      }
      if (!selRange.text.trim()) {
        selStatus.textContent = 'The selection is gone. Close this and select again.';
        return;
      }

      selRunning?.abort();
      const controller = new AbortController();
      selRunning = controller;

      selRun.hidden = true;
      selApply.hidden = true;
      selDiscard.hidden = true;
      selOut.hidden = false;
      selOut.textContent = '';
      selStatus.textContent = 'Writing…';
      resetSelThinking();

      selResult = '';
      let thought = '';

      try {
        const output = await runAssist(
          'selection',
          {
            selection: selRange.text,
            title: fields.title.value,
            summary: fields.summary.value,
          },
          instruction,
          {
            onDelta: chunk => {
              selResult += chunk;
              selOut.textContent = selResult;
              selOut.scrollTop = selOut.scrollHeight;
            },
            onThinking: chunk => {
              thought += chunk;
              selThink.hidden = false;
              selThinkSummary.textContent = 'Thinking…';
              selThinkBody.textContent = thought;
              selThinkBody.scrollTop = selThinkBody.scrollHeight;
            },
          },
          controller.signal,
          undefined,
          /* Rewriting a selection is a function of the selection. Nothing about
             it needs the site looked up, and the round trip a tool call costs
             would be spent on a task the author is watching. */
          { tools: false },
        );

        if (thought) {
          selThinkSummary.textContent = `Thinking \u00b7 ${thought.length.toLocaleString()} characters`;
          selThink.open = false;
        }

        if (!output.trim()) {
          selStatus.textContent = thought
            ? 'It spent the whole budget thinking and wrote nothing. Open Thinking, or ask again.'
            : 'It wrote nothing. Ask again.';
          selRun.hidden = false;
          return;
        }

        selResult = output.trim();
        selOut.textContent = selResult;
        selStatus.textContent = 'Replace puts this in place of the selection.';
        selApply.hidden = false;
        selDiscard.hidden = false;
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        selStatus.textContent = error instanceof Error ? error.message : 'That did not work.';
        selRun.hidden = false;
      } finally {
        if (selRunning === controller) selRunning = null;
      }
    }

    selRun.addEventListener('click', () => void runSelection());
    selInput.addEventListener('keydown', event => {
      if (event.key === 'Enter') {
        event.preventDefault();
        void runSelection();
      }
      if (event.key === 'Escape') hideSelUi();
    });

    selApply.addEventListener('click', () => {
      /* Through `captured`, because `replaceSelection` is the one function that
         knows how to put text into the body without losing the native undo
         stack — `setRangeText` keeps it and assigning `.value` does not. */
      captured = selRange;
      replaceSelection(selResult);
      hideSelUi();
      toast('Selection replaced. Ctrl+Z puts it back.', { tone: 'success' });
    });

    selDiscard.addEventListener('click', () => {
      hideSelUi();
      toast('Discarded. The draft is unchanged.', { tone: 'info' });
    });

    $<HTMLButtonElement>('sel-cancel').addEventListener('click', hideSelUi);

    /* Clicking anywhere outside closes it. Not on the body field itself, which
       is what produced the selection in the first place. */
    document.addEventListener('pointerdown', event => {
      if (selPop.hidden) return;
      const target = event.target as Node;
      if (selPop.contains(target) || selFlag.contains(target)) return;
      hideSelUi();
    });

    /* — the panel —

       Mounted last, because everything above is what it calls. `run` is the
       whole contract: the panel decides *that* a command was asked for, this
       decides what it does to the post. A message with no command is `chat`,
       which is a task in the same closed table as the other twelve. */
    const panel = mountAssistPanel({
      surface: 'journal',
      docSlug: () => editing ?? 'new',
      blocked: (item, instruction) => blockedBecause(item, instruction),
      stop: () => assisting?.abort(),
      run: (item, instruction) => runTask(item ? item.name : 'chat', instruction),
    });

    assistOpen.addEventListener('click', () => {
      if (panel.isOpen()) panel.close();
      else panel.open();
    });

    /* Every per-field button on the editor: open the panel with that field's
       command. One that needs a topic is typed in and left for the author to
       finish; one that does not runs straight away, which is the press they
       were making. `data-assist-task` is still the whole wiring. */
    document.querySelectorAll<HTMLButtonElement>('[data-assist-task]').forEach(button => {
      button.addEventListener('click', () => {
        const name = button.dataset.assistTask ?? '';
        if (!isAssistTask(name)) return;
        const item = ASSIST_MENU.find(entry => entry.name === name);
        if (!item) return;
        if (item.needsTopic) panel.open(item.command);
        else {
          panel.open();
          panel.send(`/${item.command}`);
        }
      });
    });

    /* Same rule as the save buttons: the endpoint asks GitHub who is calling,
       so a signed-out screen says so rather than offering a button that 401s. */
    if (!getToken()) {
      const why = 'Sign in with GitHub to use the assistant.';
      assistOpen.disabled = true;
      assistOpen.title = why;
      document.querySelectorAll<HTMLButtonElement>('[data-assist-task]').forEach(button => {
        button.disabled = true;
        button.title = why;
      });
    }

    const shell = document.getElementById('admin-shell')!;

    const focusBtn = $<HTMLButtonElement>('focus-toggle');
    focusBtn.addEventListener('click', () => {
      const on = shell.classList.toggle('is-focus');
      focusBtn.textContent = on ? 'Exit Focus' : 'Focus';
      focusBtn.setAttribute('aria-pressed', String(on));
    });

    render();
    /* Last, and only ever an offer: it compares against the form as it now
       stands, which needs the seed and the first render to have happened. */
    offerRestore();
  });
</script>

<style>
  .je-id { min-width: 0; }
  /* `.btn.btn-ghost` for the polished treatment — the border-radius, the hover
     tint, the pressed state — that a bare link never had; this and `.pd-back`
     on the project screen used to be a plain twelve-pixel line of mono text
     with no affordance at all beyond the arrow icon in front of it. */
  .je-back {
    font-family: var(--font-mono);
    margin-bottom: var(--space-2);
  }
  .je-path { font-size: 11px; margin: 4px 0 6px; display: flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; }
  .je-path code { font-family: var(--font-mono); background: var(--color-surface); padding: 1px 5px; }
  .je-path-note { font-size: 11px; }

  /* The offer to put unsaved work back. Accent-edged rather than red: nothing
     has gone wrong, there is simply a decision to make, and it is a decision
     that used to be taken silently on the author's behalf. */
  .je-restore {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-accent);
    border-left-width: 3px;
    border-radius: var(--radius-md);
    background: var(--color-accent-100);
  }

  .je-restore[hidden] { display: none; }
  .je-restore-copy { min-width: 0; }
  .je-restore-title { margin: 0; font-weight: 600; font-size: 14px; }
  .je-restore-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  /* The mockup's bento: writing surface left, everything that describes the
     post right. Focus mode hides the right column outright. */
  .editor-grid { display: grid; grid-template-columns: 8fr 4fr; gap: var(--space-4); align-items: start; }

  /* One column when the grid itself is narrow, whatever the window is. The
     viewport rule at the bottom of this block cannot see the column a docked
     assistant reserves (`.admin-main` pads away from it), so at 1440px with
     the panel open the body textarea was 295px wide — while the panel was
     writing into it. Same arrangement the project page uses on `.tab-panel`.
     The grid queries itself, so the *children* stack rather than the template
     changing: `1 / -1` spans both tracks. */
  .editor-grid { container-type: inline-size; }
  @container (max-width: 820px) {
    .editor-col,
    .editor-side { grid-column: 1 / -1; }
  }

  /* The assistant docks to the bottom-right of the viewport, which is exactly
     where this column's fields are — so the panel sat over the Summary field
     while the Summary task was writing into it. The panel cannot move: it is
     `position: fixed` and non-modal on purpose, and watching the fields fill in
     is the whole point of decision 28. So the column gets room to scroll clear
     of it instead, and only while the panel is actually open.

     Below 620px the panel is a full-width bottom sheet and the grid is a single
     column, so there is nothing beside it to uncover. */
  @media (min-width: 621px) {
    :global(body:has(.asx[open])) .editor-side { padding-bottom: min(76dvh, 680px); }
  }

  /* — focus mode —

     `.is-focus` hid the sidebar and the metadata column and stopped there,
     which left the *grid* untouched: still two tracks, the second one now
     empty, so the writing surface kept two thirds of the width and a third of
     the screen was blank paper. Hiding a column is not the same as removing it.

     One track, and a measure. A textarea the full width of a 1790px screen is
     not a better place to write a paragraph than one the width of a page, so
     the column is capped and centred — the same pairing every other width cap
     on this surface uses — and the header above it is capped to match, or the
     toolbar floats off to the right of the thing it belongs to.

     `.admin-shell` is rendered by `AdminLayout`, so it carries no cid of this
     component's and has to be reached through `:global()`. */
  :global(.admin-shell.is-focus) .editor-grid { grid-template-columns: minmax(0, 1fr); }

  :global(.admin-shell.is-focus) .editor-col,
  :global(.admin-shell.is-focus) .admin-head {
    max-width: var(--wrap-mid);
    margin-inline: auto;
    width: 100%;
  }

  /* The point of focus mode is the body, so give it the height the metadata
     column was using. */
  :global(.admin-shell.is-focus) .editor-body,
  :global(.admin-shell.is-focus) .preview-card {
    min-height: min(70dvh, 900px);
  }
  .editor-col { display: flex; flex-direction: column; gap: var(--space-4); }
  .editor-side { display: flex; flex-direction: column; gap: var(--space-4); }
  .editor-title { font-size: 20px; font-family: var(--font-heading); height: 48px; border-left: 3px solid var(--color-accent); }

  /* The title and its assist button share a row. `min-width: 0` on the input,
     because a flex item's default `min-width: auto` refuses to shrink below its
     content and a long title would push the button off the end. */
  .editor-title-row { display: flex; gap: var(--space-2); align-items: stretch; }
  .editor-title-row .editor-title { flex: 1 1 auto; min-width: 0; }

  /* A field that the assistant can write gets its label and its button on one
     line. `space-between` rather than a gap, so the button sits against the
     right edge of the field it belongs to and reads as attached to it. */
  .je-field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 5px;
  }
  .je-field-head label { margin-bottom: 0; }

  .preview-card { min-height: 460px; padding-top: var(--space-5); }
  /* The head's own margins are the page's, from `global.css`. The only thing
     added here is the rule between the head and the body, which on the page is
     a full-bleed band and in a card is a hairline. */
  .preview-head {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-divider);
    margin-bottom: var(--space-4);
  }
  .je-preview-note { margin: 0; }
  /* The hero is capped in the preview and not on the page, and the difference
     is stated rather than hidden. On the page the image is bounded by a 1120px
     container; in a card roughly 600px wide, a portrait-orientation hero runs
     to well over a thousand pixels and pushes the body — the thing being
     previewed — entirely below the fold. `object-fit: cover` keeps the
     proportions the author chose visible; what is lost is the lower part of a
     tall image, which is the least useful part to judge a post from. */
  .preview-head .post-figure { max-height: 260px; overflow: hidden; }
  .preview-head .post-figure img { max-height: 260px; object-fit: cover; object-position: top center; }
  .je-spark { flex: none; }
  .je-spark-sm { font-size: 11px; padding: 2px 6px; gap: 4px; }
  /* The toolbar is five groups rather than one row, so a keyboard user's Tab
     order follows what the buttons do rather than jumping between two ends of
     a strip. `gap` on the row is the space *between* groups and the groups
     carry a rule of their own, which is what makes the grouping visible
     without sixteen borders. */
  .md-toolbar {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
    padding: var(--space-2);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .md-group { display: flex; gap: 3px; align-items: center; }
  .md-group + .md-group { border-left: 1px solid var(--color-divider); padding-left: var(--space-3); }
  .md-group-end { margin-left: auto; }

  /* One row of glyphs at a fixed measure, so a button's width never depends on
     which glyph it holds and the groups stay aligned down the column. The
     28px is below the 44px touch target the rest of the admin aims for, and
     the `padding` on the button is what reaches it — this is a pointer-first
     surface on a desktop, and the shortcut is on every one of them. */
  .md-toolbar .md-btn {
    min-width: 30px;
    height: 30px;
    padding: 0 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    justify-content: center;
  }
  .md-toolbar .md-btn[data-md='strike'] { text-decoration: line-through; }
  .md-toolbar .md-btn[data-md='fence'] { letter-spacing: -0.08em; }

  /* The count is a readout, not a control: it is a button only so pressing it
     fills the read time, and it looks like text until it is hovered. */
  .md-toolbar .md-stats-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    border-color: transparent;
    box-shadow: none;
    cursor: pointer;
  }
  .md-toolbar .md-stats-btn:hover { color: var(--color-text); border-color: var(--color-divider); }

  .md-toolbar .md-assist {
    font-size: 12px;
    padding: 4px 10px;
    font-weight: 600;
  }

  /* The tab bar sits directly under the title, so it does not need the shared
     gap on top of the column's own. */
  .tab-bar { margin-bottom: 0; }
  .editor-col .tab-panel { display: flex; flex-direction: column; gap: var(--space-3); }
  .editor-col .tab-panel[hidden] { display: none; }

  .summary-input { min-height: 56px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .field-row label { display: block; font-size: 12px; margin-bottom: 5px; color: color-mix(in srgb, var(--color-text) 70%, transparent); }
  /* Tall, because the panel it sits in no longer shares the column with a
     preview card — the writing surface gets the whole height. */
  .editor-body { min-height: 460px; font-family: var(--font-mono); font-size: 13px; }

  .preview-card { min-height: 460px; }
  .preview-title { margin: 0; }
  .je-preview-note { margin: 0; }

  /* A render is a round trip to `/api/preview` now, not a regex, so the pane
     says so while one is in flight — dimmed rather than emptied, because the
     last render is still the best answer until the new one lands. The body
     itself is `.prose`: the same rules the post's page renders it under, which
     is why nothing here styles a heading, a list or a fence. */
  #preview-body[data-state='rendering'] { opacity: 0.5; }
  #preview-note[data-tone='error'] { color: var(--color-accent-700); }

  .status-help { margin-top: 6px; }

  code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }

  @media (max-width: 1000px) {
    .editor-grid { grid-template-columns: 1fr; }
  }
</style>
