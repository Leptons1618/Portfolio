---
/**
 * The journal writing surface, shared by the two screens that write a post.
 *
 * `/admin/journal/new` renders it with `slug: null`; `/admin/journal/[slug]`
 * renders it with the post's fields and body read from its row. That split
 * replaced a single screen that was an editor, a "which post am I editing"
 * indicator and the entries list all at once, and had to keep the three in
 * sync in JavaScript. The URL says which post is open now, so this component
 * never has to answer that question — the prop does, once, and the save path
 * reads it back out of the seed.
 *
 * The one rule that survived the move intact: **an open post keeps its slug**,
 * however the title is edited. The slug is the row's primary key and the public
 * URL, so a rename would orphan a live page. `slug` is the row this saves to,
 * and nothing here ever recomputes it.
 *
 * Writing and previewing are a tablist rather than two stacked panels. Both
 * are the same column of the same document at different fidelities, and side
 * by side neither got enough width to read at.
 */
import { Icon } from 'astro-icon/components';
import { POST_STATUSES, postPath, type PostFields } from '../lib/content-store';
import { ASSIST_GROUPS, ASSIST_MENU } from '../lib/assist-tasks';

interface Props {
  /** The post being edited, or `null` for a new one. Also the row's key. */
  slug: string | null;
  /** The row's fields, or `null` for a new post. */
  fields: PostFields | null;
  body: string;
  /** Today, from the server, so the date field has a sane default. */
  today: string;
}

const { slug, fields, body, today } = Astro.props;
const editing = slug !== null;

/* What the script cannot read back off the form. The title, the body and the
   status are server-rendered into the controls themselves, so they are not
   repeated here — the body especially, which would otherwise ship twice.
   `<` is escaped because this lands inside a script element — never write that
   tag literally in a comment here: Vite's dependency scanner matches it in the
   raw `.astro` source and parses the markup after it as JavaScript. */
const seedJson = JSON.stringify({ slug, fields }).replace(/</g, '\\u003c');
---
<div class="admin-head" id="journal-editor">
  <div class="je-id">
    <a class="je-back" href="/admin/journal">
      <Icon name="lucide:arrow-left" class="admin-nav-icon" />All entries
    </a>
    <h6 class="admin-eyebrow-mono">{editing ? 'MODULE: EDIT_ENTRY' : 'MODULE: NEW_ENTRY'}</h6>
    <h1 class="admin-title-sm" id="editor-heading">
      {editing ? fields!.title : 'Create New Journal Entry'}
    </h1>
    {/* The path, not the heading, is where the slug belongs: the heading
        follows the title as it is typed and the slug deliberately does not, so
        putting it in the h1 said the opposite of what is true. */}
    <p class="je-path">
      <code id="f-slug">{editing ? postPath(slug!) : postPath('untitled')}</code>
      <span class="text-muted je-path-note">
        {editing ? 'the row this saves to — a title edit will not rename it' : 'from the title, until it is first saved'}
      </span>
    </p>
    <span class="text-muted admin-stamp" id="save-stamp">
      {editing
        ? `Opened on ${postPath(slug!)} — the same row a reader would see.`
        : 'Draft mode. Not saved yet.'}
    </span>
  </div>

  <div class="admin-actions">
    <button type="button" class="btn btn-secondary" id="focus-toggle">Focus</button>
    {/* The assistant drafts; it never saves. Everything it produces lands in a
        panel with an Insert button, and the post is written by the same Save
        this screen has always had. */}
    <button type="button" class="btn btn-secondary" id="assist-open">
      <Icon name="lucide:sparkles" class="admin-nav-icon" />Assist
    </button>
    {/* This used to write `localStorage` and nothing else, which made it the
        one button on the surface whose label was a lie: the schema has a
        `draft` status, the entries list has a Draft filter, and pressing "Save
        Draft" put an entry in neither. It saves a row now — status forced to
        draft — so a draft is a draft everywhere. */}
    <button type="button" class="btn btn-secondary" id="save-draft">Save as draft</button>
    <button type="button" class="btn btn-secondary" id="export-md">
      <Icon name="lucide:download" class="admin-nav-icon" />Export .md
    </button>
    <button type="button" class="btn btn-primary" id="commit-md">
      {editing ? 'Save changes' : 'Save to the site'}
    </button>
  </div>
</div>

{/* — unsaved work, offered rather than applied —

    The browser snapshot is a crash guard, and it used to be restored on sight:
    open `/admin/journal/new` and last week's abandoned paragraph was already in
    the fields, with one line of grey mono explaining why and no way to get rid
    of it short of the dashboard's Clear Local Drafts. Every new entry started
    as someone else's old one.

    So it is an offer. Nothing is written into the form until this says so, and
    Discard is right next to it. */}
<div class="je-restore" id="je-restore" role="status" hidden>
  <div class="je-restore-copy">
    <p class="je-restore-title">Unsaved changes are being held in this browser</p>
    <p class="text-muted admin-note" id="je-restore-when"></p>
  </div>
  <div class="je-restore-actions">
    <button type="button" class="btn btn-primary btn-sm" id="je-restore-apply">Restore them</button>
    <button type="button" class="btn btn-secondary btn-sm" id="je-restore-discard">Discard</button>
  </div>
</div>

<div class="editor-grid">
  <div class="editor-col">
    {/* Each field that the assistant can write gets its own button, because
        "ask the assistant to do this to this field" is one intention and
        making it two — open a panel, then find the right task in a list of ten
        — is the thing that stops people using it. The button carries the task
        name; the panel is opened *and run* from it. */}
    <div class="editor-title-row">
      <input
        class="input editor-title"
        id="f-title"
        placeholder="Post Title..."
        value={editing ? fields!.title : ''}
      />
      <button
        type="button"
        class="btn btn-secondary je-spark"
        data-assist-task="titles"
        title="Suggest titles"
        aria-label="Suggest titles"
      >
        <Icon name="lucide:sparkles" class="admin-nav-icon" />
      </button>
    </div>

    <div class="tab-bar" role="tablist" aria-label="Editor view" id="je-tabs">
      <button type="button" class="tab" role="tab" id="je-tab-write" aria-controls="je-panel-write" aria-selected="true">
        <Icon name="lucide:pen-line" class="admin-nav-icon" />Write
      </button>
      <button type="button" class="tab" role="tab" id="je-tab-preview" aria-controls="je-panel-preview" aria-selected="false">
        <Icon name="lucide:eye" class="admin-nav-icon" />Preview
      </button>
    </div>

    <div class="tab-panel" id="je-panel-write" role="tabpanel" aria-labelledby="je-tab-write">
      <div class="md-toolbar" role="toolbar" aria-label="Markdown formatting">
        <button type="button" class="btn btn-secondary md-btn" data-before="**" data-after="**" title="Bold"><strong>B</strong></button>
        <button type="button" class="btn btn-secondary md-btn" data-before="*" data-after="*" title="Italic"><em>I</em></button>
        <button type="button" class="btn btn-secondary md-btn" data-before="`" data-after="`" title="Inline code">&lt;/&gt;</button>
        <button type="button" class="btn btn-secondary md-btn" data-before="[" data-after="](https://)" title="Link">link</button>
        <button type="button" class="btn btn-secondary md-btn" data-before="![" data-after="](/images/)" title="Image">image</button>
        <button
          type="button"
          class="btn btn-secondary md-assist"
          data-assist-task="compose"
          title="Write the whole post from a topic"
        >
          <Icon name="lucide:sparkles" class="admin-nav-icon" />Write with AI
        </button>
      </div>
      <textarea class="input editor-body" id="f-body" placeholder="Write your post using Markdown...">{body}</textarea>
    </div>

    <div class="tab-panel" id="je-panel-preview" role="tabpanel" aria-labelledby="je-tab-preview" hidden>
      <div class="card elev-md preview-card">
        <h3 class="preview-title" id="preview-title">Post Title...</h3>
        <div class="preview-md" id="preview-body"></div>
      </div>
      <p class="text-muted admin-note je-preview-note">
        A small hand-rolled Markdown subset — enough to check shape and spelling.
        Saving renders the real thing, and the post's page is what shows it.
      </p>
    </div>
  </div>

  <aside class="editor-side focus-hide">
    <div class="card elev-sm">
      <h6 class="admin-eyebrow">Metadata</h6>
      <div class="field">
        <div class="je-field-head">
          <label for="f-summary">Summary</label>
          <button
            type="button"
            class="btn btn-ghost je-spark je-spark-sm"
            data-assist-task="summary"
            title="Write the summary from the draft"
          >
            <Icon name="lucide:sparkles" class="admin-nav-icon" />Write it
          </button>
        </div>
        <textarea class="input summary-input" id="f-summary" placeholder="One line for the card and the meta description."></textarea>
      </div>
      <div class="field">
        <label for="f-date">Publish Date</label>
        <input class="input" type="date" id="f-date" value={today} />
      </div>
      <div class="field">
        <div class="je-field-head">
          <label for="f-tags">Tags (comma separated)</label>
          <button
            type="button"
            class="btn btn-ghost je-spark je-spark-sm"
            data-assist-task="tags"
            title="Suggest tags, reusing ones already on the site"
          >
            <Icon name="lucide:sparkles" class="admin-nav-icon" />Suggest
          </button>
        </div>
        <input class="input" id="f-tags" placeholder="e.g. Design Systems, Astro" />
      </div>
      <div class="field field-row">
        <div>
          <label for="f-readtime">Read time</label>
          <input class="input" id="f-readtime" placeholder="5 min" />
        </div>
        <div>
          <label for="f-duration">Video duration</label>
          <input class="input" id="f-duration" placeholder="14:23" />
        </div>
      </div>
      <div class="field">
        <label>Status</label>
        <div class="seg">
          {POST_STATUSES.map(([value, label]) => (
            <label class="seg-opt">
              <input
                type="radio"
                name="status"
                value={value}
                checked={value === (editing ? fields!.status : 'draft')}
              />{label}
            </label>
          ))}
        </div>
        <p class="text-muted admin-note status-help" id="status-help"></p>
      </div>
    </div>

    <div class="card elev-sm">
      <h6 class="admin-eyebrow">Thumbnail</h6>
      <div class="field">
        <label for="f-hero">Featured image</label>
        <input class="input" id="f-hero" placeholder="/images/post.jpg or https://…" />
      </div>
      <p class="text-muted admin-note">
        <strong>Browse library</strong> picks an image that is already here;
        <strong>Upload image</strong> adds a new one under <code>images/journal/</code> and
        fills the field with the <code>/media/…</code> path it now answers on. An absolute
        URL to somewhere else works too, and is never fetched by this site.
      </p>
    </div>
  </aside>
</div>

{/* — the writing assistant —

    A **non-modal** `<dialog>`, docked to the corner, and that is the whole
    design rather than a styling choice. It used to be `showModal()`, which put
    a backdrop over the editor — fine when the assistant's entire output was a
    block of text in a panel waiting for Insert, and wrong the moment a task
    started writing into the fields themselves. The point of `compose` is that
    the author *watches the form fill in*; a modal is a sheet pulled over the
    only thing worth looking at.

    Non-modal costs three things the platform gives a modal for free, and each
    is re-added in the script below because each is worth having: Escape to
    close, focus moving in on open, and the top layer. The last one is not
    re-added — it is not wanted. A docked panel that sits *under* the select
    popovers and the toast host is correct, and those are the only two things
    on this surface that outrank it.

    Everything the assistant produces still ends in the editor and nowhere else.
    `save()` remains the only thing that writes a row. */}
<dialog class="asx" id="assist-dialog" aria-label="Writing assistant">
  <header class="asx-head">
    <div class="asx-head-copy">
      <h3 class="asx-title">
        <Icon name="lucide:sparkles" class="admin-nav-icon" />Writing assistant
      </h3>
      <p class="asx-sub">Writes into the editor. Nothing is saved until you press Save.</p>
    </div>
    <button type="button" class="btn btn-icon" id="assist-close" aria-label="Close assistant">
      <Icon name="lucide:x" class="admin-nav-icon" />
    </button>
  </header>

  <div class="asx-body">
    {/* The topic box is first and always visible, because "write a post about
        X" is the thing this panel exists for and burying it under ten task
        buttons would make the headline feature the least reachable one. */}
    <div class="asx-ask">
      <label class="asx-ask-label" for="assist-instruction">What should it write about?</label>
      <textarea
        class="input asx-ask-input"
        id="assist-instruction"
        rows="2"
        placeholder="e.g. why we replaced cache invalidation with a five minute TTL"
      ></textarea>
      <div class="asx-ask-row">
        <span class="text-muted asx-ask-hint" id="assist-hint"></span>
        <button type="button" class="btn btn-primary btn-sm" id="assist-run">Write the whole post</button>
      </div>
    </div>

    {/* Three shelves rather than ten buttons in a row. The grouping is a field
        on the task (`ASSIST_GROUPS` in `assist-tasks.ts`), not a decision made
        here, so a new task lands on the right shelf by declaring where it
        belongs — the same reason the buttons themselves are generated. */}
    <div class="asx-tasks" id="assist-tasks">
      {ASSIST_GROUPS.map(group => (
        <section class="asx-group">
          <div class="asx-group-head">
            <h4 class="asx-group-label">{group.label}</h4>
            <p class="asx-group-hint">{group.hint}</p>
          </div>
          {ASSIST_MENU.filter(task => task.surface === 'journal' && task.group === group.id).map(task => (
            <button
              type="button"
              class="asx-task"
              data-task={task.name}
              data-needs-selection={task.needsSelection ? '1' : undefined}
              data-needs-topic={task.needsTopic ? '1' : undefined}
              data-live={task.live ?? undefined}
              aria-pressed="false"
            >
              <span class="asx-task-label">{task.label}</span>
              <span class="asx-task-hint">{task.hint}</span>
            </button>
          ))}
        </section>
      ))}
    </div>

    <p class="admin-note asx-status" id="assist-status">
      Pick a task, or describe a post and press Write. Nothing is sent until you do.
    </p>

    {/* Only the tasks that *offer* something fill this. A task that writes
        straight into a field shows its progress on the status line instead —
        the author is looking at the form, and a second copy of the same text
        beside it is noise competing with the thing it duplicates. */}
    <div class="asx-output" id="assist-output" hidden>
      {/* Suggestions that are a *list* — five titles, six tags — are pickable
          here rather than being printed as text with an Insert button that
          silently took the first one and left the other four to be copied by
          hand. One chip, one thing applied, and the panel says which. */}
      <div class="asx-options" id="assist-options" hidden></div>
      <pre class="asx-text" id="assist-text"></pre>
      <div class="asx-preview" id="assist-preview" hidden></div>
    </div>
  </div>

  <footer class="asx-foot">
    <span class="text-muted asx-note" id="assist-note"></span>
    <div class="asx-foot-actions">
      <button type="button" class="btn btn-secondary btn-sm" id="assist-stop" hidden>Stop</button>
      <button type="button" class="btn btn-secondary btn-sm" id="assist-undo" hidden>Undo</button>
      <button type="button" class="btn btn-secondary btn-sm" id="assist-copy" hidden>Copy</button>
      <button type="button" class="btn btn-secondary btn-sm" id="assist-retry" hidden>Try again</button>
      <button type="button" class="btn btn-primary btn-sm" id="assist-insert" hidden>Insert</button>
    </div>
  </footer>
</dialog>

<script is:inline type="application/json" id="journal-editor-seed" set:html={seedJson}></script>

<script>
  import { navigate } from 'astro:transitions/client';
  import { ADMIN_KEYS, onAdminPage, setBusy, setLabel, toast, undoRing, wireTabs } from '../lib/admin';
  import {
    buildPostMarkdown,
    createPost,
    postPath,
    updatePost,
    type PostFields,
    type PostStatus,
  } from '../lib/content-store';
  import { getToken } from '../lib/github';
  import { attachImageUpload } from '../lib/image-upload';
  import { copyText } from '../lib/clipboard';
  import { runAssist } from '../lib/ai-store';
  import {
    ASSIST_TASKS,
    isAssistTask,
    parseDocument,
    type JournalTarget,
    type AssistTask,
    type AssistTaskName,
  } from '../lib/assist-tasks';
  import {
    DiagramError,
    diagramMarkdown,
    diagramName,
    extractMermaid,
    renderMermaid,
    standalone,
    uploadDiagram,
  } from '../lib/diagram';

  /* One module for both screens — `/admin/journal/new` and
     `/admin/journal/<slug>` render the same component, so the difference
     between them is entirely in the seed below. The admin client-routes, so
     this runs on first paint and again on every navigation into either. */
  onAdminPage('#journal-editor', () => {
    const KEY = ADMIN_KEYS.journalDraft;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    interface Seed {
      /** The post being edited, or `null` for a new one. The URL decided this. */
      slug: string | null;
      fields: PostFields | null;
    }
    const seed: Seed = JSON.parse(document.getElementById('journal-editor-seed')!.textContent || '{}');
    const editing = seed.slug;

    const fields = {
      title: $<HTMLInputElement>('f-title'),
      summary: $<HTMLTextAreaElement>('f-summary'),
      date: $<HTMLInputElement>('f-date'),
      tags: $<HTMLInputElement>('f-tags'),
      readTime: $<HTMLInputElement>('f-readtime'),
      duration: $<HTMLInputElement>('f-duration'),
      hero: $<HTMLInputElement>('f-hero'),
      body: $<HTMLTextAreaElement>('f-body'),
    };
    const statusInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="status"]'));
    const slugOut = $('f-slug');
    const heading = $('editor-heading');
    const previewTitle = $('preview-title');
    const previewBody = $('preview-body');
    const stamp = $('save-stamp');
    const commitBtn = $<HTMLButtonElement>('commit-md');

    const slugify = (s: string) =>
      s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'untitled';

    // Quotes matter: link hrefs below are interpolated into an attribute, and an
    // unescaped `"` would close it and inject markup of the author's own typing.
    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    /* Only schemes a published post could actually use — keeps `javascript:`
       out of the preview's hrefs. */
    const safeHref = (url: string) =>
      /^(https?:|mailto:|[/#.])/i.test(url.trim()) ? url.trim() : '#';

    /* A deliberately small Markdown subset — enough for an accurate preview
       without pulling a parser into the bundle. */
    function renderMarkdown(src: string): string {
      const blocks = escapeHtml(src).split(/\n{2,}/);
      return blocks
        .map(block => {
          const trimmed = block.trim();
          if (!trimmed) return '';

          if (trimmed.startsWith('```')) {
            const code = trimmed.replace(/^```[^\n]*\n?/, '').replace(/```$/, '');
            return `<pre><code>${code}</code></pre>`;
          }
          const heading = trimmed.match(/^(#{1,3})\s+(.*)$/);
          if (heading) {
            const level = heading[1].length;
            return `<h${level}>${inline(heading[2])}</h${level}>`;
          }
          if (/^>\s/.test(trimmed)) {
            return `<blockquote>${inline(trimmed.replace(/^>\s?/gm, ''))}</blockquote>`;
          }
          if (/^[-*]\s/.test(trimmed)) {
            const items = trimmed.split('\n').map(l => `<li>${inline(l.replace(/^[-*]\s+/, ''))}</li>`).join('');
            return `<ul>${items}</ul>`;
          }
          if (/^\d+\.\s/.test(trimmed)) {
            const items = trimmed.split('\n').map(l => `<li>${inline(l.replace(/^\d+\.\s+/, ''))}</li>`).join('');
            return `<ol>${items}</ol>`;
          }
          return `<p>${inline(trimmed.replace(/\n/g, ' '))}</p>`;
        })
        .join('');
    }

    function inline(s: string): string {
      return s
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, label, url) => `<a href="${safeHref(url)}">${label}</a>`);
    }

    const STATUS_HELP: Record<string, string> = {
      draft: 'Off the public site in production. Visible here, and in local development.',
      published: 'Live on the site the moment you save — there is no build in between.',
      unpublished: 'Withdrawn: no listing, no page, the URL returns 404. Reversible from here.',
    };

    function currentStatus(): PostStatus {
      return (statusInputs.find(i => i.checked)?.value ?? 'draft') as PostStatus;
    }

    /* An open post keeps its slug however the title is edited, so the image is
       named after whichever of the two is the post's actual identity. */
    attachImageUpload(fields.hero, {
      dir: 'images/journal',
      name: () => `${editing ?? slugify(fields.title.value)}-hero`,
    });

    /* The preview is only rebuilt while its tab is showing — it is the whole
       body through a regex on every keystroke, and nobody is reading it from
       behind the writing panel. Switching tabs rebuilds it once. */
    let previewing = false;

    function renderPreview() {
      previewTitle.textContent = fields.title.value || 'Post Title...';
      previewBody.innerHTML = renderMarkdown(fields.body.value);
    }

    function render() {
      if (previewing) renderPreview();

      /* A new post's slug follows the title until the first save. An open one
         already has a row, and rewriting the line on every keystroke would
         promise a rename this screen deliberately does not do. */
      if (editing === null) {
        slugOut.textContent = postPath(slugify(fields.title.value));
        heading.textContent = fields.title.value.trim() || 'Create New Journal Entry';
      }
      $('status-help').textContent = STATUS_HELP[currentStatus()] ?? '';
    }

    wireTabs($('je-tabs'), id => {
      previewing = id === 'je-panel-preview';
      if (previewing) renderPreview();
    });

    function snapshot() {
      return {
        title: fields.title.value,
        summary: fields.summary.value,
        date: fields.date.value,
        tags: fields.tags.value,
        readTime: fields.readTime.value,
        duration: fields.duration.value,
        hero: fields.hero.value,
        body: fields.body.value,
        status: currentStatus(),
        /* Which post this draft belongs to. The offer below refuses a snapshot
           whose `editing` does not match this screen, so a half-written new
           entry cannot be resurrected on top of a published post. */
        editing,
        /* When, so the offer can say how old it is. A snapshot with no answer
           to that is a decision made blind. */
        savedAt: Date.now(),
      };
    }

    /** The form as schema-shaped fields, for both the export and the save. */
    function readFields(): PostFields {
      return {
        title: fields.title.value.trim(),
        summary: fields.summary.value.trim(),
        date: fields.date.value,
        tags: fields.tags.value.split(',').map(tag => tag.trim()).filter(Boolean),
        readTime: fields.readTime.value.trim() || undefined,
        videoDuration: fields.duration.value.trim() || undefined,
        heroImage: fields.hero.value.trim() || undefined,
        status: currentStatus(),
      };
    }

    /* The title, the body and the status are server-rendered into the markup —
       they are the three the browser can restore for free. The rest is filled
       in here so an empty optional stays empty rather than printing
       "undefined". */
    if (seed.fields) {
      fields.summary.value = seed.fields.summary ?? '';
      fields.date.value = (seed.fields.date ?? '').slice(0, 10) || fields.date.value;
      fields.tags.value = (seed.fields.tags ?? []).join(', ');
      fields.readTime.value = seed.fields.readTime ?? '';
      fields.duration.value = seed.fields.videoDuration ?? '';
      fields.hero.value = seed.fields.heroImage ?? '';
    }

    /* — the browser snapshot —

       A crash guard, and nothing more: the *saved* state of a post is its row,
       and has been since content moved to D1. This used to be applied on sight,
       which turned every visit to `/admin/journal/new` into last week's
       abandoned paragraph, already in the fields, with no way to clear it short
       of the dashboard's Clear Local Drafts.

       `editing` is part of the snapshot so this can tell which screen it
       belongs to: a draft of the new-entry screen must not reappear on top of a
       post, and a draft of one post must not reappear on another. */
    const restoreBar = $('je-restore');

    function readSnapshot(): Record<string, unknown> | null {
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (!saved || (saved.editing ?? null) !== editing) return null;
        return saved;
      } catch {
        /* A corrupt snapshot is worth less than the space it takes up. */
        localStorage.removeItem(KEY);
        return null;
      }
    }

    function applySnapshot(saved: Record<string, any>) {
      fields.title.value = saved.title ?? '';
      fields.summary.value = saved.summary ?? '';
      if (saved.date) fields.date.value = saved.date;
      fields.tags.value = saved.tags ?? '';
      fields.readTime.value = saved.readTime ?? '';
      fields.duration.value = saved.duration ?? '';
      fields.hero.value = saved.hero ?? '';
      fields.body.value = saved.body ?? '';
      statusInputs.forEach(i => { i.checked = i.value === (saved.status ?? 'draft'); });
      render();
    }

    /* Only worth offering if it actually differs from what is already on
       screen — a snapshot identical to the row it came from is not unsaved
       work, and offering to "restore" it is a bar that never goes away. */
    function differsFromForm(saved: Record<string, any>): boolean {
      const now = snapshot();
      return (['title', 'summary', 'date', 'tags', 'readTime', 'duration', 'hero', 'body', 'status'] as const)
        .some(key => String(saved[key] ?? '') !== String((now as Record<string, unknown>)[key] ?? ''));
    }

    function offerRestore() {
      const saved = readSnapshot();
      if (!saved || !differsFromForm(saved)) {
        restoreBar.hidden = true;
        return;
      }
      const when = typeof saved.savedAt === 'number' ? new Date(saved.savedAt) : null;
      $('je-restore-when').textContent = when
        ? `Last typed ${when.toLocaleString()}. Restoring replaces what is on screen.`
        : 'Restoring replaces what is on screen.';
      restoreBar.hidden = false;
    }

    $<HTMLButtonElement>('je-restore-apply').addEventListener('click', () => {
      const saved = readSnapshot();
      if (saved) applySnapshot(saved as Record<string, any>);
      restoreBar.hidden = true;
      toast('Unsaved changes restored. Save to put them on the site.', { tone: 'info' });
    });

    $<HTMLButtonElement>('je-restore-discard').addEventListener('click', () => {
      localStorage.removeItem(KEY);
      restoreBar.hidden = true;
      toast('Held changes discarded. The screen is on what is saved.', { tone: 'info' });
    });

    /* Autosaved rather than saved by a button, because the button that said
       "Save Draft" now saves a row and the snapshot has no user-facing job
       left. Debounced: this runs per keystroke over a whole post body. */
    let autosave: ReturnType<typeof setTimeout>;
    function holdLocally() {
      clearTimeout(autosave);
      autosave = setTimeout(() => {
        /* Nothing typed is not work to protect, and writing it would make the
           next visit offer to restore an empty form. */
        if (!fields.title.value.trim() && !fields.body.value.trim()) return;
        localStorage.setItem(KEY, JSON.stringify(snapshot()));
      }, 700);
    }

    Object.values(fields).forEach(el => {
      el.addEventListener('input', render);
      el.addEventListener('input', holdLocally);
    });
    statusInputs.forEach(i => {
      i.addEventListener('change', render);
      i.addEventListener('change', holdLocally);
    });

    /* Formatting buttons wrap the selection. `setRangeText` keeps the undo stack
       intact, which reassigning `.value` would throw away. */
    /* `[data-before]`, not just `.md-btn`: this handler reads `dataset.before`
       and `dataset.after` and interpolates both into a template literal, so a
       button in this toolbar that carries the class without the data pastes the
       string `undefined` into the post — twice, once for each end. The Write
       with AI button was exactly that until the selector said what it needs. */
    document.querySelectorAll<HTMLButtonElement>('.md-btn[data-before]').forEach(btn => {
      btn.addEventListener('click', () => {
        const body = fields.body;
        const { selectionStart: start, selectionEnd: end } = body;
        const wrapped = `${btn.dataset.before}${body.value.slice(start, end)}${btn.dataset.after}`;
        body.setRangeText(wrapped, start, end, 'end');
        body.focus();
        render();
      });
    });

    /* Forces the status and saves, so a draft ends up where every screen looks
       for one: a `journal` row with `status = 'draft'`, in the entries list,
       under the Draft filter, on the dashboard. */
    const draftBtn = $<HTMLButtonElement>('save-draft');
    draftBtn.addEventListener('click', () => {
      statusInputs.forEach(input => { input.checked = input.value === 'draft'; });
      render();
      void save(draftBtn);
    });

    $<HTMLButtonElement>('export-md').addEventListener('click', () => {
      const name = editing ?? slugify(fields.title.value);
      const blob = new Blob([buildPostMarkdown(readFields(), fields.body.value)], {
        type: 'text/markdown',
      });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${name}.md`;
      a.click();
      URL.revokeObjectURL(url);
      toast(`Downloaded ${name}.md.`, { tone: 'success' });
    });

    /* Save straight to the row the public page renders. The export above stays:
       it is the only path that works when you are not signed in, and the way a
       post leaves this system.

       Two write paths, and which one runs is the URL. A new entry is inserted
       whole — there is nothing to preserve. An open one is patched column by
       column with its body swapped, because the row may carry a column this
       editor has never heard of and rewriting it whole would drop it. Same
       split as the project screens; see `content-store.ts`. */
    if (!getToken()) {
      /* Both save paths write a row, so both need a session. Export and the
         browser snapshot are what still work signed out. */
      for (const button of [commitBtn, draftBtn]) {
        button.disabled = true;
        button.title = 'Sign in with GitHub to save.';
      }
    }

    /**
     * The three columns `journal` declares NOT NULL, checked before the round
     * trip rather than after it.
     *
     * The database is the validation now (decision 18), and it does refuse
     * these — but it refuses them in SQLite: saving with an empty summary
     * answered `D1_ERROR: NOT NULL constraint failed: journal.summary:
     * SQLITE_CONSTRAINT`, which is a correct sentence about a blank field a few
     * pixels away and reads as a broken site. `explainConstraint()` on the
     * endpoint turns that into English for anything that gets past here; this
     * is the half that never sends the request at all, and can therefore name
     * the field in the terms this screen uses for it.
     *
     * Keep the two in step: a column that becomes NOT NULL wants a line here.
     */
    function whatIsMissing(post: PostFields): string | null {
      if (!post.title) return 'A title is required — it is also where the slug comes from.';
      if (!post.summary) return 'A summary is required: it is the card body and the meta description.';
      if (!post.date) return 'A publish date is required — it is what orders the listing.';
      return null;
    }

    /* Which field to put the cursor in, for each of the above. Reporting what is
       wrong and leaving the author to find it is half an error message. */
    const FIELD_FOR_ERROR: [keyof typeof fields, () => boolean][] = [
      ['title', () => !fields.title.value.trim()],
      ['summary', () => !fields.summary.value.trim()],
      ['date', () => !fields.date.value],
    ];

    /**
     * Write the post, from whichever button asked.
     *
     * Shared by "Save as draft" and the primary save, which differ only in
     * whether the status is forced first — so there is one write path, one set
     * of required-field checks and one place the busy state is released.
     */
    async function save(button: HTMLButtonElement): Promise<void> {
      const post = readFields();
      const missing = whatIsMissing(post);
      if (missing) {
        stamp.textContent = missing;
        toast(missing, { tone: 'error' });
        const blank = FIELD_FOR_ERROR.find(([, isEmpty]) => isEmpty());
        if (blank) fields[blank[0]].focus();
        return;
      }

      const target = editing ?? slugify(post.title);

      setBusy(button, true, 'Saving…');
      stamp.textContent = `Saving ${postPath(target)}…`;
      const pending = toast(`Saving ${target}…`, { tone: 'pending' });

      try {
        const result = editing
          ? await updatePost(editing, post, fields.body.value)
          : await createPost(target, post, fields.body.value);

        /* The row is the saved state now, so the browser snapshot has nothing
           left to protect — and leaving it would have the restore bar offering
           to put the same content back on the next visit. */
        localStorage.removeItem(KEY);
        restoreBar.hidden = true;

        /* An unpublished post has no public page, so offering a link to one
           would be offering a 404 — the same reason the entries list only links
           the published state. */
        const live = post.status === 'published';
        pending.update(
          live
            ? `${target} is saved and live.`
            : `${target} is saved as a ${post.status === 'draft' ? 'draft' : post.status} post — in the entries list, not on the public site.`,
          {
            tone: 'success',
            action: live ? { label: 'view live ↗', href: result.url } : undefined,
          },
        );

        if (editing) {
          const link = document.createElement('a');
          link.href = result.url;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = 'view live ↗';
          stamp.replaceChildren(document.createTextNode('Saved — '), link);
          setBusy(button, false);
          return;
        }

        /* A new post now exists at a slug, and this screen is still
           `/admin/journal/new` — which is the screen that *creates* one. Press
           save twice and the second one is a duplicate-slug refusal. Which post
           is open is the route (decision 13), so the route has to catch up.
           `navigate()` rather than a location assignment, so it is a client
           route and the toast reporting the save survives the swap. */
        stamp.textContent = `Created ${postPath(target)}. Opening it…`;
        setBusy(button, false);
        await navigate(`/admin/journal/${target}`);
      } catch (error) {
        const text = error instanceof Error ? error.message : 'Save failed.';
        stamp.textContent = text;
        pending.update(text, { tone: 'error' });
        setBusy(button, false);
      }
    }

    commitBtn.addEventListener('click', () => void save(commitBtn));

    /* — the writing assistant —

       Two ways for a task's output to arrive, and which one applies is data on
       the task rather than a branch here: `task.live` names a field, or it is
       absent.

         - **Live.** The text is written into the field *as it streams*, and the
           panel's job shrinks to a progress line and an Undo. `compose` fills
           the whole form this way, which is the feature — a title appearing
           letter by letter, then a summary, then tags, then the body building
           underneath them, is the difference between a tool and a spinner.
         - **Panel.** The output lands in the box with an Insert button, because
           it is a *choice*: five titles, six tags, a paragraph that could go in
           three places. Insert is where the author says which and where.

       Neither writes a row. `save()` is still the only thing that does, and the
       diagram task's upload on Insert is still the one exception — same rule as
       `image-upload.ts`, an unreferenced upload is harmless and a saved post
       pointing at bytes that were never written is not.

       **Every live run is undoable in one press, three runs back.** The
       affected fields are snapshotted before the first token arrives, which is
       the thing that makes writing straight into the form reasonable rather
       than reckless — and the ring is what makes it survive being used the way
       it actually is, which is several tasks in a row before deciding the
       second one was the good one. */
    const assistDialog = $<HTMLDialogElement>('assist-dialog');
    const assistOutput = $('assist-output');
    const assistOptions = $('assist-options');
    const assistText = $('assist-text');
    const assistPreview = $('assist-preview');
    const assistStatus = $('assist-status');
    const assistNote = $('assist-note');
    const assistHint = $('assist-hint');
    const assistInstruction = $<HTMLTextAreaElement>('assist-instruction');
    const runBtn = $<HTMLButtonElement>('assist-run');
    const stopBtn = $<HTMLButtonElement>('assist-stop');
    const undoBtn = $<HTMLButtonElement>('assist-undo');
    const insertBtn = $<HTMLButtonElement>('assist-insert');
    const copyBtn = $<HTMLButtonElement>('assist-copy');
    const retryBtn = $<HTMLButtonElement>('assist-retry');
    const assistOpen = $<HTMLButtonElement>('assist-open');

    /* What the last panel run produced, and how to apply it. `apply` is set per
       task because "insert" means four different things — replace the
       selection, append to the body, fill a field, merge tags — and branching
       on the task name at click time would put that knowledge in two places. */
    interface Prepared {
      text: string;
      apply: () => void;
      /**
       * Individually applicable results, rendered as chips.
       *
       * A task whose output is a *list* has no single correct Insert. The panel
       * used to print all five titles and have Insert take the first one, with
       * a comment conceding that the rest were there to be copied — which is a
       * picker that makes the author do the picking by hand. When this is set,
       * the chips are the action and Insert is hidden.
       */
      options?: { label: string; apply: () => void }[];
    }

    let result: Prepared | null = null;
    let lastTask: AssistTaskName | null = null;
    let selected: AssistTaskName | null = null;

    /* The range a selection task will replace, taken at the moment the run
       starts rather than when the panel opened. The panel is non-modal now, so
       the author can select text with it already on screen — capturing on open
       would mean the panel had to be closed and reopened to notice. A textarea
       keeps `selectionStart`/`selectionEnd` after it loses focus, which is what
       makes reading them from a button click work at all. */
    let captured = { start: 0, end: 0, text: '' };

    function currentSelection() {
      const body = fields.body;
      return {
        start: body.selectionStart,
        end: body.selectionEnd,
        text: body.value.slice(body.selectionStart, body.selectionEnd),
      };
    }

    const setAssistStatus = (text: string, tone: 'info' | 'error' = 'info') => {
      assistStatus.dataset.tone = tone;
      assistStatus.textContent = text;
    };

    /** Put text where the selection was. `setRangeText` keeps the undo stack. */
    function replaceSelection(text: string) {
      const body = fields.body;
      body.focus();
      body.setRangeText(text, captured.start, captured.end, 'end');
      render();
      holdLocally();
    }

    /** Append to the end of the body, with a blank line before it. */
    function appendToBody(text: string) {
      const body = fields.body;
      const existing = body.value.replace(/\s+$/, '');
      body.value = existing ? `${existing}\n\n${text.trim()}\n` : `${text.trim()}\n`;
      /* Assigning `.value` fires no event, so the two things an `input`
         listener would have done are done by hand — the same reason
         `image-upload.ts` overrides the value setter on the field it is given. */
      render();
      holdLocally();
    }

    /** One item per line, with any bullet or numbering the model added stripped. */
    const asLines = (text: string) =>
      text
        .split('\n')
        .map(line => line.replace(/^\s*(?:[-*]|\d+[.)])\s*/, '').trim())
        .filter(Boolean);

    /* — live targets —

       Which inputs a live task touches, so the snapshot behind Undo covers
       exactly those and no more. Undoing a summary rewrite must not also revert
       the paragraph the author typed while it was running. */
    const LIVE_FIELDS: Record<JournalTarget, (keyof typeof fields)[]> = {
      document: ['title', 'summary', 'tags', 'readTime', 'body'],
      summary: ['summary'],
      body: ['body'],
    };

    /* Three runs back, not one. Tasks get used in sequence — compose, then
       rewrite the summary, then rewrite it again with a different steer — and
       the one an author wants back is often not the last. `undoRing()` in
       `admin.ts` has the reasoning and the reason it stops at three. */
    const undos = undoRing();

    function takeSnapshot(target: JournalTarget, label: string) {
      const values: Record<string, string> = {};
      for (const key of LIVE_FIELDS[target]) values[key] = fields[key].value;
      undos.push({ label, values });
    }

    /**
     * Drop the snapshot the current run took, if that run changed nothing.
     *
     * A failed or unusable run has already pushed an entry — the snapshot is
     * taken before the first token, because by the time anything is known about
     * the response the fields have been written to. Leaving it would offer Undo
     * for a run that did nothing and push a real snapshot off the end of the
     * ring, which is the one thing a three-deep ring must not do.
     *
     * Compared by value rather than tracked by a flag, so a run that wrote
     * something and *then* failed keeps its entry — that is exactly the case
     * where Undo is the only way back.
     */
    function dropUnusedSnapshot() {
      const entry = undos.peek();
      if (!entry) return;
      const untouched = Object.entries(entry.values).every(
        ([key, value]) => fields[key as keyof typeof fields].value === value,
      );
      if (untouched) undos.pop();
    }

    function undoLive() {
      const entry = undos.pop();
      if (!entry) return;
      for (const [key, value] of Object.entries(entry.values)) {
        fields[key as keyof typeof fields].value = value ?? '';
      }
      render();
      holdLocally();
      setFoot('idle');
      const left = undos.depth;
      setAssistStatus(
        left
          ? `Put back the way it was before “${entry.label}”. ${left} more step${left === 1 ? '' : 's'} back.`
          : `Put back the way it was before “${entry.label}”.`,
      );
      toast('Reverted.', { tone: 'success' });
    }

    /**
     * Write a partially-arrived response into the fields it belongs to.
     *
     * Called on every animation frame while a live task streams, and once more
     * when it finishes.
     *
     * A `document` run writes the body **only once `BODY:` has parsed**, and
     * there is no longer any fallback for a response that carried no labels at
     * all. That fallback is what wrote a reasoning model's chain-of-thought
     * into the post; `parseDocument`'s closing comment has the account, and
     * `runTask` now routes an unlabelled response to the panel instead.
     *
     * Every branch here is guarded on a *parsed* field, which is what makes
     * that safe: a run that recognised nothing writes nothing, so there is no
     * half-applied state to unpick.
     *
     * `final` still matters to the two prose targets — a streaming body keeps
     * its trailing whitespace so the caret does not jump, a finished one is
     * trimmed.
     */
    function applyLive(target: JournalTarget, raw: string, final: boolean) {
      if (target === 'document') {
        const doc = parseDocument(raw);
        if (doc.title) fields.title.value = doc.title;
        if (doc.summary) fields.summary.value = doc.summary;
        if (doc.tags) fields.tags.value = doc.tags;
        if (doc.readTime) fields.readTime.value = doc.readTime;
        if (doc.bodyStarted) fields.body.value = doc.body;
      } else if (target === 'summary') {
        /* Models quote a one-line answer about a third of the time, and a
           quoted summary goes into the card and the meta description with the
           quotes in it. */
        fields.summary.value = raw.trim().replace(/^["']|["']$/g, '');
      } else {
        fields.body.value = final ? raw.trim() : raw;
      }
      render();
      holdLocally();
    }

    /** A short, honest description of how far a live run has got. */
    function liveProgress(target: JournalTarget, raw: string): string {
      if (target !== 'document') return `Writing… ${raw.length.toLocaleString()} characters.`;
      const doc = parseDocument(raw);
      const landed = [
        doc.title && 'title',
        doc.summary && 'summary',
        doc.tags && 'tags',
        doc.readTime && 'read time',
        doc.bodyStarted && `body (${doc.body.length.toLocaleString()} characters)`,
      ].filter(Boolean);
      return landed.length ? `Writing… ${landed.join(', ')}.` : 'Writing…';
    }

    /**
     * Turn a panel task's output into something applicable.
     *
     * Every branch returns an `apply` that touches exactly one thing, so the
     * Insert button is never ambiguous about what it is about to change.
     */
    /**
     * Draw a list result as chips.
     *
     * Each chip applies exactly one thing, and the panel stays open — so
     * picking three of six tags is three clicks rather than three runs. A used
     * chip is marked rather than removed: the author needs to see what they
     * have already taken, and a list that shortens under the cursor is how the
     * wrong tag gets clicked.
     */
    function renderOptions(options?: Prepared['options']) {
      assistOptions.replaceChildren();
      assistOptions.hidden = !options?.length;
      if (!options?.length) return;

      for (const option of options) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'asx-option';
        chip.textContent = option.label;
        chip.addEventListener('click', () => {
          option.apply();
          chip.dataset.used = '';
        });
        assistOptions.append(chip);
      }
    }

    function prepare(task: string, output: string): Prepared {
      switch (task) {
        case 'titles': {
          const suggested = asLines(output);
          const setTitle = (title: string) => () => {
            fields.title.value = title;
            render();
            holdLocally();
            toast('Title set.', { tone: 'success' });
          };
          return {
            text: suggested.join('\n'),
            /* Unreachable while `options` is set, because Insert is hidden —
               but a `Prepared` that sometimes has no `apply` would be a second
               shape for every caller to handle. */
            apply: setTitle(suggested[0] ?? fields.title.value),
            options: suggested.map(title => ({ label: title, apply: setTitle(title) })),
          };
        }

        case 'tags': {
          const suggested = asLines(output);
          /* Merged with what is already there rather than replacing it, in both
             paths: the author's own tags are a deliberate choice and a
             suggestion is not grounds to drop them. Case-insensitively, because
             "Caching" and "caching" are one tag with two spellings and the site
             would otherwise list both. */
          const merge = (incoming: string[]) => () => {
            const existing = fields.tags.value.split(',').map(t => t.trim()).filter(Boolean);
            const seen = new Set(existing.map(t => t.toLowerCase()));
            for (const tag of incoming) {
              if (seen.has(tag.toLowerCase())) continue;
              existing.push(tag);
              seen.add(tag.toLowerCase());
            }
            fields.tags.value = existing.join(', ');
            render();
            holdLocally();
            toast(incoming.length > 1 ? 'Tags merged in.' : `Added "${incoming[0]}".`, {
              tone: 'success',
            });
          };
          return {
            text: suggested.join('\n'),
            apply: merge(suggested),
            /* "Add all" first, because taking the lot is the common case and
               the per-tag chips are for the run that got four right and two
               wrong. */
            options: [
              { label: 'Add all', apply: merge(suggested) },
              ...suggested.map(tag => ({ label: tag, apply: merge([tag]) })),
            ],
          };
        }

        case 'alt': {
          const [alt = '', caption = ''] = asLines(output);
          return {
            text: output.trim(),
            apply: () => {
              const url = fields.hero.value.trim();
              appendToBody(
                url
                  ? `![${alt}](${url})\n*${caption}*`
                  : `> Hero image: ${alt}\n> Caption: ${caption}`,
              );
              toast(
                url ? 'Image line added to the post.' : 'Added as a note — no hero image set yet.',
                { tone: 'info' },
              );
            },
          };
        }

        case 'expand':
        case 'tighten':
          return {
            text: output.trim(),
            apply: () => {
              replaceSelection(output.trim());
              toast('Selection replaced.', { tone: 'success' });
            },
          };

        default:
          /* `outline`, and anything added to the table later without a `live`
             target. Appending is the safe default: it cannot destroy what is
             already written. */
          return {
            text: output.trim(),
            apply: () => {
              appendToBody(output.trim());
              toast('Added to the end of the post.', { tone: 'success' });
            },
          };
      }
    }

    /**
     * The diagram path, which is three steps rather than one.
     *
     * The model returns Mermaid, it is rendered here so the author sees the
     * actual picture before committing to it, and only Insert uploads. Nothing
     * reaches the media table until then — an unreferenced upload is harmless,
     * but a library full of rejected drafts is still clutter.
     */
    async function prepareDiagram(output: string): Promise<{ text: string; apply: () => void }> {
      const source = extractMermaid(output);
      const svg = standalone(await renderMermaid(source));

      assistPreview.hidden = false;
      /* The one `innerHTML` in this component, and it is deliberate: the string
         is Mermaid's own render output, produced under `securityLevel: 'strict'`
         with `htmlLabels: false` — which is what makes every label a text node
         rather than markup. See `src/lib/diagram.ts`. There is no other way to
         display an SVG that was generated rather than fetched. */
      assistPreview.innerHTML = svg;

      return {
        text: source,
        apply: () => {
          const name = diagramName(editing ?? slugify(fields.title.value));
          const pending = toast('Saving the diagram…', { tone: 'pending' });
          void uploadDiagram(svg, name, getToken() ?? '')
            .then(url => {
              appendToBody(
                diagramMarkdown(url, `Diagram: ${fields.title.value || 'the system described above'}`),
              );
              pending.update('Diagram saved and added to the post.', {
                tone: 'success',
                action: { label: 'view ↗', href: url },
              });
            })
            .catch(error => {
              pending.update(
                error instanceof Error ? error.message : 'The diagram could not be saved.',
                { tone: 'error' },
              );
            });
        },
      };
    }

    /* — the footer, as one state rather than five booleans —

       Every button down there is meaningful in exactly one state, and the bug
       this replaces was a `disabled` flag per button set from four places that
       did not all agree. `hidden` rather than `disabled` for most of them: a
       greyed-out Insert beside a live task is an offer that will never make
       sense, and hiding it is the honest rendering. */
    /* `salvage` is the model answering, but not in the shape the task asked
       for. Copy and Try again, deliberately no Insert: there is nothing this
       screen could confidently do with the text, and an Insert that guesses is
       how a chain-of-thought ended up in a post body in the first place. */
    type FootState = 'idle' | 'running' | 'live-done' | 'panel-done' | 'salvage' | 'error';

    function setFoot(state: FootState) {
      stopBtn.hidden = state !== 'running';
      /* Not tied to `live-done` any more. With a ring, Undo outlives the run
         that filled it — pressing it once and wanting the step before that is
         the whole reason the ring exists, and a button that vanished after the
         first press would make the other two entries unreachable. */
      const undoable = state === 'running' ? null : undos.peek();
      undoBtn.hidden = undoable === null;
      if (undoable) {
        setLabel(undoBtn, undos.depth > 1 ? `Undo (${undos.depth})` : 'Undo');
        undoBtn.title = `Put the fields back the way they were before “${undoable.label}”.`;
      }
      copyBtn.hidden = !(state === 'panel-done' || state === 'salvage');
      /* Hidden when the result is a list of chips: they are the Insert, and a
         button beside them that silently picks one is the thing this replaced. */
      insertBtn.hidden = !(state === 'panel-done' && result !== null && !result.options);
      retryBtn.hidden = state === 'idle' || state === 'running';
      runBtn.disabled = state === 'running';
    }

    /* — choosing a task — */

    const taskButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('#assist-tasks .asx-task'),
    );

    /**
     * Why this task cannot run yet, or `null`.
     *
     * Returned as the sentence to show rather than a boolean, because the two
     * reasons need two different fixes and "that button is disabled" tells the
     * author neither of them.
     */
    function blockedBecause(name: AssistTaskName): string | null {
      /* Typed as the interface rather than inferred. `ASSIST_TASKS` is `as
         const satisfies`, so indexing it yields a union of ten literal object
         types and `live` exists on only three of them — the union has no such
         property and the optional fields are unreachable. Assigning to
         `AssistTask` is what widens each member back to the declared shape. */
      const task: AssistTask = ASSIST_TASKS[name];
      /* `ASSIST_TASKS` is `as const`, so each task's `context` is a readonly
         tuple of its own literals and the union across tasks narrows `includes`
         to `never`. Widening here asks the question actually being asked. */
      const wants = task.context as readonly string[];
      if (wants.includes('selection') && !currentSelection().text.trim()) {
        return 'Select the part of the draft to work on, then press this again.';
      }
      if (task.needsTopic && !assistInstruction.value.trim()) {
        return 'Say what it should write about in the box above, then press Write.';
      }
      return null;
    }

    function selectTask(name: AssistTaskName) {
      selected = name;
      const task: AssistTask = ASSIST_TASKS[name];
      taskButtons.forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.task === name));
      });
      setLabel(runBtn, task.label);
      assistHint.textContent = task.hint;
      assistNote.textContent = task.live
        ? 'Writes into the editor as it goes. Undo puts it back.'
        : 'Lands here first. Insert is what puts it in the post.';
    }

    /** Select, then run if it has everything it needs — otherwise say what is missing. */
    function chooseAndRun(name: AssistTaskName) {
      selectTask(name);
      const blocked = blockedBecause(name);
      if (blocked) {
        setAssistStatus(blocked, 'error');
        const task: AssistTask = ASSIST_TASKS[name];
        if (task.needsTopic) assistInstruction.focus();
        return;
      }
      void runTask(name);
    }

    /* — running — */

    let assisting: AbortController | null = null;

    async function runTask(name: AssistTaskName) {
      const task: AssistTask = ASSIST_TASKS[name];
      lastTask = name;
      selectTask(name);

      const blocked = blockedBecause(name);
      if (blocked) return setAssistStatus(blocked, 'error');

      const live = (task.live ?? null) as JournalTarget | null;

      captured = currentSelection();
      result = null;
      assistPreview.hidden = true;
      assistPreview.replaceChildren();
      renderOptions();
      assistText.hidden = false;
      assistText.textContent = '';
      /* A live task has nothing to show in the panel — the output is going
         where the author is already looking. */
      assistOutput.hidden = live !== null;
      setFoot('running');
      setAssistStatus(live ? 'Writing…' : `${task.label}…`);

      if (live) takeSnapshot(live, task.label);

      /* Only the fields this task declares. The allowlist on the task is what
         keeps "suggest tags" from paying for the whole post body twice over. */
      const source: Record<string, string> = {
        title: fields.title.value,
        summary: fields.summary.value,
        tags: fields.tags.value,
        body: fields.body.value,
        selection: captured.text,
      };
      const context: Record<string, string> = {};
      for (const key of task.context) context[key] = source[key] ?? '';

      assisting?.abort();
      const controller = new AbortController();
      assisting = controller;

      let raw = '';
      /* Set from the `done` frame's `stopReason`. `length` means the model was
         cut off by this task's ceiling rather than having finished, which is
         otherwise indistinguishable from a short answer — and on `compose` it
         is the difference between a draft and a draft missing its last
         paragraph. See `maxTokens` in `assist-tasks.ts`. */
      let truncated = false;
      /* One repaint per frame, not one per token. A live `document` run reparses
         the whole response and rewrites five inputs; at a fast provider's token
         rate that is a few hundred passes a second, all but sixty of which are
         overwritten before anything is painted. `render()` inside also rebuilds
         the markdown preview when that tab is open, which is the expensive one. */
      let queued = false;
      /* A frame can still be queued when the last chunk lands, and it would run
         *after* the completion handler below — repainting the fields from a
         non-final parse and putting "Writing…" back over the "Done" line. The
         abort signal does not cover it, because a run that finished normally
         was never aborted. */
      let settled = false;
      const paint = () => {
        if (queued || !live) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (settled || controller.signal.aborted) return;
          applyLive(live, raw, false);
          setAssistStatus(liveProgress(live, raw));
        });
      };

      try {
        const output = await runAssist(
          name,
          context,
          assistInstruction.value,
          {
            onDelta: chunk => {
              raw += chunk;
              if (live) {
                paint();
              } else {
                assistText.textContent = raw;
                assistText.scrollTop = assistText.scrollHeight;
              }
            },
            /* The model is deliberating rather than the request having stalled.
               Worth saying, because the two look identical from here and one of
               them is worth waiting for. The frame carries no thought text —
               only the fact that there is thinking — so there is nothing to
               show and nothing that could leak into the post. */
            onThinking: () => {
              if (!raw) setAssistStatus(`${task.label} — thinking…`);
            },
            onDone: reason => {
              truncated = reason === 'length';
            },
          },
          controller.signal,
        );

        /* Names the cause, because there is exactly one that produces this and
           it is not obvious: a reasoning model that spent the task's whole
           token ceiling thinking and stopped before writing a word. The call
           succeeded, the key is fine, and nothing else on this screen would
           say so. See the note on `maxTokens` in `assist-tasks.ts`. */
        if (!output.trim()) {
          throw new Error(
            'The model finished without writing anything — usually a reasoning model that used the whole token budget thinking. Try again, or pick a different model on the AI screen.',
          );
        }
        settled = true;

        /* Appended to whichever "done" line is shown, rather than raised as its
           own toast: it is a qualification of the result, not an event, and it
           belongs beside the sentence saying the result is ready. */
        const cutOff = () =>
          truncated ? ' It hit this task’s token ceiling, so the end may be cut off.' : '';

        if (live) {
          /* A `document` run that recognised no label wrote nothing — every
             branch in `applyLive` is guarded on a parsed field — so there is no
             half-applied state to unpick and nothing for Undo to put back. The
             reply is still worth reading, so it goes to the panel instead of
             into the post. This is the path a model that deliberates out loud
             rather than answering takes, and it used to end with several
             hundred words of that deliberation in the post body. */
          if (live === 'document' && !parseDocument(output).recognised) {
            /* Nothing was written, so the snapshot this run took is a no-op
               occupying a ring slot a real one needs. */
            dropUnusedSnapshot();
            assistOutput.hidden = false;
            assistText.textContent = output;
            assistText.scrollTop = 0;
            /* So Copy has something to copy. `apply` is unreachable — `salvage`
               hides Insert — but a `Prepared` without one would be a second
               shape for every reader of `result` to handle. */
            result = { text: output, apply: () => {} };
            setFoot('salvage');
            setAssistStatus(
              'The model answered without using the field format, so nothing was written to the post. Its reply is below — Copy takes it, Try again asks for another.',
              'error',
            );
            toast('Nothing written: the reply was not in the expected format.', { tone: 'error' });
            return;
          }

          applyLive(live, output, true);
          setFoot('live-done');
          setAssistStatus(
            `Done — it is in the editor. Undo puts it back; nothing is saved until you press Save.${cutOff()}`,
          );
          toast(
            live === 'document' ? 'Draft written into the fields.' : 'Rewritten in place.',
            { tone: 'success' },
          );
          return;
        }

        setAssistStatus('Reading it back…');
        result = name === 'diagram' ? await prepareDiagram(output) : prepare(name, output);

        /* The parsed form, which for a diagram is the Mermaid source rather
           than the fenced block it arrived wrapped in. Showing what will
           actually be used beats showing what arrived. */
        renderOptions(result.options);
        /* The chips *are* the list for a task that produced one, so printing it
           again underneath is the same five titles twice. */
        assistText.hidden = Boolean(result.options);
        assistText.textContent = result.text;
        setFoot('panel-done');
        setAssistStatus(
          `${result.options ? 'Ready. Pick one below' : 'Ready. Insert puts it in the post'}; nothing is saved until you press Save.${cutOff()}`,
        );
      } catch (error) {
        settled = true;
        if (error instanceof DOMException && error.name === 'AbortError') {
          /* Stopped on purpose. Whatever arrived stays where it was written —
             that is what "live" means — and Undo is still the way back.

             Unless nothing arrived: `applyLive` with an empty response is not a
             no-op for the two prose targets, it assigns `''`, so stopping a
             `revise` the instant it started used to empty the post. A run that
             wrote nothing also has no snapshot worth keeping. */
          if (live) {
            if (raw) {
              applyLive(live, raw, true);
              setFoot('live-done');
              setAssistStatus(
                `Stopped. ${raw.length.toLocaleString()} characters were written; Undo puts it back.`,
              );
            } else {
              dropUnusedSnapshot();
              setFoot('idle');
              setAssistStatus('Stopped before anything was written. Nothing changed.');
            }
          }
          return;
        }
        const text =
          error instanceof DiagramError || error instanceof Error
            ? error.message
            : 'The assistant failed.';
        /* A live run that failed part-way has already written into the fields,
           so the snapshot is the only way out and Undo has to stay offered.
           One that failed before writing anything has nothing to offer, and
           `dropUnusedSnapshot` is what tells the two apart. */
        if (live) dropUnusedSnapshot();
        setFoot('error');
        setAssistStatus(text, 'error');
        toast(text, { tone: 'error' });
      } finally {
        if (assisting === controller) assisting = null;
      }
    }

    taskButtons.forEach(button => {
      button.addEventListener('click', () => {
        const name = button.dataset.task ?? '';
        if (isAssistTask(name)) chooseAndRun(name);
      });
    });

    runBtn.addEventListener('click', () => {
      /* Nothing chosen means the headline task — the box above it says "what
         should it write about", and Write is the answer to that question. */
      chooseAndRun(selected ?? 'compose');
    });

    /* Cmd/Ctrl+Enter from the topic box, the shortcut every prompt field has.
       Plain Enter stays a newline: this is a textarea because a topic is often
       two sentences. */
    assistInstruction.addEventListener('keydown', event => {
      if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        chooseAndRun(selected ?? 'compose');
      }
    });

    stopBtn.addEventListener('click', () => assisting?.abort());
    undoBtn.addEventListener('click', undoLive);
    retryBtn.addEventListener('click', () => {
      if (lastTask) void runTask(lastTask);
    });

    insertBtn.addEventListener('click', () => {
      result?.apply();
      closeAssist();
    });

    copyBtn.addEventListener('click', () => {
      if (result) void copyText(result.text).then(() => toast('Copied.', { tone: 'success' }));
    });

    /* — opening and closing — */

    function openAssist(task?: AssistTaskName) {
      if (!assistDialog.open) {
        /* `show()`, not `showModal()`: the editor behind this has to stay
           visible and usable, because watching the fields fill is the point. */
        assistDialog.show();
      }
      if (task) chooseAndRun(task);
      else if (!selected) selectTask('compose');
      const opened: AssistTask | null = task ? ASSIST_TASKS[task] : null;
      if (!opened || opened.needsTopic) assistInstruction.focus();
    }

    function closeAssist() {
      assistDialog.close();
    }

    assistOpen.addEventListener('click', () => {
      if (assistDialog.open) closeAssist();
      else openAssist();
    });

    $<HTMLButtonElement>('assist-close').addEventListener('click', closeAssist);

    /* Every per-field button on the editor: open the panel and run that field's
       task in one press. `data-assist-task` is the whole wiring — a new field
       gets a button and nothing here changes. */
    document.querySelectorAll<HTMLButtonElement>('[data-assist-task]').forEach(button => {
      button.addEventListener('click', () => {
        const name = button.dataset.assistTask ?? '';
        if (isAssistTask(name)) openAssist(name);
      });
    });

    /* Escape is a modal dialog's for free and a non-modal one's to wire. Scoped
       to the panel having focus inside it, so Escape in the editor is still the
       editor's. */
    assistDialog.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeAssist();
      }
    });

    /* A run still in flight is abandoned rather than left billing in the
       background with nobody watching. Anything already written into the fields
       stays there — closing the panel is not an undo. */
    assistDialog.addEventListener('close', () => {
      assisting?.abort();
      setFoot('idle');
    });

    setFoot('idle');

    /* Same rule as the save buttons: the endpoint asks GitHub who is calling,
       so a signed-out screen says so rather than offering a button that 401s. */
    if (!getToken()) {
      const why = 'Sign in with GitHub to use the assistant.';
      assistOpen.disabled = true;
      assistOpen.title = why;
      document.querySelectorAll<HTMLButtonElement>('[data-assist-task]').forEach(button => {
        button.disabled = true;
        button.title = why;
      });
    }

    const shell = document.getElementById('admin-shell')!;

    const focusBtn = $<HTMLButtonElement>('focus-toggle');
    focusBtn.addEventListener('click', () => {
      const on = shell.classList.toggle('is-focus');
      focusBtn.textContent = on ? 'Exit Focus' : 'Focus';
      focusBtn.setAttribute('aria-pressed', String(on));
    });

    render();
    /* Last, and only ever an offer: it compares against the form as it now
       stands, which needs the seed and the first render to have happened. */
    offerRestore();
  });
</script>

<style>
  .je-id { min-width: 0; }
  .je-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-family: var(--font-mono);
    margin-bottom: var(--space-2);
  }
  .je-path { font-size: 11px; margin: 4px 0 6px; display: flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; }
  .je-path code { font-family: var(--font-mono); background: var(--color-surface); padding: 1px 5px; }
  .je-path-note { font-size: 11px; }

  /* The offer to put unsaved work back. Accent-edged rather than red: nothing
     has gone wrong, there is simply a decision to make, and it is a decision
     that used to be taken silently on the author's behalf. */
  .je-restore {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-accent);
    border-left-width: 3px;
    border-radius: var(--radius-md);
    background: var(--color-accent-100);
  }

  .je-restore[hidden] { display: none; }
  .je-restore-copy { min-width: 0; }
  .je-restore-title { margin: 0; font-weight: 600; font-size: 14px; }
  .je-restore-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  /* The mockup's bento: writing surface left, everything that describes the
     post right. Focus mode hides the right column outright. */
  .editor-grid { display: grid; grid-template-columns: 8fr 4fr; gap: var(--space-4); align-items: start; }

  /* The assistant docks to the bottom-right of the viewport, which is exactly
     where this column's fields are — so the panel sat over the Summary field
     while the Summary task was writing into it. The panel cannot move: it is
     `position: fixed` and non-modal on purpose, and watching the fields fill in
     is the whole point of decision 28. So the column gets room to scroll clear
     of it instead, and only while the panel is actually open.

     Below 620px the panel is a full-width bottom sheet and the grid is a single
     column, so there is nothing beside it to uncover. */
  @media (min-width: 621px) {
    :global(body:has(.asx[open])) .editor-side { padding-bottom: min(76dvh, 680px); }
  }

  /* — focus mode —

     `.is-focus` hid the sidebar and the metadata column and stopped there,
     which left the *grid* untouched: still two tracks, the second one now
     empty, so the writing surface kept two thirds of the width and a third of
     the screen was blank paper. Hiding a column is not the same as removing it.

     One track, and a measure. A textarea the full width of a 1790px screen is
     not a better place to write a paragraph than one the width of a page, so
     the column is capped and centred — the same pairing every other width cap
     on this surface uses — and the header above it is capped to match, or the
     toolbar floats off to the right of the thing it belongs to.

     `.admin-shell` is rendered by `AdminLayout`, so it carries no cid of this
     component's and has to be reached through `:global()`. */
  :global(.admin-shell.is-focus) .editor-grid { grid-template-columns: minmax(0, 1fr); }

  :global(.admin-shell.is-focus) .editor-col,
  :global(.admin-shell.is-focus) .admin-head {
    max-width: var(--wrap-mid);
    margin-inline: auto;
    width: 100%;
  }

  /* The point of focus mode is the body, so give it the height the metadata
     column was using. */
  :global(.admin-shell.is-focus) .editor-body,
  :global(.admin-shell.is-focus) .preview-card {
    min-height: min(70dvh, 900px);
  }
  .editor-col { display: flex; flex-direction: column; gap: var(--space-4); }
  .editor-side { display: flex; flex-direction: column; gap: var(--space-4); }
  .editor-title { font-size: 20px; font-family: var(--font-heading); height: 48px; border-left: 3px solid var(--color-accent); }

  /* The title and its assist button share a row. `min-width: 0` on the input,
     because a flex item's default `min-width: auto` refuses to shrink below its
     content and a long title would push the button off the end. */
  .editor-title-row { display: flex; gap: var(--space-2); align-items: stretch; }
  .editor-title-row .editor-title { flex: 1 1 auto; min-width: 0; }

  /* A field that the assistant can write gets its label and its button on one
     line. `space-between` rather than a gap, so the button sits against the
     right edge of the field it belongs to and reads as attached to it. */
  .je-field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 5px;
  }
  .je-field-head label { margin-bottom: 0; }

  .je-spark { flex: none; }
  .je-spark-sm { font-size: 11px; padding: 2px 6px; gap: 4px; }
  /* Deliberately not `.md-btn` — that class enrols a button in the
     wrap-the-selection handler, and this one opens the assistant. It only wants
     the toolbar's sizing. */
  .md-toolbar .md-assist {
    font-size: 12px;
    padding: 4px 10px;
    font-weight: 600;
    margin-left: auto;
  }

  /* The tab bar sits directly under the title, so it does not need the shared
     gap on top of the column's own. */
  .tab-bar { margin-bottom: 0; }
  .editor-col .tab-panel { display: flex; flex-direction: column; gap: var(--space-3); }
  .editor-col .tab-panel[hidden] { display: none; }

  .md-toolbar { display: flex; gap: 6px; flex-wrap: wrap; }
  .md-toolbar .md-btn { font-size: 12px; padding: 4px 10px; font-family: var(--font-mono); }
  .summary-input { min-height: 56px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .field-row label { display: block; font-size: 12px; margin-bottom: 5px; color: color-mix(in srgb, var(--color-text) 70%, transparent); }
  /* Tall, because the panel it sits in no longer shares the column with a
     preview card — the writing surface gets the whole height. */
  .editor-body { min-height: 460px; font-family: var(--font-mono); font-size: 13px; }

  .preview-card { min-height: 460px; }
  .preview-title { margin: 0; }
  .je-preview-note { margin: 0; }

  .status-help { margin-top: 6px; }

  code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }

  @media (max-width: 1000px) {
    .editor-grid { grid-template-columns: 1fr; }
  }
</style>
