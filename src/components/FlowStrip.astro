---
import type { FlowStep } from '../lib/chapters';

/* "How it works", as a picture made of data — decision 85.
 *
 * An ordered list of numbered nodes joined by an arrow, horizontal at desktop
 * width and vertical below it. No SVG, no Mermaid and no renderer: the arrows
 * are pseudo-elements and every colour is a token, which is what makes it work
 * in dark mode and on paper (a data-URI SVG cannot read a custom property).
 * The list is the accessible structure; the arrows are decorative. */
interface Props {
  steps: FlowStep[];
}
const { steps } = Astro.props;
---

{steps.length > 0 && (
  <ol class="flow-strip">
    {steps.map((step, i) => (
      <li class="flow-step">
        <span class="flow-index">{String(i + 1).padStart(2, '0')}</span>
        <span class="flow-name">{step.name}</span>
        {step.detail && <span class="flow-detail">{step.detail}</span>}
      </li>
    ))}
  </ol>
)}

<style>
  .flow-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
  }
  .flow-step {
    position: relative;
    flex: 1 1 140px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  /* The join, drawn rather than inserted: a pseudo-element is not in the
     accessibility tree, so an ordered list reads as an ordered list. */
  .flow-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    top: 50%;
    right: calc(var(--space-2) * -1 - 0.6ch);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-faint);
  }
  .flow-index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .flow-name {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 15px;
    line-height: 1.3;
  }
  .flow-detail {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Stacked below the desktop width, and on paper — a seven-node strip across
     a 688px printed page is not a glance. Screen only, because a bare
     `max-width` is a print rule too. */
  @media screen and (max-width: 760px) {
    .flow-strip { flex-direction: column; gap: var(--space-4); }
    .flow-step { flex: 1 1 auto; }
    .flow-step:not(:last-child)::after {
      content: '↓';
      top: auto;
      right: 50%;
      bottom: calc(var(--space-4) * -1 + 0.2em);
      transform: translateX(50%);
    }
  }
  @media print {
    .flow-strip { flex-direction: column; gap: var(--space-3); }
    .flow-step { flex: 1 1 auto; break-inside: avoid; }
    .flow-step:not(:last-child)::after {
      content: '↓';
      top: auto;
      right: 50%;
      bottom: calc(var(--space-3) * -1 + 0.2em);
      transform: translateX(50%);
    }
  }
</style>
