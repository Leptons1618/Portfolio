---
/**
 * Site identity, as a dialog rather than a screen.
 *
 * It was a page (`/admin/settings`), which put a whole navigation between the
 * author and six fields that do not commit anything — everything here is
 * export-only, because the JSON has to be hand-merged into `src/lib/site.ts`
 * before it means anything. A modal is the honest shape for that: it is a
 * scratchpad, not a section of the site.
 *
 * Rendered **inside** `AdminSidebar`'s persisted `<aside>` so it survives a
 * view transition along with the rail that opens it, which is also why its
 * script can bind once at module scope. Anything else that wants to open it —
 * the dashboard's quick actions — carries `data-open-settings` and is picked
 * up by the delegated listener in the sidebar.
 */
import { Icon } from 'astro-icon/components';
import Illustration from './Illustration.astro';
import { site } from '../lib/site';
import { THEMES } from '../lib/theme';

/* Seeded from `src/lib/site.ts` — the module these values are exported back
   into by hand. */
const defaults = {
  name: site.name,
  role: site.roleLong,
  bio: site.bio,
  github: site.github,
  linkedin: site.linkedin,
  email: site.email,
};
---
<dialog class="modal modal-narrow" id="settings-modal" aria-labelledby="settings-title">
  <form method="dialog" class="modal-close-form">
    <button class="btn btn-icon modal-close" value="cancel" aria-label="Close">
      <Icon name="lucide:x" class="admin-nav-icon" />
    </button>
  </form>

  <div class="settings-head">
    <div>
      <h6 class="admin-eyebrow-mono">MODULE: IDENTITY</h6>
      <h2 class="modal-title" id="settings-title">Site Identity</h2>
      <p class="text-muted admin-note modal-lede">
        The name, role and links every public page reads from <code>src/lib/site.ts</code>.
      </p>
    </div>
    <div class="settings-art"><Illustration name="personal-settings" /></div>
  </div>

  <div class="field">
    <label for="s-name">Name</label>
    <input class="input" id="s-name" value={defaults.name} />
  </div>
  <div class="field">
    <label for="s-role">Role</label>
    <input class="input" id="s-role" value={defaults.role} />
  </div>
  <div class="field">
    <label for="s-bio">Bio</label>
    <textarea class="input settings-bio" id="s-bio">{defaults.bio}</textarea>
  </div>
  <div class="settings-pair">
    <div class="field">
      <label for="s-github">GitHub</label>
      <input class="input" id="s-github" value={defaults.github} />
    </div>
    <div class="field">
      <label for="s-linkedin">LinkedIn</label>
      <input class="input" id="s-linkedin" value={defaults.linkedin} />
    </div>
  </div>
  <div class="field">
    <label for="s-email">Email</label>
    <input class="input" id="s-email" value={defaults.email} />
  </div>

  <hr class="rule settings-rule" />

  <h6 class="admin-eyebrow">Theme</h6>
  <div class="seg" role="group" aria-label="Theme">
    {THEMES.map(theme => (
      <label class="seg-opt"><input type="radio" name="settings-theme" value={theme.id} />{theme.label}</label>
    ))}
  </div>
  <p class="text-muted admin-note settings-theme-note">
    Stored in this browser and applied everywhere, public pages included. The same
    switch as the one in the rail.
  </p>

  <p class="admin-note settings-message" id="settings-message"></p>

  <div class="modal-actions">
    <button type="button" class="btn btn-secondary" id="export-settings">
      <Icon name="lucide:download" class="admin-nav-icon" />Export JSON
    </button>
    <button type="button" class="btn btn-primary" id="save-settings">Save to this browser</button>
  </div>

  <p class="text-muted admin-note">
    Export only, on purpose: these values have to be merged into
    <code>src/lib/site.ts</code> by hand, so committing the JSON verbatim would drop
    a file into the repository that nothing reads.
  </p>
</dialog>

<script>
  import { ADMIN_KEYS } from '../lib/admin';
  import { THEME_EVENT, currentTheme, isThemeId, selectTheme } from '../lib/theme';

  /* Bound once at module scope, like the rail this lives inside: the element
     is moved into the next page by `transition:persist` rather than rebuilt,
     so re-running would stack duplicate listeners on the same nodes. */
  const KEY = ADMIN_KEYS.settings;
  const modal = document.getElementById('settings-modal') as HTMLDialogElement;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const ids = ['s-name', 's-role', 's-bio', 's-github', 's-linkedin', 's-email'] as const;
  const fields = Object.fromEntries(
    ids.map(id => [id, $<HTMLInputElement>(id)])
  ) as Record<(typeof ids)[number], HTMLInputElement | HTMLTextAreaElement>;

  const themeInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="settings-theme"]')
  );

  function snapshot() {
    return {
      name: fields['s-name'].value,
      role: fields['s-role'].value,
      bio: fields['s-bio'].value,
      github: fields['s-github'].value,
      linkedin: fields['s-linkedin'].value,
      email: fields['s-email'].value,
    };
  }

  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved) {
      for (const id of ids) {
        const key = id.slice(2) as keyof ReturnType<typeof snapshot>;
        if (saved[key]) fields[id].value = saved[key];
      }
    }
  } catch {
    /* ignore corrupt settings */
  }

  const message = $('settings-message');

  function say(text: string, tone: 'info' | 'error' = 'info') {
    message.dataset.tone = tone;
    message.textContent = text;
  }

  /* The theme is not part of the identity snapshot — it is a browser
     preference the public site reads too, so it goes through `theme.ts` rather
     than this dialog's storage key. The rail's toggle can change it while this
     is closed, hence following the event as well as marking on open. */
  function markTheme() {
    const active = currentTheme();
    themeInputs.forEach(input => { input.checked = input.value === active; });
  }

  document.addEventListener(THEME_EVENT, markTheme);

  themeInputs.forEach(input => {
    input.addEventListener('change', () => {
      if (isThemeId(input.value)) selectTheme(input.value);
    });
  });

  $<HTMLButtonElement>('save-settings').addEventListener('click', () => {
    localStorage.setItem(KEY, JSON.stringify(snapshot()));
    say('Saved to this browser. Export it, then merge into src/lib/site.ts.');
  });

  $<HTMLButtonElement>('export-settings').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(snapshot(), null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'site-identity.json';
    a.click();
    URL.revokeObjectURL(url);
    say('Exported site-identity.json.');
  });

  /* A `<dialog>` handles Escape, focus and the top layer itself; the backdrop
     click is the one part that is not the element's job. */
  modal.addEventListener('click', event => {
    if (event.target === modal) modal.close();
  });

  /* Delegated at the document so any screen can carry the trigger without
     knowing this element exists. */
  document.addEventListener('click', event => {
    const trigger = (event.target as Element | null)?.closest?.('[data-open-settings]');
    if (!trigger) return;
    event.preventDefault();
    markTheme();
    say('');
    modal.showModal();
  });
</script>

<style>
  .settings-head { display: flex; align-items: flex-start; gap: var(--space-4); }
  .settings-head > div:first-child { min-width: 0; }
  .settings-art { width: 140px; flex: none; color: var(--color-accent); }
  .settings-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .settings-bio { min-height: 76px; }
  .settings-rule { margin: var(--space-4) 0; }
  .settings-theme-note { margin-top: 6px; }
  .settings-message { min-height: 18px; font-size: 12px; margin: var(--space-3) 0 0; }
  .settings-message[data-tone='error'] { color: var(--color-accent-700); }

  @media (max-width: 560px) {
    .settings-art { display: none; }
    .settings-pair { grid-template-columns: 1fr; }
  }
</style>
