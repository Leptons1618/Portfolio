---
import Tag from './Tag.astro';
interface Person {
  name: string; role: string; address: string; email: string; phone: string;
  linkedin: string;
}
interface SkillGroup { category: string; items: string[] }
interface Education { school: string; degree: string; dates: string }
interface Props {
  person: Person;
  skills: SkillGroup[];
  certifications: string[];
  education: Education[];
}
const { person, skills, certifications, education } = Astro.props;
const linkedinLabel = person.linkedin.replace(/^https?:\/\//, '');
---
<aside class="resume-aside">
  <div>
    <h1 class="aside-name">{person.name}</h1>
    <p class="text-muted aside-role">{person.role}</p>
  </div>

  <div>
    <h6 class="aside-heading">Contact</h6>
    <p class="aside-line">{person.address}</p>
    <p class="aside-line"><a href={`mailto:${person.email}`}>{person.email}</a></p>
    <p class="aside-line">{person.phone} (Mobile)</p>
    <p class="aside-line"><a href={person.linkedin} target="_blank" rel="noopener">{linkedinLabel}</a></p>
  </div>

  <div>
    <h6 class="aside-heading">Skills</h6>
    {skills.map(group => (
      <div class="skill-group">
        <p class="skill-category">{group.category}</p>
        <div class="skill-items">
          {group.items.map(item => <Tag text={item} variant="neutral" />)}
        </div>
      </div>
    ))}
  </div>

  <div>
    <h6 class="aside-heading">Certifications</h6>
    <ul class="cert-list">
      {certifications.map(c => <li>{c}</li>)}
    </ul>
  </div>

  <div>
    <h6 class="aside-heading">Education</h6>
    {education.map(ed => (
      <div class="education-item">
        <p class="education-school">{ed.school}</p>
        <p class="education-degree">{ed.degree}</p>
        <p class="text-muted education-dates">{ed.dates}</p>
      </div>
    ))}
  </div>
</aside>
<style>
  .resume-aside { display: flex; flex-direction: column; gap: var(--space-6); }
  .aside-name { font-size: 30px; margin-bottom: 2px; }
  .aside-role { font-size: 14px; margin: 0; }
  .aside-heading { color: var(--color-accent-700); margin-bottom: var(--space-2); }
  .aside-line { font-size: 13px; opacity: 0.85; margin: 0 0 4px; }

  .skill-group { margin-bottom: var(--space-2); }
  .skill-category { font-size: 12px; font-weight: 600; margin: 0 0 4px; }
  .skill-items { display: flex; flex-wrap: wrap; gap: 4px; }
  .skill-items :global(.tag) { font-size: 10px; }

  .cert-list { list-style: disc; padding-left: 16px; margin: 0; }
  .cert-list li { font-size: 12px; opacity: 0.85; margin-bottom: 4px; }

  .education-item + .education-item { margin-top: var(--space-3); }
  .education-school { font-size: 13px; font-weight: 600; margin: 0 0 2px; }
  .education-degree { font-size: 12px; opacity: 0.8; margin: 0 0 2px; }
  .education-dates { font-size: 11px; margin: 0; }
</style>
