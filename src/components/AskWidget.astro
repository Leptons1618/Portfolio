---
/**
 * The public assistant, as a launcher and a panel.
 *
 * Mounted by `BaseLayout` on every public page, and it is the only piece of
 * JavaScript on this site that talks to a server. Three things shape how it is
 * built, all of them consequences of the architecture rather than preferences:
 *
 *   - **The markup is server-rendered and starts hidden.** Public pages are
 *     prerendered static assets, so this HTML costs nothing and is already
 *     there. Whether the assistant is *switched on* is a row, which a
 *     prerendered page cannot read — so the loader below asks
 *     `/api/ai/status` once per session, and only then idle-imports the
 *     behaviour (`src/lib/ask-widget.ts`) and the stylesheet
 *     (`src/styles/ask-widget.css`). Pages where the assistant is off pay for
 *     the gate and nothing else — never the panel's 13KB of styles, which
 *     used to be part of the one render-blocking sheet every page loads.
 *     `src/pages/api/ai/status.ts` has the reasoning about that request's cost.
 *   - **Nothing is inserted as HTML.** Answers come from a language model and
 *     transcripts are echoed back into the page; every one of them is written
 *     as a text node. The tiny markdown pass in `src/lib/ask-widget.ts`
 *     produces *elements*, built with `createElement`, never a string handed
 *     to `innerHTML`.
 *   - **It degrades to nothing.** No JavaScript, no launcher — and the site is
 *     unchanged, because nothing else on the page depends on it.
 *
 * The panel is a `<dialog>` on small screens' terms and a docked card on large
 * ones, which is one element and one media query rather than two components.
 */
import { Icon } from 'astro-icon/components';
import { site } from '../lib/site';

const firstName = site.name.split(' ')[0];
---
<div class="ask" id="ask-root" hidden>
  <button
    type="button"
    class="ask-launcher"
    id="ask-launcher"
    aria-expanded="false"
    aria-controls="ask-panel"
  >
    <Icon name="lucide:message-circle" class="ask-launcher-icon" />
    <span class="ask-launcher-label">Ask about {firstName}</span>
  </button>

  <section
    class="ask-panel"
    id="ask-panel"
    role="dialog"
    aria-label={`Ask about ${site.name}`}
    aria-modal="false"
    hidden
  >
    <header class="ask-head">
      <div>
        <p class="ask-title">Ask about {firstName}</p>
        <p class="ask-sub">Answers come from this site's own pages.</p>
      </div>
      <div class="ask-head-actions">
        <button type="button" class="ask-icon-btn tap-target" id="ask-history" aria-label="Past conversations" title="Past conversations">
          <Icon name="lucide:history" class="ask-icon" />
        </button>
        <button type="button" class="ask-icon-btn tap-target" id="ask-new" aria-label="New chat" title="New chat">
          <Icon name="lucide:message-square-plus" class="ask-icon" />
        </button>
        <button type="button" class="ask-icon-btn tap-target" id="ask-close" aria-label="Close" title="Close">
          <Icon name="lucide:x" class="ask-icon" />
        </button>
      </div>
    </header>

    {/* Past conversations, kept in this browser and nowhere else. An overlay
        over the log rather than a second panel: the list is a pause in the
        conversation, not a place. Built rows land here from script, so the
        rules live in the widget stylesheet with everything else script-built. */}
    <div class="ask-history" id="ask-history-view" hidden>
      <div class="ask-history-head">
        <p class="ask-history-title">Past conversations</p>
        <button type="button" class="ask-icon-btn tap-target" id="ask-history-close" aria-label="Back to chat" title="Back to chat">
          <Icon name="lucide:x" class="ask-icon" />
        </button>
      </div>
      <p class="ask-history-note">Kept only in this browser — clearing site data forgets them.</p>
      <div class="ask-history-list" id="ask-history-list"></div>
    </div>

    {/* `aria-live="polite"` rather than `assertive`: an answer arriving is
        worth announcing, and interrupting whatever a screen reader is in the
        middle of to do it is not. */}
    <div class="ask-log" id="ask-log" role="log" aria-live="polite" aria-relevant="additions"></div>

    <div class="ask-suggestions" id="ask-suggestions" hidden></div>

    <form class="ask-form" id="ask-form">
      <label class="ask-visually-hidden" for="ask-input">Your question</label>
      <textarea
        class="ask-input"
        id="ask-input"
        rows="1"
        placeholder="Ask a question…"
        autocomplete="off"
      ></textarea>
      {/* Send and Stop are one button in two states, and both icons are in the
          markup because swapping them in script would mean writing over an
          inlined `astro-icon` SVG — the same trap `setLabel()` exists for on
          the admin surface. `data-busy` picks which one paints. */}
      <button type="submit" class="ask-send tap-target" id="ask-send" aria-label="Send">
        <Icon name="lucide:arrow-up" class="ask-send-icon" />
        <Icon name="lucide:square" class="ask-send-icon ask-send-stop" />
      </button>
    </form>

    <p class="ask-foot">
      This is a language model reading published pages. It can be wrong — the
      pages themselves are the record.
      {/* How many questions this visitor has left. Filled in by
          `ask-widget.ts` from `/api/ai/status` and decremented as they are
          spent, so running out is something they saw coming rather than a
          refusal out of nowhere. Empty — and therefore invisible — until the
          count is actually known. */}
      <span class="ask-left" id="ask-left" hidden></span>
    </p>

    {/* The corner the panel grows from. Bottom-right anchored, so the handle
        has to be top-left — CSS `resize` only ever puts one at bottom-right,
        which on this panel drags it off the screen. A button rather than a
        div so it is focusable, and the arrow keys resize from the keyboard. */}
    <button
      type="button"
      class="ask-grip"
      id="ask-grip"
      aria-label="Resize the panel. Use the arrow keys."
      title="Drag to resize"
    ></button>
  </section>
</div>

<script>
  /* The gate, not the widget. The status fetch starts at once (cheap, cached
     per session in `sessionStorage`), but the widget's behaviour and its
     stylesheet wait for an idle main thread — after first paint, after LCP —
     and load only when the assistant is actually switched on. Pages where it
     is off pay for this paragraph and nothing else. */
  import type { AskStatus } from '../lib/ask-widget';

  const STATUS_KEY = 'om-ask-status';

  /**
   * Ask the server once per browser session whether to appear at all.
   *
   * Cached in `sessionStorage` because the alternative is one Worker
   * invocation per page view on a site whose pages are otherwise served as
   * static assets without waking the Worker at all. A visitor reading eight
   * pages costs one request instead of eight, and the staleness window is a
   * single tab's lifetime — during which the only thing that could have
   * changed is the owner toggling their own switch.
   */
  async function readStatus(): Promise<AskStatus | null> {
    try {
      const cached = sessionStorage.getItem(STATUS_KEY);
      if (cached) return JSON.parse(cached) as AskStatus;
    } catch {
      /* Private browsing, or a corrupt entry. Falling through to the network
         is correct in both cases. */
    }

    try {
      const response = await fetch('/api/ai/status');
      if (!response.ok) return null;
      const status = (await response.json()) as AskStatus;
      try {
        sessionStorage.setItem(STATUS_KEY, JSON.stringify(status));
      } catch {
        /* Storage refused. The feature still works, it just asks again. */
      }
      return status;
    } catch {
      return null;
    }
  }

  function whenIdle(): Promise<void> {
    return new Promise(resolve => {
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(() => resolve(), { timeout: 2500 });
      } else {
        window.setTimeout(() => resolve(), 1);
      }
    });
  }

  void (async () => {
    const statusP = readStatus();
    await whenIdle();
    const status = await statusP;
    if (!status?.enabled) return;
    /* One chunk for the behaviour; the stylesheet URL rides with it (see
       `src/lib/ask-widget.ts`) and is injected there, so nothing here blocks
       first paint. The launcher unhides only after the styles are on, which is
       what keeps it from flashing unstyled. */
    const widget = await import('../lib/ask-widget');
    await widget.ensureAskStyles();
    widget.mountAskWidget(status);
  })();
</script>
