---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/journal', label: 'Journal' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
];
const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---
<nav class="nav container" aria-label="Main navigation">
  <a class="nav-brand" href="/">Anish Giri</a>
  <div class="nav-links">
    {navLinks.map(link => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </div>
  <a class="btn btn-primary nav-cta" href="mailto:anishgiri163@gmail.com">Hire Me</a>
</nav>
<style>
  .nav-brand { text-decoration: none; color: inherit; }
  .nav-links { display: flex; align-items: center; gap: var(--space-4); }

  /* Below the wide breakpoint the bar keeps the brand and the primary
     action on one line and lets the links flow onto a second row, rather
     than hiding navigation behind a drawer. */
  @media (max-width: 640px) {
    .nav { flex-wrap: wrap; row-gap: var(--space-3); }
    .nav-brand { margin-right: auto; }
    .nav-links { order: 3; width: 100%; flex-wrap: wrap; gap: var(--space-3) var(--space-4); }
    .nav-cta { flex: none; }
  }
</style>
