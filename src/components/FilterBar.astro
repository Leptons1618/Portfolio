---
interface Props {
  categories: { key: string; label: string }[];
  topTags: string[];
}
const { categories, topTags } = Astro.props;
---
<section class="filter-bar" id="filter-bar">
  <input
    type="search"
    id="filter-search"
    class="input filter-search"
    placeholder="Search projects..."
    aria-label="Search projects"
    autocomplete="off"
  />

  <div class="filter-row">
    {categories.map(cat => (
      <button type="button" class="tag tag-button tag-neutral" data-filter="category" data-value={cat.key}>{cat.label}</button>
    ))}
    <label class="radio featured-toggle">
      <input type="checkbox" id="filter-featured-first" checked />
      <span class="dot"></span>
      Featured First
    </label>
  </div>

  <div class="filter-row" id="tag-chips">
    {topTags.map(tag => (
      <button type="button" class="tag tag-button tag-neutral" data-filter="tag" data-value={tag}>{tag}</button>
    ))}
  </div>

  <p class="text-muted results-count" id="results-count" aria-live="polite"></p>
</section>
<style>
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
  }
  .filter-search { max-width: 360px; }
  .filter-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .featured-toggle { margin-left: auto; }
  .results-count { font-size: 12px; margin: 0; }

  @media (max-width: 640px) {
    .filter-search { max-width: none; }
    .featured-toggle { margin-left: 0; width: 100%; }
  }
</style>
