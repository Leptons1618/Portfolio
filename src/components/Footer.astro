---
/**
 * The foot of every public page: a status line, not a sitemap.
 *
 * Two rows in the terminal's voice. The first is who and when, with the
 * profiles as `--flags`; the second is the stack the page was served by,
 * the way a `--version` prints its build. All of it reads from `site.ts`;
 * the stack line is the one place the architecture names itself to a
 * visitor, and it is copy — nothing here is computed from the runtime.
 */
import { site } from '../lib/site';

const year = new Date().getFullYear();
const host = new URL(site.url).hostname;
const links = [
  { label: 'github', href: site.github },
  { label: 'linkedin', href: site.linkedin },
  { label: 'x', href: site.twitter },
  { label: 'source', href: site.repo },
];
---
<footer class="site-footer">
  {/* The frame's rails, closing the sheet: the same spans the header
      carries, squaring the footer's top corners where `main`'s rails end.
      The bottom edge stays open like the header's top — the shared layer
      suppresses this rail's bottom node, so the sheet leaves unmarked the
      way it arrived. */}
  <span class="frame-rail frame-rail-l" aria-hidden="true"></span>
  <span class="frame-rail frame-rail-r" aria-hidden="true"></span>
  <div class="container footer-col">
  <div class="footer-row">
    <span class="text-muted footer-copy"><span class="footer-prompt" aria-hidden="true">$</span> © {year} {site.name} <span class="footer-sep">//</span> built with precision</span>
    <nav class="footer-links" aria-label="Profiles">
      {links.map(link => (
        <a href={link.href} target="_blank" rel="noopener">--{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="footer-row footer-sys">
    <span class="footer-copy text-muted">
      <span class="footer-key">host</span>{host}
      <span class="footer-sep">·</span>
      <span class="footer-key">stack</span><a href="/colophon">astro · cloudflare workers · d1</a>
      <span class="footer-sep">·</span>
      <span class="footer-key">tz</span>{site.timezone}
    </span>
    <a class="footer-top" href="#main">↑ top</a>
  </div>
  </div>
</footer>
<style>
  /* The frame's foot: full-bleed rules top and bottom in the separator's
     ink and style, mirroring `.site-header`, with the rails running between
     them. The column inside is what pages used to put the border on. */
  .site-footer {
    position: relative;
    border-top: 1px var(--rule-style) var(--sep-ink);
    border-bottom: 1px var(--rule-style) var(--sep-ink);
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    font-family: var(--font-mono);
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .footer-copy { font-size: 12px; letter-spacing: 0.02em; }
  .footer-prompt { color: var(--color-accent); font-weight: 600; margin-right: 0.4ch; }
  .footer-sep { color: var(--color-text-faint); margin: 0 0.4ch; }
  .footer-key { color: var(--color-text-faint); margin-right: 0.6ch; }
  .footer-key::after { content: '='; }
  .footer-links { display: flex; gap: var(--space-3); font-size: 12px; flex-wrap: wrap; }
  .footer-links a { text-decoration: none; color: var(--color-text-muted); transition: color var(--dur-fast) ease; }
  .footer-links a:hover { color: var(--color-accent); }

  /* The stack line is the one place the architecture names itself to a
     visitor, so it is also the way to the page that explains it. Underlined
     on the dotted rule rather than coloured, because the row it sits in is
     muted status text and a coloured word in it reads as an alert. */
  .footer-sys .footer-copy a {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    transition: color var(--dur-fast) ease;
  }
  .footer-sys .footer-copy a:hover,
  .footer-sys .footer-copy a:focus-visible { color: var(--color-accent); }
  .footer-sys { font-size: 11px; }
  .footer-top { font-size: 11px; text-decoration: none; color: var(--color-text-faint); }
  .footer-top:hover { color: var(--color-accent); }
</style>
