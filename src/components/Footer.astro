---
const year = new Date().getFullYear();
---
<footer class="site-footer container">
  <span class="text-muted footer-copy">© {year} Anish Giri // Built with precision</span>
  <div class="footer-links">
    <a href="https://github.com/Leptons1618" target="_blank" rel="noopener">GitHub</a>
    <a href="https://www.linkedin.com/in/anish-giri-a4031723a" target="_blank" rel="noopener">LinkedIn</a>
    <a href="https://github.com/Leptons1618/Portfolio" target="_blank" rel="noopener">Source</a>
  </div>
</footer>
<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--color-divider);
  }
  .footer-copy { font-size: 12px; }
  .footer-links { display: flex; gap: var(--space-4); font-size: 13px; }
</style>
