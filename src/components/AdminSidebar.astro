---
/**
 * The admin rail: who you are signed in as, where you can go, and the actions
 * that belong to no single screen.
 *
 * `AdminLayout` marks this `transition:persist`, so the element survives a
 * navigation instead of being rebuilt — which is the whole reason the layout
 * mounts `<ClientRouter />`. Two consequences shape the script below:
 *
 *   - It binds **once**, at module scope. Astro moves this exact DOM node into
 *     the next page, listeners and all, and re-running the bindings would stack
 *     duplicates on the same nodes.
 *   - The current-section marker is therefore *not* server state. It is
 *     rendered here for the first paint and refreshed from `location.pathname`
 *     after every transition, so the URL is the single source of truth.
 */
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../lib/site';
import { SIDEBAR_WIDTH } from '../lib/admin';

/* Identity is the fifth destination. It was a dialog on the grounds that a
   screen should be something that writes, and it is still the one entry here
   that only exports — but the rule cost more than it bought: a modal has no
   URL, does not survive a reload, and loses what you typed to a stray Escape.
   Decision 14 has the reversal; the screen itself says it exports. */
const NAV_GROUPS = [
  {
    label: 'Manage',
    items: [
      { label: 'Dashboard', href: '/admin/dashboard', icon: 'lucide:layout-dashboard' },
      { label: 'Projects', href: '/admin/projects', icon: 'lucide:folder-git-2' },
      { label: 'Journal', href: '/admin/journal', icon: 'lucide:pen-line' },
      { label: 'Resume', href: '/admin/resume', icon: 'lucide:file-text' },
    ],
  },
  {
    label: 'System',
    items: [
      { label: 'AI', href: '/admin/ai', icon: 'lucide:sparkles' },
      { label: 'Identity', href: '/admin/settings', icon: 'lucide:user-round-cog' },
    ],
  },
];

/* Built and served paths differ by a trailing slash, so compare without one.
   A project's detail page is under `/admin/projects/…`, and it belongs to the
   Projects section rather than to nothing — hence prefix, not equality. */
const here = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (href: string) => here === href || here.startsWith(`${href}/`);
---
{/* The persist name is set here rather than by the caller: a transition
    directive on a component tag does not reach the element inside it, and this
    rail is the reason `AdminLayout` mounts a router at all. */}
<aside class="admin-sidebar" transition:persist="admin-sidebar">
  <div class="admin-sidebar-head">
    {/* Identity sits at the top, where an avatar reads as "who am I signed in
        as". Seeded from `site.ts`, replaced with the GitHub login below once a
        session exists. */}
    <span class="admin-whoami" id="admin-whoami">
      {/* The ring around the avatar is the session: a conic sweep that
          empties as the eight-hour token runs down, written to
          `--session-left` by the script below. Signed out it is a plain
          hairline. */}
      <span class="admin-avatar-ring" id="admin-avatar-ring">
        <img class="admin-avatar" id="admin-avatar" alt="" width="28" height="28" src={site.photo} />
      </span>
      <span class="admin-whoami-text collapsible">
        <span class="admin-whoami-name" id="admin-identity">{site.name}</span>
        <span class="admin-whoami-role" id="admin-session">signed out</span>
      </span>
    </span>
    <button
      type="button"
      class="btn btn-icon admin-collapse"
      id="admin-collapse"
      aria-label="Collapse sidebar"
      aria-expanded="true"
      title="Collapse sidebar (Ctrl+B)"
    >
      <Icon name="lucide:chevrons-left" class="admin-nav-icon" />
    </button>
  </div>

  <nav class="admin-nav" aria-label="Admin sections">
    {NAV_GROUPS.map(group => (
      <div class="admin-nav-group">
        <p class="admin-nav-label collapsible">{group.label}</p>
        {group.items.map(item => (
          <a
            href={item.href}
            class="admin-nav-link"
            data-label={item.label}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <Icon name={item.icon} class="admin-nav-icon" />
            <span class="collapsible">{item.label}</span>
          </a>
        ))}
      </div>
    ))}
  </nav>

  <div class="admin-sidebar-foot">
    <a class="btn btn-primary btn-block admin-new-post" href="/admin/journal/new" data-label="New Post">
      <Icon name="lucide:plus" class="admin-nav-icon" /><span class="collapsible">New Post</span>
    </a>
    <span class="collapsible admin-foot-actions">
      <ThemeToggle />
    </span>
    {/* Leaving the surface, twice: the site as a reader sees it, and the
        session. Both are buttons of the same weight because they are the same
        kind of thing — a ghost link under a pair of theme controls read as a
        stray line of text rather than as a way out. */}
    <span class="collapsible admin-foot-links">
      <a class="btn btn-secondary btn-sm" href="/" title="Public site">
        <Icon name="lucide:external-link" class="admin-nav-icon" />Public site
      </a>
      <button type="button" class="btn btn-secondary btn-sm" id="admin-signout" hidden>
        <Icon name="lucide:log-out" class="admin-nav-icon" />Sign out
      </button>
    </span>
  </div>

  {/* — resize handle —

      The rail's edge, made into a control: a separator you can drag, nudge
      with the arrow keys, or double-act to put the default width back. The
      grip only surfaces when the pointer is near or focus arrives, so at rest
      the edge reads as an edge and not as chrome asking for attention. */}
  <div
    class="admin-resizer"
    id="admin-resizer"
    role="separator"
    aria-orientation="vertical"
    tabindex="0"
    aria-valuemin={SIDEBAR_WIDTH.min}
    aria-valuemax={SIDEBAR_WIDTH.max}
    aria-label={`Resize sidebar. Drag, or use the arrow keys. Range ${SIDEBAR_WIDTH.min} to ${SIDEBAR_WIDTH.max} pixels.`}
  ></div>
</aside>

<script>
  import { SIDEBAR_KEY, SIDEBAR_WIDTH, SIDEBAR_WIDTH_KEY } from '../lib/admin';
  import { getUser, isConfigured, sessionExpiresAt, signOut } from '../lib/github';

  const root = document.documentElement;

  /* — identity —

     Written as text nodes and an image `src`, never innerHTML: the login and
     the avatar come back from GitHub, and it is never worth handing a remote
     string to a parser. */
  const sessionLine = document.getElementById('admin-session')!;
  const signOutButton = document.getElementById('admin-signout') as HTMLButtonElement;
  const user = getUser();

  if (user) {
    document.getElementById('admin-identity')!.textContent = user.name ?? `@${user.login}`;
    signOutButton.hidden = false;

    /* GitHub App user tokens expire after 8 hours. Saying how much is left
       beats discovering it when a save fails. */
    const expiresAt = sessionExpiresAt();
    const hoursLeft = expiresAt === null ? null : Math.max(0, Math.round((expiresAt - Date.now()) / 36e5));
    sessionLine.textContent = hoursLeft === null ? `@${user.login}` : `@${user.login} · ${hoursLeft}h left`;

    const avatar = document.getElementById('admin-avatar') as HTMLImageElement;
    avatar.src = user.avatarUrl;
    avatar.alt = `@${user.login}`;

    /* The ring: what fraction of the eight-hour token is left, as a custom
       property the stylesheet sweeps a conic gradient with. Repainted every
       minute — the number in the text line is rounded to the hour, and a ring
       that only moved hourly would look stuck. */
    const whoami = document.getElementById('admin-whoami')!;
    const ring = document.getElementById('admin-avatar-ring')!;
    whoami.dataset.signed = '';
    const SESSION_HOURS = 8;
    const paintRing = () => {
      if (expiresAt === null) return;
      const left = Math.max(0, Math.min(1, (expiresAt - Date.now()) / (SESSION_HOURS * 36e5)));
      ring.style.setProperty('--session-left', left.toFixed(3));
      if (left < 0.125) ring.dataset.low = '';
    };
    paintRing();
    setInterval(paintRing, 60_000);
  } else if (!isConfigured()) {
    /* No client ID in this build — a fork, or a local checkout with no `.env`.
       The screens stay reachable so the repository is usable without secrets,
       but nothing here can save, and the rail should say which it is. */
    sessionLine.textContent = 'local · export only';
  }

  signOutButton.addEventListener('click', () => {
    signOut();
    window.location.replace('/admin/');
  });

  /* — collapse —

     The state lives on `<html>` rather than on a class here, because the
     pre-paint script in `AdminLayout` has to set it before this element
     exists. The chevron is an inlined SVG flipped in CSS; writing
     `textContent` on that button would delete the icon. */
  const collapseButton = document.getElementById('admin-collapse')!;

  /* — two phases, because one attribute made both directions glitch —

     Collapsing: the width animates first; hiding the labels at the same
     instant made the text vanish and the icons jump while the rail was still
     wide. Expanding: labels appearing immediately reflowed inside a 64px rail
     and wrapped into a scramble until the width caught up.

     So the width answers to `data-admin-collapsed` (set now, either way) and
     the text answers to `data-admin-labels-hidden`: set ~190ms *after* the
     collapse starts — just past the 180ms width transition — and cleared
     *before* the expand starts, so the labels slide back in behind the
     growing width (clipped by the rail's `overflow-x: clip`) instead of
     wrapping in it. */
  const COLLAPSE_MS = 190;
  let labelsTimer = 0;

  /* The animation window carries its own attribute: while it is set the rail
     clips its edge and the labels hold one line, so the text slides instead
     of wrapping inside a rail that is still the wrong width. Collapsing, the
     labels phase lands when the width has finished; expanding, the labels are
     back at once and the clip holds until the width has caught up with them.
     The window is cleared in both directions when the timer lands, because
     the collapsed tooltips render outside the rail and a permanent clip would
     cut them off. */
  function setLabelsHidden(hidden: boolean) {
    window.clearTimeout(labelsTimer);
    root.dataset.adminAnimating = '1';
    labelsTimer = window.setTimeout(() => {
      if (hidden) root.dataset.adminLabelsHidden = '1';
      else delete root.dataset.adminLabelsHidden;
      delete root.dataset.adminAnimating;
    }, COLLAPSE_MS);
  }

  function markCollapsed(collapsed: boolean, animate = true) {
    if (collapsed) root.dataset.adminCollapsed = '1';
    else delete root.dataset.adminCollapsed;
    /* Restoring a saved state has nothing to animate — the pre-paint script
       set the width and the labels phase together, so this only syncs the
       button's state. A toggle goes through the timed two-phase path. */
    if (animate) setLabelsHidden(collapsed);
    collapseButton.setAttribute('aria-expanded', String(!collapsed));
    collapseButton.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
  }

  markCollapsed(localStorage.getItem(SIDEBAR_KEY) === '1', false);

  function toggleCollapsed() {
    const next = root.dataset.adminCollapsed !== '1';
    localStorage.setItem(SIDEBAR_KEY, next ? '1' : '0');
    markCollapsed(next);
  }

  collapseButton.addEventListener('click', toggleCollapsed);

  /* Ctrl/⌘+B, the editor convention for the side rail. Bound once, at module
     scope, like everything else in this persisted element — and never while
     typing, where the browser's own Ctrl+B (bold, in a rich field) or a
     terminal-style shortcut the editor may own must win. */
  document.addEventListener('keydown', event => {
    if (!(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey) return;
    if (event.key.toLowerCase() !== 'b') return;
    const target = event.target as HTMLElement | null;
    if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
    event.preventDefault();
    toggleCollapsed();
  });

  /* — resize —

     The width is a custom property on `<html>`, never an inline width on the
     rail: the collapsed rule has to keep winning while collapsed, and a
     variable lets the stylesheet own both states. `AdminLayout`'s pre-paint
     script restores the remembered value the same way, so nothing here has to
     run before first paint. */
  const resizer = document.getElementById('admin-resizer');

  if (resizer) {
    const clamp = (px: number) =>
      Math.min(SIDEBAR_WIDTH.max, Math.max(SIDEBAR_WIDTH.min, px));
    const stored = () => {
      const raw = Number(localStorage.getItem(SIDEBAR_WIDTH_KEY));
      return raw >= SIDEBAR_WIDTH.min && raw <= SIDEBAR_WIDTH.max ? raw : null;
    };

    let width = stored() ?? SIDEBAR_WIDTH.default;
    resizer.setAttribute('aria-valuenow', String(width));

    function applyWidth(px: number) {
      width = px;
      /* Collapsed, the property would be invisible anyway — writing it there
         would let an old value spring back the moment the rail was expanded. */
      if (root.dataset.adminCollapsed !== '1') {
        root.style.setProperty('--admin-sidebar-w', `${px}px`);
        resizer!.setAttribute('aria-valuenow', String(px));
      }
    }

    function remember() {
      if (width === SIDEBAR_WIDTH.default) localStorage.removeItem(SIDEBAR_WIDTH_KEY);
      else localStorage.setItem(SIDEBAR_WIDTH_KEY, String(width));
    }

    let dragging = false;

    resizer.addEventListener('pointerdown', event => {
      if (root.dataset.adminCollapsed === '1') return;
      dragging = true;
      document.body.classList.add('is-resizing-sidebar');
      /* Capture keeps a fast pull tracked once the pointer outruns the strip.
         It can legitimately fail — the pointer cancelled between events — and
         the window-level listeners below cover that case anyway. */
      try {
        resizer.setPointerCapture(event.pointerId);
      } catch {
        /* keep going */
      }
      event.preventDefault();
    });

    /* On `window`, not on the strip: the pointer is free to leave nine pixels
       of handle while it is still pulling, and the drag must follow it. */
    window.addEventListener('pointermove', event => {
      if (!dragging) return;
      /* The rail starts at x=0, so the pointer *is* the right edge. */
      applyWidth(clamp(event.clientX));
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      document.body.classList.remove('is-resizing-sidebar');
      remember();
    };
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    /* The keyboard path mirrors the drag in 16px steps; Home puts the default
       back — the same three verbs the drag offers, without the mouse. */
    resizer.addEventListener('keydown', event => {
      if (root.dataset.adminCollapsed === '1') return;
      const step = event.key === 'ArrowRight' ? 16 : event.key === 'ArrowLeft' ? -16 : 0;
      if (step || event.key === 'Home') {
        event.preventDefault();
        applyWidth(step ? clamp(width + step) : SIDEBAR_WIDTH.default);
        remember();
      }
    });

    /* A double-click on an edge means "I didn't mean to change this". */
    resizer.addEventListener('dblclick', () => {
      applyWidth(SIDEBAR_WIDTH.default);
      remember();
    });
  }

  /* — current section —

     This node outlives the page it was rendered on, so the server-rendered
     `aria-current` is only right for the first paint. `astro:page-load` is not
     dispatched for that first page, which is why the marker is also applied
     once here.

     Prefix, not equality — the same rule the frontmatter above uses. Both
     sections have pages underneath them now (`/admin/projects/<slug>`,
     `/admin/journal/new`, `/admin/journal/<slug>`), and on those the rail was
     marking nothing at all. */
  function markCurrent() {
    const here = window.location.pathname.replace(/\/+$/, '');
    document.querySelectorAll<HTMLAnchorElement>('.admin-nav-link').forEach(link => {
      const target = new URL(link.href).pathname.replace(/\/+$/, '');
      if (target === here || here.startsWith(`${target}/`)) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  markCurrent();
  document.addEventListener('astro:page-load', markCurrent);
</script>
