---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/format';
interface Props {
  title: string; subtitle: string; slug: string; heroImage?: string; heroVideo?: string;
  problem: string; solution: string; architectureImage?: string; achievements: string[];
  stack: string[]; repoUrl?: string; demoUrl?: string; date: string; readTime?: string;
}
const { title, subtitle, slug, heroImage, heroVideo, problem, solution, architectureImage, achievements, stack, repoUrl, demoUrl, date, readTime } = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  'ai-llm': 'AI / ML',
  'ml-cv': 'Computer Vision',
  'full-stack': 'Full-Stack',
  devtools: 'DevTools',
  systems: 'Systems',
  simulation: 'Simulation',
  other: 'Other',
};

const allCaseStudies = await getCollection('case-studies');
const sorted = allCaseStudies.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const currentIdx = sorted.findIndex(cs => cs.slug === slug);
const prev = sorted[currentIdx + 1] || null;
const next = sorted[currentIdx - 1] || null;

/* The design's eyebrow tag reads "{category} · {year}". Case studies carry
   neither field, so both come from the project that links to this study. */
const allProjects = await getCollection('projects');
const linkedProject = allProjects.find(p => p.data.caseStudySlug === slug);
const categoryLabel = linkedProject ? (CATEGORY_LABELS[linkedProject.data.category] ?? linkedProject.data.category) : null;
const year = linkedProject?.data.year ?? new Date(date).getFullYear();
const eyebrow = categoryLabel ? `${categoryLabel} · ${year}` : String(year);
---
<BaseLayout title={title} description={subtitle}>
  <article class="container container-mid case-study">
    <a class="btn btn-ghost back-link" href="/projects">← Back to Projects</a>
    <span class="tag tag-accent-2 cs-eyebrow">{eyebrow}</span>
    <h1 class="cs-title">{title}</h1>
    <p class="cs-subtitle">{subtitle}</p>
    <p class="text-muted cs-meta">{formatDate(date)}{readTime && ` · ${readTime} read`}</p>

    {heroVideo
      ? <div class="grayscale cs-hero"><video src={heroVideo} autoplay muted loop playsinline></video></div>
      : heroImage
        ? <div class="grayscale cs-hero"><img src={heroImage} alt={title} /></div>
        : null}

    <h3>The Problem</h3>
    <p class="cs-copy">{problem}</p>

    <h3>The Solution</h3>
    <p class="cs-copy">{solution}</p>

    <div class="prose cs-content"><slot /></div>

    {architectureImage && (
      <>
        <h3>Architecture</h3>
        <figure class="grayscale cs-arch"><img src={architectureImage} alt="Architecture diagram" /></figure>
      </>
    )}

    <h3>Achievements</h3>
    <ul class="cs-list">
      {achievements.map(a => <li>{a}</li>)}
    </ul>

    <h3>Stack</h3>
    <div class="cs-stack">
      {stack.map(s => <Tag text={s} variant="neutral" />)}
    </div>

    {(repoUrl || demoUrl) && (
      <div class="cs-actions">
        {repoUrl && <a class="btn btn-primary" href={repoUrl} target="_blank" rel="noopener">Repo ↗</a>}
        {demoUrl && <a class="btn btn-secondary" href={demoUrl} target="_blank" rel="noopener">Demo ↗</a>}
      </div>
    )}

    {(prev || next) && (
      <nav class="cs-nav">
        {prev && (
          <a href={`/case-studies/${prev.slug}`} class="cs-nav-link">
            <span class="text-muted">← Previous</span>
            <strong>{prev.data.title}</strong>
          </a>
        )}
        {next && (
          <a href={`/case-studies/${next.slug}`} class="cs-nav-link next">
            <span class="text-muted">Next →</span>
            <strong>{next.data.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
<style>
  .case-study { padding-top: var(--space-6); padding-bottom: var(--space-8); }
  .back-link { padding-inline: 0; margin-bottom: var(--space-3); }
  .cs-eyebrow { margin-bottom: var(--space-3); }
  .cs-title { margin-bottom: var(--space-2); }
  .cs-subtitle { font-size: 17px; opacity: 0.85; max-width: 56ch; margin-bottom: var(--space-2); }
  .cs-meta { font-size: 13px; margin-bottom: var(--space-4); }

  .cs-hero { margin-bottom: var(--space-6); }
  .cs-hero img, .cs-hero video { width: 100%; height: 360px; object-fit: cover; }

  .cs-copy { opacity: 0.85; margin-bottom: var(--space-4); }
  .cs-content:empty { display: none; }

  .cs-arch { margin-bottom: var(--space-4); }

  .cs-list { list-style: disc; opacity: 0.85; padding-left: 20px; margin: 0 0 var(--space-4); }
  .cs-list li { margin-bottom: 6px; }

  .cs-stack { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-6); }
  .cs-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }

  .cs-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-divider);
  }
  .cs-nav-link { display: flex; flex-direction: column; gap: 2px; max-width: 45%; text-decoration: none; font-size: 13px; }
  .cs-nav-link span { font-size: 12px; }
  .cs-nav-link strong { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 15px; color: var(--color-text); }
  .cs-nav-link:hover strong { color: var(--color-accent); }
  .cs-nav-link.next { text-align: right; margin-left: auto; }

  @media (max-width: 640px) {
    .cs-hero img, .cs-hero video { height: 220px; }
    .cs-nav { flex-direction: column; }
    .cs-nav-link { max-width: none; }
    .cs-nav-link.next { text-align: left; margin-left: 0; }
  }
</style>
