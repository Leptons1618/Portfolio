---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AskWidget from '../components/AskWidget.astro';
import ThemeHead from '../components/ThemeHead.astro';
/* The three themes' faces. Space Grotesk heads all of them; Inter is
   Geometry's body, Manrope is Blueprint's and Paper's, JetBrains Mono is the
   metadata voice everywhere. Declaring an @font-face costs nothing until a
   rendered element resolves to it, so a visitor only downloads the pair the
   active theme actually sets. */
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
/* Preloaded by URL below, so the latin files arrive with the CSS rather than
   after first paint. Every family here ships `font-display: swap`: without
   the preload the fallback renders first and the whole nav re-lays-out when
   the webfont lands — on every MPA navigation while dev serves them
   uncached, on every first view in production. Four files, ~136KB total. */
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import jetbrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { site, absoluteUrl } from '../lib/site';
import { DEFAULT_THEME } from '../lib/theme';

interface Props { title?: string; description?: string; image?: string; }
const siteTitle = `${site.name} Portfolio`;
const { title = siteTitle, description = site.tagline, image = site.ogImage } = Astro.props;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const origin = Astro.site ?? site.url;
const canonicalURL = absoluteUrl(Astro.url.pathname, origin);
/* Open Graph requires absolute URLs — a site-relative path is not resolved
   by every scraper. */
const imageURL = absoluteUrl(image, origin);
---
<!DOCTYPE html>
<html lang="en" data-theme={DEFAULT_THEME}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
  {/* The portrait, cropped to the head — the same face the hero and the about
      page show, so a pinned tab is recognisably this person rather than a
      monogram that means nothing to anyone who has not been here before. */}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  {/* The faces the first screen is set in, fetched at head priority — see
      the `?url` imports above for why they are named here. */}
  <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={jetbrainsMonoLatin} as="font" type="font/woff2" crossorigin />
  <ThemeHead />
  <script is:inline>
    // Arm the scroll reveal before paint, not in the module script below:
    // adding the class after parse would fade already-painted content out and
    // back in. The timer un-arms it if the module never loads, so a failed
    // bundle can never strand the page invisible.
    (function () {
      if (
        !('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) return;
      document.documentElement.classList.add('reveal-ready');
      window.__omRevealFallback = setTimeout(function () {
        document.documentElement.classList.remove('reveal-ready');
      }, 3000);
    })();
  </script>
</head>
<body>
  {/* First thing Tab can reach. The nav sits between every keyboard arrival
      and the content; this hands the trip back to whoever does not want it.
      Visible only while focused, so pointer users never see it. */}
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
  {/* Renders hidden and unhides itself only if the assistant is switched on —
      a prerendered page cannot read the row that decides it, so the launcher
      asks once per session. See `src/pages/api/ai/status.ts`. Costs nothing
      when the feature is off, and nothing at all without JavaScript. */}
  <AskWidget />

  <script>
    /* Reveal sections as they arrive. One observer for the page, elements
       staggered by their position in the batch that crossed together — which
       is what makes a grid of cards land in sequence rather than as a block.

       Public pages are plain MPA (decision 11), so this runs once per
       document and needs no view-transition handling. */
    import { mountTextFx } from '../lib/text-fx';
    import { mountCode } from '../lib/code-fx';

    const STAGGER = 70;

    /* Typed prompts and decoded eyebrows. Independent of the reveal below: it
       has its own observer and its own reduced-motion check. */
    mountTextFx();

    /* Fenced code: framed, coloured and dealt in a line at a time. Mounted
       here rather than on the two pages that render `.prose`, so a third
       long-form surface gets it without a third import — and it returns on
       the first query when a page has no listing on it, which is most of
       them. Its own observer and its own reduced-motion check, again. */
    mountCode();

    /* The head script armed the reveal; this module is the proof it loaded. */
    const fallback = (window as unknown as { __omRevealFallback?: number }).__omRevealFallback;
    if (fallback) {
      clearTimeout(fallback);
      (window as unknown as { __omRevealFallback?: number }).__omRevealFallback = undefined;
    }

    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

    if (!document.documentElement.classList.contains('reveal-ready')) {
      /* Never armed — no observer, or reduced motion. The CSS is inert, so
         there is nothing to do and nothing is hidden. */
    } else {
      const observer = new IntersectionObserver(
        (entries, self) => {
          entries
            .filter(entry => entry.isIntersecting)
            .forEach((entry, index) => {
              const node = entry.target as HTMLElement;
              /* Authored delays win: a page that staged its own entrance
                 keeps it, and the batch stagger fills in for everyone else. */
              if (!node.style.getPropertyValue('--reveal-delay')) {
                node.style.setProperty('--reveal-delay', `${index * STAGGER}ms`);
              }
              node.classList.add('is-revealed');
              self.unobserve(node);
            });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );

      targets.forEach(target => observer.observe(target));
    }
  </script>
</body>
</html>
<style>
  /* Off-canvas until focused, then a panel top-left in the page's own
     materials. `:focus` not `:focus-visible`: keyboard activation of an
     anchor does move focus here, but the link must also appear for the
     touch and switch users a `focus-visible` heuristic can miss. */
  .skip-link {
    position: fixed;
    /* Parked at the top edge and moved off it by the transform, rather than
       positioned at the inset and moved off by the inset. The two are only
       the same until the arithmetic has to be exact: `top: 16px` with
       `translateY(-100% - 16px)` lands the panel's bottom edge on *exactly*
       y=0, where its 1px border still paints a row — which is the second half
       of the dark bar in the corner, and the half a safe-area env() would
       have made worse rather than better. Off-screen by a clear 4px instead.
       The left inset is still a floor, not a constant: on a notched device in
       landscape env() is larger and wins. */
    top: 0;
    left: max(var(--space-4), env(safe-area-inset-left));
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-md);
    transform: translateY(calc(-100% - var(--space-1)));
  }

  /* The elevation belongs to the *focused* panel and to nothing else.
     Carrying it at rest put a shadow on a box parked above the viewport, and
     `--shadow-lg` is a hard 4px offset with no blur on both drafting themes —
     so the shadow of an off-screen element landed *inside* the viewport as a
     dark bar wedged into the top-left corner of every page. A blurred shadow
     did the same thing more quietly. Painting it only on focus is the fix
     that holds whatever a theme's shadow token turns out to be. */
  .skip-link:focus {
    transform: translateY(max(var(--space-4), env(safe-area-inset-top)));
    box-shadow: var(--shadow-lg);
  }

  /* The arrival is a motion moment — the panel drops in from off-screen —
     so it gets a short settle rather than teleporting into place. The exit
     keeps its instant snap: dismissal should be quicker than arrival, and
     nobody watches this one leave. */
  @media (prefers-reduced-motion: no-preference) {
    .skip-link:focus {
      transition: transform var(--dur-fast) var(--ease-out);
    }
  }
</style>
