---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AskWidget from '../components/AskWidget.astro';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/800.css';
/* Blueprint's faces. Declaring the @font-face rules costs nothing until a
   rendered element actually resolves to one of these families, which only
   happens under `data-theme="blueprint"` — so Modernist visitors never
   download them. */
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site, absoluteUrl } from '../lib/site';
import { DEFAULT_THEME, THEME_KEY, THEMES } from '../lib/theme';

interface Props { title?: string; description?: string; image?: string; }
const siteTitle = `${site.name} Portfolio`;
const { title = siteTitle, description = site.tagline, image = site.ogImage } = Astro.props;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const origin = Astro.site ?? site.url;
const canonicalURL = absoluteUrl(Astro.url.pathname, origin);
/* Open Graph requires absolute URLs — a site-relative path is not resolved
   by every scraper. */
const imageURL = absoluteUrl(image, origin);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
  {/* The portrait, cropped to the head — the same face the hero and the about
      page show, so a pinned tab is recognisably this person rather than a
      monogram that means nothing to anyone who has not been here before. */}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <meta name="theme-color" content={THEMES.find(t => t.id === DEFAULT_THEME)!.themeColor} />
  <script is:inline define:vars={{ THEME_KEY, DEFAULT_THEME, THEME_IDS: THEMES.map(t => t.id) }}>
    // Restore the stored theme before first paint, so the page never renders
    // in the default theme and then flips.
    (function () {
      var stored = localStorage.getItem(THEME_KEY);
      if (stored && stored !== DEFAULT_THEME && THEME_IDS.indexOf(stored) !== -1) {
        document.documentElement.dataset.theme = stored;
      }
    })();
  </script>
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
  {/* Renders hidden and unhides itself only if the assistant is switched on —
      a prerendered page cannot read the row that decides it, so the launcher
      asks once per session. See `src/pages/api/ai/status.ts`. Costs nothing
      when the feature is off, and nothing at all without JavaScript. */}
  <AskWidget />
</body>
</html>
