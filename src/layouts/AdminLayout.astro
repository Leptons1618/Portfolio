---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/admin.css';
import { ClientRouter } from 'astro:transitions';
import AdminErrorBoundary from '../components/AdminErrorBoundary.astro';
import AdminSidebar from '../components/AdminSidebar.astro';
import ThemeHead from '../components/ThemeHead.astro';
import { SIDEBAR_KEY, TOAST_HOST_ID } from '../lib/admin';
import { EXPIRY_KEY, TOKEN_KEY, isConfigured } from '../lib/github';

/* Only gate when the build actually has a GitHub App wired up. An
   unconfigured build (a local checkout, a fork) keeps the screens reachable
   rather than bouncing to a sign-in that cannot succeed. */
const GATE = isConfigured();

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <ThemeHead />
  {/* Client-side routing between admin screens, so the sidebar can persist
      rather than being rebuilt on every navigation. Public pages stay plain
      MPA — this is the only layout that mounts it. */}
  <ClientRouter />
  <script is:inline define:vars={{ SIDEBAR_KEY, TOKEN_KEY, EXPIRY_KEY, GATE }}>
    // Runs before first paint: bounce an unauthenticated visitor before any
    // editor chrome renders, and restore the sidebar and theme so neither
    // flashes the wrong way.
    //
    // This hides the screens; it does not protect them. `/admin/*` is
    // prerendered public HTML. The repository is what is protected, and that
    // is enforced by GitHub when a write is attempted without a token.
    (function () {
      function restore() {
        // An expired token is treated as no token, so an 8-hour-old tab lands
        // on the sign-in page rather than a dashboard where every action fails.
        var expiry = Number(sessionStorage.getItem(EXPIRY_KEY));
        var expired = Number.isFinite(expiry) && expiry > 0 && Date.now() >= expiry;
        if (GATE && (expired || !sessionStorage.getItem(TOKEN_KEY))) {
          window.location.replace('/admin/');
          return;
        }
        if (localStorage.getItem(SIDEBAR_KEY) === '1') {
          document.documentElement.dataset.adminCollapsed = '1';
        }
        // `ThemeHead` above published this and already ran it once. Calling it
        // again here is what survives a view transition, which replaces every
        // attribute on `<html>` with the incoming document's.
        window.__omRestoreTheme();
      }

      restore();

      // A view transition replaces every attribute on `<html>` with the ones
      // the incoming document was built with, which drops both of the above.
      // `astro:after-swap` runs before paint, so putting them back here is
      // invisible rather than a flash. This script is only executed once —
      // identical inline scripts are not re-run across a transition — so the
      // listener registered here covers every later navigation.
      document.addEventListener('astro:after-swap', restore);

      // Client routing means a click produces nothing visible until the next
      // document has been fetched and swapped — on a project's page, which is
      // prerendered per project and not small, that gap reads as a dead click.
      // The bar is the only thing that says a navigation is in flight. It is
      // `transition:persist`, so this is the same node for the whole session
      // and these two listeners are all it needs.
      function hideProgress() {
        var bar = document.getElementById('route-progress');
        if (bar) bar.hidden = true;
      }

      document.addEventListener('astro:before-preparation', function () {
        var bar = document.getElementById('route-progress');
        if (!bar) return;
        // Restart the animation. Without this the bar is already parked at 92%
        // from the previous navigation and the second click looks like nothing
        // happened at all — which is the exact failure the bar exists to fix.
        bar.hidden = false;
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      });

      // Both, and deliberately. `astro:page-load` is the normal end of a
      // navigation, but it is dispatched from a `.finally()` hung off the view
      // transition — and a navigation the router aborts before preparation
      // finishes never reaches it, which used to leave the bar crawling across
      // the top of a page that had already arrived. `astro:after-swap` fires
      // before paint on every completed swap, so it closes that hole without
      // ever hiding the bar early.
      document.addEventListener('astro:after-swap', hideProgress);
      document.addEventListener('astro:page-load', hideProgress);
    })();
  </script>
</head>
<body>
  {/* Outside the shell and pinned to the viewport: it belongs to the
      navigation, not to any screen. */}
  <div class="route-progress" id="route-progress" transition:persist hidden></div>

  <div class="admin-shell" id="admin-shell">
    <AdminSidebar />

    <main class="admin-main">
      {/* Above the content, not instead of it: the markup below still renders
          and is still readable, it just cannot be trusted to *do* anything
          once this is showing. */}
      <AdminErrorBoundary />
      <slot />
    </main>
  </div>

  {/* Outside the shell and `transition:persist`ed, for the same two reasons the
      progress bar is: a toast belongs to the *session*, not to the screen that
      raised it, and a save that finishes just as you navigate away must not
      have its result thrown out mid-swap. Empty until `toast()` in
      `src/lib/admin.ts` puts something in it. */}
  {/* `popover="manual"` puts the stack in the top layer, which is the only
      place a toast can be seen over an open `<dialog>` — `raiseHost()` in
      `src/lib/admin.ts` explains the re-show. Manual, not `auto`: a toast is
      not a menu and must not light-dismiss on the next click anywhere. */}
  <div
    class="toast-host"
    id={TOAST_HOST_ID}
    role="region"
    aria-label="Notifications"
    aria-live="polite"
    popover="manual"
    transition:persist
  ></div>

  {/* Dropdowns, everywhere at once. A `<select>` cannot be styled past its
      closed state — the list it opens belongs to the operating system — so the
      popup is replaced with one this design system owns. Mounted from the
      layout rather than per page because there is nothing page-specific about
      a dropdown, and it is idempotent, so the repeat visits `<ClientRouter />`
      produces cost one `querySelectorAll`. Without JavaScript the native
      element is never hidden and every form still works. */}
  <script>
    import { mountSelects } from '../lib/select';
    mountSelects();
  </script>
</body>
</html>
