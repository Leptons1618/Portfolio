---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import Illustration from '../components/Illustration.astro';
import MathVisual from '../components/MathVisual.astro';
import PathLine from '../components/PathLine.astro';
import SectionSep from '../components/SectionSep.astro';
import { CATEGORY_LABELS, categoryLabel, getProjects, topTags } from '../lib/content';

/* Reads content from D1 per request — see the note in `src/lib/content.ts`.
   Prerendering this page would freeze the listing at deploy time, which is the
   whole thing the database was introduced to stop. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const allProjects = await getProjects(DB);

/* "Featured" is a pseudo-category: it filters on featuredRank, not on the
   schema's category field, so it is prepended rather than derived. */
const presentCategories = new Set<string>(allProjects.map(p => p.data.category));
const categories = [
  { key: 'all', label: 'All' },
  { key: 'featured', label: 'Featured' },
  ...Object.entries(CATEGORY_LABELS)
    .filter(([key]) => presentCategories.has(key))
    .map(([key, label]) => ({ key, label })),
];

const projectsData = allProjects.map(p => ({
  title: p.data.title,
  slug: p.slug,
  summary: p.data.summary,
  category: p.data.category,
  categoryLabel: categoryLabel(p.data.category),
  tags: p.data.tags,
  stack: p.data.stack,
  status: p.data.status,
  year: p.data.year,
  repoUrl: p.data.repoUrl,
  demoUrl: p.data.demoUrl,
  caseStudySlug: p.data.caseStudySlug,
  featuredRank: p.data.featuredRank,
}));
---
<BaseLayout title="Projects" description="All projects — filterable by category, tag, and stack.">
  <header class="container page-header" data-reveal>
    <div class="page-header-copy">
      <PathLine path="projects" cmd="ls --sort=year --all" />
      <h1>Projects</h1>
      <p class="page-desc">The work — production systems, experiments, and everything in between, filterable by category, tag, and stack.</p>
    </div>
    {/* The rotation and its matrix, on every theme: the header's argument is
        that this is engineering, and a transform computed in front of you
        says so better than a static grid did. */}
    <div class="page-header-art">
      <MathVisual />
    </div>
  </header>

  <SectionSep />

  <div class="container filter-row" data-reveal style="--reveal-delay: 80ms">
    <FilterBar categories={categories} topTags={topTags(allProjects)} />
  </div>

  <section class="container results" data-reveal style="--reveal-delay: 140ms">
    <div class="project-grid" id="project-grid">
      {projectsData.map(project => (
        <article
          class="card elev-sm project-card"
          data-title={project.title.toLowerCase()}
          data-summary={project.summary.toLowerCase()}
          data-category={project.category}
          data-tags={project.tags.join(',')}
          data-stack={project.stack.join(',').toLowerCase()}
          data-year={project.year}
          data-featured-rank={project.featuredRank ?? 9999}
        >
          <div class="card-top">
            <span class="card-year">{project.year}</span>
            <span class="tag tag-accent-2">{project.categoryLabel}</span>
          </div>
          <h2 class="card-title"><a href={`/projects/${project.slug}`}>{project.title}</a></h2>
          <p class="card-body">{project.summary}</p>
          <hr class="rule" />
          <div class="card-stack">
            {project.stack.slice(0, 5).map(s => <span class="tag tag-neutral">{s}</span>)}
          </div>
          <div class="card-actions">
            <a class="btn btn-primary btn-sm" href={project.caseStudySlug ? `/case-studies/${project.caseStudySlug}` : `/projects/${project.slug}`}>
              {project.caseStudySlug ? 'Case study' : 'Details'}
            </a>
            <a class="btn btn-secondary btn-sm" href={project.repoUrl} target="_blank" rel="noopener">Repo ↗</a>
          </div>
        </article>
      ))}
    </div>
    <div id="no-results" class="empty-state hidden">
      <div class="empty-state-art"><Illustration name="no-data" /></div>
      <p class="empty-state-copy">No projects match your filters.</p>
      {/* An empty state teaches the space: the fact, then the way out — the
          same pair the journal's empty state renders. */}
      <p class="empty-state-hint">Try a broader search, or clear a category or tag chip.</p>
      <button type="button" class="btn btn-secondary" id="clear-filters">Clear filters</button>
    </div>
  </section>
</BaseLayout>

<script>
  /* The one `select.input` on the public site. Mounted here rather than in
     `BaseLayout` so the module is a chunk this page pays for and no other page
     does — the admin mounts it from its own layout because every screen there
     has one. */
  import { mountSelects } from '../lib/select';
  mountSelects();

  const grid = document.getElementById('project-grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.project-card'));
  const searchInput = document.getElementById('filter-search') as HTMLInputElement;
  const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement;
  const categoryChips = document.querySelectorAll<HTMLElement>('[data-filter="category"]');
  const tagChips = document.querySelectorAll<HTMLElement>('[data-filter="tag"]');
  const noResults = document.getElementById('no-results')!;
  const resultsCount = document.getElementById('results-count')!;

  type Sort = 'featured' | 'newest' | 'oldest';
  const SORTS: Sort[] = ['featured', 'newest', 'oldest'];

  let activeCategory = 'all';
  let activeTags: string[] = [];
  let query = '';
  let sort: Sort = 'featured';

  function syncFromURL() {
    const params = new URLSearchParams(window.location.search);
    query = params.get('q') || '';
    activeCategory = params.get('category') || 'all';
    activeTags = params.get('tags')?.split(',').filter(Boolean) || [];
    const requested = params.get('sort') as Sort | null;
    sort = requested && SORTS.includes(requested) ? requested : 'featured';
    if (searchInput) searchInput.value = query;
    if (sortSelect) sortSelect.value = sort;
  }

  function updateURL() {
    const params = new URLSearchParams();
    if (query) params.set('q', query);
    if (activeCategory && activeCategory !== 'all') params.set('category', activeCategory);
    if (activeTags.length) params.set('tags', activeTags.join(','));
    if (sort !== 'featured') params.set('sort', sort);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  function setChipState(chip: HTMLElement, active: boolean, activeClass: string) {
    chip.classList.toggle(activeClass, active);
    chip.classList.toggle('tag-neutral', !active);
    chip.setAttribute('aria-pressed', String(active));
  }

  function applyFilters() {
    const visible: HTMLElement[] = [];
    const returning: HTMLElement[] = [];
    const q = query.trim().toLowerCase();
    for (const card of cards) {
      const title = card.dataset.title || '';
      const summary = card.dataset.summary || '';
      const category = card.dataset.category || '';
      const stack = card.dataset.stack || '';
      const tags = card.dataset.tags?.split(',') || [];
      const isFeatured = (card.dataset.featuredRank || '9999') !== '9999';

      const matchesQ = !q || title.includes(q) || summary.includes(q) || stack.includes(q) || tags.some(t => t.toLowerCase().includes(q));
      const matchesCat =
        activeCategory === 'all' ||
        (activeCategory === 'featured' ? isFeatured : category === activeCategory);
      const matchesTags = activeTags.length === 0 || activeTags.every(t => tags.includes(t));

      /* A card coming back from `display: none` is the one thing here worth
         animating: the change has to read as "these match now", not as a
         spreadsheet quietly repopulating. First paint skips this — the page
         reveal already owns arrival. */
      const wasHidden = card.style.display === 'none';
      if (matchesQ && matchesCat && matchesTags) {
        card.style.display = '';
        visible.push(card);
        if (wasHidden && initialised) returning.push(card);
      } else {
        card.style.display = 'none';
      }
    }

    visible.sort((a, b) => {
      const ya = parseInt(a.dataset.year || '0');
      const yb = parseInt(b.dataset.year || '0');
      if (sort === 'oldest') return ya - yb;
      if (sort === 'featured') {
        const fa = parseInt(a.dataset.featuredRank || '9999');
        const fb = parseInt(b.dataset.featuredRank || '9999');
        if (fa !== fb) return fa - fb;
      }
      return yb - ya;
    });
    visible.forEach(card => grid.appendChild(card));

    /* Staggered by rank in the visible set, capped so a large result set
       never makes the last card wait out a long queue. */
    returning.forEach((card, i) => {
      card.style.setProperty('--enter-delay', `${Math.min(i * 30, 240)}ms`);
      card.classList.remove('is-entering');
      void card.offsetWidth;
      card.classList.add('is-entering');
    });

    noResults.classList.toggle('hidden', visible.length > 0);
    resultsCount.textContent = `Showing ${visible.length} project${visible.length === 1 ? '' : 's'}`;
    categoryChips.forEach(chip => setChipState(chip, chip.dataset.value === activeCategory, 'tag-accent'));
    tagChips.forEach(chip => setChipState(chip, activeTags.includes(chip.dataset.value || ''), 'tag-accent-2'));
  }

  let initialised = false;
  syncFromURL();
  applyFilters();
  initialised = true;
  searchInput?.addEventListener('input', e => { query = (e.target as HTMLInputElement).value; updateURL(); applyFilters(); });
  sortSelect?.addEventListener('change', e => { sort = (e.target as HTMLSelectElement).value as Sort; updateURL(); applyFilters(); });
  categoryChips.forEach(chip => chip.addEventListener('click', () => {
    activeCategory = chip.dataset.value || 'all';
    updateURL(); applyFilters();
  }));
  tagChips.forEach(chip => chip.addEventListener('click', () => {
    const val = chip.dataset.value || '';
    activeTags = activeTags.includes(val) ? activeTags.filter(t => t !== val) : [...activeTags, val];
    updateURL(); applyFilters();
  }));

  /* The empty state's way out: everything back to the unfiltered view, the
     same path the URL round-trip already knows. */
  document.getElementById('clear-filters')?.addEventListener('click', () => {
    query = '';
    activeCategory = 'all';
    activeTags = [];
    sort = 'featured';
    if (searchInput) searchInput.value = '';
    if (sortSelect) sortSelect.value = sort;
    updateURL();
    applyFilters();
    searchInput?.focus();
  });
  applyFilters();
</script>

<style>
  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-8);
    align-items: center;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .page-header-copy { min-width: 0; }
  /* Sized from the wrapper, never from the component — a class on a component
     root does not carry this page's scope. */
  .page-header-art { width: 260px; }
  /* Room under the separator band before the controls. */
  .filter-row { padding-top: var(--space-6); }

  .page-desc { opacity: 0.8; max-width: 60ch; margin: 0; }
  .results { padding-bottom: var(--space-8); }
  .project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .card-year { font-family: var(--font-mono); font-size: 12px; color: var(--color-text-muted); }
  .card-title a { color: inherit; text-decoration: none; }
  .card-title a:hover,
  .card-title a:focus-visible { color: var(--color-accent); }
  .card-stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .card-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-1); }
  .hidden { display: none; }

  /* A card that filters back in re-enters with a short rise — the same
     grammar as the page reveal (opacity + translate), at interaction speed
     rather than arrival speed, staggered by `--enter-delay` from script.
     Keyframe on the `translate` channel, so it never argues with the hover
     lift living on `transform`. Reduced motion gets the plain reappear. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes card-enter {
      from {
        opacity: 0;
        translate: 0 8px;
      }
    }
    .project-card.is-entering {
      animation: card-enter var(--dur-base) var(--ease-out) backwards;
      animation-delay: var(--enter-delay, 0ms);
    }

    @keyframes empty-in {
      from { opacity: 0; }
    }
    .empty-state:not(.hidden) { animation: empty-in var(--dur-base) var(--ease-out) backwards; }
  }

  @media (max-width: 900px) {
    .project-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .project-grid { grid-template-columns: 1fr; }
    .page-header { grid-template-columns: 1fr; gap: var(--space-4); }
    .page-header-art { width: 200px; }
  }
</style>
