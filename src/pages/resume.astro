---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/content';
import { getResume, resolveVariant } from '../lib/resume';
import { renderSheet } from '../lib/resume-render';

/* The resume is a row in `documents` now, not a module, so this page reads it
   per request like every other content route — editing it in the admin changes
   this page immediately rather than at the next deploy. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const resume = await getResume(DB);
/* Only the variants that name projects need these, but reading them
   unconditionally is one query against a table this page would otherwise be
   the only route not to touch — and `resolveVariant` drops the hidden ones. */
const projects = await getProjects(DB);

/* Whichever variant the author marked public, or the whole master if none is.
   The page never chooses: which resume strangers see is an editorial decision
   and it is stored, not derived. */
const sheet = resolveVariant(resume, resume.publicVariant, projects);
const html = renderSheet(sheet);
---
<BaseLayout
  title="Resume"
  description={`Resume — ${sheet.person.name}, ${sheet.person.role}.`}
>
  {/* An eyebrow, not a heading. The sheet's own `<h1>` is the person's name,
      which is what this document is called — a second `<h1>` reading "Resume"
      above it was both a duplicate landmark and a line repeating the three
      facts printed underneath it. */}
  <header class="container container-resume resume-header no-print">
    <p class="resume-eyebrow">Resume</p>
    <div class="resume-actions">
      <button type="button" class="btn btn-secondary" id="resume-share">Share</button>
      <button type="button" class="btn btn-primary" id="resume-export">Download PDF</button>
    </div>
  </header>

  {/* The same string the admin preview assigns to `innerHTML` and the same one
      that prints. `set:html` rather than a component tree because there is one
      renderer — see the header of `src/lib/resume-render.ts`; everything in it
      is escaped at every interpolation. */}
  <div class="container container-resume resume-sheet" set:html={html} />
</BaseLayout>

<script>
  import { copyText } from '../lib/clipboard';

  const shareBtn = document.getElementById('resume-share');
  const exportBtn = document.getElementById('resume-export');

  /* The browser's own print dialogue, which saves a PDF on every platform.
     Nothing renders a PDF server-side: that is a headless browser in the
     request path for a document one person downloads a few times a month, and
     the print stylesheet has to be right either way. */
  exportBtn?.addEventListener('click', () => window.print());

  shareBtn?.addEventListener('click', async () => {
    const copied = await copyText(window.location.href);
    shareBtn.textContent = copied ? 'Copied!' : 'Copy failed';
    setTimeout(() => { shareBtn.textContent = 'Share'; }, 1500);
  });
</script>

<style>
  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
  }
  .resume-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .resume-actions { display: flex; gap: var(--space-2); }

  .resume-sheet { padding-bottom: var(--space-8); }
</style>

<style is:global>
  /* The sheet itself is styled by `src/styles/resume.css`, which every surface
     that renders it shares. What is left here is the page *around* it. */
  @media print {
    .no-print,
    .nav,
    .site-footer { display: none !important; }

    /* The white page ground is in `theme.css`'s print block, not here — the
       admin renders this same sheet and a rule scoped to this route never
       reached it. */

    .container,
    .container-resume { max-width: 100%; padding-left: 0; padding-right: 0; }

    .resume-sheet { padding-bottom: 0; }
  }
</style>
