---
import PageLayout from '../layouts/PageLayout.astro';
import ResumeAside from '../components/ResumeAside.astro';

const person = {
  name: 'Anish Giri',
  role: 'Software Engineer',
  location: 'Bengaluru, Karnataka, India',
  address: 'Nanjappa Layout, Adugodi, Bengaluru, Karnataka, 560030',
  email: 'anishgiri163@gmail.com',
  phone: '6294957979',
  linkedin: 'https://www.linkedin.com/in/anish-giri-a4031723a',
  summary:
    "As a curious, skeptical, and agnostic carbon-based bipedal, I thrive on delving into the depths of knowledge and discovering the world's treasures. With a strong interest in technology, I find peace in the Linux environment and enjoy deciphering its complexities. As an AI, ML, and Data Science enthusiast, I am eager to realize these areas' full potential and leverage their transformative impact. With an unshakable passion for coding, I am always looking for new ways to broaden my programming language vocabulary. My unquenchable curiosity drives my ambition to explore the fields of AI, ML, and Data Science, where I hope to make a significant contribution.",
};

const experience = [
  {
    title: 'Software Engineer',
    company: 'Axcend Automation and Software Solutions pvt.Ltd',
    dates: 'July 2024 - Present (1 year 10 months)',
    location: 'Bengaluru, Karnataka, India',
    description:
      'As a Trainee Engineer at Axcend Automation and Software Solutions, I am responsible for developing and maintaining software for industrial automation projects. My role involves working with network protocols to ensure seamless communication between devices and systems. I collaborate on designing and managing control systems and SCADA systems, gaining hands-on experience with PLCs, HMIs, and other automation components. Additionally, I integrate hardware and software components to ensure efficient and reliable operation.',
  },
  {
    title: 'Subject Matter Expert',
    company: 'Chegg India',
    dates: 'June 2023 - September 2024 (1 year 4 months)',
    location: '',
    description: '',
  },
  {
    title: 'Intern',
    company: 'Axcend Automation and Software Solutions pvt.Ltd',
    dates: 'January 2024 - May 2024 (5 months)',
    location: 'Bengaluru, Karnataka, India',
    description: '',
  },
];

const skills = [
  { category: 'Top Skills', items: ['Next.js', 'React.js', 'TypeScript'] },
  { category: 'ML / CV', items: ['PyTorch', 'TensorFlow', 'OpenCV', 'scikit-learn', 'YOLO'] },
  { category: 'Languages', items: ['Python', 'TypeScript', 'Go', 'Rust', 'SQL'] },
  { category: 'Web', items: ['Astro', 'React', 'FastAPI', 'Node.js', 'Tailwind'] },
  { category: 'Data', items: ['PostgreSQL', 'Redis', 'Apache Kafka', 'DuckDB'] },
  { category: 'Infra', items: ['Docker', 'GitHub Actions', 'Cloudflare', 'Vercel'] },
];

const certifications = [
  'Artificial Intelligence Fundamentals',
  'Problem Solving (Basic)',
  'SQL (Intermediate)',
  'Data Fundamentals',
  'SQL (Basic)',
];

const education = [
  {
    school: 'Pondicherry University, Puducherry',
    degree: "Master's degree, Computer Science",
    dates: 'December 2022 - July 2024',
  },
];
---
<PageLayout title="Resume" description="Resume — Anish Giri, ML/CV Engineer and full-stack developer.">
  <header class="container container-resume resume-header no-print">
    <div>
      <h1 class="resume-title">Resume</h1>
      <p class="text-muted resume-note">{person.name} — {person.role}, {person.location}</p>
    </div>
    <div class="resume-actions">
      <button type="button" class="btn btn-secondary" id="resume-share">Share</button>
      <button type="button" class="btn btn-primary" id="resume-export">Export PDF</button>
    </div>
  </header>

  <div class="container container-resume resume-grid">
    <ResumeAside person={person} skills={skills} certifications={certifications} education={education} />

    <main class="resume-main">
      <section class="resume-section">
        <h6 class="section-heading">Summary</h6>
        <p class="summary-copy">{person.summary}</p>
      </section>

      <section>
        <h6 class="section-heading experience-heading">Experience</h6>
        {experience.map(item => (
          <div class="experience-item">
            <div class="experience-top">
              <h4 class="experience-title">{item.title}</h4>
              <span class="text-muted experience-dates">{item.dates}</span>
            </div>
            <p class="experience-company">{item.company}</p>
            {item.location && <p class="text-muted experience-location">{item.location}</p>}
            {item.description && <p class="experience-description">{item.description}</p>}
          </div>
        ))}
      </section>
    </main>
  </div>
</PageLayout>

<script>
  const shareBtn = document.getElementById('resume-share');
  const exportBtn = document.getElementById('resume-export');

  exportBtn?.addEventListener('click', () => window.print());

  shareBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard?.writeText(window.location.href);
      shareBtn.textContent = 'Copied!';
    } catch {
      shareBtn.textContent = 'Copy failed';
    }
    setTimeout(() => { shareBtn.textContent = 'Share'; }, 1500);
  });
</script>

<style>
  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
  }
  .resume-title { margin-bottom: 2px; }
  .resume-note { font-size: 13px; margin: 0; }
  .resume-actions { display: flex; gap: var(--space-2); }

  .resume-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .resume-main { min-width: 0; }
  .resume-section { margin-bottom: var(--space-6); }
  .section-heading { color: var(--color-accent-700); margin-bottom: var(--space-2); }
  .experience-heading { margin-bottom: var(--space-3); }
  .summary-copy { font-size: 14px; line-height: 1.7; opacity: 0.85; margin: 0; }

  .experience-item {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-divider);
  }
  .experience-item:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .experience-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
  }
  .experience-title { margin: 0; }
  .experience-dates { font-size: 12px; }
  .experience-company { font-size: 13px; font-weight: 600; color: var(--color-accent-700); margin: 2px 0 6px; }
  .experience-location { font-size: 12px; margin: 0 0 6px; }
  .experience-description { font-size: 13px; line-height: 1.65; opacity: 0.85; margin: 0; }

  @media (max-width: 720px) {
    .resume-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>

<style is:global>
  @media print {
    .no-print,
    .nav,
    .site-footer { display: none !important; }

    body { background: #fff; }

    .container,
    .container-resume { max-width: 100%; padding-left: 0; padding-right: 0; }

    .resume-grid { padding-bottom: 0; }

    .experience-item { break-inside: avoid; }

    @page { size: letter; margin: 0.6in; }
  }
</style>
