---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeAside from '../components/ResumeAside.astro';
import { person, experience, skills, certifications, education } from '../lib/resume';
---
<BaseLayout title="Resume" description={`Resume — ${person.name}, ML/CV Engineer and full-stack developer.`}>
  <header class="container container-resume resume-header no-print">
    <div>
      <h1 class="resume-title">Resume</h1>
      <p class="text-muted resume-note">{person.name} — {person.role}, {person.location}</p>
    </div>
    <div class="resume-actions">
      <button type="button" class="btn btn-secondary" id="resume-share">Share</button>
      <button type="button" class="btn btn-primary" id="resume-export">Export PDF</button>
    </div>
  </header>

  <div class="container container-resume resume-grid">
    <ResumeAside person={person} skills={skills} certifications={certifications} education={education} />

    <main class="resume-main">
      <section class="resume-section">
        <h6 class="section-heading">Summary</h6>
        <p class="summary-copy">{person.summary}</p>
      </section>

      <section>
        <h6 class="section-heading experience-heading">Experience</h6>
        {experience.map(item => (
          <div class="experience-item">
            <div class="experience-top">
              <h4 class="experience-title">{item.title}</h4>
              <span class="text-muted experience-dates">{item.dates}</span>
            </div>
            <p class="experience-company">{item.company}</p>
            {item.location && <p class="text-muted experience-location">{item.location}</p>}
            {item.description && <p class="experience-description">{item.description}</p>}
          </div>
        ))}
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  const shareBtn = document.getElementById('resume-share');
  const exportBtn = document.getElementById('resume-export');

  exportBtn?.addEventListener('click', () => window.print());

  // navigator.clipboard needs a focused document and a secure context; fall
  // back to a selection copy so the button still works where it doesn't.
  function legacyCopy(text: string) {
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.appendChild(field);
    field.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(field);
    return ok;
  }

  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    let copied = false;
    try {
      await navigator.clipboard.writeText(url);
      copied = true;
    } catch {
      copied = legacyCopy(url);
    }
    shareBtn.textContent = copied ? 'Copied!' : 'Copy failed';
    setTimeout(() => { shareBtn.textContent = 'Share'; }, 1500);
  });
</script>

<style>
  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
  }
  .resume-title { margin-bottom: 2px; }
  .resume-note { font-size: 13px; margin: 0; }
  .resume-actions { display: flex; gap: var(--space-2); }

  .resume-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .resume-main { min-width: 0; }
  .resume-section { margin-bottom: var(--space-6); }
  .section-heading { color: var(--color-accent-700); margin-bottom: var(--space-2); }
  .experience-heading { margin-bottom: var(--space-3); }
  .summary-copy { font-size: 14px; line-height: 1.7; opacity: 0.85; margin: 0; }

  .experience-item {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-divider);
  }
  .experience-item:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .experience-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
  }
  .experience-title { margin: 0; }
  .experience-dates { font-size: 12px; }
  .experience-company { font-size: 13px; font-weight: 600; color: var(--color-accent-700); margin: 2px 0 6px; }
  .experience-location { font-size: 12px; margin: 0 0 6px; }
  .experience-description { font-size: 13px; line-height: 1.65; opacity: 0.85; margin: 0; }

  @media (max-width: 720px) {
    .resume-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>

<style is:global>
  @media print {
    .no-print,
    .nav,
    .site-footer { display: none !important; }

    body { background: #fff; }

    .container,
    .container-resume { max-width: 100%; padding-left: 0; padding-right: 0; }

    .resume-grid { padding-bottom: 0; }

    .experience-item { break-inside: avoid; }

    @page { size: letter; margin: 0.6in; }
  }
</style>
