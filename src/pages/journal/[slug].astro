---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PathLine from '../../components/PathLine.astro';
import { getPost } from '../../lib/content';
import { formatTag, metaLine } from '../../lib/format';
import { absoluteUrl, site } from '../../lib/site';

/* Read from D1 per request. A post moved to `unpublished` stops resolving
   here the moment it is saved, so its URL 404s instead of lingering as an
   orphan page for anyone still holding the link. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const post = Astro.params.slug ? await getPost(DB, Astro.params.slug) : undefined;
if (!post) return new Response(null, { status: 404 });

const { title, summary, tags, videoDuration, heroImage } = post.data;

const meta = metaLine(post.data);
const shareUrl = absoluteUrl(Astro.url.pathname, Astro.site ?? site.url);
---
<BaseLayout title={title} description={summary}>
  {/* The full container, and the write-up in a 4fr/8fr split — the same shape
      and therefore the same measure as `CaseStudyLayout`. It used to be
      `container-prose`, which is a 720px page rather than a 720px column: the
      hero, the title and the footer were all squeezed into it, and the two
      long-form pages on this site read at visibly different widths. */}
  <article class="container journal-post">
    <a class="btn btn-ghost back-link" href="/journal">← Back to Journal</a>

    <header class="post-head">
      {heroImage && (
        <div class="post-figure">
          <div class="grayscale"><img src={heroImage} alt={title} /></div>
          {videoDuration && <span class="tag tag-neutral post-duration">{videoDuration}</span>}
        </div>
      )}

      <PathLine path={`journal/${post.slug}`} cmd="less post.md" />
      <div class="tag-row">
        {tags.map((tag, i) => (
          <span class={`tag ${i % 2 === 0 ? 'tag-accent' : 'tag-accent-2'}`}>{formatTag(tag)}</span>
        ))}
      </div>

      <h1 class="post-title">{title}</h1>
      <p class="text-muted post-meta">{meta}</p>
      <p class="post-summary">{summary}</p>
    </header>
    <hr class="rule post-head-rule" />

    <div class="prose post-prose"><Fragment set:html={post.html} /></div>

    <hr class="rule post-footer-rule" />
    <div class="post-footer">
      <span class="text-muted share-label">Share this post</span>
      <div class="share-actions">
        <button type="button" class="btn btn-secondary" id="copy-link" data-url={shareUrl}>Copy link</button>
        <a
          class="btn btn-secondary"
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener"
        >Share on LinkedIn</a>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { copyText } from '../../lib/clipboard';

  const btn = document.getElementById('copy-link') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    const copied = await copyText(btn.dataset.url || window.location.href);
    btn.textContent = copied ? 'Copied!' : 'Copy failed';
    setTimeout(() => { btn.textContent = 'Copy link'; }, 1500);
  });
</script>

<style>
  .journal-post { padding-top: var(--space-6); padding-bottom: var(--space-8); }
  .back-link { padding-inline: 0; margin-bottom: var(--space-3); }

  /* Hero, tags, title and lead as one cover block over the full width, closed
     with a rule — a case study's `.cs-head` by another name. */
  .post-head { margin-bottom: var(--space-4); }
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-3); }
  .post-title { margin-bottom: var(--space-2); }
  .post-meta { font-size: 13px; margin-bottom: var(--space-3); }
  .post-head-rule { margin-bottom: var(--space-8); }

  .post-figure { position: relative; margin-bottom: var(--space-4); }
  .post-figure img { width: 100%; height: 360px; object-fit: cover; }
  .post-duration { position: absolute; bottom: 12px; left: 12px; font-family: var(--font-mono); }

  /* Capped rather than full-bleed: the block above runs to 1120px and a lead
     paragraph set across all of it is 130 characters a line. */
  .post-summary { font-size: 18px; line-height: 1.6; opacity: 0.85; max-width: 62ch; margin: 0; }

  /* Capped for a readable line length, but left-aligned with the title and
     hero above it. This used to follow `CaseStudyLayout`'s 4fr/8fr split with
     an empty left cell — which makes sense there, where other sections put
     real content in that column, but a journal post never does. The empty
     column just shifted the body a third of the way across the page while the
     title, hero and tags above it stayed flush left, so the post visibly
     stopped lining up with itself partway down.

     It then sat at `--wrap-prose` (720px) inside the 1120px container, which
     read as a narrow strip under a full-width cover block. Posts are code-heavy,
     so the body takes `--wrap-mid` (900px): wide enough that fenced blocks stop
     clipping, still short of a 100-character line. */
  .post-prose { max-width: var(--wrap-mid); }

  /* Code and tables are the reason the column is wider than prose measure:
     let both use all of it rather than wrapping inside an already-wide box. */
  .post-prose pre { overflow-x: auto; }

  .post-footer-rule { margin-top: var(--space-8); }
  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-4);
  }
  .share-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
  .share-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  @media (max-width: 640px) {
    .post-figure img { height: 220px; }
  }
</style>
