---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Illustration from '../../components/Illustration.astro';
import PathLine from '../../components/PathLine.astro';
import SectionSep from '../../components/SectionSep.astro';
import { getPosts } from '../../lib/content';
import { formatShortDate, formatTag, metaLine } from '../../lib/format';

/* Reads content from D1 per request — see the note in `src/lib/content.ts`.
   Prerendering this page would freeze the listing at deploy time, which is the
   whole thing the database was introduced to stop. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const posts = await getPosts(DB);
const [featured, ...archive] = posts;
---
<BaseLayout title="Journal" description="Field notes from building things — write-ups and the occasional video log.">
  <header class="container page-header" data-reveal>
    <div>
      <PathLine path="journal" cmd={`tail -n ${posts.length} notes.log`} />
      <h1>Journal</h1>
      <p class="page-desc">Field notes from building things — write-ups and the occasional video log.</p>
    </div>
    <div class="page-header-art"><Illustration name="blogging" /></div>
  </header>

  <SectionSep />

  {featured && (
    <section class="container featured-section" data-reveal>
      <a href={`/journal/${featured.slug}`} class="card elev-md featured-card">
        {featured.data.heroImage && (
          <div class="post-media featured-media">
            <div class="grayscale media-frame"><img src={featured.data.heroImage} alt={featured.data.title} /></div>
            {featured.data.videoDuration && <span class="tag tag-neutral media-duration">{featured.data.videoDuration}</span>}
          </div>
        )}
        <div class="tag-row">
          {featured.data.tags.slice(0, 3).map((tag, i) => (
            <span class={`tag ${i % 2 === 0 ? 'tag-accent' : 'tag-accent-2'}`}>{formatTag(tag)}</span>
          ))}
        </div>
        <h2 class="card-title featured-title">{featured.data.title}</h2>
        <p class="card-body">{featured.data.summary}</p>
        <div class="card-meta">{metaLine(featured.data)}</div>
      </a>
    </section>
  )}

  {archive.length > 0 && (
    <section class="container archive-section" data-reveal>
      <div class="section-head-rule archive-head">
        <p class="eyebrow">Archive</p>
        <hr class="rule" />
      </div>
      <div class="archive-grid">
        {archive.map(post => (
          <a href={`/journal/${post.slug}`} class="card elev-sm archive-card">
            {post.data.heroImage && (
              <div class="post-media">
                <div class="grayscale media-frame"><img src={post.data.heroImage} alt={post.data.title} loading="lazy" /></div>
                {(post.data.videoDuration ?? post.data.readTime) && (
                  <span class="tag tag-neutral media-duration">{post.data.videoDuration ?? post.data.readTime}</span>
                )}
              </div>
            )}
            <span class="text-muted archive-date">{formatShortDate(post.data.date)}</span>
            <h3 class="card-title archive-title">{post.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <section class="container archive-section" data-reveal>
      {/* An empty state teaches the space: what belongs here, and what fills
          it — not just the fact that it is empty. `data-reveal` puts it on
          the page's own arrival choreography instead of a private fade, so
          it lands with everything else on the page. */}
      <div class="empty-state">
        <div class="empty-state-art"><Illustration name="no-data" /></div>
        <p class="empty-state-copy">Nothing published yet.</p>
        <p class="empty-state-hint">Field notes land here as they are written. The projects page has the work that exists today.</p>
        <a class="btn btn-secondary" href="/projects">Browse projects</a>
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .page-header {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: var(--space-6);
    align-items: center;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .page-desc { opacity: 0.8; max-width: 56ch; margin: 0; }

  /* Whichever listing is first under the separator band pads the top — the
     archive is, when there is no featured post. `:global` because the band is
     another component's element and carries no scope hash of this page. */
  .featured-section { padding-bottom: var(--space-6); }
  :global(.section-sep) + .featured-section,
  :global(.section-sep) + .archive-section { padding-top: var(--space-6); }
  .featured-card { gap: var(--space-3); text-decoration: none; color: inherit; }
  .featured-card:hover,
  .featured-card:focus-visible { color: inherit; }
  .featured-card:hover .featured-title,
  .featured-card:focus-visible .featured-title { color: var(--color-accent); }
  .featured-title { font-size: 26px; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; }

  /* Thumbnail block: 16:9 frame, duration stamped in the corner. Photographs
     are black and white until the card is hovered — the same reveal the
     mockup uses to mark which entry you are pointing at. */
  .post-media { position: relative; }
  .media-frame { aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-neutral-200); }
  .media-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .media-duration { position: absolute; bottom: 8px; right: 8px; font-family: var(--font-mono); }
  .featured-media { margin-bottom: var(--space-2); }

  /* Same parity as ProjectCard: keyboard focus wakes the photograph, the
     pointer reveal only where hover actually exists. */
  @media (hover: hover) {
    a.card:hover .grayscale { filter: none; }
  }
  a.card:focus-within .grayscale { filter: none; }
  @media (prefers-reduced-motion: no-preference) {
    .media-frame img { transition: filter 0.4s ease; }
  }

  .archive-section { padding-bottom: var(--space-8); }

  /* — the empty state —
     Composition comes from the shared `.empty-state` layer; this page adds
     nothing. It only renders when the archive is genuinely empty. */
  .eyebrow { margin: 0; }
  .archive-head { margin-bottom: var(--space-4); }
  .archive-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .archive-card { text-decoration: none; color: inherit; }
  .archive-card:hover,
  .archive-card:focus-visible { color: inherit; }
  .archive-card:hover .archive-title,
  .archive-card:focus-visible .archive-title { color: var(--color-accent); }
  /* Date and title pinned to the bottom of the card, whichever cards the row
     mixes: some posts carry a hero image and some do not, and without this the
     text-only cards float to the top of their cell and the row reads as three
     different layouts instead of one grid. */
  .archive-card { display: flex; flex-direction: column; }
  .archive-date { font-size: 12px; font-family: var(--font-mono); margin-top: auto; padding-top: var(--space-3); }
  .archive-title { font-size: 16px; }

  @media (max-width: 900px) {
    .archive-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .page-header { grid-template-columns: 1fr; gap: var(--space-4); }
    .page-header-art { max-width: 200px; }
    .archive-grid { grid-template-columns: 1fr; }
  }
</style>
