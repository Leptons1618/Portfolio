<script>
  // 1. Horizontal Scroll & Dynamic SVG Line Drawing (with smooth Lerp)
  const storyCanvas = document.getElementById('story-canvas');
  const track = document.getElementById('story-track');
  const path = document.getElementById('story-wire-path') as SVGGeometryElement | null;
  const dot = document.getElementById('story-wire-dot');
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal-at]');

  let targetProgress = 0;
  let currentProgress = 0;
  let isAnimatingScroll = false;
  let pathLen = 0;

  if (path && path.getTotalLength) {
    pathLen = path.getTotalLength();
  }

  function updateScroll() {
    if (!storyCanvas || !track || !path) return;
    const rect = storyCanvas.getBoundingClientRect();
    const maxScroll = storyCanvas.offsetHeight - window.innerHeight;
    if (maxScroll <= 0) return;

    const scrolled = -rect.top;
    targetProgress = Math.max(0, Math.min(1, scrolled / maxScroll));

    if (!isAnimatingScroll) {
      isAnimatingScroll = true;
      requestAnimationFrame(renderScroll);
    }
  }

  function renderScroll() {
    // Smooth interpolation (lerp factor 0.08 for buttery smoothness)
    currentProgress += (targetProgress - currentProgress) * 0.08;

    if (Math.abs(targetProgress - currentProgress) < 0.0005) {
      currentProgress = targetProgress;
      isAnimatingScroll = false;
    } else {
      requestAnimationFrame(renderScroll);
    }

    // Pan horizontal track
    if (track) {
      const maxPan = track.scrollWidth - window.innerWidth;
      track.style.transform = `translate3d(-${currentProgress * maxPan}px, 0, 0)`;
    }

    // Draw active wire
    if (path) {
      path.style.strokeDashoffset = `${1 - currentProgress}`;
    }

    // Move leading photon dot along path
    if (dot && path && pathLen > 0) {
      const pt = path.getPointAtLength(currentProgress * pathLen);
      dot.setAttribute('cx', String(pt.x));
      dot.setAttribute('cy', String(pt.y));
    }

    // Reveal station items smoothly as the line approaches
    revealItems.forEach(item => {
      const at = parseFloat(item.dataset.revealAt || '0');
      // Adding a dynamic fade-up translation based on proximity
      const distance = currentProgress - at;
      if (distance >= -0.04) {
        item.classList.add('is-revealed');
      } else {
        item.classList.remove('is-revealed');
      }
    });
  }

  window.addEventListener('scroll', updateScroll, { passive: true });
  window.addEventListener('resize', updateScroll, { passive: true });
  updateScroll();

  // 2. Category filter for all works
  const buttons = document.querySelectorAll<HTMLButtonElement>('.st-filters [data-cat]');
  const items = document.querySelectorAll<HTMLElement>('.st-filterable');

  buttons.forEach(btn => btn.addEventListener('click', () => {
    const cat = btn.dataset.cat;
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    items.forEach(item => {
      const match = cat === 'all' || item.dataset.cat === cat;
      item.hidden = !match;
      if (match) {
        item.style.animation = 'st-card 0.4s cubic-bezier(0.22, 1, 0.36, 1) both';
      }
    });
  }));

  // 3. Desktop Floating Cursor Tooltip (physics-interpolated)
  const cursorPill = document.querySelector<HTMLElement>('.st-cursor-pill');
  const cursorText = document.querySelector<HTMLElement>('.st-cursor-text');

  if (cursorPill && cursorText && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let mouseX = -100;
    let mouseY = -100;
    let currentX = -100;
    let currentY = -100;
    let isVisible = false;

    window.addEventListener('mousemove', (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      const target = (e.target as HTMLElement)?.closest<HTMLElement>('[data-cursor]');
      if (target && target.dataset.cursor) {
        cursorText.textContent = target.dataset.cursor;
        if (!isVisible) {
          isVisible = true;
          cursorPill.classList.add('is-active');
        }
      } else {
        if (isVisible) {
          isVisible = false;
          cursorPill.classList.remove('is-active');
        }
      }
    });

    const render = () => {
      currentX += (mouseX - currentX) * 0.22;
      currentY += (mouseY - currentY) * 0.22;
      cursorPill.style.transform = `translate3d(${currentX + 14}px, ${currentY + 16}px, 0)`;
      requestAnimationFrame(render);
    };
    requestAnimationFrame(render);
  }
</script>

