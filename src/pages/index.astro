---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Illustration from '../components/Illustration.astro';
import SectionSep from '../components/SectionSep.astro';
import PathLine from '../components/PathLine.astro';
import ContactTerminal from '../components/ContactTerminal.astro';
import { categoryLabel, getDeepDiveProjects, getFeaturedProjects, getProjects } from '../lib/content';
import { site } from '../lib/site';

/* Reads content from D1 per request.
   Prerendering this page would freeze the listing at deploy time. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const allProjects = await getProjects(DB);
const featured = await getFeaturedProjects(DB, 6);
const deepDives = await getDeepDiveProjects(DB);

// Distinct categories present in active projects
const activeCategories = Array.from(new Set(allProjects.map(p => p.data.category)));

const skillSet = new Set<string>();
allProjects.forEach(p => p.data.stack.forEach(s => skillSet.add(s)));

const SKILL_ORDER = ['ML / CV', 'Languages', 'Web', 'Data & Infra', 'Also'];
type SkillGroup = { label: string; items: string[] };
const SKILL_BUCKETS: Record<string, string[]> = {
  'ML / CV': ['pytorch', 'tensorflow', 'opencv', 'scikit', 'yolo', 'transformers', 'onnx', 'ml ', 'machine learning', 'vision'],
  Languages: ['python', 'typescript', 'javascript', 'go', 'rust', 'c++', 'sql', 'java', 'c#'],
  Web: ['react', 'next.js', 'nextjs', 'astro', 'vue', 'svelte', 'tailwind', 'html', 'css', 'fastapi', 'node', 'express', 'vite'],
  'Data & Infra': ['postgres', 'redis', 'kafka', 'duckdb', 'docker', 'kubernetes', 'github actions', 'cloudflare', 'vercel', 'aws', 'gcp', 'linux'],
};
function skillGroupFor(skill: string): string {
  const s = skill.toLowerCase();
  for (const [label, needles] of Object.entries(SKILL_BUCKETS)) {
    if (needles.some(n => s.includes(n))) return label;
    if (s.includes(label.split(' ')[0].toLowerCase())) return label;
  }
  return 'Also';
}
const skillGroups: SkillGroup[] = SKILL_ORDER.map(label => ({
  label,
  items: Array.from(skillSet)
    .filter(s => skillGroupFor(s) === label)
    .sort((a, b) => a.localeCompare(b)),
})).filter(g => g.items.length > 0);

const first = site.name.split(' ')[0].toLowerCase();

/* Curiosity stickers (rabbit holes) with tangible engineering hooks */
const TABS = [
  {
    art: 'code-inspection',
    title: 'code inspection',
    tag: 'kernel · compiler',
    caption: 'reading other people’s code for fun',
    note: 'From CUDA memory allocations to Linux device drivers, I love knowing how things actually run beneath the abstractions.',
  },
  {
    art: 'fixing-bugs',
    title: 'midnight trace',
    tag: 'profiling · race conditions',
    caption: 'chasing the bug past midnight',
    note: 'The best lessons are hidden behind a 2 AM stack trace. If a packet dropped, there is a reason why.',
  },
  {
    art: 'taking-notes',
    title: 'field notes',
    tag: 'telemetry · architecture',
    caption: 'notes on everything',
    note: 'Obsessively documented: pipeline throughput bottlenecks, loss curves, and aha moments.',
  },
  {
    art: 'blogging',
    title: 'writing it down',
    tag: 'daily journal · post-mortems',
    caption: 'writing it down after',
    note: 'If it’s not documented, it didn’t ship. This portfolio keeps its own automated daily journal of real engineering work.',
  },
  {
    art: 'playful-cat',
    title: 'curiosity',
    tag: 'what if? · side projects',
    caption: 'easily distracted',
    note: '“What if we rewrite the ingestion pipeline in Rust?” ...wait, stay focused.',
  },
];

/* Core engineering domains */
const HEART = [
  {
    num: '01',
    title: 'machines that see',
    tag: 'ML / CV',
    body: 'Cameras, bounding boxes, spatial tracking. Estimating vehicle speed from raw CCTV video, parsing restaurant menus from unstructured photos with DBSCAN and Hungarian matching, tracking objects frame to frame with YOLOv8 and DeepSort. Vision is where I started and it still pulls hardest.',
    aside: 'pixels in, meaning out',
  },
  {
    num: '02',
    title: 'data that never stops',
    tag: 'Systems & Edge',
    body: 'Change-data capture, Kafka pipelines, MQTT brokers, PLCs on high-throughput factory lines at Axcend. I like systems where the input does not wait for you to be ready, and where dropped packets mean stalled machines.',
    aside: 'if it streams, I want to tap it',
  },
  {
    num: '03',
    title: 'tools for the person building',
    tag: 'Dev Tools & AI',
    body: 'Evaluation harnesses, local RAG pipelines, developer CLIs, in-browser CAD editors, and this site’s own custom admin & journal. Most of my side projects start as something I wanted for myself.',
    aside: 'half engineer. half “why is this manual?”',
  },
];

/* Timeline milestones */
const TIMELINE = [
  {
    year: '2022',
    what: 'Pondicherry University',
    role: 'M.Sc. Computer Science',
    note: 'Diving deep into algorithms, distributed systems, and starting the first serious side projects.',
  },
  {
    year: '2023',
    what: 'Chegg India',
    role: 'Subject Matter Expert',
    note: 'Explaining complex computer science problems to strangers turns out to be the sharpest way to master them.',
  },
  {
    year: '2023',
    what: 'Vision Systems',
    role: 'Independent Research',
    note: 'Vehicle speed estimation, Menu OCR, and in-browser VisionPlay — the first projects that felt genuinely mine.',
  },
  {
    year: '2024',
    what: 'Axcend Automation',
    role: 'Software Engineer',
    note: 'Industrial automation, SCADA systems, PLCs, network protocols (OPC UA, MQTT, Modbus), and factory telemetry.',
  },
  {
    year: '2024',
    what: 'Local AI & LLMs',
    role: 'Engineering Experiments',
    note: 'LocalRAG, EchoScript, QueryPilot — models running on local silicon, answering real questions without cloud lag.',
  },
  {
    year: 'now',
    what: 'This Site & Systems',
    role: 'Full-Stack Architecture',
    note: 'A database, an admin, a CLI, an assistant and a daily journal. Built the way I like building: all the way down.',
  },
];

/* Continuous Story Thread Path: 6500px wide canvas across 650vw track */
const STORY_THREAD_PATH =
  'M 560 380 ' + // Hero brain knot exit
  'C 750 380, 950 210, 1250 210 ' + // Rabbit holes top curve
  'C 1420 210, 1460 550, 1680 550 ' + // Rabbit holes bottom curve
  'C 1820 550, 1860 270, 2100 270 ' + // Heart/Vision curve
  'C 2300 270, 2400 620, 2680 620 ' + // Project previews entry
  'C 2880 620, 2920 230, 3180 230 ' + // Project previews top
  'C 3380 230, 3450 710, 3750 710 ' + // Links / Blogs bottom
  'C 3950 710, 4050 350, 4320 350 ' + // User Info top
  'C 4550 350, 4650 680, 5000 680 ' + // User Info bottom
  'C 5300 680, 5400 450, 5700 450 ' + // Transmission entry
  'C 5900 450, 6100 500, 6500 500';   // Terminal socket end
---
<BaseLayout title="Home" description={`The anatomy of a curious engineer — ${site.name}'s field notes, systems, and works.`}>
  <div class="st-page">
    {/* Pinned reading progress bar riding inside the header slot */}
    <div slot="header" class="st-progress" aria-hidden="true"></div>

    {/* Floating custom cursor pill for desktop pointers */}
    <div class="st-cursor-pill" aria-hidden="true"><span class="st-cursor-text"></span></div>

    {/* =========================================================================
        1. THE STICKY HORIZONTAL STORY CANVAS (DESKTOP)
        Exactly inspired by somehowliving.tech: a continuous drawn SVG wire that
        unravels across a pinned horizontal track as the visitor scrolls down!
       ========================================================================= */}
    <section id="story-canvas" class="st-canvas-section" aria-label="Anatomy of a curious engineer">
      <div class="st-canvas-sticky">
        <div id="story-track" class="st-canvas-track" style="width: 650vw;">

          {/* Master SVG Thread Line that physically draws on scroll */}
          <svg class="st-master-svg" viewBox="0 0 6500 1000" preserveAspectRatio="none" aria-hidden="true">
            {/* The background guide wire (subtle) */}
            <path class="st-guide-wire" d={STORY_THREAD_PATH} />
            {/* The active drawn wire (animates stroke-dashoffset on scroll) */}
            <path
              id="story-wire-path"
              class="st-active-wire"
              pathLength="1"
              d={STORY_THREAD_PATH}
            />
            {/* The glowing leading photon / dot at the tip of the wire */}
            <circle id="story-wire-dot" class="st-wire-dot" r="8" cx="560" cy="380" />
          </svg>

          {/* ————————— STATION 1: HERO & BRAIN SCHEMATIC (0vw - 100vw) ————————— */}
          <div class="st-station st-station-hero" style="left: 0vw;">
            <div class="st-hero-inner">
              <div class="st-hero-text" data-reveal-at="0">
                <div class="hero-badges">
                  <span class="tag tag-accent-2 hero-status">
                    <span class="status-dot" aria-hidden="true"></span>
                    Open to opportunities · ML/CV, full-stack, systems
                  </span>
                </div>

                <PathLine cmd="whoami" delay={200} />
                <p class="eyebrow" data-fx="scramble" data-fx-delay="700">Software Engineer · {site.name}</p>

                <h1 class="st-display">
                  the<br />
                  anatomy of a<br />
                  <span class="st-mark">
                    <em>curious engineer.</em>
                    <svg class="st-underline" viewBox="0 0 320 24" preserveAspectRatio="none" aria-hidden="true">
                      <path class="st-draw" pathLength="1" d="M4 16 C60 6 120 20 180 12 S280 8 316 16" />
                    </svg>
                  </span>
                </h1>

                <p class="st-lede">
                  Field notes of someone who lives in the terminal, tracks bounding boxes on 25&nbsp;FPS video, decodes industrial PLCs on factory floors — and follows the wire all the way down.
                </p>

                <div class="hero-actions">
                  <a class="btn btn-primary" href="#works" data-cursor="jump to selected work ↓">see the work</a>
                  <a class="btn btn-secondary" href="#contact" data-cursor="say hello ✉️">let's talk</a>
                  <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener" data-cursor="read the code ↗">github</a>
                </div>
              </div>

              {/* Detailed Engineer, Brain & Swirling Knots */}
              <div class="st-tangled-brain" data-reveal-at="0.02" data-cursor="an almost accurate map of what's in my mind :)">
                <div class="schematic-note" style="top: 5%; right: -15%;">
                  <svg class="st-arrow" viewBox="0 0 48 24" aria-hidden="true">
                    <path class="st-draw" pathLength="1" d="M6 14 C18 4 34 4 44 12 M44 12 l-10 -6 M44 12 l-11 3" />
                  </svg>
                  <span>an almost accurate map of my mind</span>
                </div>

                <svg class="st-tangle-svg" viewBox="0 0 600 550" aria-hidden="true" style="overflow: visible;">
                  {/* Laptop & Desk */}
                  <path d="M 60 420 L 140 420 L 140 320 L 60 320 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
                  <path d="M 80 340 L 120 340 M 80 360 L 100 360 M 80 380 L 110 380" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <path d="M 40 440 L 160 440 L 140 420 L 60 420 Z" fill="currentColor" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
                  <path d="M 0 440 L 220 440" stroke="currentColor" stroke-width="4" stroke-linecap="round" />

                  <g class="st-head-group">
                    {/* Face Profile (Facing Left) */}
                    <path d="M 300 120 
                      C 260 120, 230 140, 220 180 
                      C 210 190, 200 195, 180 195 
                      C 170 195, 160 205, 160 215 
                      C 160 230, 180 240, 190 250 
                      C 180 270, 175 285, 190 300
                      C 205 315, 220 330, 210 360
                      C 200 390, 210 410, 240 430
                      C 270 450, 280 480, 280 500" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

                    {/* Back of Head & Shoulders */}
                    <path d="M 300 120 
                      C 380 120, 440 180, 440 280 
                      C 440 360, 400 420, 360 460
                      C 330 490, 330 500, 330 500
                      M 280 500 C 350 500, 400 520, 420 550" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />

                    {/* Typing Arm */}
                    <path d="M 280 500 C 270 470, 240 440, 180 440 C 160 440, 140 445, 120 445" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />

                    {/* The Brain (MDI Icon layered inside) */}
                    <g transform="translate(240, 140) scale(6)" class="st-brain-icon" fill="none" stroke="currentColor" stroke-width="0.4" stroke-linecap="round" stroke-linejoin="round" opacity="0.3">
                      <path d="M21.33 12.91c.09 1.55-.62 3.04-1.89 3.95l.77 1.49c.23.45.26.98.06 1.45c-.19.47-.58.84-1.06 1l-.79.25a1.69 1.69 0 0 1-1.86-.55L14.44 18c-.89-.15-1.73-.53-2.44-1.1c-.5.15-1 .23-1.5.23c-.88 0-1.76-.27-2.5-.79c-.53.16-1.07.23-1.62.22c-.79.01-1.57-.15-2.3-.45a4.1 4.1 0 0 1-2.43-3.61c-.08-.72.04-1.45.35-2.11c-.29-.75-.32-1.57-.07-2.33C2.3 7.11 3 6.32 3.87 5.82c.58-1.69 2.21-2.82 4-2.7c1.6-1.5 4.05-1.66 5.83-.37c.42-.11.86-.17 1.3-.17c1.36-.03 2.65.57 3.5 1.64c2.04.53 3.5 2.35 3.58 4.47c.05 1.11-.25 2.2-.86 3.13c.07.36.11.72.11 1.09m-5-1.41c.57.07 1.02.5 1.02 1.07a1 1 0 0 1-1 1h-.63c-.32.9-.88 1.69-1.62 2.29c.25.09.51.14.77.21c5.13-.07 4.53-3.2 4.53-3.25a2.59 2.59 0 0 0-2.69-2.49a1 1 0 0 1-1-1a1 1 0 0 1 1-1c1.23.03 2.41.49 3.33 1.3c.05-.29.08-.59.08-.89c-.06-1.24-.62-2.32-2.87-2.53c-1.25-2.96-4.4-1.32-4.4-.4c-.03.23.21.72.25.75a1 1 0 0 1 1 1c0 .55-.45 1-1 1c-.53-.02-1.03-.22-1.43-.56c-.48.31-1.03.5-1.6.56c-.57.05-1.04-.35-1.07-.9a.97.97 0 0 1 .88-1.1c.16-.02.94-.14.94-.77c0-.66.25-1.29.68-1.79c-.92-.25-1.91.08-2.91 1.29C6.75 5 6 5.25 5.45 7.2C4.5 7.67 4 8 3.78 9c1.08-.22 2.19-.13 3.22.25c.5.19.78.75.59 1.29c-.19.52-.77.78-1.29.59c-.73-.32-1.55-.34-2.3-.06c-.32.27-.32.83-.32 1.27c0 .74.37 1.43 1 1.83c.53.27 1.12.41 1.71.4q-.225-.39-.39-.81a1.038 1.038 0 0 1 1.96-.68c.4 1.14 1.42 1.92 2.62 2.05c1.37-.07 2.59-.88 3.19-2.13c.23-1.38 1.34-1.5 2.56-1.5" />
                      <path d="M18.33 11.5l-.62-1.3l-.71.16l1 1.25zm-4.65-8.61a1 1 0 0 0-.91-1.03c-.71-.04-1.4.2-1.93.67c-.57.58-.87 1.38-.84 2.19a1 1 0 0 0 1 1c.57 0 1-.45 1-1c0-.27.07-.54.23-.76c.12-.1.27-.15.43-.15c.55.03 1.02-.38 1.02-.92" />
                    </g>

                    {/* Animated Knot/Swirl Unraveling */}
                    <path class="st-brain-knot" d="
                      M 312 222
                      C 280 180, 240 240, 290 280
                      C 340 320, 390 290, 390 240
                      C 390 190, 340 140, 280 180
                      C 220 220, 230 290, 270 330
                      C 310 370, 400 360, 420 310
                      C 440 260, 460 290, 460 330
                      C 460 360, 500 380, 560 380
                    " fill="none" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round" />
                    
                    <circle cx="312" cy="222" r="6" fill="var(--color-accent)" />
                  </g>
                </svg>
              </div>
            </div>
          </div>

          {/* ————————— STATION 2: RABBIT HOLES & CLIMBER (105vw - 215vw) ————————— */}
          <div class="st-station" style="left: 105vw; width: 105vw;">
            <div class="st-placed-sticker st-station-heading" style="left: 4vw; top: 22vh; width: 340px;" data-reveal-at="0.16">
              <p class="st-kicker">curiosity · rabbit holes</p>
              <h2 class="st-statement">a jack of all trades.</h2>
              <p class="st-sub">what a cool way to say i fall down rabbit holes.</p>
            </div>

            {/* Sticker 1: Code inspection */}
            <div class="st-placed-sticker" style="left: 30vw; top: 12vh; width: 280px;" data-reveal-at="0.18">
              <div class="st-sticker-card card elev-sm" data-cursor="rabbit hole: code inspection 🔍">
                <div class="st-sticker-art"><Illustration name={TABS[0].art} /></div>
                <strong>{TABS[0].caption}</strong>
                <p class="mono-dim">{TABS[0].tag}</p>
                <div class="st-bubble-note"><p>{TABS[0].note}</p></div>
              </div>
            </div>

            {/* Sticker 2: Midnight bugs */}
            <div class="st-placed-sticker" style="left: 54vw; top: 54vh; width: 280px;" data-reveal-at="0.24">
              <div class="st-sticker-card card elev-sm" data-cursor="rabbit hole: 2 AM race condition 🐛">
                <div class="st-sticker-art"><Illustration name={TABS[1].art} /></div>
                <strong>{TABS[1].caption}</strong>
                <p class="mono-dim">{TABS[1].tag}</p>
                <div class="st-bubble-note"><p>{TABS[1].note}</p></div>
              </div>
            </div>

            {/* Sticker 3: The Climber hanging from the wire */}
            <div class="st-placed-sticker st-climber-hang" style="left: 78vw; top: 26vh;" data-reveal-at="0.28" data-cursor="hanging on! tracing every packet :)">
              <div class="st-rope-line" aria-hidden="true"></div>
              <div class="st-climber-figure">
                <svg class="st-climber-svg" viewBox="0 0 80 120" aria-hidden="true">
                  <circle cx="40" cy="10" r="5" fill="var(--color-accent)" />
                  <path d="M40 10 L44 32" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                  <circle cx="46" cy="38" r="9" fill="currentColor" />
                  <path d="M46 47 L48 78" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
                  <path d="M46 54 L62 48 L68 38" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M48 78 L38 98 L30 110" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M48 78 L58 96 L68 104" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <span class="st-tag-caption">the engineer, hanging from the wire</span>
            </div>
          </div>

          {/* ————————— STATION 3: WHAT HAS MY HEART & OWNERSHIP (215vw - 325vw) ————————— */}
          <div class="st-station" style="left: 215vw; width: 110vw;">
            <div class="st-placed-sticker st-station-heading" style="left: 4vw; top: 22vh; width: 320px;" data-reveal-at="0.36">
              <p class="st-kicker">craft · obsessions</p>
              <h2 class="st-statement">but few things<br /><em>have my heart.</em></h2>
            </div>

            {/* Heart 01: Vision */}
            <div class="st-placed-sticker" style="left: 28vw; top: 12vh; width: 320px;" data-reveal-at="0.38">
              <article class="card elev-sm st-heart-box" data-cursor="ML & Vision: pixels in, meaning out">
                <span class="tag tag-accent-2">01 · ML / CV</span>
                <h3>{HEART[0].title}</h3>
                <p>{HEART[0].body}</p>
                <span class="st-aside"><em>{HEART[0].aside}</em></span>
              </article>
            </div>

            {/* Heart 02: Streaming */}
            <div class="st-placed-sticker" style="left: 52vw; top: 54vh; width: 320px;" data-reveal-at="0.45">
              <article class="card elev-sm st-heart-box" data-cursor="Kafka & PLCs: if it streams, I want to tap it">
                <span class="tag tag-neutral">02 · Systems &amp; Edge</span>
                <h3>{HEART[1].title}</h3>
                <p>{HEART[1].body}</p>
                <span class="st-aside"><em>{HEART[1].aside}</em></span>
              </article>
            </div>

            {/* Heart 03: Dev Tools */}
            <div class="st-placed-sticker" style="left: 74vw; top: 12vh; width: 320px;" data-reveal-at="0.52">
              <article class="card elev-sm st-heart-box" data-cursor="Dev Tools: why is this manual?">
                <span class="tag tag-neutral">03 · Dev Tools</span>
                <h3>{HEART[2].title}</h3>
                <p>{HEART[2].body}</p>
                <span class="st-aside"><em>{HEART[2].aside}</em></span>
              </article>
            </div>

            {/* Ownership Callout */}
            <div class="st-placed-sticker" style="left: 80vw; top: 58vh; width: 360px;" data-reveal-at="0.58">
              <div class="card elev-sm st-ownership-box">
                <p class="st-statement-sm">somehow, <span class="st-dim">i keep ending up...</span><br /><em>taking ownership.</em></p>
                <p class="st-quote">“Most things I got curious about, I ended up building. Most things I built, I ended up looking after.”</p>
              </div>
            </div>
          </div>

          {/* ————————— STATION 4: THE LOOP & THE JOURNEY (330vw - 435vw) ————————— */}
          {/* ————————— STATION 4: PROJECT PREVIEWS (330vw - 420vw) ————————— */}
          <div class="st-station" style="left: 330vw; width: 90vw;">
            <div class="st-placed-sticker" style="left: 4vw; top: 62vh; width: 340px;" data-reveal-at="0.55">
              <div class="st-station-title-box">
                <p class="st-kicker">the cycle</p>
                <h2 class="st-statement-sm">i like to build things<br /><span class="st-dim">all the way down.</span></h2>
                <p>from kernel tuning to frontend styling, here are a few things I've built recently.</p>
              </div>
            </div>

            <div class="st-placed-sticker" style="left: 30vw; top: 55vh; width: 340px;" data-reveal-at="0.58">
              <a href="/projects" class="card elev-sm st-preview-card" data-cursor="view project: VisionPlay">
                <span class="tag tag-accent-2">Recent Build</span>
                <h3>VisionPlay</h3>
                <p>In-browser CV editor using WebAssembly and OpenCV.</p>
              </a>
            </div>

            <div class="st-placed-sticker" style="left: 56vw; top: 48vh; width: 340px;" data-reveal-at="0.61">
              <a href="/projects" class="card elev-sm st-preview-card" data-cursor="view project: LocalRAG">
                <span class="tag tag-neutral">LLM Engineering</span>
                <h3>LocalRAG</h3>
                <p>Private document querying entirely on local silicon.</p>
              </a>
            </div>
          </div>

          {/* ————————— STATION 5: LOGS & MORE PROJECTS (430vw - 510vw) ————————— */}
          <div class="st-station" style="left: 430vw; width: 80vw;">
            <div class="st-placed-sticker" style="left: 6vw; top: 22vh; width: 360px;" data-reveal-at="0.68">
              <p class="st-kicker">transmissions & logs</p>
              <h2 class="st-statement-sm">i write things down.</h2>
              <p>Mostly personal blogs, engineering field notes, and architecture diagrams for things that break.</p>
              <div class="st-action-row" style="margin-top: 2rem;">
                <a class="btn btn-secondary" href="/blog" data-cursor="read the journal 📓">read the logs →</a>
                <a class="btn btn-ghost" href="/projects" data-cursor="all repositories 📂">more projects →</a>
              </div>
            </div>
            
            <div class="st-placed-sticker" style="left: 45vw; top: 12vh; width: 280px;" data-reveal-at="0.72">
               <div class="card elev-sm st-heart-box" data-cursor="latest log">
                  <span class="tag tag-accent-2">Latest Log</span>
                  <h3>Why I built this site</h3>
                  <p>A deep dive into abandoning heavy frameworks for vanilla DOM physics.</p>
               </div>
