---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { categoryLabel, getDeepDiveCaseStudies, getFeaturedProjects, getProjects } from '../lib/content';
import { site } from '../lib/site';

/* Reads content from D1 per request — see the note in `src/lib/content.ts`.
   Prerendering this page would freeze the listing at deploy time, which is the
   whole thing the database was introduced to stop. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const allProjects = await getProjects(DB);
const featured = await getFeaturedProjects(DB, 6);
/* The line-up is the author's call, not `date DESC`'s — the admin picks and
   orders these, and an empty or absent pick falls back to newest first. */
const caseStudies = await getDeepDiveCaseStudies(DB);

/* Case studies carry neither category nor year — both come from the project
   that links to the study, the same way the case-study page's eyebrow does. */
const linkedProject = new Map(
  allProjects.filter(p => p.data.caseStudySlug).map(p => [p.data.caseStudySlug!, p])
);

const skillSet = new Set<string>();
allProjects.forEach(p => p.data.stack.forEach(s => skillSet.add(s)));

/* The skills section is a wall of ~70 chips when it is one alphabetical
   run — no order a visitor can hold onto. Grouping by discipline gives the
   wall a reading path: scan the labels, land on your stack. Membership is
   derived from the projects themselves; anything unmatched falls into
   "Also" rather than being dropped or invented into a bucket. */
const SKILL_ORDER = ['ML / CV', 'Languages', 'Web', 'Data & Infra', 'Also'];
type SkillGroup = { label: string; items: string[] };
const SKILL_BUCKETS: Record<string, string[]> = {
  'ML / CV': ['pytorch', 'tensorflow', 'opencv', 'scikit', 'yolo', 'transformers', 'onnx', 'ml ', 'machine learning', 'vision'],
  Languages: ['python', 'typescript', 'javascript', 'go', 'rust', 'c++', 'sql', 'java', 'c#'],
  Web: ['react', 'next.js', 'nextjs', 'astro', 'vue', 'svelte', 'tailwind', 'html', 'css', 'fastapi', 'node', 'express', 'vite'],
  'Data & Infra': ['postgres', 'redis', 'kafka', 'duckdb', 'docker', 'kubernetes', 'github actions', 'cloudflare', 'vercel', 'aws', 'gcp', 'linux'],
};
function skillGroupFor(skill: string): string {
  const s = skill.toLowerCase();
  for (const [label, needles] of Object.entries(SKILL_BUCKETS)) {
    if (needles.some(n => s.includes(n))) return label;
    if (s.includes(label.split(' ')[0].toLowerCase())) return label;
  }
  return 'Also';
}
const skillGroups: SkillGroup[] = SKILL_ORDER.map(label => ({
  label,
  items: Array.from(skillSet)
    .filter(s => skillGroupFor(s) === label)
    .sort((a, b) => a.localeCompare(b))
})).filter(g => g.items.length > 0);
---
<BaseLayout title="Home" description={site.tagline}>
  <header class="hero container">
    <div class="hero-copy" data-reveal>
      <span class="tag tag-accent-2 hero-status"><span class="status-dot" aria-hidden="true"></span>Open to opportunities</span>
      <p class="eyebrow">Software Engineer</p>
      <h1 class="hero-title">Building <span class="highlight">ML systems</span>, <span class="nowrap">full-stack</span> apps &amp; dev tools</h1>
      <p class="hero-desc">{site.bio}</p>
      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">View Projects</a>
        <a href={site.github} class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="hero-figure" data-reveal style="--reveal-delay: 120ms">
      {/* The hero's LCP element. It is above the fold on every viewport, so it
          is fetched at high priority and never lazily — the browser's default
          heuristics de-prioritise it behind the stylesheet otherwise. */}
      <img
        class="grayscale hero-photo"
        src={site.photo}
        alt={site.name}
        width="480"
        height="480"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </header>

  <section class="container home-section" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">Case Studies</p>
        <h2>Deep dives</h2>
      </div>
      <hr class="rule section-line" />
    </div>
    <div class="grid-3 cs-grid">
      {caseStudies.map((cs, i) => {
        const project = linkedProject.get(cs.slug);
        const year = project?.data.year ?? new Date(cs.data.date).getFullYear();
        return (
          <a
            href={`/case-studies/${encodeURIComponent(cs.slug)}`}
            class:list={['card', 'elev-sm', 'cs-card', { 'cs-lead': i === 0 && caseStudies.length >= 3 }]}
          >
            <span class="card-kicker">{year} · {project ? categoryLabel(project.data.category) : 'Case study'}</span>
            <h3 class="card-title">{cs.data.title}</h3>
            <p class="card-body">{cs.data.subtitle}</p>
            {/* A span, not an anchor — the whole card already links to the
                study, and a button inside a link is the one nesting browsers
                refuse to render. Dressed as the same primary action the
                project cards below use, so both sections answer "where do I
                click" identically. */}
            <span class="btn btn-primary btn-sm cs-card-cta">Read case study</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container home-section" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">Featured Projects</p>
        <h2>Recent work</h2>
      </div>
      <hr class="rule section-line" />
      <a class="btn btn-ghost" href="/projects">View all projects →</a>
    </div>
    <div class="grid-2">
      {featured.map(project => (
        <ProjectCard title={project.data.title} slug={project.slug} summary={project.data.summary} tags={project.data.tags} status={project.data.status} year={project.data.year} repoUrl={project.data.repoUrl} demoUrl={project.data.demoUrl} caseStudySlug={project.data.caseStudySlug} heroImage={project.data.heroImage} />
      ))}
    </div>
  </section>

  <section class="container home-section" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">Skills &amp; Stack</p>
        <h2 class="skills-title">What I build with</h2>
      </div>
      <hr class="rule section-line" />
    </div>
    <div class="skills-grid">
      {skillGroups.map(group => (
        <div class:list={['skill-cluster', { 'skill-cluster-wide': group.label === 'Also' }]}>
          <p class="skill-label">{group.label}</p>
          <div class="tag-row">
            {group.items.map(s => <span class="tag tag-neutral">{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="closing-banner" data-reveal>
    <div class="container closing-inner">
      <div>
        <h2 class="closing-title">Let's work together</h2>
        <p class="closing-desc">Open to interesting ML/CV, full-stack, and systems projects.</p>
      </div>
      <div class="closing-actions">
        <a href={`mailto:${site.email}`} class="btn btn-on-accent">Hire me</a>
        <a href="/resume" class="btn btn-on-accent-outline">Resume</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .eyebrow { margin-bottom: var(--space-2); }

  /* — hero — */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .hero-status { margin-bottom: var(--space-3); gap: 8px; }

  /* Availability light. It is the only thing on the page that moves on its
     own, so it stops entirely when the visitor asks for less motion. */
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .status-dot { animation: status-pulse 2s ease-in-out infinite; }
  }
  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* 22ch, not 12ch. The measure has to hold the first line — "Building ML
     systems," — or the marked phrase breaks away from the verb that governs
     it, which is the one line in the hero that has to read as a unit. */
  .hero-title { font-size: clamp(32px, 5.4vw, 52px); max-width: 22ch; margin-bottom: var(--space-4); }

  /* The one phrase the hero argues for, marked the way a spec marks the term
     it is defining. It never breaks: the box is the mark, and a mark split
     across two lines reads as two marks. */
  .highlight {
    color: var(--color-accent-800);
    background: var(--color-accent-100);
    border: 1px dashed var(--color-accent);
    padding: 0 8px;
    white-space: nowrap;
  }
  .nowrap { white-space: nowrap; }
  .hero-desc { font-size: 17px; max-width: 52ch; opacity: 0.85; margin-bottom: var(--space-4); }
  .hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .hero-figure { border-left: 2px solid var(--color-divider); padding-left: var(--space-6); }
  .hero-photo { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: center 20%; }

  /* — sections — */
  .home-section { padding-bottom: var(--space-8); }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  /* The rule runs from the heading out to the section action. */
  .section-line { flex: 1; min-width: 40px; align-self: center; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }

  /* Case studies are not three equal tiles. The lead study takes a double
     column and the taller type; the rest stack in the remaining lane. One
     card is allowed to be more important than the others because one of
     them is — the newest, deepest dive is the argument for reading any. */
  .cs-grid.cs-grid { grid-template-areas: 'lead lead b' 'lead lead c'; grid-template-columns: 1fr 1fr 1fr; }
  .cs-grid .cs-card:nth-child(1) { grid-area: lead; }
  .cs-grid .cs-card:nth-child(2) { grid-area: b; }
  .cs-grid .cs-card:nth-child(3) { grid-area: c; }
  /* Fewer than three studies: no hierarchy to draw, so the flat grid stays. */
  @media (min-width: 761px) {
    .cs-grid:not(:has(.cs-card:nth-child(3))) { grid-template-areas: none; grid-template-columns: repeat(3, 1fr); }
    .cs-grid:not(:has(.cs-card:nth-child(3))) .cs-card { grid-area: auto; }
  }

  .cs-card { text-decoration: none; color: inherit; }
  /* The lead card earns larger type with its double column; the stack cards
     keep the shared scale so the hierarchy reads as chosen, not noisy. */
  .cs-lead .card-title { font-size: clamp(24px, 2.6vw, 34px); max-width: 30ch; }
  .cs-lead .card-body { font-size: 15px; opacity: 0.85; max-width: 52ch; }
  .cs-card:hover,
  .cs-card:focus-visible { color: inherit; }
  .cs-card:hover .card-title,
  .cs-card:focus-visible .card-title { color: var(--color-accent); }
  /* The card's action wears the project cards' primary button. A flex-column
     `.card` stretches its children, so the button is pulled back to its label;
     the top margin parks it after the body copy on every card height. */
  .cs-card-cta {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  .skills-title { margin-bottom: var(--space-3); }
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; }

  /* The wall reads as columns of related work, not one undifferentiated run.
     Labels wear the site's eyebrow voice so the clusters scan like the rest
     of the page's metadata; "Also" is deliberately unstyled beyond the voice
     so it stays the quiet last stop, not a fifth peer. */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6) var(--space-4);
    align-items: start;
  }
  .skill-cluster { display: flex; flex-direction: column; gap: var(--space-2); }
  /* "Also" is the overflow bucket, not a peer discipline — a lone narrow
     column of stragglers beside four full clusters read as a layout mistake.
     Spanning the whole width turns it into its own band, the way the run
     would have flowed before the grouping existed. */
  .skill-cluster-wide { grid-column: 1 / -1; }
  .skill-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* — closing banner: the one place the accent runs as a field — */
  .closing-banner {
    background: var(--color-accent);
    color: var(--color-bg);
    padding: var(--space-8) 0;
    margin-bottom: var(--space-8);
  }
  .closing-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .closing-title { font-size: clamp(28px, 4vw, 42px); margin-bottom: var(--space-2); }
  .closing-desc { margin: 0; }
  .closing-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .btn-on-accent { background: var(--color-bg); color: var(--color-accent-700); transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease; }
  .btn-on-accent:hover { background: var(--color-accent-100); color: var(--color-accent-800); }
  .btn-on-accent-outline { border-color: var(--color-bg); color: var(--color-bg); transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease; }
  .btn-on-accent-outline:hover { background: color-mix(in srgb, var(--color-bg) 18%, transparent); color: var(--color-bg); }

  @media (max-width: 900px) {
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
    /* The lead keeps its dominance at two columns; the stack cards sit
       beneath it in a pair rather than losing the hierarchy entirely. */
    .cs-grid.cs-grid { grid-template-areas: 'lead lead' 'b c'; }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: var(--space-6); }
    .cs-grid.cs-grid { grid-template-areas: 'lead' 'b' 'c'; grid-template-columns: 1fr; }
    .cs-lead .card-title { font-size: 24px; }
    .hero-figure {
      border-left: 0;
      border-top: 2px solid var(--color-divider);
      padding-left: 0;
      padding-top: var(--space-6);
      max-width: 320px;
    }
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
  }
</style>
