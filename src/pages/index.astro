---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Illustration from '../components/Illustration.astro';
import SectionSep from '../components/SectionSep.astro';
import PathLine from '../components/PathLine.astro';
import ContactTerminal from '../components/ContactTerminal.astro';
import { getFeaturedProjects, getProjects } from '../lib/content';
import { site } from '../lib/site';

/* Reads content from D1 per request — see the note in `src/lib/content.ts`.
   Prerendering this page would freeze the listing at deploy time, which is the
   whole thing the database was introduced to stop. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const allProjects = await getProjects(DB);
const featured = await getFeaturedProjects(DB, 6);

const skillSet = new Set<string>();
allProjects.forEach(p => p.data.stack.forEach(s => skillSet.add(s)));

/* The skills section is a wall of ~70 chips when it is one alphabetical
   run — no order a visitor can hold onto. Grouping by discipline gives the
   wall a reading path: scan the labels, land on your stack. Membership is
   derived from the projects themselves; anything unmatched falls into
   "Also" rather than being dropped or invented into a bucket. */
const SKILL_ORDER = ['ML / CV', 'Languages', 'Web', 'Data & Infra', 'Also'];
type SkillGroup = { label: string; items: string[] };
const SKILL_BUCKETS: Record<string, string[]> = {
  'ML / CV': ['pytorch', 'tensorflow', 'opencv', 'scikit', 'yolo', 'transformers', 'onnx', 'ml ', 'machine learning', 'vision'],
  Languages: ['python', 'typescript', 'javascript', 'go', 'rust', 'c++', 'sql', 'java', 'c#'],
  Web: ['react', 'next.js', 'nextjs', 'astro', 'vue', 'svelte', 'tailwind', 'html', 'css', 'fastapi', 'node', 'express', 'vite'],
  'Data & Infra': ['postgres', 'redis', 'kafka', 'duckdb', 'docker', 'kubernetes', 'github actions', 'cloudflare', 'vercel', 'aws', 'gcp', 'linux'],
};
function skillGroupFor(skill: string): string {
  const s = skill.toLowerCase();
  for (const [label, needles] of Object.entries(SKILL_BUCKETS)) {
    if (needles.some(n => s.includes(n))) return label;
    if (s.includes(label.split(' ')[0].toLowerCase())) return label;
  }
  return 'Also';
}
const skillGroups: SkillGroup[] = SKILL_ORDER.map(label => ({
  label,
  items: Array.from(skillSet)
    .filter(s => skillGroupFor(s) === label)
    .sort((a, b) => a.localeCompare(b))
})).filter(g => g.items.length > 0);
---
<BaseLayout title="Home" description={site.tagline}>
  <header class="hero container">
    <div class="hero-copy" data-reveal>
      <span class="tag tag-accent-2 hero-status"><span class="status-dot" aria-hidden="true"></span>Open to opportunities</span>
      {/* The name header, in the wordmark's voice: a prompt asks `whoami`
          and the eyebrow below decodes in as the answer. */}
      <PathLine cmd="whoami" delay={200} />
      <p class="eyebrow" data-fx="scramble" data-fx-delay="700">Software Engineer</p>
      <h1 class="hero-title">Building <span class="highlight">ML systems</span>, <span class="nowrap">full-stack</span> apps &amp; dev tools</h1>
      <p class="hero-desc">{site.bio}</p>
      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">View Projects</a>
        <a href={site.github} class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="hero-figure" data-reveal style="--reveal-delay: 120ms">
      {/* The wireframe orbit takes the portrait's place under the Geometry
          theme — hidden by default here, revealed by geometry.css, so the
          page never knows which theme is on. The photo stays the LCP element:
          it is present in the markup on every theme. */}
      <div class="hero-visual">
        <Illustration name="geometry-orbit" />
      </div>
      {/* The hero's LCP element. It is above the fold on every viewport, so it
          is fetched at high priority and never lazily — the browser's default
          heuristics de-prioritise it behind the stylesheet otherwise. */}
      <img
        class="grayscale hero-photo"
        src={site.photo}
        alt={site.name}
        width="480"
        height="480"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </header>

  <SectionSep />

  <section class="container home-section" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">Featured Projects</p>
        <h2>Recent work</h2>
      </div>
      <hr class="rule section-line" />
      <a class="btn btn-ghost" href="/projects">View all projects →</a>
    </div>
    <div class="grid-2">
      {featured.map(project => (
        <ProjectCard title={project.data.title} slug={project.slug} summary={project.data.summary} tags={project.data.tags} status={project.data.status} year={project.data.year} repoUrl={project.data.repoUrl} demoUrl={project.data.demoUrl} caseStudySlug={project.data.caseStudySlug} heroImage={project.data.heroImage} />
      ))}
    </div>
  </section>

  <SectionSep />

  <section class="container home-section" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">Skills &amp; Stack</p>
        <h2 class="skills-title">What I build with</h2>
      </div>
      <hr class="rule section-line" />
    </div>
    <div class="skills-grid">
      {skillGroups.map(group => (
        <div class:list={['skill-cluster', { 'skill-cluster-wide': group.label === 'Also' }]}>
          <p class="skill-label">{group.label}</p>
          <div class="tag-row">
            {group.items.map(s => <span class="tag tag-neutral">{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <SectionSep />

  {/* The closing move used to be a solid banner with two buttons. It is now
      the contact section: the same invitation, with the details a visitor
      actually needs and a way to write back. */}
  <ContactTerminal />
</BaseLayout>
<style>
  .eyebrow { margin-bottom: var(--space-2); }

  /* Theme-only artwork. The slot exists in the markup on every theme but
     renders nowhere until a theme file reveals it — the page stays theme-
     agnostic and the artwork is display:none, so no paint cost elsewhere. */
  .hero-visual { display: none; }

  /* — hero — */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .hero-status { margin-bottom: var(--space-3); gap: 8px; }

  /* Availability light. It is the only thing on the page that moves on its
     own, so it stops entirely when the visitor asks for less motion. */
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .status-dot { animation: status-pulse 2s ease-in-out infinite; }
  }
  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* 22ch, not 12ch. The measure has to hold the first line — "Building ML
     systems," — or the marked phrase breaks away from the verb that governs
     it, which is the one line in the hero that has to read as a unit. */
  .hero-title { font-size: clamp(32px, 5.4vw, 52px); max-width: 22ch; margin-bottom: var(--space-4); }

  /* The one phrase the hero argues for, marked the way a spec marks the term
     it is defining. It never breaks: the box is the mark, and a mark split
     across two lines reads as two marks. */
  .highlight {
    color: var(--color-accent-800);
    background: var(--color-accent-100);
    border: 1px dashed var(--color-accent);
    padding: 0 8px;
    white-space: nowrap;
  }
  .nowrap { white-space: nowrap; }
  .hero-desc { font-size: 17px; max-width: 52ch; opacity: 0.85; margin-bottom: var(--space-4); }
  .hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .hero-figure {
    border-left: 2px solid var(--color-divider);
    padding-left: var(--space-6);
    /* The vignette below hangs off this. Geometry replaces the whole figure
       with the orbit and sets its own; both are `relative` either way. */
    position: relative;
  }

  /* 4:5 rather than square, and the eyeline a little higher.

     A head-and-shoulders portrait in a 1:1 crop loses one of the two — at 480
     square this one was cut across the top of the head and again across the
     chest. Geometry overrides both of these to make the disc, so this is the
     shape every *other* theme gets. */
  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 15%;
  }

  /* The bottom edge, landed on the page ground rather than cut off at it.

     The shirt in this photograph is near-white and half the themes here have a
     near-black ground, so the frame's bottom was a hard horizontal line that
     reads as an image that failed to finish loading. A gradient in
     `--color-bg` resolves to the theme's own ground, which on the light themes
     is near-invisible and correctly does nothing. */
  .hero-figure::after {
    content: '';
    position: absolute;
    inset: 0 0 0 var(--space-6);
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-bg) 78%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 20%, transparent) 20%,
      transparent 42%
    );
  }

  /* — sections —
     Padded on both ends now that a separator band sits between them: the
     band's rule is the boundary, and content needs the same breathing room
     below it as it has above the next one. */
  .home-section { padding-top: var(--space-6); padding-bottom: var(--space-8); }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  /* The rule runs from the heading out to the section action. */
  .section-line { flex: 1; min-width: 40px; align-self: center; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }

  .skills-title { margin-bottom: var(--space-3); }
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; }

  /* The wall reads as columns of related work, not one undifferentiated run.
     Labels wear the site's eyebrow voice so the clusters scan like the rest
     of the page's metadata; "Also" is deliberately unstyled beyond the voice
     so it stays the quiet last stop, not a fifth peer. */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6) var(--space-4);
    align-items: start;
  }
  .skill-cluster { display: flex; flex-direction: column; gap: var(--space-2); }
  /* "Also" is the overflow bucket, not a peer discipline — a lone narrow
     column of stragglers beside four full clusters read as a layout mistake.
     Spanning the whole width turns it into its own band, the way the run
     would have flowed before the grouping existed. */
  .skill-cluster-wide { grid-column: 1 / -1; }
  .skill-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: var(--space-6); }
    .hero-figure {
      border-left: 0;
      border-top: 2px solid var(--color-divider);
      padding-left: 0;
      padding-top: var(--space-6);
      max-width: 320px;
    }
    /* The inset followed the padding, which has moved to the top edge. */
    .hero-figure::after { inset: var(--space-6) 0 0; }
    .grid-2 { grid-template-columns: 1fr; }
  }
</style>
