---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects.filter(p => p.data.featuredRank !== undefined).sort((a, b) => (a.data.featuredRank ?? 99) - (b.data.featuredRank ?? 99)).slice(0, 10);
const featuredCaseStudies = [...allProjects]
  .sort((a, b) => {
    const rankDiff = (a.data.featuredRank ?? 99) - (b.data.featuredRank ?? 99);
    if (rankDiff !== 0) return rankDiff;
    return b.data.year - a.data.year;
  })
  .slice(0, 12);
const skillSet = new Set<string>();
allProjects.forEach(p => p.data.stack.forEach(s => skillSet.add(s)));
const profilePhoto = 'https://github.com/user-attachments/assets/ac0a8a77-f1eb-45fa-8670-9b13cefd85e4';
---
<PageLayout title="Home" description="ML/CV engineer and full-stack developer portfolio.">
  <header class="hero container">
    <div class="hero-copy">
      <span class="tag tag-accent-2 hero-status">Open to opportunities</span>
      <h6 class="eyebrow">Software Engineer</h6>
      <h1 class="hero-title">Building ML systems, <span class="nowrap">full-stack</span> apps &amp; dev tools</h1>
      <p class="hero-desc">I work at the intersection of machine learning, computer vision, and software engineering. I build practical systems that ship.</p>
      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">View Projects</a>
        <a href="https://github.com/Leptons1618" class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="hero-figure">
      <img class="grayscale hero-photo" src={profilePhoto} alt="Anish Giri" width="480" height="480" />
    </div>
  </header>

  <section class="container home-section">
    <div class="section-head">
      <div>
        <h6 class="eyebrow">Case Studies</h6>
        <h2>Deep dives</h2>
      </div>
    </div>
    <div class="grid-3">
      {featuredCaseStudies.map(project => (
        <a
          href={project.data.caseStudySlug ? `/case-studies/${encodeURIComponent(project.data.caseStudySlug)}` : `/projects/${encodeURIComponent(project.slug)}`}
          class="card elev-sm cs-card"
        >
          <span class="card-kicker">{project.data.year} · {project.data.category}</span>
          <h3 class="card-title">{project.data.title}</h3>
          <p class="card-body">{project.data.summary}</p>
          <span class="card-meta cs-card-cta">{project.data.caseStudySlug ? 'Read case study →' : 'View project →'}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section">
    <div class="section-head">
      <div>
        <h6 class="eyebrow">Featured Projects</h6>
        <h2>Recent work</h2>
      </div>
      <a class="btn btn-ghost" href="/projects">View all projects →</a>
    </div>
    <div class="grid-2">
      {featured.slice(0, 6).map(project => (
        <ProjectCard title={project.data.title} slug={project.slug} summary={project.data.summary} tags={project.data.tags} stack={project.data.stack} status={project.data.status} year={project.data.year} repoUrl={project.data.repoUrl} demoUrl={project.data.demoUrl} caseStudySlug={project.data.caseStudySlug} heroImage={project.data.heroImage} />
      ))}
    </div>
  </section>

  <section class="container home-section">
    <h6 class="eyebrow">Skills &amp; Stack</h6>
    <h2 class="skills-title">What I build with</h2>
    <div class="tag-row">
      {Array.from(skillSet).sort().map(s => <span class="tag tag-neutral">{s}</span>)}
    </div>
  </section>

  <section class="closing-banner">
    <div class="container closing-inner">
      <div>
        <h2 class="closing-title">Let's work together</h2>
        <p class="closing-desc">Open to interesting ML/CV, full-stack, and systems projects.</p>
      </div>
      <div class="closing-actions">
        <a href="mailto:anishgiri163@gmail.com" class="btn btn-on-accent">Hire Me</a>
        <a href="/resume" class="btn btn-on-accent-outline">Resume</a>
      </div>
    </div>
  </section>
</PageLayout>
<style>
  .eyebrow { color: var(--color-accent-700); margin-bottom: var(--space-2); }

  /* — hero — */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .hero-status { margin-bottom: var(--space-3); }
  .hero-title { font-size: clamp(32px, 5.4vw, 52px); max-width: 12ch; margin-bottom: var(--space-4); }
  .nowrap { white-space: nowrap; }
  .hero-desc { font-size: 17px; max-width: 52ch; opacity: 0.85; margin-bottom: var(--space-4); }
  .hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .hero-figure { border-left: 2px solid var(--color-divider); padding-left: var(--space-6); }
  .hero-photo { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: center 20%; }

  /* — sections — */
  .home-section { padding-bottom: var(--space-8); }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }

  .cs-card { text-decoration: none; color: inherit; }
  .cs-card:hover { color: inherit; }
  .cs-card:hover .card-title { color: var(--color-accent); }
  .cs-card-cta { color: var(--color-accent-700); margin-top: var(--space-2); }

  .skills-title { margin-bottom: var(--space-3); }
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; }

  /* — closing banner: the one place the accent runs as a field — */
  .closing-banner {
    background: var(--color-accent);
    color: var(--color-bg);
    padding: var(--space-8) 0;
    margin-bottom: var(--space-8);
  }
  .closing-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .closing-title { font-size: clamp(28px, 4vw, 42px); margin-bottom: var(--space-2); }
  .closing-desc { margin: 0; opacity: 0.9; }
  .closing-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .btn-on-accent { background: var(--color-bg); color: var(--color-accent-700); }
  .btn-on-accent:hover { background: var(--color-accent-100); color: var(--color-accent-800); }
  .btn-on-accent-outline { border-color: var(--color-bg); color: var(--color-bg); }
  .btn-on-accent-outline:hover { background: color-mix(in srgb, var(--color-bg) 18%, transparent); color: var(--color-bg); }

  @media (max-width: 900px) {
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: var(--space-6); }
    .hero-figure {
      border-left: 0;
      border-top: 2px solid var(--color-divider);
      padding-left: 0;
      padding-top: var(--space-6);
      max-width: 320px;
    }
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
  }
</style>
