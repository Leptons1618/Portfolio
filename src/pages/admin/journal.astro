---
/**
 * The journal manifest: every entry, whatever its status, and the one button
 * that starts a new one.
 *
 * This screen used to be an editor with a list bolted underneath it, which
 * meant the answer to "which file does Commit write" lived in a JavaScript
 * variable and had to be mirrored into the heading, the filename line and a
 * highlighted row. Writing is now `/admin/journal/new` and
 * `/admin/journal/<slug>`, so the URL answers it and this screen has one job:
 * say what exists and move a post between states.
 *
 * The three statuses meet here, and that is why the state is one enum in the
 * file rather than a flag in the frontmatter and a draft store somewhere else:
 * `getPosts(true)` already returned everything, so filtering is one predicate
 * and moving a post between states is one frontmatter patch on a file this
 * screen never had to parse.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Illustration from '../../components/Illustration.astro';
import { Icon } from 'astro-icon/components';
import { getPosts } from '../../lib/content';
import { formatShortDate } from '../../lib/format';
import { POST_STATUSES } from '../../lib/content-store';

/* Every status, including the two the public site never renders — managing
   them is what this screen exists for. */
/* The admin reads D1 per request, like every content route. Prerendering it
   would show the author the state of the last deploy while they are editing
   the state of the database — the two would disagree the moment anything was
   saved, which is exactly the confusion this surface exists to remove. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const existing = await getPosts(DB, true);

const counts = {
  draft: existing.filter(entry => entry.data.status === 'draft').length,
  published: existing.filter(entry => entry.data.status === 'published').length,
  unpublished: existing.filter(entry => entry.data.status === 'unpublished').length,
};
---
<AdminLayout title="Journal">
  <div class="admin-main-wide" id="admin-journal">
    <div class="admin-head">
      <div>
        <h6 class="admin-eyebrow-mono">MODULE: JOURNAL</h6>
        <h1 class="admin-title">Journal</h1>
        <p class="jl-desc">
          Everything in <code>src/content/journal/</code>, drafts and withdrawn posts
          included. <strong>Edit</strong> opens an entry on its own page; a status change
          is its own commit from the row menu.
        </p>
      </div>
      <div class="admin-actions">
        <a class="btn btn-primary" href="/admin/journal/new">
          <Icon name="lucide:file-plus-2" class="admin-nav-icon" />Create journal entry
        </a>
      </div>
    </div>

    {existing.length > 0 && (
      <div class="jl-summary">
        <span class="tag tag-accent-2">{counts.published} published</span>
        {counts.draft > 0 && <span class="tag tag-accent">{counts.draft} draft</span>}
        {counts.unpublished > 0 && <span class="tag tag-neutral">{counts.unpublished} unpublished</span>}
      </div>
    )}

    {/* Nothing written at all is a real state, and the one moment this screen
        can say exactly what would fill it instead of showing a rule over an
        empty card. */}
    {existing.length === 0 ? (
      <div class="card elev-sm">
        <div class="admin-empty">
          <div class="admin-empty-art"><Illustration name="taking-notes" /></div>
          <h3 class="admin-empty-title">Nothing written yet</h3>
          <p class="admin-empty-copy">
            <code>src/content/journal/</code> is empty. A new entry starts as a draft — it
            stays out of production builds until you publish it, which is one menu click
            from this list.
          </p>
          <div class="admin-empty-actions">
            <a class="btn btn-primary btn-sm" href="/admin/journal/new">
              <Icon name="lucide:file-plus-2" class="admin-nav-icon" />Create your first entry
            </a>
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="existing-head">
          <h6 class="admin-eyebrow">Entries ({existing.length})</h6>
          <div class="existing-filters">
            <input
              class="input entry-search"
              id="entry-search"
              type="search"
              placeholder="Search titles…"
              aria-label="Search journal entries"
            />
            <div class="seg" role="group" aria-label="Filter entries by status">
              <label class="seg-opt"><input type="radio" name="entry-filter" value="all" checked />All</label>
              {POST_STATUSES.map(([value, label]) => (
                <label class="seg-opt"><input type="radio" name="entry-filter" value={value} />{label}</label>
              ))}
            </div>
          </div>
        </div>

        <div class="card elev-sm existing-card">
          {existing.map(entry => (
            <div
              class="existing-row"
              data-slug={entry.slug}
              data-status={entry.data.status}
              data-search={entry.data.title.toLowerCase()}
            >
              <div class="existing-id">
                <a class="existing-title" href={`/admin/journal/${entry.slug}`}>{entry.data.title}</a>
                {/* Colour comes from the row's `data-status` in this page's
                    stylesheet, so the script only has to rewrite one attribute
                    and one word when a status changes. */}
                <span class="tag entry-flag" data-role="flag">{entry.data.status}</span>
              </div>
              <p class="text-muted existing-summary">{entry.data.summary}</p>
              <span class="text-muted cell-mono existing-date">{formatShortDate(entry.data.date)}</span>

              <a class="btn btn-secondary btn-sm" href={`/admin/journal/${entry.slug}`}>
                <Icon name="lucide:pencil" class="admin-nav-icon" />Edit
              </a>

              {/* Everything else this row can do, behind one control. A `<details>`
                  rather than a scripted popover: the open/close, the button
                  semantics and the click-outside-to-close are all things the
                  element does for free once the row closes its siblings. */}
              <details class="menu entry-menu">
                <summary
                  class="btn btn-icon btn-sm"
                  role="button"
                  aria-haspopup="menu"
                  aria-label={`More actions for ${entry.data.title}`}
                  title="More actions"
                >
                  <Icon name="lucide:ellipsis-vertical" class="admin-nav-icon" />
                </summary>
                <div class="menu-panel" role="menu">
                  <span class="menu-label">Status</span>
                  {POST_STATUSES.map(([value, label]) => (
                    <button
                      type="button"
                      class="menu-item"
                      role="menuitemradio"
                      data-status={value}
                      aria-checked={value === entry.data.status ? 'true' : 'false'}
                      aria-current={value === entry.data.status ? 'true' : undefined}
                    >{label}</button>
                  ))}
                  <hr class="menu-sep" />
                  {/* Unpublished posts leave `getStaticPaths`, so there is no page
                      to open — a disabled row saying why beats a link that 404s. */}
                  {entry.data.status === 'unpublished' ? (
                    <button type="button" class="menu-item" role="menuitem" disabled>No public page</button>
                  ) : (
                    <a class="menu-item" role="menuitem" href={`/journal/${entry.slug}`} target="_blank" rel="noopener">
                      <Icon name="lucide:external-link" class="admin-nav-icon" />Open the post
                    </a>
                  )}
                  <button type="button" class="menu-item menu-item-danger" role="menuitem" data-action="delete">
                    <Icon name="lucide:trash-2" class="admin-nav-icon" />Delete the file
                  </button>
                </div>
              </details>

              <p class="text-muted admin-note entry-line" data-role="status"></p>
            </div>
          ))}

          {/* A filter that matched none of the posts there are is a different
              nothing from having none, and it wants a different sentence. */}
          <div class="admin-empty" id="entries-empty" hidden>
            <div class="admin-empty-art admin-empty-art-sm"><Illustration name="empty-mailbox" /></div>
            <p class="admin-empty-copy">No entry matches that search and filter.</p>
          </div>
        </div>

        <p class="text-muted admin-note jl-note">
          Changing a status is its own commit — unpublishing removes the page from the
          build outright, so its URL starts returning 404. Deleting commits a removal of
          the file, which stays in the history either way.
        </p>
      </>
    )}
  </div>
</AdminLayout>

<script>
  import { onAdminPage } from '../../lib/admin';
  import { removePost, setPostStatus, type PostStatus } from '../../lib/content-store';
  import { getToken } from '../../lib/github';

  /* The admin client-routes, so this runs on first paint and again every time
     you come back to this screen — see `onAdminPage`. */
  onAdminPage('#admin-journal', () => {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.existing-row'));
    if (!rows.length) return;

    const entrySearch = document.getElementById('entry-search') as HTMLInputElement | null;
    const entryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="entry-filter"]'));
    const entriesEmpty = document.getElementById('entries-empty')!;
    const rowBySlug = new Map(rows.map(row => [row.dataset.slug!, row]));

    function applyEntryFilters() {
      const term = (entrySearch?.value ?? '').trim().toLowerCase();
      const status = entryFilters.find(input => input.checked)?.value ?? 'all';
      let shown = 0;
      rows.forEach(row => {
        const hide =
          !(status === 'all' || row.dataset.status === status) ||
          !(term === '' || (row.dataset.search ?? '').includes(term));
        row.hidden = hide;
        if (!hide) shown += 1;
      });
      entriesEmpty.hidden = shown > 0;
    }

    entrySearch?.addEventListener('input', applyEntryFilters);
    entryFilters.forEach(input => input.addEventListener('change', applyEntryFilters));

    /** Move a row to a status without re-reading it from the database. */
    function markRowStatus(slug: string, status: PostStatus) {
      const row = rowBySlug.get(slug);
      if (!row) return;
      row.dataset.status = status;
      row.querySelector<HTMLElement>('[data-role="flag"]')!.textContent = status;
      row.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(item => {
        const on = item.dataset.status === status;
        item.setAttribute('aria-checked', String(on));
        if (on) item.setAttribute('aria-current', 'true');
        else item.removeAttribute('aria-current');
      });
      applyEntryFilters();
    }

    /* One open menu at a time. `<details>` has no notion of a group, and two
       panels overlapping each other is worse than the two lines it costs. */
    const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('.entry-menu'));
    menus.forEach(menu => {
      menu.addEventListener('toggle', () => {
        if (menu.open) menus.forEach(other => { if (other !== menu) other.open = false; });
      });
    });
    document.addEventListener('click', event => {
      const inside = (event.target as Element | null)?.closest?.('.entry-menu');
      menus.forEach(menu => { if (menu !== inside) menu.open = false; });
    });

    rows.forEach(row => {
      const slug = row.dataset.slug!;
      const line = row.querySelector<HTMLElement>('[data-role="status"]')!;
      const menu = row.querySelector<HTMLDetailsElement>('.entry-menu')!;

      const say = (text: string, tone: 'info' | 'error' = 'info') => {
        line.dataset.tone = tone;
        line.textContent = text;
      };

      const statusItems = Array.from(row.querySelectorAll<HTMLButtonElement>('[data-status]'));
      const deleteItem = row.querySelector<HTMLButtonElement>('[data-action="delete"]')!;

      /* Editing is a link to a prerendered page, so it works signed out. Every
         control in this menu is a commit, and none of them does. */
      if (!getToken()) {
        [...statusItems, deleteItem].forEach(item => {
          item.disabled = true;
          item.title = 'Sign in with GitHub — each of these is a commit.';
        });
        return;
      }

      statusItems.forEach(item => {
        item.addEventListener('click', async () => {
          const next = item.dataset.status as PostStatus;
          const previous = row.dataset.status as PostStatus;
          menu.open = false;
          if (next === previous) return;

          statusItems.forEach(other => { other.disabled = true; });
          say('Saving…');

          try {
            const result = await setPostStatus(slug, next);
            markRowStatus(slug, next);

            /* Unpublishing takes the page away, so there is nothing to link to.
               The other two states are live the moment this returns. */
            if (next === 'published') {
              const anchor = document.createElement('a');
              anchor.href = result.url;
              anchor.target = '_blank';
              anchor.rel = 'noopener';
              anchor.textContent = 'view live ↗';
              line.dataset.tone = 'info';
              line.replaceChildren(document.createTextNode('Published — live now — '), anchor);
            } else {
              say(next === 'unpublished' ? 'Unpublished — its URL now 404s.' : 'Saved as a draft.');
            }
          } catch (error) {
            markRowStatus(slug, previous);
            say(error instanceof Error ? error.message : 'Save failed.', 'error');
          } finally {
            statusItems.forEach(other => { other.disabled = false; });
          }
        });
      });

      /* Two clicks, like the project cards: the first is the one people mean to
         take back. The file stays in the history, so a confirm is enough. */
      let armed = false;
      let disarm: ReturnType<typeof setTimeout>;

      deleteItem.addEventListener('click', async () => {
        menu.open = false;

        if (!armed) {
          armed = true;
          deleteItem.textContent = 'Confirm delete';
          say(`This commits a deletion of src/content/journal/${slug}.md. Open the menu and click again.`, 'error');
          disarm = setTimeout(() => {
            armed = false;
            deleteItem.textContent = 'Delete the file';
            say('');
          }, 6000);
          return;
        }

        clearTimeout(disarm);
        armed = false;
        deleteItem.textContent = 'Delete the post';
        deleteItem.disabled = true;
        say('Deleting…');

        try {
          await removePost(slug);
          row.classList.add('is-removed');
          /* Its editor page resolves from the same row, so that link is dead the
             moment this returns — stop offering it. */
          row.querySelectorAll('button, a').forEach(control => {
            if (control instanceof HTMLButtonElement) control.disabled = true;
            else control.removeAttribute('href');
          });
          say('Deleted. The post is gone from the site.');
        } catch (error) {
          deleteItem.disabled = false;
          say(error instanceof Error ? error.message : 'Delete failed.', 'error');
        }
      });
    });
  });
</script>

<style>
  .jl-desc { opacity: 0.8; max-width: 70ch; margin: 0; }
  .jl-summary { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: var(--space-4); }
  .jl-note { margin-top: var(--space-4); max-width: 76ch; }

  .existing-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .existing-head h6 { margin: 0; }
  .existing-filters { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .entry-search { width: 220px; font-size: 13px; padding: 6px 10px; }

  .existing-card { gap: 0; }
  /* Title | date | edit | menu, with the summary tucked under the title and any
     commit message spanning the whole row beneath — so a long sentence never
     squeezes the controls out of alignment with the row above it.

     Every cell is placed explicitly. Mixing definite rows with auto-placed
     columns makes the order depend on the auto-placement algorithm's two
     passes, which is not a thing to leave to chance in a list. */
  .existing-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: 2px var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-divider);
    font-size: 14px;
  }
  .existing-row:last-child { border-bottom: 0; }
  .existing-row[hidden] { display: none; }
  .existing-row.is-removed { opacity: 0.5; }

  .existing-id { grid-column: 1; grid-row: 1; display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
  .existing-title { font-weight: 600; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .existing-title:hover { color: var(--color-accent); }
  .existing-summary {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    font-size: 12px;
    /* One line: this is a manifest, and the summary is here to tell two similar
       titles apart rather than to be read. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .existing-date { grid-column: 2; grid-row: 1 / span 2; white-space: nowrap; }
  .existing-row > .btn { grid-column: 3; grid-row: 1 / span 2; }
  .entry-menu { grid-column: 4; grid-row: 1 / span 2; }

  .entry-line { grid-column: 1 / -1; grid-row: 3; min-height: 0; margin: 6px 0 0; }
  .entry-line:empty { display: none; }
  .entry-line[data-tone='error'] { color: var(--color-accent-700); }

  /* The flag mirrors the row's state, so the script rewrites one attribute
     rather than juggling three global tag variants. */
  .entry-flag { text-transform: lowercase; }
  .existing-row[data-status='draft'] .entry-flag {
    background: var(--color-accent-100);
    color: var(--color-accent-800);
  }
  .existing-row[data-status='published'] .entry-flag {
    background: var(--color-accent-2-100);
    color: var(--color-accent-2-800);
  }
  .existing-row[data-status='unpublished'] .entry-flag {
    background: var(--color-neutral-100);
    color: var(--color-neutral-800);
  }

  code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }

  /* Narrow, the date drops below the summary rather than eating the width the
     title needs, and the two controls keep their own columns. */
  @media (max-width: 700px) {
    .existing-row { grid-template-columns: minmax(0, 1fr) auto auto; }
    .existing-date { grid-column: 1; grid-row: 3; }
    .existing-row > .btn { grid-column: 2; grid-row: 1 / span 3; }
    .entry-menu { grid-column: 3; grid-row: 1 / span 3; }
    .entry-line { grid-row: 4; }
  }
</style>
