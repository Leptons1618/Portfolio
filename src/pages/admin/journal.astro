---
/**
 * The journal manifest: every entry, whatever its status, and the one button
 * that starts a new one.
 *
 * This screen used to be an editor with a list bolted underneath it, which
 * meant the answer to "which post does Save write" lived in a JavaScript
 * variable and had to be mirrored into the heading, the path line and a
 * highlighted row. Writing is now `/admin/journal/new` and
 * `/admin/journal/<slug>`, so the URL answers it and this screen has one job:
 * say what exists and move a post between states.
 *
 * The three statuses meet here, and that is why the state is one enum on the
 * row rather than a flag plus a draft store somewhere else: `getPosts(db, true)`
 * already returns everything, so filtering is one predicate and moving a post
 * between states is one column patch.
 *
 * The list is on two shelves — Active for published and drafts, Archived for
 * withdrawn posts — with one order control over both. That is arrangement, not
 * a third filter: the status segments still reach either shelf, and a status
 * change moves the row rather than leaving it under a heading that has stopped
 * being true. Every row carries `updated_at` as well as its own date, because
 * on a manifest of things being written the useful timestamp is the one that
 * says where you left off.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Illustration from '../../components/Illustration.astro';
import { Icon } from 'astro-icon/components';
import { getPosts, getJournalOrder } from '../../lib/content';
import { formatShortDate, relativeTime } from '../../lib/format';
import { POST_STATUSES } from '../../lib/content-store';

/* Every status, including the two the public site never renders — managing
   them is what this screen exists for. */
/* The admin reads D1 per request, like every content route. Prerendering it
   would show the author the state of the last deploy while they are editing
   the state of the database — the two would disagree the moment anything was
   saved, which is exactly the confusion this surface exists to remove. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const existing = await getPosts(DB, true);

/* The pinned order the public journal follows, so this screen arranges what a
   visitor actually sees — the same rule the deep-dives editor works by. */
const savedOrder = await getJournalOrder(DB);
const orderedSlugs = [
  ...savedOrder.filter(slug => existing.some(entry => entry.slug === slug)),
  ...existing.map(entry => entry.slug).filter(slug => !savedOrder.includes(slug)),
];
/* Date order, for the Automatic reset to restore. */
const dateOrder = [...existing]
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))
  .map(entry => entry.slug)
  .join(',');

const counts = {
  draft: existing.filter(entry => entry.data.status === 'draft').length,
  published: existing.filter(entry => entry.data.status === 'published').length,
  unpublished: existing.filter(entry => entry.data.status === 'unpublished').length,
};

/* Two shelves rather than one list, because the third status is not a third
   kind of post — it is a post that has been taken off the site. Drafts and
   published entries are both things being worked on and both belong at the
   top; a withdrawn one is a record. The status filter above still reaches
   either, so this is arrangement and not another filter. */
const sections = [
  {
    id: 'active',
    title: 'Active',
    note: 'Published and drafts — everything currently in play.',
    rows: existing.filter(entry => entry.data.status !== 'unpublished'),
  },
  {
    id: 'archived',
    title: 'Archived',
    note: 'Withdrawn. Their URLs 404 until they are published again.',
    rows: existing.filter(entry => entry.data.status === 'unpublished'),
  },
];

/* The four orders the list can be put in. The default is what the manifest
   showed before there was a control: the post date, newest first. */
const SORTS = [
  ['newest', 'Newest first'],
  ['oldest', 'Oldest first'],
  ['edited', 'Recently edited'],
  ['title', 'Title A–Z'],
];
---
<AdminLayout title="Journal">
  <div class="admin-main-wide" id="admin-journal" data-date-order={dateOrder}>
    <div class="admin-head">
      <div>
        <p class="admin-eyebrow-mono">MODULE: JOURNAL</p>
        <h1 class="admin-title">Journal</h1>
        <p class="jl-desc">
          Every row in <code>journal</code>, drafts and withdrawn posts included.
          <strong>Edit</strong> opens an entry on its own page; a status change is one
          click in the row menu and takes effect on the site immediately.
        </p>
      </div>
      <div class="admin-actions">
        <a class="btn btn-primary" href="/admin/journal/new">
          <Icon name="lucide:file-plus-2" class="admin-nav-icon" />Create journal entry
        </a>
      </div>
    </div>

    {existing.length > 0 && (
      <div class="jl-summary">
        <span class="tag tag-accent-2">{counts.published} published</span>
        {counts.draft > 0 && <span class="tag tag-accent">{counts.draft} draft</span>}
        {counts.unpublished > 0 && <span class="tag tag-neutral">{counts.unpublished} unpublished</span>}
      </div>
    )}

    {/* Nothing written at all is a real state, and the one moment this screen
        can say exactly what would fill it instead of showing a rule over an
        empty card. */}
    {existing.length === 0 ? (
      <div class="card elev-sm">
        <div class="admin-empty">
          <div class="admin-empty-art"><Illustration name="taking-notes" /></div>
          <h3 class="admin-empty-title">Nothing written yet</h3>
          <p class="admin-empty-copy">
            The <code>journal</code> table is empty. A new entry starts as a draft — it
            stays off the public site until you publish it, which is one menu click from
            this list.
          </p>
          <div class="admin-empty-actions">
            <a class="btn btn-primary btn-sm" href="/admin/journal/new">
              <Icon name="lucide:file-plus-2" class="admin-nav-icon" />Create your first entry
            </a>
          </div>
        </div>
      </div>
    ) : (
      <>
        {/* Reordering, like the dashboard's deep dives: the pinned order is
            what the public journal follows, dragging a row moves it within its
            shelf, and Save writes the whole order as one document. The sort
            control above is still a view of this list — it re-appends rows and
            so does the drag; whichever acted last wins until you save. */}
        <div class="existing-head">
          <p class="admin-eyebrow">Entries ({existing.length})</p>
          <div class="existing-filters">
            <input
              class="input entry-search"
              id="entry-search"
              type="search"
              placeholder="Search titles…"
              aria-label="Search journal entries"
            />
            {/* `select.input`, so `src/lib/select.ts` replaces it with the
                dropdown this surface uses everywhere else. Ordering is a view
                of the list, not a property of a post — nothing is written and
                nothing persists past a reload. */}
            <select class="input is-auto entry-sort" id="entry-sort" aria-label="Order entries">
              {SORTS.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
            <div class="seg" role="group" aria-label="Filter entries by status">
              <label class="seg-opt"><input type="radio" name="entry-filter" value="all" checked />All</label>
              {POST_STATUSES.map(([value, label]) => (
                <label class="seg-opt"><input type="radio" name="entry-filter" value={value} />{label}</label>
              ))}
            </div>
          </div>
        </div>

        <div class="order-toolbar">
          <p class="text-muted admin-note order-lede">
            Drag a post to change where it sits in the public journal — pinned posts come first,
            in this order, ahead of everything newer. Saving writes the whole order;
            <strong>Automatic</strong> puts every post back to date order.
          </p>
          <div class="admin-actions">
            <button type="button" class="btn btn-secondary btn-sm" id="order-reset">Automatic</button>
            <button type="button" class="btn btn-primary btn-sm" id="order-save">Save order</button>
          </div>
        </div>

        {sections.map(section => (
          <section class="entry-section" data-section={section.id} hidden={section.rows.length === 0}>
            <div class="entry-section-head">
              <p class="admin-eyebrow">{section.title} ({section.rows.length})</p>
              <p class="text-muted admin-note entry-section-note">{section.note}</p>
            </div>
            <div class="card elev-sm existing-card">
              {orderedSlugs
                .map(slug => section.rows.find(entry => entry.slug === slug))
                .filter(entry => entry !== undefined)
                .map(entry => (
                <div
                  class="existing-row"
                  data-slug={entry.slug}
                  data-status={entry.data.status}
                  data-search={entry.data.title.toLowerCase()}
                  data-date={entry.data.date}
                  data-updated={entry.data.updatedAt}
                >
                  <div class="existing-id">
                    <a class="existing-title" href={`/admin/journal/${entry.slug}`}>{entry.data.title}</a>
                    {/* Colour comes from the row's `data-status` in this page's
                        stylesheet, so the script only has to rewrite one attribute
                        and one word when a status changes. */}
                    <span class="tag entry-flag" data-role="flag">{entry.data.status}</span>
                  </div>
                  <p class="text-muted existing-summary">{entry.data.summary}</p>
                  {/* Two timestamps, because they answer different questions: the
                      post's own date is what the site shows, and `updated_at` is
                      when this row was last written — which is the one that says
                      where you left off. The exact stamp is the tooltip. */}
                  <span class="text-muted cell-mono existing-date">
                    <span>{formatShortDate(entry.data.date)}</span>
                    {entry.data.updatedAt && (
                      <span class="existing-edited" title={entry.data.updatedAt}>
                        edited {relativeTime(entry.data.updatedAt)}
                      </span>
                    )}
                  </span>

                  <button
                    type="button"
                    class="row-grip"
                    aria-label={`Reorder ${entry.data.title}. Drag, or focus here and use the arrow keys.`}
                    title="Drag to reorder"
                  >
                    <Icon name="lucide:grip-vertical" class="admin-nav-icon" />
                  </button>

                  <a class="btn btn-secondary btn-sm" href={`/admin/journal/${entry.slug}`}>
                    <Icon name="lucide:pencil" class="admin-nav-icon" />Edit
                  </a>

                  {/* Everything else this row can do, behind one control. A `<details>`
                      rather than a scripted popover: the open/close, the button
                      semantics and the click-outside-to-close are all things the
                      element does for free once the row closes its siblings. */}
                  <details class="menu entry-menu">
                    <summary
                      class="btn btn-icon btn-sm"
                      role="button"
                      aria-haspopup="menu"
                      aria-label={`More actions for ${entry.data.title}`}
                      title="More actions"
                    >
                      <Icon name="lucide:ellipsis-vertical" class="admin-nav-icon" />
                    </summary>
                    <div class="menu-panel" role="menu">
                      <span class="menu-label">Status</span>
                      {POST_STATUSES.map(([value, label]) => (
                        <button
                          type="button"
                          class="menu-item"
                          role="menuitemradio"
                          data-status={value}
                          aria-checked={value === entry.data.status ? 'true' : 'false'}
                          aria-current={value === entry.data.status ? 'true' : undefined}
                        >{label}</button>
                      ))}
                    <hr class="menu-sep" />
                    {/* Unpublished posts leave `getStaticPaths`, so there is no page
                        to open — a disabled row saying why beats a link that 404s. */}
                    {entry.data.status === 'unpublished' ? (
                      <button type="button" class="menu-item" role="menuitem" disabled>No public page</button>
                    ) : (
                      <a class="menu-item" role="menuitem" href={`/journal/${entry.slug}`} target="_blank" rel="noopener">
                        <Icon name="lucide:external-link" class="admin-nav-icon" />Open the post
                      </a>
                    )}
                    <button type="button" class="menu-item menu-item-danger" role="menuitem" data-action="delete">
                      <Icon name="lucide:trash-2" class="admin-nav-icon" />Delete the post
                    </button>
                  </div>
                </details>

                <p class="text-muted admin-note entry-line" data-role="status"></p>
              </div>
              ))}
            </div>
          </section>
        ))}
        {/* A filter that matched none of the posts there are is a different
            nothing from having none, and it wants a different sentence. Outside
            the cards now that there are two of them — and outside the rows the
            sort control re-appends, which would otherwise leave it stranded
            above them. */}
        <div class="admin-empty" id="entries-empty" hidden>
          <div class="admin-empty-art admin-empty-art-sm"><Illustration name="empty-mailbox" /></div>
          <p class="admin-empty-copy">No entry matches that search and filter.</p>
        </div>

        <p class="text-muted admin-note jl-note">
          A status change is live the moment it saves — unpublishing takes the page away
          outright, so its URL starts returning 404, and publishing puts it back. Deleting
          is the one that does not come back: the row is the only copy there is.
        </p>
      </>
    )}
  </div>
</AdminLayout>

<script>
  import { onAdminPage, setBusy, setLabel, toast } from '../../lib/admin';
  import { removePost, setPostStatus, postPath, saveJournalOrder, type PostStatus } from '../../lib/content-store';
  import { getToken } from '../../lib/github';

  /* The admin client-routes, so this runs on first paint and again every time
     you come back to this screen — see `onAdminPage`. */
  onAdminPage('#admin-journal', () => {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.existing-row'));
    if (!rows.length) return;

    const entrySearch = document.getElementById('entry-search') as HTMLInputElement | null;
    const entrySort = document.getElementById('entry-sort') as HTMLSelectElement | null;
    const entryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="entry-filter"]'));
    const entriesEmpty = document.getElementById('entries-empty')!;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.entry-section'));
    const rowBySlug = new Map(rows.map(row => [row.dataset.slug!, row]));

    /* — reordering —
       Same shape as the dashboard's deep-dives editor: the DOM order inside
       each shelf is the state, dragging or arrow keys move the row, and Save
       reads the whole order back out of the DOM. The saved list is global, not
       per-shelf: a slug keeps its position whether it sits under Active or
       Archived. */
    const orderSaveButton = document.getElementById('order-save') as HTMLButtonElement;
    const orderResetButton = document.getElementById('order-reset') as HTMLButtonElement;
    const signedIn = Boolean(getToken());

    function pinnedSlugs(): string[] {
      /* Every row in DOM order across both shelves — the shelves are display,
         and this flat list is what the public journal follows. */
      return Array.from(document.querySelectorAll<HTMLElement>('.existing-row'))
        .map(row => row.dataset.slug!);
    }

    async function commitOrder(slugs: string[], note: string) {
      setBusy(orderSaveButton, true, 'Saving…');
      try {
        await saveJournalOrder(slugs);
        toast(note, { tone: 'success' });
      } catch (error) {
        const text = error instanceof Error ? error.message : 'Save failed.';
        toast(text, { tone: 'error' });
      } finally {
        setBusy(orderSaveButton, false);
      }
    }

    if (!signedIn) {
      for (const button of [orderSaveButton, orderResetButton]) {
        button.disabled = true;
        button.title = 'Sign in with GitHub to change the public journal.';
      }
    } else {
      orderSaveButton.addEventListener('click', () => {
        void commitOrder(pinnedSlugs(), 'Journal order saved.');
      });
      /* Restore what the server rendered as the default — date order, newest
         first — and save an empty list, which the read side treats as
         automatic. */
      orderResetButton.addEventListener('click', () => {
        const slugs = (document.getElementById('admin-journal')!.dataset.dateOrder ?? '')
          .split(',')
          .filter(Boolean);
        slugs.map(slug => rowBySlug.get(slug)).forEach(row => {
          if (!row) return;
          const card = row.closest('.existing-card');
          if (card) card.appendChild(row);
        });
        applySort();
        applyEntryFilters();
        void commitOrder([], 'Automatic — every post in date order.');
      });

      /* Dragging within a shelf, plus the keyboard path through the grip's
         arrow keys. Rows cannot cross between Active and Archived by dragging:
         membership there is status, which has its own menu control. */
      let dragged: HTMLElement | null = null;

      rows.forEach(row => {
        row.draggable = true;
        row.classList.add('is-orderable');

        row.addEventListener('dragstart', event => {
          dragged = row;
          row.classList.add('is-dragging');
          event.dataTransfer?.setData('text/plain', row.dataset.slug ?? '');
          if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
        });
        row.addEventListener('dragend', () => {
          row.classList.remove('is-dragging');
          dragged = null;
        });

        row.querySelector<HTMLButtonElement>('.row-grip')?.addEventListener('keydown', event => {
          const delta =
            event.key === 'ArrowUp' ? -1 : event.key === 'ArrowDown' ? 1 : 0;
          if (!delta) return;
          event.preventDefault();
          const card = row.closest('.existing-card');
          if (!card) return;
          const siblings = Array.from(card.querySelectorAll<HTMLElement>('.existing-row:not([hidden])'));
          const neighbour = siblings[siblings.indexOf(row) + delta];
          if (!neighbour) return;
          if (delta < 0) neighbour.before(row);
          else neighbour.after(row);
          row.querySelector<HTMLElement>('.row-grip')?.focus();
        });
      });

      document.addEventListener('dragover', event => {
        if (!dragged) return;
        event.preventDefault();
        if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
        const card = (event.target as HTMLElement).closest<HTMLElement>('.existing-card');
        if (!card) return;
        const overRow = (event.target as HTMLElement).closest<HTMLElement>('.existing-row');
        if (!overRow || overRow === dragged || !card.contains(overRow)) return;
        const box = overRow.getBoundingClientRect();
        const after = event.clientY > box.top + box.height / 2;
        if (after ? dragged.nextElementSibling === overRow : dragged.previousElementSibling === overRow) return;
        if (after) overRow.after(dragged);
        else overRow.before(dragged);
      });
      document.addEventListener('drop', event => {
        if (dragged) event.preventDefault();
      });
    }


    function applyEntryFilters() {
      const term = (entrySearch?.value ?? '').trim().toLowerCase();
      const status = entryFilters.find(input => input.checked)?.value ?? 'all';
      let shown = 0;
      rows.forEach(row => {
        const hide =
          !(status === 'all' || row.dataset.status === status) ||
          !(term === '' || (row.dataset.search ?? '').includes(term));
        row.hidden = hide;
        if (!hide) shown += 1;
      });
      /* A shelf with nothing left on it is a heading over a rule. Asked of the
         rows rather than counted alongside them, so this stays right after a
         status change moves a post from one section to the other. */
      sections.forEach(section => {
        section.hidden = !section.querySelector('.existing-row:not([hidden])');
      });
      entriesEmpty.hidden = shown > 0;
    }

    /* Ordering is a comparator per option, read off the row's data attributes
       rather than from the DOM text — both timestamps are ISO, so comparing
       them as strings is comparing them as dates. */
    const ORDERS: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      newest: (a, b) => (b.dataset.date ?? '').localeCompare(a.dataset.date ?? ''),
      oldest: (a, b) => (a.dataset.date ?? '').localeCompare(b.dataset.date ?? ''),
      edited: (a, b) => (b.dataset.updated ?? '').localeCompare(a.dataset.updated ?? ''),
      title: (a, b) => (a.dataset.search ?? '').localeCompare(b.dataset.search ?? ''),
    };

    function applySort() {
      const order = ORDERS[entrySort?.value ?? ''] ?? ORDERS.newest;
      sections.forEach(section => {
        const card = section.querySelector('.existing-card');
        if (!card) return;
        Array.from(card.querySelectorAll<HTMLElement>('.existing-row'))
          .sort(order)
          .forEach(row => card.appendChild(row));
      });
    }

    entrySearch?.addEventListener('input', applyEntryFilters);
    entrySort?.addEventListener('change', applySort);
    entryFilters.forEach(input => input.addEventListener('change', applyEntryFilters));

    /** Move a row to a status without re-reading it from the database. */
    function markRowStatus(slug: string, status: PostStatus) {
      const row = rowBySlug.get(slug);
      if (!row) return;
      row.dataset.status = status;
      /* Withdrawing a post is what "archived" means, so the row moves rather
         than sitting under a heading that is now wrong. Re-sorted after the
         move because it lands at the end of whichever card it went to. */
      const shelf = document
        .querySelector(`.entry-section[data-section="${status === 'unpublished' ? 'archived' : 'active'}"]`)
        ?.querySelector('.existing-card');
      if (shelf && row.parentElement !== shelf) {
        shelf.appendChild(row);
        applySort();
      }
      row.querySelector<HTMLElement>('[data-role="flag"]')!.textContent = status;
      row.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(item => {
        const on = item.dataset.status === status;
        item.setAttribute('aria-checked', String(on));
        if (on) item.setAttribute('aria-current', 'true');
        else item.removeAttribute('aria-current');
      });
      applyEntryFilters();
    }

    /* One open menu at a time. `<details>` has no notion of a group, and two
       panels overlapping each other is worse than the two lines it costs. */
    const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('.entry-menu'));
    menus.forEach(menu => {
      menu.addEventListener('toggle', () => {
        if (menu.open) menus.forEach(other => { if (other !== menu) other.open = false; });
      });
    });
    document.addEventListener('click', event => {
      const inside = (event.target as Element | null)?.closest?.('.entry-menu');
      menus.forEach(menu => { if (menu !== inside) menu.open = false; });
    });

    rows.forEach(row => {
      const slug = row.dataset.slug!;
      const line = row.querySelector<HTMLElement>('[data-role="status"]')!;
      const menu = row.querySelector<HTMLDetailsElement>('.entry-menu')!;

      const say = (text: string, tone: 'info' | 'error' = 'info') => {
        line.dataset.tone = tone;
        line.textContent = text;
      };

      const statusItems = Array.from(row.querySelectorAll<HTMLButtonElement>('[data-status]'));
      const deleteItem = row.querySelector<HTMLButtonElement>('[data-action="delete"]')!;

      /* Editing is a link to a page that reads the same row, so it works signed
         out. Every control in this menu writes one, and none of them can. */
      if (!getToken()) {
        [...statusItems, deleteItem].forEach(item => {
          item.disabled = true;
          item.title = 'Sign in with GitHub — each of these writes to the live site.';
        });
        return;
      }

      statusItems.forEach(item => {
        item.addEventListener('click', async () => {
          const next = item.dataset.status as PostStatus;
          const previous = row.dataset.status as PostStatus;
          menu.open = false;
          if (next === previous) return;

          statusItems.forEach(other => { other.disabled = true; });
          say('Saving…');
          /* The menu closed the moment this started and the row can scroll out
             from under the reader, so the durable line below is not enough on
             its own — the toast is the half that actually gets seen. */
          const pending = toast(`Moving ${slug} to ${next}…`, { tone: 'pending' });

          try {
            const result = await setPostStatus(slug, next);
            markRowStatus(slug, next);

            /* Unpublishing takes the page away, so there is nothing to link to.
               The other two states are live the moment this returns. */
            if (next === 'published') {
              const anchor = document.createElement('a');
              anchor.href = result.url;
              anchor.target = '_blank';
              anchor.rel = 'noopener';
              anchor.textContent = 'view live ↗';
              line.dataset.tone = 'info';
              line.replaceChildren(document.createTextNode('Published — live now — '), anchor);
              pending.update(`${slug} is published and live.`, {
                tone: 'success',
                action: { label: 'view live ↗', href: result.url },
              });
            } else if (next === 'unpublished') {
              say('Unpublished — its URL now 404s.');
              pending.update(`${slug} is withdrawn. Its URL now 404s.`, { tone: 'success' });
            } else {
              say('Saved as a draft.');
              pending.update(`${slug} is back to a draft — off the public site.`, { tone: 'success' });
            }
          } catch (error) {
            markRowStatus(slug, previous);
            const text = error instanceof Error ? error.message : 'Save failed.';
            say(text, 'error');
            pending.update(text, { tone: 'error' });
          } finally {
            statusItems.forEach(other => { other.disabled = false; });
          }
        });
      });

      /* Two clicks, like the project cards: the first is the one people mean to
         take back. Unlike every delete on this surface before decision 18 there
         is no history holding a copy — the row is the only one there is — so the
         copy has to say the deletion is final, and it has to point at the
         reversible control that does the job people usually mean.

         `setLabel` rather than `textContent`: this menu item carries an inlined
         trash icon, and writing text straight onto it deleted that glyph for the
         life of the page. */
      let armed = false;
      let disarm: ReturnType<typeof setTimeout>;

      deleteItem.addEventListener('click', async () => {
        menu.open = false;

        if (!armed) {
          armed = true;
          setLabel(deleteItem, 'Confirm delete');
          say(
            `This deletes ${postPath(slug)} for good — there is no copy to restore it from. ` +
              'Unpublish instead if you only want it off the site. Open the menu and click ' +
              'again to confirm.',
            'error'
          );
          disarm = setTimeout(() => {
            armed = false;
            setLabel(deleteItem, null);
            say('');
          }, 6000);
          return;
        }

        clearTimeout(disarm);
        armed = false;
        setBusy(deleteItem, true, 'Deleting…');
        say('Deleting…');
        const pending = toast(`Deleting ${slug}…`, { tone: 'pending' });

        try {
          await removePost(slug);
          row.classList.add('is-removed');
          /* Its editor page resolves from the same row, so that link is dead the
             moment this returns — stop offering it. */
          row.querySelectorAll('button, a').forEach(control => {
            if (control instanceof HTMLButtonElement) control.disabled = true;
            else control.removeAttribute('href');
          });
          say('Deleted. The post is gone from the site.');
          pending.update(`${slug} is deleted.`, { tone: 'success' });
        } catch (error) {
          setBusy(deleteItem, false);
          const text = error instanceof Error ? error.message : 'Delete failed.';
          say(text, 'error');
          pending.update(text, { tone: 'error' });
        }
      });
    });
  });
</script>

<style>
  .jl-desc { opacity: 0.8; max-width: 70ch; margin: 0; }
  .jl-summary { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: var(--space-4); }
  .jl-note { margin-top: var(--space-4); max-width: 76ch; }

  .existing-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  /* — reordering — */
  .order-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .order-lede { max-width: 68ch; margin: 0; }

  .row-grip {
    display: inline-flex;
    padding: 2px;
    border: 0;
    background: none;
    border-radius: 7px;
    color: var(--color-text-faint);
    cursor: grab;
    vertical-align: middle;
  }
  .row-grip:hover { color: var(--color-text); }
  .row-grip:focus-visible { outline: 2px solid var(--color-accent); }
  .row-grip:active { cursor: grabbing; }

  /* The grip sits ahead of the title, inside the first grid cell. */
  .existing-id { flex-wrap: nowrap; }
  .is-orderable { cursor: grab; }
  @media (prefers-reduced-motion: no-preference) {
    .is-orderable { transition: box-shadow var(--dur-base) var(--ease-out); }
  }
  .is-orderable:hover { box-shadow: var(--shadow-sm); }
  .existing-row.is-dragging { opacity: 0.45; }

  .existing-head h6 { margin: 0; }
  .existing-filters { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .entry-search { width: 220px; font-size: 13px; padding: 6px 10px; }

  /* Two shelves, each its own card, so the heading and its sentence sit on the
     paper rather than inside the list. */
  .entry-section { margin-bottom: var(--space-6); }
  .entry-section:last-of-type { margin-bottom: 0; }
  .entry-section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }
  .entry-section-head h6 { margin: 0; }
  .entry-section-note { margin: 0; }

  .existing-card { gap: 0; }
  /* Title | date | edit | menu, with the summary tucked under the title and any
     status message spanning the whole row beneath — so a long sentence never
     squeezes the controls out of alignment with the row above it.

     Every cell is placed explicitly. Mixing definite rows with auto-placed
     columns makes the order depend on the auto-placement algorithm's two
     passes, which is not a thing to leave to chance in a list. */
  .existing-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: 2px var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-divider);
    font-size: 14px;
  }
  .existing-row:last-child { border-bottom: 0; }
  .existing-row[hidden] { display: none; }
  .existing-row.is-removed { opacity: 0.5; }

  .existing-id { grid-column: 1; grid-row: 1; display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
  .existing-title { font-weight: 600; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .existing-title:hover { color: var(--color-accent); }
  .existing-summary {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    font-size: 12px;
    /* One line: this is a manifest, and the summary is here to tell two similar
       titles apart rather than to be read. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Two stamps stacked: the post's date, and when the row was last written. */
  .existing-date {
    grid-column: 2;
    grid-row: 1 / span 2;
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .existing-edited { font-size: 11px; opacity: 0.7; }
  .existing-row > .btn { grid-column: 3; grid-row: 1 / span 2; }
  .entry-menu { grid-column: 4; grid-row: 1 / span 2; }

  .entry-line { grid-column: 1 / -1; grid-row: 3; min-height: 0; margin: 6px 0 0; }
  .entry-line:empty { display: none; }
  .entry-line[data-tone='error'] { color: var(--color-accent-700); }

  /* The flag mirrors the row's state, so the script rewrites one attribute
     rather than juggling three global tag variants. */
  .entry-flag { text-transform: lowercase; }
  .existing-row[data-status='draft'] .entry-flag {
    background: var(--color-accent-100);
    color: var(--color-accent-800);
  }
  .existing-row[data-status='published'] .entry-flag {
    background: var(--color-accent-2-100);
    color: var(--color-accent-2-800);
  }
  .existing-row[data-status='unpublished'] .entry-flag {
    background: var(--color-neutral-100);
    color: var(--color-neutral-800);
  }

  code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }

  /* Narrow, the date drops below the summary rather than eating the width the
     title needs, and the two controls keep their own columns. */
  @media (max-width: 700px) {
    .existing-row { grid-template-columns: minmax(0, 1fr) auto auto; }
    .existing-date { grid-column: 1; grid-row: 3; }
    .existing-row > .btn { grid-column: 2; grid-row: 1 / span 3; }
    .entry-menu { grid-column: 3; grid-row: 1 / span 3; }
    .entry-line { grid-row: 4; }
  }
</style>
