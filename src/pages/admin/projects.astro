---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminProjectCard from '../../components/AdminProjectCard.astro';
import Illustration from '../../components/Illustration.astro';
import { Icon } from 'astro-icon/components';
import { getDeepDiveSelection, getProjects } from '../../lib/content';
import { PROJECT_CATEGORIES, projectPath } from '../../lib/content-store';
import { grantAccessUrl, parseRepoUrl } from '../../lib/github';
import { site } from '../../lib/site';

/* Hidden projects are exactly what this screen manages, so it asks for them. */
/* The admin reads D1 per request, like every content route. Prerendering it
   would show the author the state of the last deploy while they are editing
   the state of the database — the two would disagree the moment anything was
   saved, which is exactly the confusion this surface exists to remove. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const projects = await getProjects(DB, true);
const GITHUB_USER = site.githubUser;

const rows = projects.map(project => {
  /* A project whose repository is private (or simply unmapped) has no URL to
     parse — the row stays, with nothing to link to. */
  const repo = project.data.repoUrl ? parseRepoUrl(project.data.repoUrl) : null;
  return {
    slug: project.slug,
    /* The row every action on this card writes to. Content is in D1, so this
       is a table and a primary key rather than a path in the repository —
       `projectPath()` is the one place that spelling is decided. */
    path: projectPath(project.slug),
    owner: repo?.owner ?? '',
    repoName: repo?.name ?? '',
    data: project.data,
  };
});

const hiddenCount = rows.filter(row => row.data.hidden).length;
const linkedCount = rows.filter(row => row.data.caseStudySlug).length;

/* — the line-up —

    Which projects lead the home page's Deep dives section, and in what order.

    It is edited here rather than on the dashboard because the flag it has to
    agree with is the visibility switch on these very cards — two screens apart,
    the two were easy to leave disagreeing (decision 55). And it is edited *on
    the manifest itself* rather than behind a tab beside it: there is one card
    per project on this screen, the cards above the line are the line-up in
    order, the cards below it are everything else, and dragging one across is
    the whole interaction. A tab would have been a second list of the same
    projects, which is a second place for the same fact to be wrong.

    Rows are **projects**, and they used to be case studies. That is the fix for
    a real bug and not a refactor: the section read straight out of
    `case_studies`, which has no idea a project is hidden, so retiring a project
    took it off `/projects` and 404'd its page while leaving its study leading
    the home page. Decision 53. */
const deepDiveSelection = await getDeepDiveSelection(DB);
const rowBySlug = new Map(rows.map(row => [row.slug, row]));

/* What the read side does with an empty selection, and what Automatic
   restores: the projects there is a write-up to read. */
const automatic = rows.filter(row => !row.data.hidden && row.data.caseStudySlug).map(row => row.slug);

/* Hidden projects cannot lead. A retired project cannot head a section it is
   not on, so the saved list is intersected with what is visible before it is
   drawn — the same intersection `getDeepDiveProjects()` does on the read side,
   which is what keeps the preview and the page from disagreeing. */
const picked = deepDiveSelection.filter(slug => rowBySlug.get(slug) && !rowBySlug.get(slug)!.data.hidden);
const lineUp = picked.length > 0 ? picked : automatic;
const inLineUp = new Set(lineUp);

/* The line-up in its saved order, then everything else in the site's canonical
   order — hidden projects included, because this screen is where one is
   brought back. */
const leadRows = lineUp.map(slug => rowBySlug.get(slug)!);
const restRows = rows.filter(row => !inLineUp.has(row.slug));
---
<AdminLayout title="Project Manager">
  <div class="admin-main-wide" id="admin-projects" data-user={GITHUB_USER}>
    <p class="admin-eyebrow-mono">MODULE: PROJECT_MGMT</p>
    <h1 class="pm-title">Project Portfolio</h1>
    <p class="pm-desc">
      Import repositories and manage what is visible. <strong>Import</strong> has a screen of
      its own; <strong>Edit</strong> on a card opens that project's page, where the fields
      and its case study live. Every change here writes a row in <code>projects</code> and is
      live on the site immediately — there is no build to wait for.
    </p>

    <section class="card elev-sm source-control">
      <div class="source-head">
        <p class="admin-eyebrow">Source Control</p>
        <div class="admin-actions">
          {/* "Authorize" was the wrong verb and it cost an afternoon: signing
              in already authorises the App, so a button offering to do it
              again reads as done. What is missing on a fresh account is the
              *installation*, which is the thing that carries repository
              access — see `grantAccessUrl()`. */}
          <a class="btn btn-secondary" href={grantAccessUrl()} target="_blank" rel="noopener">
            <Icon name="lucide:shield-check" class="admin-nav-icon" />Repository access
          </a>
          <a class="btn btn-primary" href="/admin/projects/import">
            <Icon name="lucide:git-branch" class="admin-nav-icon" />Import from GitHub
          </a>
          <a class="btn btn-secondary" href="/admin/" id="connect-github">Connect to GitHub</a>
        </div>
      </div>
      <hr class="rule" />
      <div class="source-row">
        <div class="source-identity">
          <img class="source-avatar" id="source-avatar" alt="" width="40" height="40" hidden />
          <div>
            <p class="source-account" id="source-account">Connected Account: @{GITHUB_USER}</p>
            <div class="source-tags">
              <span class="tag tag-neutral" id="session-pill">not signed in · read only</span>
              <span class="tag tag-accent-2">{rows.length} projects tracked</span>
              <span class="tag tag-accent-2">{linkedCount} linked to a case study</span>
              {hiddenCount > 0 && <span class="tag tag-neutral">{hiddenCount} hidden</span>}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* — the manifest, in two regions —

        One card per project, in one of two places: above the line it leads the
        home page's Deep dives section, below it it does not. Drag a card across
        to change that. Order inside the top region is the order the section
        renders in, and Save writes it as one document.

        The boundary is `.pm-band`, this surface's own: a rule at the tab
        bar's weight, which is what the admin already uses to say "a section
        ends here". `SectionSep` — the hatched, full-bleed band with corner
        nodes — is a *public page* mark. It was tried here and was wrong twice
        over: nothing else on the admin draws it, and its hatch is a hairline in
        `--hatch-ink`, which on the light themes reads as a rendering artifact
        rather than as a boundary. */}

    {/* Search and filter, client-side against the cards already on the page —
        there is no pagination here, so there is nothing to ask the server
        for. It runs across both regions. */}
    {rows.length > 0 && (
      <div class="pm-filter-bar">
        <input
          type="search"
          id="pm-search"
          class="input pm-search"
          placeholder="Search projects…"
          aria-label="Search projects"
          autocomplete="off"
        />
        <select class="input is-auto" id="pm-status-filter" aria-label="Filter by visibility">
          <option value="all">All visibility</option>
          <option value="visible">Visible</option>
          <option value="hidden">Hidden</option>
        </select>
        <select class="input is-auto" id="pm-category-filter" aria-label="Filter by category">
          <option value="all">All categories</option>
          {PROJECT_CATEGORIES.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
        <p class="text-muted pm-results-count" id="pm-results-count" aria-live="polite"></p>
      </div>
    )}

    {/* Nothing tracked is a real state — a fresh checkout, or a portfolio
        emptied out — and it is the one moment the screen can say exactly what
        to do next instead of showing an empty grid and a rule. */}
    {rows.length === 0 && (
      <div class="card elev-sm">
        <div class="admin-empty">
          <div class="admin-empty-art"><Illustration name="the-void" /></div>
          <h3 class="admin-empty-title">No projects tracked yet</h3>
          <p class="admin-empty-copy">
            The <code>projects</code> table is empty. Import a repository and fill in the
            two fields GitHub cannot answer — a category and the highlights — and it is on
            the site as soon as you save.
          </p>
          <div class="admin-empty-actions">
            <a class="btn btn-primary btn-sm" href="/admin/projects/import">
              <Icon name="lucide:git-branch" class="admin-nav-icon" />Import from GitHub
            </a>
          </div>
        </div>
      </div>
    )}

    {rows.length > 0 && (
      <Fragment>
        <section class="pm-zone" data-zone="lead" aria-labelledby="pm-zone-lead-title">
          <div class="pm-zone-head">
            <div class="pm-zone-copy">
              <p class="admin-eyebrow" id="pm-zone-lead-title">
                Deep dives (<span data-role="zone-count">{leadRows.length}</span>)
              </p>
              <p class="text-muted admin-note pm-zone-hint">
                These lead the home page, in this order. Which side of the line a card is
                on is the whole of that decision — there is no switch for it. Nothing here
                hides anything: a project below the line is still on <code>/projects</code>
                and still has its own page. An empty region falls back to the projects that
                have a case study, and a hidden project cannot lead, so retiring one sends
                its card down.
              </p>
            </div>
            <div class="dd-controls">
              <div class="admin-actions">
                <button type="button" class="btn btn-secondary btn-sm" id="dd-reset">Automatic</button>
                <button type="button" class="btn btn-primary btn-sm" id="dd-save">Save layout</button>
              </div>
              <p class="text-muted admin-note dd-status" id="dd-status"></p>
            </div>
          </div>
          <hr class="rule" />
          <div class="pm-grid pm-zone-grid" id="pm-grid-lead" data-default={automatic.join(',')}>
            {leadRows.map(row => (
              <AdminProjectCard
                slug={row.slug}
                path={row.path}
                owner={row.owner}
                repoName={row.repoName}
                data={row.data}
              />
            ))}
          </div>
          <p class="text-muted admin-note pm-zone-empty" id="pm-lead-empty" hidden></p>
        </section>

        <hr class="pm-band" />

        <section class="pm-zone" data-zone="rest" aria-labelledby="pm-zone-rest-title">
          <div class="pm-zone-head">
            <div class="pm-zone-copy">
              <p class="admin-eyebrow" id="pm-zone-rest-title">
                Everything else (<span data-role="zone-count">{restRows.length}</span>)
              </p>
              <p class="text-muted admin-note pm-zone-hint">
                The rest of the index, and every hidden project. Drag a card above the
                line to make it lead — or focus its grip and press Enter.
              </p>
            </div>
          </div>
          <hr class="rule" />
          <div class="pm-grid pm-zone-grid" id="pm-grid-rest">
            {restRows.map(row => (
              <AdminProjectCard
                slug={row.slug}
                path={row.path}
                owner={row.owner}
                repoName={row.repoName}
                data={row.data}
              />
            ))}
          </div>
          <p class="text-muted admin-note pm-zone-empty" id="pm-rest-empty" hidden></p>
        </section>
      </Fragment>
    )}

    <div class="admin-empty" id="pm-no-results" hidden>
      <div class="admin-empty-art admin-empty-art-sm"><Illustration name="no-data" /></div>
      <p class="admin-empty-copy">No tracked project matches that search and filter.</p>
    </div>

    <p class="text-muted admin-note visibility-note" id="write-note">
      Signed out, this screen is read-only — visibility, the line-up, editing and delete
      all need a GitHub session, because each one writes to the live database.
    </p>
  </div>
</AdminLayout>

<script>
  import { onAdminPage, setBusy, setLabel, toast } from '../../lib/admin';
  import { relativeTime } from '../../lib/format';
  import { patchProject, removeProject, saveDeepDives } from '../../lib/content-store';
  import {
    canWriteContent,
    fetchRepoMeta,
    getToken,
    getUser,
    grantAccessUrl,
  } from '../../lib/github';

  /* The admin client-routes, so this runs on first paint and again every time
     you come back to this screen — see `onAdminPage`. */
  onAdminPage('#admin-projects', () => {
    const signedIn = Boolean(getToken() && getUser());
    const message = (error: unknown) => (error instanceof Error ? error.message : 'Request failed.');

    /* `site.githubUser` is a frontmatter constant, so a client script cannot
       see it — the `data-user` attribute on the root is the seam. */
    const OWNER = (document.getElementById('admin-projects') as HTMLElement).dataset.user!;

    /* — session banner —

       Signed in, every switch on this screen writes a row; signed out none of
       them does anything at all. The screen says which of the two it is in
       rather than looking identical in both states. */
    const account = getUser();
    if (signedIn && account) {
      document.getElementById('source-account')!.textContent = `Connected Account: @${account.login}`;
      const pill = document.getElementById('session-pill')!;
      pill.textContent = 'signed in · checking access…';
      pill.className = 'tag tag-neutral';
      const avatar = document.getElementById('source-avatar') as HTMLImageElement;
      avatar.src = account.avatarUrl;
      avatar.alt = `@${account.login}`;
      avatar.hidden = false;
      document.getElementById('connect-github')!.remove();

      /* Holding a token is not the same as being able to write, and this banner
         used to claim it was — a "writes enabled" pill appeared the moment a
         session existed, and then every switch below it failed, which reads as
         a broken screen rather than as a session the endpoint will not accept.
         Ask GitHub instead: `canWriteContent()` asks who the token belongs to,
         which is the same question `requireOwner()` asks server-side and the
         one that actually decides whether a save lands. */
      const note = document.getElementById('write-note')!;
      canWriteContent().then(allowed => {
        pill.textContent = allowed ? 'signed in · writes enabled' : 'signed in · not the site owner';
        pill.className = allowed ? 'tag tag-accent' : 'tag tag-neutral';

        if (allowed) {
          note.textContent =
            'Every action here writes to the site immediately. There is no build or deploy to wait for.';
          return;
        }

        const link = document.createElement('a');
        /* Called here rather than baked into the markup: by now
           `canWriteContent()` has resolved, so if an installation exists this
           points at that installation's own page instead of the generic one. */
        link.href = grantAccessUrl();
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'the App’s installation ↗';
        note.dataset.tone = 'error';
        note.replaceChildren(
          document.createTextNode(
            'GitHub does not report this session as the owner of this site, so visibility, ' +
              'editing and delete will all be refused — the write endpoint admits one account ' +
              `and it is @${OWNER}. Sign out and back in with that account. Repository ` +
              `access for the import list is a separate grant on the site's repository, at `
          ),
          link,
          document.createTextNode('.')
        );
        toast('This session is signed in, but not as the site owner — saves will be refused.', {
          tone: 'error',
        });
      });
    }

    function say(host: HTMLElement, text: string, tone: 'info' | 'error' = 'info') {
      host.dataset.tone = tone;
      host.textContent = text;
    }

    /* The URL a save returns is the **live page**, not a commit — there is no
       commit and no build between pressing the button and the page changing.
       Any "view commit" left on this surface is stale by definition. */
    function sayLink(host: HTMLElement, text: string, url: string) {
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.target = '_blank';
      anchor.rel = 'noopener';
      anchor.textContent = 'view live ↗';
      host.dataset.tone = 'info';
      host.replaceChildren(document.createTextNode(`${text} — `), anchor);
    }

    // ---------------------------------------------------------------- cards

    const root = document.getElementById('admin-projects')!;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.pm-card'));
    const statusOf = (card: HTMLElement) => card.querySelector<HTMLElement>('[data-role="status"]')!;

    /* What the line-up editor below needs to know when a project is retired or
       brought back. It is assigned there rather than called from there because
       the visibility switch is wired first and has to keep working on a screen
       with no line-up on it — an empty manifest. */
    let onHidden: (slug: string, hidden: boolean) => void = () => applyPmFilters();

    // ------------------------------------------------------ search & filter

    /* Client-side against the cards already on the page — this screen has no
       pagination, so there is nothing further to ask the server for. */
    const pmSearch = document.getElementById('pm-search') as HTMLInputElement | null;
    const pmStatusFilter = document.getElementById('pm-status-filter') as HTMLSelectElement | null;
    const pmCategoryFilter = document.getElementById('pm-category-filter') as HTMLSelectElement | null;
    const pmResultsCount = document.getElementById('pm-results-count');
    const pmNoResults = document.getElementById('pm-no-results') as HTMLElement | null;

    /* A region has to keep its box when it empties — it is a drop target, and a
       target that disappears when the last card leaves it is one that cannot be
       dropped into. The note inside it says which kind of empty it is: nothing
       put there, or nothing left after a filter. */
    const zoneNotes = [
      {
        grid: document.getElementById('pm-grid-lead'),
        note: document.getElementById('pm-lead-empty'),
        bare: 'Nothing leads the home page yet — drag a project up here, or focus its grip and press Enter.',
      },
      {
        grid: document.getElementById('pm-grid-rest'),
        note: document.getElementById('pm-rest-empty'),
        bare: 'Every project leads the home page, so there is nothing below the line.',
      },
    ];

    function applyPmFilters() {
      const term = (pmSearch?.value ?? '').trim().toLowerCase();
      const status = pmStatusFilter?.value ?? 'all';
      const category = pmCategoryFilter?.value ?? 'all';
      let visible = 0;

      for (const card of cards) {
        const matchesTerm = !term || (card.dataset.title ?? '').includes(term);
        const matchesStatus =
          status === 'all' || (status === 'hidden' ? card.dataset.hidden === '1' : card.dataset.hidden === '0');
        const matchesCategory = category === 'all' || card.dataset.category === category;
        const shown = matchesTerm && matchesStatus && matchesCategory;
        card.style.display = shown ? '' : 'none';
        if (shown) visible += 1;
      }

      for (const zone of zoneNotes) {
        if (!zone.grid || !zone.note) continue;
        const held = Array.from(zone.grid.querySelectorAll<HTMLElement>('.pm-card'));
        const shown = held.filter(card => card.style.display !== 'none').length;
        zone.note.textContent = held.length === 0 ? zone.bare : 'No project in this section matches that search and filter.';
        /* The attribute, not a class: `global.css` asserts `[hidden]` with
           `!important` because a `display` in the component layer outranks
           Tailwind's preflight otherwise — decision 26. */
        zone.note.hidden = shown > 0;
      }

      if (pmResultsCount) {
        pmResultsCount.textContent = `Showing ${visible} of ${cards.length} project${cards.length === 1 ? '' : 's'}`;
      }
      if (pmNoResults) pmNoResults.hidden = visible > 0 || cards.length === 0;
    }

    pmSearch?.addEventListener('input', applyPmFilters);
    pmStatusFilter?.addEventListener('change', applyPmFilters);
    pmCategoryFilter?.addEventListener('change', applyPmFilters);
    applyPmFilters();

    /* Visibility. The row is the only truth; signed out there is nowhere to
       write, so the switch is disabled rather than recording an intention in
       this browser that nothing will ever apply.

       The toast is the second report, and on this control it is the one that
       gets read: the switch is on a card in a grid, and the line under it is
       frequently off screen by the time the request comes back. */
    function bindToggle(toggle: HTMLButtonElement, line: HTMLElement) {
      if (!signedIn) {
        toggle.disabled = true;
        toggle.title = 'Sign in with GitHub to change visibility.';
        return;
      }

      toggle.addEventListener('click', async () => {
        const slug = toggle.dataset.slug!;
        const visible = toggle.getAttribute('aria-checked') !== 'true';
        toggle.setAttribute('aria-checked', String(visible));
        toggle.disabled = true;

        say(line, visible ? 'Publishing…' : 'Hiding…');
        const pending = toast(`${visible ? 'Publishing' : 'Hiding'} ${slug}…`, { tone: 'pending' });
        try {
          const result = await patchProject(slug, { hidden: !visible });
          syncToggles(slug, visible);
          if (visible) {
            sayLink(line, 'Visible now', result.url);
            pending.update(`${slug} is visible.`, {
              tone: 'success',
              action: { label: 'view live ↗', href: result.url },
            });
          } else {
            say(line, 'Hidden — its page now 404s.');
            pending.update(`${slug} is hidden. Its page now 404s.`, { tone: 'success' });
          }
        } catch (error) {
          toggle.setAttribute('aria-checked', String(!visible));
          say(line, message(error), 'error');
          pending.update(message(error), { tone: 'error' });
        } finally {
          toggle.disabled = false;
        }
      });
    }

    /* `data-hidden` on the card is the same field a second time — read by the
       visibility filter above, and by the rule that a hidden project cannot
       lead the home page. It is written here so the two cannot drift apart. */
    function syncToggles(slug: string, visible: boolean) {
      document
        .querySelectorAll<HTMLButtonElement>(`.toggle[data-slug="${CSS.escape(slug)}"]`)
        .forEach(toggle => toggle.setAttribute('aria-checked', String(visible)));
      cards
        .filter(card => card.dataset.slug === slug)
        .forEach(card => { card.dataset.hidden = visible ? '0' : '1'; });
      onHidden(slug, !visible);
    }

    cards.forEach(card => {
      const button = (action: string) => card.querySelector<HTMLButtonElement>(`[data-action="${action}"]`)!;
      const line = statusOf(card);
      bindToggle(card.querySelector<HTMLButtonElement>('.toggle')!, line);

      /* Edit is an anchor to `/admin/projects/<slug>`, so it needs nothing
         here. */

      /* Fetch is the only action that works signed out — the public API answers
         an unauthenticated read, and the branch and push time are public facts. */
      button('fetch').addEventListener('click', async () => {
        const fetchButton = button('fetch');
        setBusy(fetchButton, true, 'Reading…');
        say(line, 'Reading the repository…');
        try {
          const meta = await fetchRepoMeta(card.dataset.owner!, card.dataset.repo!);
          card.querySelector('.pm-branch')!.textContent = `branch: ${meta.defaultBranch}`;
          card.querySelector('.pm-sync')!.textContent = `last push: ${relativeTime(meta.pushedAt)}`;
          const notes = [`${meta.stars} ★`];
          if (meta.archived) notes.push('archived on GitHub');
          say(line, notes.join(' · '));
        } catch (error) {
          say(line, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          setBusy(fetchButton, false);
        }
      });

      /* Two clicks, because the first one is the one people mean to take back.
         There is no history holding a copy any more — the row is the only one
         there is — so the confirm is doing more work than it used to and the
         copy has to say the deletion is final. */
      let armed = false;
      let disarm: ReturnType<typeof setTimeout>;
      button('delete').addEventListener('click', async () => {
        const del = button('delete');
        if (!signedIn) return say(line, 'Sign in to delete a project.', 'error');

        if (!armed) {
          armed = true;
          setLabel(del, 'Confirm delete');
          say(line, `This deletes the row ${card.dataset.path} for good. Click again to confirm.`, 'error');
          disarm = setTimeout(() => {
            armed = false;
            setLabel(del, null);
            say(line, '');
          }, 5000);
          return;
        }

        clearTimeout(disarm);
        armed = false;
        setBusy(del, true, 'Deleting…');
        say(line, 'Deleting…');
        const pending = toast(`Deleting ${card.dataset.slug}…`, { tone: 'pending' });
        try {
          await removeProject(card.dataset.slug!);
          card.classList.add('is-removed');
          card.querySelectorAll('button').forEach(b => { b.disabled = true; });
          say(line, 'Deleted. The project is gone from the site.');
          pending.update(`${card.dataset.slug} is deleted.`, { tone: 'success' });
        } catch (error) {
          setBusy(del, false);
          say(line, message(error), 'error');
          pending.update(message(error), { tone: 'error' });
        }
      });
    });

    // -------------------------------------------------- the deep dives line-up

    /* The two regions *are* the state: which grid holds a card is whether that
       project leads the home page, and DOM order inside the top grid is the
       order the section renders in. Every action moves a card and lets Save
       read the truth back out of the page — there is no second copy of the
       order to keep honest, and no second list of the same projects. */
    const leadGrid = document.getElementById('pm-grid-lead');
    if (leadGrid) {
      const restGrid = document.getElementById('pm-grid-rest')!;
      const ddStatus = document.getElementById('dd-status')!;
      const ddSave = document.getElementById('dd-save') as HTMLButtonElement;
      const ddReset = document.getElementById('dd-reset') as HTMLButtonElement;

      const cardsIn = (zone: HTMLElement) => Array.from(zone.querySelectorAll<HTMLElement>('.pm-card'));

      /* Save stays disabled until the lead region differs from the last save —
         the same contract as the journal order. Every move funnels through
         `syncLead()` below; the snapshot moves only on a good save. */
      const ddOrder = () => cardsIn(leadGrid).map(card => card.dataset.slug!).join(',');
      let ddSaved = ddOrder();
      const paintDd = () => {
        if (!signedIn || ddSave.hasAttribute('aria-busy')) return;
        const dirty = ddOrder() !== ddSaved;
        ddSave.disabled = !dirty;
        if (dirty) ddSave.removeAttribute('title');
        else ddSave.title = 'The line-up matches what is saved.';
      };

      /* The counts in the two headings are the line-up's size and the index's,
         so they move with the cards rather than with the page load. */
      const zoneHeads = [
        { grid: leadGrid, count: document.querySelector<HTMLElement>('[data-zone="lead"] [data-role="zone-count"]') },
        { grid: restGrid, count: document.querySelector<HTMLElement>('[data-zone="rest"] [data-role="zone-count"]') },
      ];

      /* There is nothing to sync a card *to*: which grid holds it is the only
         record of whether it leads, which is why it carries no switch saying so
         as well. Redrawing after a move is the region headings and the empty
         notes, both of which `applyPmFilters` already owns. */
      function syncLead() {
        for (const zone of zoneHeads) {
          if (zone.count) zone.count.textContent = String(cardsIn(zone.grid).length);
        }
        applyPmFilters();
        paintDd();
      }

      async function ddCommit(slugs: string[], note: string) {
        setBusy(ddSave, true, 'Saving…');
        let saved = false;
        try {
          await saveDeepDives(slugs);
          say(ddStatus, note);
          toast('Deep dives updated.', { tone: 'success' });
          saved = true;
        } catch (error) {
          say(ddStatus, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          setBusy(ddSave, false);
        }
        /* After the busy restore, so the fresh snapshot paints. Failures
           keep their dirt. */
        if (saved) {
          ddSaved = ddOrder();
          paintDd();
        }
      }

      if (!signedIn) {
        for (const button of [ddSave, ddReset]) {
          button.disabled = true;
          button.title = 'Sign in with GitHub to change the home page.';
        }
      }

      ddSave.addEventListener('click', () => {
        if (!signedIn) return;
        const slugs = cardsIn(leadGrid).map(card => card.dataset.slug!);
        void ddCommit(
          slugs,
          slugs.length
            ? `Saved — ${slugs.length} ${slugs.length === 1 ? 'project leads' : 'projects lead'} the home page, in the order laid out above.`
            : 'Saved — nothing picked, so the section falls back to the projects with a case study.',
        );
      });

      ddReset.addEventListener('click', () => {
        if (!signedIn) return;
        /* Restore what the read side does with an empty selection — the
           projects that have a case study lead, in the site's canonical order,
           and everything else goes below the line — then save the empty list,
           which is what "automatic" is stored as.

           Both regions, not just the top one. A card left above the line
           because nothing moved it down would be a manifest disagreeing with
           the empty selection just saved. */
        const held = new Map([...cardsIn(leadGrid), ...cardsIn(restGrid)].map(card => [card.dataset.slug!, card]));
        const wanted = (leadGrid.dataset.default ?? '').split(',').filter(Boolean);
        wanted.forEach(slug => {
          const card = held.get(slug);
          if (card) leadGrid.append(card);
        });
        for (const [slug, card] of held) {
          if (!wanted.includes(slug)) restGrid.append(card);
        }
        syncLead();
        void ddCommit([], 'Automatic — the projects with a case study lead, the rest follow.');
      });

      /* Moving a card between regions, by whichever route. A hidden project is
         refused the top region outright: it cannot head a section it is not on,
         and letting one up here is the disagreement the line-up was moved onto
         this screen to end. */
      function moveTo(card: HTMLElement, lead: boolean) {
        const allowed = lead && card.dataset.hidden !== '1';
        if (lead && !allowed) say(statusOf(card), 'A hidden project cannot lead the home page.', 'error');
        const target = allowed ? leadGrid! : restGrid;
        /* Only when the region actually changes. `append` on the parent a card
           is already in moves it to the end, which would throw away the
           position a drop inside one region had just chosen. */
        if (card.parentElement !== target) target.append(card);
        syncLead();
      }
      /* Retiring a project takes it out of the line-up in the same gesture,
         rather than leaving a card above the line that the read side drops. */
      onHidden = (slug, hidden) => {
        const card = [...cardsIn(leadGrid), ...cardsIn(restGrid)].find(c => c.dataset.slug === slug);
        if (card && hidden && card.parentElement === leadGrid) moveTo(card, false);
        else applyPmFilters();
      };

      /* Dragging, and everything that has to exist for it to be fair: a
         keyboard path through the grip's arrow keys, and a switch that makes
         the same move for anyone not using a pointer. */
      if (signedIn) {
        let dragged: HTMLElement | null = null;

        for (const card of [...cardsIn(leadGrid), ...cardsIn(restGrid)]) {
          card.classList.add('is-draggable');
          card.draggable = true;

          card.addEventListener('dragstart', event => {
            dragged = card;
            card.classList.add('is-dragging');
            root.classList.add('is-reordering');
            event.dataTransfer?.setData('text/plain', card.dataset.slug ?? '');
            if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
          });
          card.addEventListener('dragend', () => {
            card.classList.remove('is-dragging');
            root.classList.remove('is-reordering');
            dragged = null;
            /* The drop already moved the node; a hidden project dragged up is
               sent straight back down, with the reason on its own status line. */
            moveTo(card, card.parentElement === leadGrid);
          });

          /* The keyboard's whole path through this, since there is no switch:
             the arrows reorder inside a region and Enter crosses the line. */
          card.querySelector<HTMLButtonElement>('.pm-grip')?.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
              event.preventDefault();
              moveTo(card, card.parentElement !== leadGrid);
              card.querySelector<HTMLButtonElement>('.pm-grip')?.focus();
              return;
            }
            const delta =
              event.key === 'ArrowUp' || event.key === 'ArrowLeft'
                ? -1
                : event.key === 'ArrowDown' || event.key === 'ArrowRight'
                  ? 1
                  : 0;
            if (!delta) return;
            event.preventDefault();
            const zone = card.parentElement!;
            const siblings = cardsIn(zone);
            const neighbour = siblings[siblings.indexOf(card) + delta];
            if (!neighbour) return;
            if (delta < 0) neighbour.before(card);
            else neighbour.after(card);
            syncLead();
          });
        }

        /* Live reorder: the dragged card moves as the pointer crosses a
           neighbour, so the layout *is* the drop preview. The pointer's offset
           from a card's centre picks before/after on whichever axis dominates,
           which is what makes a card in a wide track behave like every other
           slot. An empty region takes the card whole. */
        function bindZone(grid: HTMLElement) {
          const surface = grid.closest<HTMLElement>('.pm-zone') ?? grid;
          surface.addEventListener('dragover', event => {
            if (!dragged) return;
            event.preventDefault();
            if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
            const card = (event.target as HTMLElement).closest<HTMLElement>('.pm-card');
            if (!card) {
              if (!cardsIn(grid).length && dragged.parentElement !== grid) grid.append(dragged);
              return;
            }
            if (card === dragged || card.parentElement !== grid) return;
            const box = card.getBoundingClientRect();
            const dx = event.clientX - (box.left + box.width / 2);
            const dy = event.clientY - (box.top + box.height / 2);
            const after = Math.abs(dx) > Math.abs(dy) ? dx > 0 : dy > 0;
            if (after ? dragged.nextElementSibling === card : dragged.previousElementSibling === card) return;
            if (after) card.after(dragged);
            else card.before(dragged);
          });
          surface.addEventListener('drop', event => event.preventDefault());
        }
        bindZone(leadGrid);
        bindZone(restGrid);
      }

      syncLead();
    }
  });
</script>

<style>
  .pm-title { margin-bottom: 4px; }
  .pm-desc { opacity: 0.8; max-width: 70ch; margin-bottom: var(--space-6); }
  .pm-desc code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }

  .source-control { margin-bottom: var(--space-6); }
  .source-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .source-head h6 { margin: 0; }
  .source-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); }
  .source-identity { display: flex; align-items: center; gap: var(--space-3); }
  .source-avatar { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--color-divider); flex: none; }
  .source-account { margin: 0; font-weight: 600; font-size: 14px; }
  .source-tags { display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap; }

  .pm-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .pm-search { max-width: 320px; flex: 1 1 200px; }
  .pm-filter-bar :global(.select) { width: auto; }
  .pm-filter-bar :global(.select-button) { font-family: var(--font-mono); font-size: 12px; }
  .pm-results-count {
    margin: 0 0 0 auto;
    font-size: 12px;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .pm-filter-bar { align-items: stretch; }
    .pm-search { max-width: none; flex-basis: auto; }
    .pm-filter-bar :global(.select) { width: 100%; }
    .pm-results-count { margin-left: 0; }
  }

  /* Track count comes from the available width rather than from a breakpoint:
     each card holds a 2×2 field grid whose longest value is a full `owner/name`
     in mono. 440px was where that never wrapped, and it was also one column
     beside a docked assistant panel — the manifest keeps ~770px there at
     1794px. 360px is two columns in that room and three at full width, at the
     price of a long repository name wrapping once. `min()` keeps the track
     from overflowing a viewport narrower than the minimum. */
  .pm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: var(--space-4);
  }

  /* The card's own layout lives in `AdminProjectCard.astro`, and it has to:
     the component root does not carry this page's `data-astro-cid`, so a
     `.pm-card` rule written here would silently match nothing. What is left
     here is the grid it sits in. */

  .visibility-note { margin-top: var(--space-6); max-width: 70ch; }
  .visibility-note code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }
  /* Set when the access check comes back read-only — the one case where this
     footnote is reporting a fault rather than describing the screen. */
  .visibility-note[data-tone='error'] { color: var(--color-accent-700); }

  /* — the two regions —

     Not a panel and not a tray: two runs of the same grid with the site's own
     section band between them. The band is what says these are two halves of
     one list rather than two lists, which is the whole reason the line-up is
     edited on the manifest instead of beside it. */
  .pm-zone { position: relative; }
  .pm-zone-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }
  .pm-zone-copy { min-width: 0; }
  .pm-zone-hint { max-width: 72ch; margin-top: 4px; }
  .pm-zone-grid { margin-top: var(--space-4); }

  /* A region keeps its box when it empties, because an empty region is still a
     drop target. `min-height` is roughly a card, so the target is somewhere a
     card can plausibly be aimed at. */
  .pm-zone-grid:empty { min-height: 120px; }
  .pm-zone-empty {
    margin-top: var(--space-3);
    text-align: center;
    padding: var(--space-4) 0;
    border: 1px dashed var(--color-divider);
    border-radius: var(--radius-md);
  }
  .pm-zone-empty[hidden] { display: none; }

  /* Both regions light up while a card is in the air — the one being left as
     much as the one being aimed at, because either is a legal drop and a target
     that only appears under the pointer is one you have to discover. */
  .is-reordering .pm-zone-grid,
  .is-reordering .pm-zone-empty {
    outline: 2px dashed color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 6px;
    border-radius: var(--radius-md);
  }

  /* The boundary between the two regions, in this surface's own grammar: a
     rule at the weight `.tab-bar` uses to close a section, not the public
     pages' hatched full-bleed `SectionSep` — nothing else on the admin draws
     that, and its hatch is a hairline that reads as an artifact here.

     `--sep-ink` and `--rule-style`, not `--color-divider` and `solid`. That
     pair is the theme's *section boundary*, raised to a mid-ramp step by every
     theme precisely because a divider between two rows of text wants to be
     barely there and a boundary between two sections wants to be read — at
     `--color-divider` this line was the same weight as the card edges either
     side of it, which is the way it disappears. */
  .pm-band {
    border: 0;
    border-top: 2px var(--rule-style) var(--sep-ink);
    margin: var(--space-8) 0;
  }

  /* Save reports beside its own button, and takes no room until it has
     something to say — an empty status line here would push the divider away
     from the grid it is meant to be the edge of. */
  .dd-controls { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .dd-status { margin: 0; text-align: right; max-width: 46ch; }
  .dd-status:empty { display: none; }
  .dd-status[data-tone='error'] { color: var(--color-accent-700); }
</style>
