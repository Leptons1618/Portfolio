---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AssistPanel from '../../components/AssistPanel.astro';
import { Icon } from 'astro-icon/components';
import Illustration from '../../components/Illustration.astro';
import { getProjects } from '../../lib/content';
import { documentOf, getResume } from '../../lib/resume';

/* The editor seeds from the same row the public page renders, so what you see
   here is the live content rather than a mock. Projects come from the live
   table for the same reason: a variant references projects by slug and the
   picker has to offer what actually exists — including hidden ones, flagged, so
   an author is told why a project they remember is not on the list. */
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

const resume = await getResume(DB);
const projects = await getProjects(DB, true);

const seed = {
  document: documentOf(resume),
  person: resume.person,
  projects: projects.map(project => ({
    slug: project.slug,
    title: project.data.title,
    summary: project.data.summary,
    year: project.data.year,
    stack: project.data.stack,
    repoUrl: project.data.repoUrl,
    demoUrl: project.data.demoUrl ?? '',
    hidden: project.data.hidden,
  })),
};
---
<AdminLayout title="Resume Editor">
  <div class="re-wrap">
    <div class="admin-head">
      <div>
        <h1 class="admin-title-sm">Resume</h1>
        <span class="text-muted admin-stamp" id="resume-stamp">
          [ status: editing // seeded from documents/resume ]
        </span>
      </div>
      <div class="admin-actions">
        <button type="button" class="btn btn-secondary" id="assist-open">
          <Icon name="lucide:sparkles" class="admin-nav-icon" />Assistant
        </button>
        <a class="btn btn-secondary" href="/resume" target="_blank" rel="noopener">Live ↗</a>
        <button type="button" class="btn btn-secondary" id="print-resume">
          <Icon name="lucide:printer" class="admin-nav-icon" />Print / PDF
        </button>
        <button type="button" class="btn btn-secondary" id="export-resume">Export JSON</button>
        <button type="button" class="btn btn-primary" id="commit-resume">Save</button>
      </div>
    </div>

    {/* — which resume is open —

        Above the tabs rather than inside them, because it governs both of
        them: the Tailor panel edits whatever is selected here and the Preview
        renders it. A control that changed what two tabs showed from inside one
        of them would be a control you cannot see while using the other. */}
    <div class="card elev-sm rv-bar">
      <div class="rv-row">
        <span class="pm-field-label rv-caption">Resume</span>
        <div class="rv-list" id="rv-list" role="tablist" aria-label="Which resume is open"></div>
        <button type="button" class="btn btn-secondary btn-sm" id="rv-new">
          <Icon name="lucide:plus" class="admin-nav-icon" />New variant
        </button>
      </div>

      <div class="rv-row rv-row-settings">
        <label class="field rv-field" id="rv-name-field">
          <span>Name</span>
          <input class="input" id="rv-label" placeholder="ML / CV Engineer" />
        </label>
        <label class="field rv-field rv-field-narrow">
          <span>Sheet</span>
          <select class="input" id="rv-layout"></select>
        </label>
        <label class="field rv-field rv-field-narrow">
          <span>Shown on /resume</span>
          <select class="input" id="rv-public"></select>
        </label>
        <div class="rv-danger">
          <button type="button" class="btn btn-secondary btn-sm" id="rv-duplicate">Duplicate</button>
          <button type="button" class="btn btn-secondary btn-sm admin-danger" id="rv-delete">Delete</button>
        </div>
      </div>
    </div>

    <div class="tab-bar" role="tablist" aria-label="Resume view" id="re-tabs">
      <button type="button" class="tab" role="tab" id="re-tab-master" aria-controls="re-panel-master" aria-selected="true">
        <Icon name="lucide:library" class="admin-nav-icon" />Master content
      </button>
      <button type="button" class="tab" role="tab" id="re-tab-tailor" aria-controls="re-panel-tailor" aria-selected="false">
        <Icon name="lucide:sliders-horizontal" class="admin-nav-icon" />Tailor
      </button>
      <button type="button" class="tab" role="tab" id="re-tab-preview" aria-controls="re-panel-preview" aria-selected="false">
        <Icon name="lucide:eye" class="admin-nav-icon" />Preview
      </button>
    </div>

    {/* Each section is a `<details>`, so collapsing is the platform's job — the
        open/close, the keyboard behaviour and the fact that a closed section's
        inputs leave the focus order all come free, and none of it is script. */}
    <div class="tab-panel" id="re-panel-master" role="tabpanel" aria-labelledby="re-tab-master">
      <div class="editor-col">
        <p class="text-muted admin-note re-hint">
          Written once, shared by every variant. Fix a date here and it is fixed on all of them.
        </p>

        <details class="card elev-sm ed-section" open>
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Summary <span class="tag tag-neutral ed-count" id="count-summary"></span>
            </h6>
          </summary>
          <div class="ed-body">
            <textarea class="input summary-input" id="summary" data-rs-line placeholder="The default professional statement. A variant may override it."></textarea>
          </div>
        </details>

        <details class="card elev-sm ed-section" open>
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Experience <span class="tag tag-neutral ed-count" id="count-experience"></span>
            </h6>
          </summary>
          <div class="ed-body">
            <div id="experience-list" class="entry-list"></div>
            <button type="button" class="btn btn-secondary btn-block" id="add-experience">Add a role</button>
          </div>
        </details>

        <details class="card elev-sm ed-section">
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Skills <span class="tag tag-neutral ed-count" id="count-skills"></span>
            </h6>
          </summary>
          <div class="ed-body">
            <div id="skills-groups" class="skill-groups"></div>
            <button type="button" class="btn btn-secondary btn-block" id="add-skill-group">Add a skill group</button>
          </div>
        </details>

        <details class="card elev-sm ed-section">
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Education <span class="tag tag-neutral ed-count" id="count-education"></span>
            </h6>
          </summary>
          <div class="ed-body">
            <div id="education-list" class="entry-list"></div>
            <button type="button" class="btn btn-secondary btn-block" id="add-education">Add an entry</button>
          </div>
        </details>

        <details class="card elev-sm ed-section">
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Certifications <span class="tag tag-neutral ed-count" id="count-certifications"></span>
            </h6>
          </summary>
          <div class="ed-body">
            <div id="cert-list" class="cert-rows"></div>
            <div class="skill-add">
              <input class="input" id="cert-input" placeholder="Add a certification…" />
              <button type="button" class="btn btn-secondary" id="add-cert">Insert</button>
            </div>
          </div>
        </details>
      </div>
    </div>

    <div class="tab-panel" id="re-panel-tailor" role="tabpanel" aria-labelledby="re-tab-tailor" hidden>
      <div class="editor-col" id="tailor-body">
        <details class="card elev-sm ed-section" open>
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">This variant</h6>
          </summary>
          <div class="ed-body">
            <label class="field">
              <span>Summary for this role <em class="text-muted">— empty falls back to the master's</em></span>
              <textarea class="input summary-input" id="tv-summary" data-rs-line></textarea>
            </label>
            <label class="field">
              <span>Role being applied for <em class="text-muted">— paste the advert; the assistant reads it</em></span>
              <textarea class="input jd-input" id="tv-jd" placeholder="Paste the job description here."></textarea>
            </label>
          </div>
        </details>

        <details class="card elev-sm ed-section" open>
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Experience <span class="tag tag-neutral ed-count" id="tv-count-experience"></span>
            </h6>
          </summary>
          <div class="ed-body"><div id="tv-experience" class="pick-list"></div></div>
        </details>

        <details class="card elev-sm ed-section" open>
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Projects <span class="tag tag-neutral ed-count" id="tv-count-projects"></span>
            </h6>
          </summary>
          <div class="ed-body">
            <div id="tv-projects" class="pick-list"></div>
            <div class="skill-add">
              <select class="input" id="tv-project-pick"></select>
              <button type="button" class="btn btn-secondary" id="tv-project-add">Add</button>
            </div>
          </div>
        </details>

        <details class="card elev-sm ed-section">
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">
              Skills <span class="tag tag-neutral ed-count" id="tv-count-skills"></span>
            </h6>
          </summary>
          <div class="ed-body"><div id="tv-skills" class="pick-list"></div></div>
        </details>

        <details class="card elev-sm ed-section">
          <summary class="ed-summary">
            <h6 class="admin-eyebrow ed-legend">Education &amp; certifications</h6>
          </summary>
          <div class="ed-body">
            <div id="tv-education" class="pick-list"></div>
            <hr class="rule" />
            <div id="tv-certifications" class="pick-list"></div>
          </div>
        </details>
      </div>

      <div class="admin-empty" id="tailor-empty" hidden>
        <div class="admin-empty-art admin-empty-art-sm"><Illustration name="personal-settings" /></div>
        <h4 class="admin-empty-title">No variant is open</h4>
        <p class="admin-empty-copy">
          A variant is one resume aimed at one kind of role — which of your jobs, skills and
          projects it shows, and how each of them is worded. The history itself stays in
          <strong>Master content</strong>.
        </p>
        <div class="admin-empty-actions">
          <button type="button" class="btn btn-primary" id="tailor-empty-new">Create the first variant</button>
        </div>
      </div>
    </div>

    <div class="tab-panel" id="re-panel-preview" role="tabpanel" aria-labelledby="re-tab-preview" hidden>
      <div class="pv-bar">
        <span class="pm-field-label pv-label" id="pv-what"></span>
        <button type="button" class="btn btn-secondary btn-sm" id="pv-print">
          <Icon name="lucide:printer" class="admin-nav-icon" />Print / Save PDF
        </button>
      </div>
      {/* The sheet at its real width on a real page, rather than an
          approximation of it: `#rs-preview` is filled with exactly the string
          `/resume` renders and `resume.css` styles both. The scroller is what
          keeps 210mm from widening the screen on a laptop. */}
      <div class="pv-scroll">
        <div class="rs-paper" id="rs-preview"></div>
      </div>
      <p class="text-muted admin-note preview-note">
        This is the same renderer, the same stylesheet and the same page size the PDF uses —
        A4 at 14mm margins. Print from here to check the page breaks before you send it.
      </p>
    </div>

    <p class="text-muted admin-note export-note">
      <strong>Save</strong> writes the whole document — master and every variant — to
      <code>documents/resume</code>, and the public page renders it on the next request.
      <strong>Export</strong> downloads the same JSON as a backup. Identity fields stay in
      <code>src/lib/site.ts</code> and are never written here.
    </p>
  </div>

  <AssistPanel
    surface="resume"
    sub="Tailors the open variant. It never edits the master and never saves."
  />

  <script is:inline type="application/json" id="resume-seed" set:html={JSON.stringify(seed)}></script>
</AdminLayout>

<script>
  import { ADMIN_KEYS, onAdminPage, setBusy, toast, undoRing, wireTabs } from '../../lib/admin';
  import { saveResume } from '../../lib/content-store';
  import { getToken } from '../../lib/github';
  import { runAssist } from '../../lib/ai-store';
  import { mountAssistPanel } from '../../lib/assist-panel';
  import {
    ASSIST_MENU,
    ASSIST_TASKS,
    VARIANT_KEYS,
    isAssistTask,
    parseFields,
    type AssistMenuItem,
    type AssistTask,
  } from '../../lib/assist-tasks';
  import { formatRange } from '../../lib/format';
  import {
    RESUME_LAYOUTS,
    isResumeLayout,
    newVariant,
    normaliseResume,
    resolveVariant,
    type ExperienceEntry,
    type Resume,
    type ResumeDocument,
    type ResumeLayout,
    type ResumePerson,
    type ResumeVariant,
  } from '../../lib/resume';
  import { renderSheet, resumeContext } from '../../lib/resume-render';

  interface SeedProject {
    slug: string;
    title: string;
    summary: string;
    year: number;
    stack: string[];
    repoUrl: string;
    demoUrl: string;
    hidden: boolean;
  }

  /* The admin client-routes, so this runs on first paint and again after every
     navigation back to this screen — see `onAdminPage`. */
  onAdminPage('#resume-seed', () => {
    const KEY = ADMIN_KEYS.resumeDraft;
    const seed = JSON.parse(document.getElementById('resume-seed')!.textContent || '{}') as {
      document: ResumeDocument;
      person: ResumePerson;
      projects: SeedProject[];
    };

    const person = seed.person;
    const allProjects = seed.projects;
    /* Only what a resume may cite. Hidden projects stay in `allProjects` so the
       picker can say *why* one is missing rather than leaving the author
       hunting for it. */
    const visibleProjects = allProjects.filter(project => !project.hidden);
    /* The resolver takes rows the way `content.ts` hands them out — `slug`
       beside `data` — and the seed is flat because every control on this screen
       reads it. Reshaped once here rather than inside `sheetNow()`, which runs
       on every keystroke. */
    const projectRows = visibleProjects.map(project => ({ slug: project.slug, data: project }));

    let state: ResumeDocument = normaliseResume(structuredClone(seed.document));
    /* Which resume is open: a variant id, or `''` for the master. Not persisted
       — it is where you are, not what you wrote. */
    let openId = state.publicVariant || state.variants[0]?.id || '';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    /* Wired first: a throw further down would otherwise leave a tablist with
       every panel showing at once. */
    wireTabs($('re-tabs'));

    const openVariant = (): ResumeVariant | null =>
      state.variants.find(variant => variant.id === openId) ?? null;

    /* Everything downstream — the preview, the assistant's context, the print
       sheet — goes through the one resolver the public page uses. */
    const asResume = (): Resume => ({ ...state, person: { ...person, summary: state.summary } });
    const sheetNow = () => resolveVariant(asResume(), openId, projectRows);

    /* ---------- storage ---------- */

    function persist() {
      localStorage.setItem(KEY, JSON.stringify(state));
      $('resume-stamp').textContent =
        `[ status: editing // draft saved ${new Date().toLocaleTimeString()} ]`;
    }

    /* ---------- small builders, shared by both panels ---------- */

    const el = <T extends HTMLElement>(tag: string, className = ''): T => {
      const node = document.createElement(tag) as T;
      if (className) node.className = className;
      return node;
    };

    /** A labelled control. The one shape every field on this screen has. */
    function field(
      label: string,
      control: HTMLElement,
      modifier = '',
    ): HTMLLabelElement {
      const wrap = el<HTMLLabelElement>('label', `field${modifier ? ` ${modifier}` : ''}`);
      const caption = el('span');
      caption.textContent = label;
      wrap.append(caption, control);
      return wrap;
    }

    /**
     * A text control bound to one property of one object.
     *
     * Every editable string on this screen is this: read on build, written on
     * `input`, and followed by a repaint of the preview but *not* of the list
     * it lives in. Re-rendering a list from inside its own input handler is how
     * an editor loses the caret on every keystroke.
     */
    function bound<T, K extends keyof T>(
      row: T,
      key: K,
      options: { placeholder?: string; multiline?: boolean; type?: string; line?: boolean } = {},
    ): HTMLInputElement | HTMLTextAreaElement {
      const node = el<HTMLInputElement | HTMLTextAreaElement>(
        options.multiline ? 'textarea' : 'input',
        'input',
      );
      if (options.type) (node as HTMLInputElement).type = options.type;
      if (options.placeholder) node.placeholder = options.placeholder;
      /* Marks a control the assistant's line rewriter may target. */
      if (options.line) node.dataset.rsLine = '';
      node.value = String(row[key] ?? '');
      node.addEventListener('input', () => {
        (row[key] as unknown as string) = node.value;
        persist();
        renderPreview();
      });
      return node;
    }

    /** A row of small buttons: move up, move down, remove. */
    function reorder(
      list: unknown[],
      index: number,
      after: () => void,
      removeLabel = 'Remove',
    ): HTMLElement {
      const controls = el('div', 'entry-controls');
      const action = (label: string, title: string, run: () => void, disabled = false) => {
        const button = el<HTMLButtonElement>('button', 'btn btn-secondary entry-action');
        button.type = 'button';
        button.textContent = label;
        button.title = title;
        button.disabled = disabled;
        button.addEventListener('click', () => {
          run();
          persist();
          after();
        });
        return button;
      };
      const move = (to: number) => {
        const [row] = list.splice(index, 1);
        list.splice(to, 0, row);
      };
      controls.append(
        action('↑', 'Move up', () => move(index - 1), index === 0),
        action('↓', 'Move down', () => move(index + 1), index === list.length - 1),
        action(removeLabel, 'Remove this entry', () => list.splice(index, 1)),
      );
      return controls;
    }

    /**
     * A checkbox row: included or not, plus whatever the caller hangs off it.
     *
     * The one control the Tailor panel is built from. Selection is a checkbox
     * rather than a two-list "available / chosen" transfer because a resume has
     * a dozen items, not two hundred, and a checkbox says the same thing with
     * no drag target to miss.
     */
    function pickRow(label: string, checked: boolean, onToggle: (on: boolean) => void): HTMLElement {
      const row = el('div', 'pick-row');
      const head = el<HTMLLabelElement>('label', 'pick-head');
      const box = el<HTMLInputElement>('input');
      box.type = 'checkbox';
      box.checked = checked;
      box.addEventListener('change', () => onToggle(box.checked));
      const text = el('span', 'pick-label');
      text.textContent = label;
      head.append(box, text);
      row.append(head);
      return row;
    }

    /* ---------- the master panel ---------- */

    const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

    function renderExperience() {
      const host = $('experience-list');
      host.replaceChildren();

      state.experience.forEach((entry, index) => {
        const wrap = el('div', 'admin-subcard');

        const grid = el('div', 'entry-grid');
        grid.append(
          field('Title', bound(entry, 'title', { placeholder: 'Software Engineer' })),
          field('Company', bound(entry, 'company', { placeholder: 'Axcend Automation' })),
          field('Start', bound(entry, 'start', { type: 'month' })),
          field('End — empty means Present', bound(entry, 'end', { type: 'month' })),
        );
        wrap.append(grid);
        wrap.append(field('Location', bound(entry, 'location', { placeholder: 'Bengaluru, India' })));
        wrap.append(
          field(
            'Description — one framing sentence',
            bound(entry, 'description', { multiline: true, line: true }),
            'entry-description-field',
          ),
        );

        /* What a recruiter actually scans, so it is a list of its own rather
           than newlines inside the paragraph above. */
        const points = el('div', 'points');
        const pointsLabel = el('span', 'pm-field-label');
        pointsLabel.textContent = 'Highlights — one outcome each';
        points.append(pointsLabel);

        entry.highlights.forEach((_, pi) => {
          const row = el('div', 'point-row');
          const input = el<HTMLTextAreaElement>('textarea', 'input point-input');
          input.dataset.rsLine = '';
          input.value = entry.highlights[pi];
          input.rows = 2;
          input.addEventListener('input', () => {
            entry.highlights[pi] = input.value;
            persist();
            renderPreview();
          });
          const drop = el<HTMLButtonElement>('button', 'btn btn-secondary entry-action');
          drop.type = 'button';
          drop.textContent = '×';
          drop.title = 'Remove this highlight';
          drop.addEventListener('click', () => {
            entry.highlights.splice(pi, 1);
            persist();
            renderExperience();
            renderPreview();
          });
          row.append(input, drop);
          points.append(row);
        });

        const addPoint = el<HTMLButtonElement>('button', 'btn btn-secondary btn-sm');
        addPoint.type = 'button';
        addPoint.textContent = 'Add a highlight';
        addPoint.addEventListener('click', () => {
          entry.highlights.push('');
          persist();
          renderExperience();
        });
        points.append(addPoint);
        wrap.append(points);

        wrap.append(
          reorder(state.experience, index, () => {
            syncVariantIds();
            renderExperience();
            renderTailor();
            renderPreview();
          }, 'Remove role'),
        );

        host.append(wrap);
      });
    }

    function renderEducation() {
      const host = $('education-list');
      host.replaceChildren();

      state.education.forEach((entry, index) => {
        const wrap = el('div', 'admin-subcard');
        const grid = el('div', 'entry-grid');
        grid.append(
          field('Degree', bound(entry, 'degree', { placeholder: "Master's degree, Computer Science" })),
          field('School', bound(entry, 'school', { placeholder: 'Pondicherry University' })),
          field('Start', bound(entry, 'start', { type: 'month' })),
          field('End', bound(entry, 'end', { type: 'month' })),
        );
        wrap.append(grid);
        wrap.append(
          reorder(state.education, index, () => {
            syncVariantIds();
            renderEducation();
            renderTailor();
            renderPreview();
          }, 'Remove'),
        );
        host.append(wrap);
      });
    }

    function renderSkills() {
      const host = $('skills-groups');
      host.replaceChildren();

      state.skills.forEach((group, gi) => {
        const wrap = el('div', 'skill-group');

        const head = el('div', 'skill-head');
        const name = el<HTMLInputElement>('input', 'input skill-name');
        name.value = group.category;
        name.placeholder = 'Group name';
        name.addEventListener('input', () => {
          /* A renamed group is a group every variant referenced by its old
             name, so the references move with it. */
          const from = group.category;
          group.category = name.value;
          for (const variant of state.variants) {
            for (const pick of variant.skills) if (pick.category === from) pick.category = name.value;
          }
          persist();
          renderPreview();
        });
        const dropGroup = el<HTMLButtonElement>('button', 'btn btn-secondary entry-action');
        dropGroup.type = 'button';
        dropGroup.textContent = 'Remove group';
        dropGroup.addEventListener('click', () => {
          state.skills.splice(gi, 1);
          syncVariantIds();
          persist();
          renderSkills();
          renderTailor();
          renderPreview();
        });
        head.append(name, dropGroup);
        wrap.append(head);

        const chips = el('div', 'skill-chips');
        group.items.forEach((item, ii) => {
          const chip = el<HTMLButtonElement>('button', 'tag tag-button tag-neutral');
          chip.type = 'button';
          chip.textContent = `${item} ×`;
          chip.setAttribute('aria-label', `Remove ${item}`);
          chip.addEventListener('click', () => {
            group.items.splice(ii, 1);
            persist();
            renderSkills();
            renderTailor();
            renderPreview();
          });
          chips.append(chip);
        });
        wrap.append(chips);

        const row = el('div', 'skill-add');
        const input = el<HTMLInputElement>('input', 'input');
        input.placeholder = `Add to ${group.category || 'this group'}…`;
        const insert = el<HTMLButtonElement>('button', 'btn btn-secondary');
        insert.type = 'button';
        insert.textContent = 'Insert';
        const commit = () => {
          const value = input.value.trim();
          if (!value) return;
          group.items.push(value);
          input.value = '';
          persist();
          renderSkills();
          renderTailor();
          renderPreview();
        };
        insert.addEventListener('click', commit);
        input.addEventListener('keydown', event => {
          if (event.key === 'Enter') {
            event.preventDefault();
            commit();
          }
        });
        row.append(input, insert);
        wrap.append(row);

        host.append(wrap);
      });
    }

    function renderCertifications() {
      const host = $('cert-list');
      host.replaceChildren();

      state.certifications.forEach((item, index) => {
        const row = el('div', 'cert-row');
        const input = el<HTMLInputElement>('input', 'input');
        input.value = item;
        input.dataset.rsLine = '';
        input.addEventListener('input', () => {
          const from = state.certifications[index];
          state.certifications[index] = input.value;
          for (const variant of state.variants) {
            const at = variant.certifications.indexOf(from);
            if (at !== -1) variant.certifications[at] = input.value;
          }
          persist();
          renderPreview();
        });
        const drop = el<HTMLButtonElement>('button', 'btn btn-secondary entry-action');
        drop.type = 'button';
        drop.textContent = '×';
        drop.title = 'Remove';
        drop.addEventListener('click', () => {
          state.certifications.splice(index, 1);
          syncVariantIds();
          persist();
          renderCertifications();
          renderTailor();
          renderPreview();
        });
        row.append(input, drop);
        host.append(row);
      });
    }

    function renderCounts() {
      $('count-summary').textContent = plural(state.summary.trim().length, 'character');
      $('count-experience').textContent = plural(state.experience.length, 'role');
      const items = state.skills.reduce((total, group) => total + group.items.length, 0);
      $('count-skills').textContent = `${plural(state.skills.length, 'group')} · ${plural(items, 'skill')}`;
      $('count-education').textContent = plural(state.education.length, 'entry', 'entries');
      $('count-certifications').textContent = plural(state.certifications.length, 'item');
    }

    /* ---------- the variant bar ---------- */

    /**
     * Drop every reference a variant holds to something that no longer exists.
     *
     * Called after any structural change to the master. `resolveVariant` is
     * already tolerant of a dangling id — it filters them out — so this is
     * housekeeping rather than correctness: it stops a document accumulating
     * references to roles deleted a year ago, which would then come back to
     * life if an id were ever reused.
     */
    function syncVariantIds() {
      const roles = new Set(state.experience.map(entry => entry.id));
      const schools = new Set(state.education.map(entry => entry.id));
      const groups = new Set(state.skills.map(group => group.category));
      const certs = new Set(state.certifications);
      const slugs = new Set(visibleProjects.map(project => project.slug));

      for (const variant of state.variants) {
        variant.experience = variant.experience.filter(pick => roles.has(pick.id));
        variant.education = variant.education.filter(id => schools.has(id));
        variant.skills = variant.skills.filter(pick => groups.has(pick.category));
        variant.certifications = variant.certifications.filter(item => certs.has(item));
        variant.projects = variant.projects.filter(pick => slugs.has(pick.slug));
      }
    }

    function renderVariantBar() {
      const list = $('rv-list');
      list.replaceChildren();

      const chip = (id: string, label: string) => {
        const button = el<HTMLButtonElement>('button', 'rv-chip');
        button.type = 'button';
        button.setAttribute('role', 'tab');
        button.setAttribute('aria-selected', String(id === openId));
        button.textContent = label;
        if (id && id === state.publicVariant) {
          const mark = el('span', 'rv-live');
          mark.textContent = 'live';
          button.append(mark);
        }
        button.addEventListener('click', () => {
          openId = id;
          renderAll();
        });
        return button;
      };

      list.append(chip('', 'Master'));
      for (const variant of state.variants) list.append(chip(variant.id, variant.label));

      const variant = openVariant();
      const label = $<HTMLInputElement>('rv-label');
      const layout = $<HTMLSelectElement>('rv-layout');

      /* The master has no *name* and cannot be duplicated or deleted — it is
         not a variant. It does have a sheet, and it is the document that says
         which resume is public, so those two controls stay.

         This row used to be hidden wholesale on the master, on the reasoning
         that none of it applied. Two of the four did: the Sheet picker was the
         only way to choose a layout and the master could not reach it, so the
         resume everybody starts with was permanently whatever `resolveVariant`
         hard-coded. Hiding the one field that does not apply is the smaller
         rule and the one that is true. */
      $('rv-name-field').hidden = !variant;
      $<HTMLButtonElement>('rv-duplicate').disabled = !variant;
      $<HTMLButtonElement>('rv-delete').disabled = !variant;

      if (variant) label.value = variant.label;
      layout.value = variant ? variant.layout : state.layout;

      const publicPick = $<HTMLSelectElement>('rv-public');
      publicPick.replaceChildren();
      const none = el<HTMLOptionElement>('option');
      none.value = '';
      none.textContent = 'The master, unfiltered';
      publicPick.append(none);
      for (const entry of state.variants) {
        const option = el<HTMLOptionElement>('option');
        option.value = entry.id;
        option.textContent = entry.label;
        publicPick.append(option);
      }
      publicPick.value = state.publicVariant;
    }

    /* ---------- the tailor panel ---------- */

    function renderTailor() {
      const variant = openVariant();
      $('tailor-body').hidden = !variant;
      $('tailor-empty').hidden = Boolean(variant);
      $<HTMLButtonElement>('re-tab-tailor').disabled = false;
      if (!variant) return;

      $<HTMLTextAreaElement>('tv-summary').value = variant.summary ?? '';
      $<HTMLTextAreaElement>('tv-summary').placeholder = state.summary;
      $<HTMLTextAreaElement>('tv-jd').value = variant.jobDescription ?? '';

      /* — roles — */
      const roles = $('tv-experience');
      roles.replaceChildren();
      const picked = new Map(variant.experience.map((pick, index) => [pick.id, index]));

      /* Chosen roles first, in the variant's own order, then the rest. That is
         what makes the order editable at all: an unchecked row has no position
         to move. */
      const ordered = [
        ...variant.experience
          .map(pick => state.experience.find(entry => entry.id === pick.id))
          .filter((entry): entry is ExperienceEntry => Boolean(entry)),
        ...state.experience.filter(entry => !picked.has(entry.id)),
      ];

      ordered.forEach(entry => {
        const at = picked.get(entry.id);
        const on = at !== undefined;
        const row = pickRow(
          `${entry.title} — ${entry.company}`,
          on,
          checked => {
            if (checked) variant.experience.push({ id: entry.id });
            else variant.experience = variant.experience.filter(pick => pick.id !== entry.id);
            persist();
            renderTailor();
            renderPreview();
          },
        );

        const when = el('span', 'pick-meta');
        when.textContent = formatRange(entry.start, entry.end) || entry.dates || '';
        row.querySelector('.pick-head')!.append(when);

        if (on) {
          const pick = variant.experience[at!];
          row.append(
            reorder(variant.experience, at!, () => {
              renderTailor();
              renderPreview();
            }, '×'),
          );

          /* The override, behind a disclosure. Most roles do not need one, and
             a textarea per role open by default is a page of empty boxes. */
          const more = el<HTMLDetailsElement>('details', 'pick-override');
          more.open = pick.description !== undefined || pick.highlights !== undefined;
          const label = el('summary');
          label.textContent = pick.description !== undefined || pick.highlights !== undefined
            ? 'Reworded for this resume'
            : 'Reword for this resume';
          more.append(label);

          const body = el('div', 'pick-override-body');
          const description = el<HTMLTextAreaElement>('textarea', 'input');
          description.dataset.rsLine = '';
          description.rows = 2;
          description.placeholder = entry.description || 'Same as the master';
          description.value = pick.description ?? '';
          description.addEventListener('input', () => {
            if (description.value.trim()) pick.description = description.value;
            else delete pick.description;
            persist();
            renderPreview();
          });
          body.append(field('Description', description));

          const points = el<HTMLTextAreaElement>('textarea', 'input');
          points.dataset.rsLine = '';
          points.rows = 4;
          points.placeholder = entry.highlights.join('\n') || 'Same as the master';
          points.value = (pick.highlights ?? []).join('\n');
          points.addEventListener('input', () => {
            const lines = points.value.split('\n').map(line => line.trim()).filter(Boolean);
            if (points.value.trim()) pick.highlights = lines;
            else delete pick.highlights;
            persist();
            renderPreview();
          });
          body.append(field('Highlights — one per line', points));

          more.append(body);
          row.append(more);
        }

        roles.append(row);
      });
      $('tv-count-experience').textContent =
        `${variant.experience.length} of ${state.experience.length}`;

      /* — projects — */
      const projectHost = $('tv-projects');
      projectHost.replaceChildren();
      variant.projects.forEach((pick, index) => {
        const project = visibleProjects.find(entry => entry.slug === pick.slug);
        const row = el('div', 'pick-row');
        const head = el('div', 'pick-head');
        const name = el('span', 'pick-label');
        name.textContent = project ? project.title : pick.slug;
        const meta = el('span', 'pick-meta');
        meta.textContent = project ? `${project.year}` : 'missing';
        head.append(name, meta);
        row.append(head);

        const line = el<HTMLTextAreaElement>('textarea', 'input');
        line.dataset.rsLine = '';
        line.rows = 2;
        line.placeholder = project?.summary ?? 'One line for this resume';
        line.value = pick.line ?? '';
        line.addEventListener('input', () => {
          if (line.value.trim()) pick.line = line.value;
          else delete pick.line;
          persist();
          renderPreview();
        });
        row.append(line);
        row.append(
          reorder(variant.projects, index, () => {
            renderTailor();
            renderPreview();
          }, '×'),
        );
        projectHost.append(row);
      });
      $('tv-count-projects').textContent = plural(variant.projects.length, 'project');

      const pickList = $<HTMLSelectElement>('tv-project-pick');
      const chosen = new Set(variant.projects.map(pick => pick.slug));
      pickList.replaceChildren();
      const blank = el<HTMLOptionElement>('option');
      blank.value = '';
      blank.textContent = 'Add a project…';
      pickList.append(blank);
      for (const project of visibleProjects) {
        if (chosen.has(project.slug)) continue;
        const option = el<HTMLOptionElement>('option');
        option.value = project.slug;
        option.textContent = `${project.title} · ${project.year}`;
        pickList.append(option);
      }

      /* — skills — */
      const skillHost = $('tv-skills');
      skillHost.replaceChildren();
      const skillPicked = new Map(variant.skills.map((pick, index) => [pick.category, index]));
      const skillOrder = [
        ...variant.skills
          .map(pick => state.skills.find(group => group.category === pick.category))
          .filter((group): group is NonNullable<typeof group> => Boolean(group)),
        ...state.skills.filter(group => !skillPicked.has(group.category)),
      ];

      skillOrder.forEach(group => {
        const at = skillPicked.get(group.category);
        const on = at !== undefined;
        const row = pickRow(group.category, on, checked => {
          if (checked) variant.skills.push({ category: group.category });
          else variant.skills = variant.skills.filter(pick => pick.category !== group.category);
          persist();
          renderTailor();
          renderPreview();
        });

        if (on) {
          const pick = variant.skills[at!];
          const chips = el('div', 'skill-chips pick-chips');
          const shown = new Set(pick.items ?? group.items);
          group.items.forEach(item => {
            const chip = el<HTMLButtonElement>('button', 'tag tag-button');
            chip.type = 'button';
            chip.classList.add(shown.has(item) ? 'tag-accent' : 'tag-neutral');
            chip.textContent = item;
            chip.setAttribute('aria-pressed', String(shown.has(item)));
            chip.addEventListener('click', () => {
              const next = new Set(pick.items ?? group.items);
              if (next.has(item)) next.delete(item);
              else next.add(item);
              /* Back to "all of them" rather than an explicit copy of the
                 master, so adding a skill later shows up here too. */
              const kept = group.items.filter(entry => next.has(entry));
              if (kept.length === group.items.length) delete pick.items;
              else pick.items = kept;
              persist();
              renderTailor();
              renderPreview();
            });
            chips.append(chip);
          });
          row.append(chips);
          row.append(
            reorder(variant.skills, at!, () => {
              renderTailor();
              renderPreview();
            }, '×'),
          );
        }

        skillHost.append(row);
      });
      $('tv-count-skills').textContent = `${variant.skills.length} of ${state.skills.length}`;

      /* — education and certifications — */
      const eduHost = $('tv-education');
      eduHost.replaceChildren();
      const eduCaption = el('span', 'pm-field-label');
      eduCaption.textContent = 'Education';
      eduHost.append(eduCaption);
      for (const entry of state.education) {
        eduHost.append(
          pickRow(`${entry.degree} — ${entry.school}`, variant.education.includes(entry.id), checked => {
            variant.education = checked
              ? [...variant.education, entry.id]
              : variant.education.filter(id => id !== entry.id);
            persist();
            renderPreview();
          }),
        );
      }

      const certHost = $('tv-certifications');
      certHost.replaceChildren();
      const certCaption = el('span', 'pm-field-label');
      certCaption.textContent = 'Certifications';
      certHost.append(certCaption);
      for (const item of state.certifications) {
        certHost.append(
          pickRow(item, variant.certifications.includes(item), checked => {
            variant.certifications = checked
              ? [...variant.certifications, item]
              : variant.certifications.filter(entry => entry !== item);
            persist();
            renderPreview();
          }),
        );
      }
    }

    /* ---------- the preview ---------- */

    function renderPreview() {
      const sheet = sheetNow();
      $('rs-preview').innerHTML = renderSheet(sheet);
      const layout = RESUME_LAYOUTS.find(entry => entry.id === sheet.layout);
      $('pv-what').textContent = openVariant()
        ? `${sheet.variantLabel} · ${layout?.label ?? sheet.layout} · A4`
        : `Master, unfiltered · ${layout?.label ?? sheet.layout} · A4`;
      renderCounts();
    }

    function renderAll() {
      $<HTMLTextAreaElement>('summary').value = state.summary;
      renderVariantBar();
      renderExperience();
      renderSkills();
      renderEducation();
      renderCertifications();
      renderTailor();
      renderPreview();
    }

    /* ---------- wiring ---------- */

    const summaryInput = $<HTMLTextAreaElement>('summary');
    summaryInput.addEventListener('input', () => {
      state.summary = summaryInput.value;
      persist();
      renderPreview();
    });

    $<HTMLTextAreaElement>('tv-summary').addEventListener('input', function () {
      const variant = openVariant();
      if (!variant) return;
      variant.summary = this.value;
      persist();
      renderPreview();
    });

    $<HTMLTextAreaElement>('tv-jd').addEventListener('input', function () {
      const variant = openVariant();
      if (!variant) return;
      variant.jobDescription = this.value;
      persist();
    });

    $<HTMLInputElement>('rv-label').addEventListener('input', function () {
      const variant = openVariant();
      if (!variant) return;
      variant.label = this.value;
      persist();
      renderVariantBar();
      renderPreview();
    });

    const layoutPick = $<HTMLSelectElement>('rv-layout');
    for (const layout of RESUME_LAYOUTS) {
      const option = document.createElement('option');
      option.value = layout.id;
      option.textContent = layout.label;
      option.title = layout.hint;
      layoutPick.append(option);
    }
    layoutPick.addEventListener('change', () => {
      if (!isResumeLayout(layoutPick.value)) return;
      const chosen = layoutPick.value as ResumeLayout;
      /* Whichever resume is open owns the choice: a variant stores its own, and
         the master stores the document's. Same control, because it is the same
         decision — which is why it is not two. */
      const variant = openVariant();
      if (variant) variant.layout = chosen;
      else state.layout = chosen;
      persist();
      renderPreview();
    });

    $<HTMLSelectElement>('rv-public').addEventListener('change', function () {
      state.publicVariant = this.value;
      persist();
      renderVariantBar();
    });

    function createVariant(label: string, from?: ResumeVariant) {
      const variant = from
        ? { ...structuredClone(from), id: '', label }
        : newVariant(state, label);
      if (from) {
        /* `newVariant` mints the id; a duplicate has to as well, and the only
           thing that knows which ids are taken is `normaliseResume`. */
        variant.id = '';
        state.variants.push(variant);
        state = normaliseResume(state);
        openId = state.variants[state.variants.length - 1].id;
      } else {
        state.variants.push(variant);
        openId = variant.id;
      }
      persist();
      renderAll();
      $<HTMLInputElement>('rv-label').focus();
    }

    const newLabel = () => `Variant ${state.variants.length + 1}`;

    $<HTMLButtonElement>('rv-new').addEventListener('click', () => createVariant(newLabel()));
    $<HTMLButtonElement>('tailor-empty-new').addEventListener('click', () => createVariant(newLabel()));

    $<HTMLButtonElement>('rv-duplicate').addEventListener('click', () => {
      const variant = openVariant();
      if (variant) createVariant(`${variant.label} copy`, variant);
    });

    $<HTMLButtonElement>('rv-delete').addEventListener('click', () => {
      const variant = openVariant();
      if (!variant) return;
      if (!confirm(`Delete "${variant.label}"? The master content is not touched.`)) return;
      state.variants = state.variants.filter(entry => entry.id !== variant.id);
      if (state.publicVariant === variant.id) state.publicVariant = '';
      openId = state.variants[0]?.id ?? '';
      persist();
      renderAll();
      toast(`Deleted "${variant.label}".`, { tone: 'info' });
    });

    $<HTMLButtonElement>('add-experience').addEventListener('click', () => {
      state.experience.push({
        id: '',
        title: '',
        company: '',
        start: '',
        end: null,
        location: '',
        description: '',
        highlights: [],
      });
      /* Normalising is what mints the id, and it is the same function the read
         path uses — so a row added here is indistinguishable from a stored one. */
      state = normaliseResume(state);
      persist();
      renderExperience();
      renderTailor();
      renderPreview();
    });

    $<HTMLButtonElement>('add-education').addEventListener('click', () => {
      state.education.push({ id: '', school: '', degree: '', start: '', end: null });
      state = normaliseResume(state);
      persist();
      renderEducation();
      renderTailor();
      renderPreview();
    });

    $<HTMLButtonElement>('add-skill-group').addEventListener('click', () => {
      state.skills.push({ category: `Group ${state.skills.length + 1}`, items: [] });
      persist();
      renderSkills();
      renderTailor();
    });

    const certInput = $<HTMLInputElement>('cert-input');
    const addCert = () => {
      const value = certInput.value.trim();
      if (!value) return;
      state.certifications.push(value);
      certInput.value = '';
      persist();
      renderCertifications();
      renderTailor();
      renderPreview();
    };
    $<HTMLButtonElement>('add-cert').addEventListener('click', addCert);
    certInput.addEventListener('keydown', event => {
      if (event.key === 'Enter') {
        event.preventDefault();
        addCert();
      }
    });

    const projectPick = $<HTMLSelectElement>('tv-project-pick');
    $<HTMLButtonElement>('tv-project-add').addEventListener('click', () => {
      const variant = openVariant();
      if (!variant || !projectPick.value) return;
      variant.projects.push({ slug: projectPick.value });
      persist();
      renderTailor();
      renderPreview();
    });

    /* ---------- print, export, save ---------- */

    /* Printing the admin screen prints the preview and nothing else — the rule
       is in `admin.css`, hung off `body.is-printing`, because everything on
       this page except `#rs-preview` is chrome. */
    function printSheet() {
      const wasSelected = $('re-tab-preview').getAttribute('aria-selected') === 'true';
      if (!wasSelected) $<HTMLButtonElement>('re-tab-preview').click();
      document.body.classList.add('is-printing');
      /* One frame, so the tab swap and the class have both painted before the
         dialogue freezes the document. */
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          window.print();
          document.body.classList.remove('is-printing');
        }),
      );
    }

    $<HTMLButtonElement>('print-resume').addEventListener('click', printSheet);
    $<HTMLButtonElement>('pv-print').addEventListener('click', printSheet);

    $<HTMLButtonElement>('export-resume').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'resume.json';
      link.click();
      URL.revokeObjectURL(url);
      toast('Downloaded resume.json.', { tone: 'success' });
    });

    const commitBtn = $<HTMLButtonElement>('commit-resume');
    const stamp = $('resume-stamp');
    const signedIn = Boolean(getToken());

    if (!signedIn) {
      commitBtn.disabled = true;
      commitBtn.title = 'Sign in with GitHub to save.';
    }

    commitBtn.addEventListener('click', async () => {
      setBusy(commitBtn, true, 'Saving…');
      stamp.textContent = '[ status: saving documents/resume ]';
      const pending = toast('Saving the resume…', { tone: 'pending' });

      try {
        syncVariantIds();
        const { url } = await saveResume(state);

        const link = document.createElement('a');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'view live ↗';
        stamp.replaceChildren(document.createTextNode('[ status: saved // '), link, document.createTextNode(' ]'));
        pending.update('Resume saved and live.', {
          tone: 'success',
          action: { label: 'view live ↗', href: url },
        });
      } catch (error) {
        const text = error instanceof Error ? error.message : 'Save failed.';
        stamp.textContent = text;
        pending.update(text, { tone: 'error' });
      } finally {
        setBusy(commitBtn, false);
      }
    });

    /* ---------- the assistant ---------- */

    /* Which line the rewriter would act on. Tracked on focus rather than on
       selection, because the thing being rewritten here is a whole field — a
       bullet, a description, a project line — and not a range inside one. */
    let lastLine: HTMLInputElement | HTMLTextAreaElement | null = null;
    document.addEventListener(
      'focusin',
      event => {
        const target = event.target as HTMLElement;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) {
          if (target.dataset.rsLine !== undefined) lastLine = target;
        }
      },
      true,
    );

    const undo = undoRing();
    let assisting: AbortController | null = null;

    /** Snapshot the whole document. Cheap, and the only thing that is correct. */
    function takeSnapshot(label: string) {
      undo.push({ label, values: { doc: JSON.stringify(state) } });
    }

    function undoAction(): { label: string; run: () => void }[] {
      const entry = undo.peek();
      if (!entry) return [];
      return [
        {
          label: `Undo ${entry.label}`,
          run: () => {
            const popped = undo.pop();
            if (!popped) return;
            state = normaliseResume(JSON.parse(popped.values.doc) as ResumeDocument);
            if (!state.variants.some(variant => variant.id === openId)) openId = '';
            persist();
            renderAll();
            toast('Put back.', { tone: 'info' });
          },
        },
      ];
    }

    /** The `resume` context field: the sheet plus the ids a task may return. */
    const contextFor = (name: string): Record<string, string> => {
      const task: AssistTask = ASSIST_TASKS[name as keyof typeof ASSIST_TASKS];
      const variant = openVariant();
      const source: Record<string, string> = {
        resume: resumeContext(sheetNow(), {
          experience: state.experience.map(entry => ({
            id: entry.id,
            title: entry.title,
            company: entry.company,
            range: formatRange(entry.start, entry.end) || entry.dates || '',
          })),
          skills: state.skills,
          education: state.education.map(entry => ({
            id: entry.id,
            degree: entry.degree,
            school: entry.school,
          })),
          certifications: state.certifications,
        }),
        jobDescription: variant?.jobDescription ?? '',
        entry: lastLine?.value ?? '',
      };
      const out: Record<string, string> = {};
      for (const key of task.context) out[key] = source[key] ?? '';
      return out;
    };

    /** Apply a `suggest-projects` answer: `slug — one line`, per line. */
    function applyProjects(text: string): number {
      const variant = openVariant();
      if (!variant) return 0;
      const known = new Map(visibleProjects.map(project => [project.slug, project]));
      let added = 0;

      for (const raw of text.split('\n')) {
        const line = raw.trim().replace(/^[-*\d.\s]+/, '');
        if (!line) continue;
        const split = line.split(/\s+[—–-]\s+|:\s+/);
        const slug = split[0]?.trim().toLowerCase();
        if (!slug || !known.has(slug)) continue;
        const description = split.slice(1).join(' — ').trim();
        const existing = variant.projects.find(pick => pick.slug === slug);
        if (existing) existing.line = description || existing.line;
        else variant.projects.push({ slug, ...(description ? { line: description } : {}) });
        added += 1;
      }
      return added;
    }

    /**
     * Apply a `build-variant` answer. Every identifier is checked first.
     *
     * Returns what actually landed, section by section, rather than a boolean.
     * Everything but the label and the summary is a *selection from what the
     * author already has*, so an answer written in prose parses but matches
     * nothing — and "Variant applied" over a variant whose roles and projects
     * are exactly as they were is the report that sends someone looking for a
     * bug in the preview. `null` is the one honest failure: no label parsed at
     * all, so there was nothing to read.
     */
    function applyVariant(text: string): string[] | null {
      const { values, recognised } = parseFields(text, VARIANT_KEYS);
      if (!recognised) return null;

      /* Applied to the open variant, or to a new one when the master is open —
         which is what makes this task reachable from a blank slate. */
      let variant = openVariant();
      if (!variant) {
        createVariant(values.label.trim() || newLabel());
        variant = openVariant();
        if (!variant) return null;
      } else if (values.label.trim()) {
        variant.label = values.label.trim();
      }

      const csv = (value: string) => value.split(',').map(item => item.trim()).filter(Boolean);
      const applied: string[] = [];

      if (values.summary.trim()) {
        variant.summary = values.summary.trim();
        applied.push('the summary');
      }

      const roles = new Set(state.experience.map(entry => entry.id));
      const wantedRoles = csv(values.experience).filter(id => roles.has(id));
      if (wantedRoles.length) {
        const kept = new Map(variant.experience.map(pick => [pick.id, pick]));
        variant.experience = wantedRoles.map(id => kept.get(id) ?? { id });
        applied.push(`${wantedRoles.length} role${wantedRoles.length === 1 ? '' : 's'}`);
      }

      const groups = new Set(state.skills.map(group => group.category));
      const wantedSkills = csv(values.skills).filter(name => groups.has(name));
      if (wantedSkills.length) {
        const kept = new Map(variant.skills.map(pick => [pick.category, pick]));
        variant.skills = wantedSkills.map(category => kept.get(category) ?? { category });
        applied.push(`${wantedSkills.length} skill group${wantedSkills.length === 1 ? '' : 's'}`);
      }

      const schools = new Set(state.education.map(entry => entry.id));
      const wantedEdu = csv(values.education).filter(id => schools.has(id));
      if (wantedEdu.length) {
        variant.education = wantedEdu;
        applied.push('education');
      }

      const certs = new Set(state.certifications);
      const wantedCerts = csv(values.certifications).filter(item => certs.has(item));
      if (wantedCerts.length) {
        variant.certifications = wantedCerts;
        applied.push('certifications');
      }

      if (values.projects.trim()) {
        const before = variant.projects;
        variant.projects = [];
        const added = applyProjects(values.projects);
        if (added) applied.push(`${added} project${added === 1 ? '' : 's'}`);
        /* No slug matched, so this was prose about projects rather than a
           shortlist of them. Putting the old list back is the difference
           between "nothing was selected" and "the selection was deleted". */
        else variant.projects = before;
      }

      persist();
      renderAll();
      return applied;
    }

    async function runTask(name: string, instruction: string) {
      if (!isAssistTask(name)) return;
      const task: AssistTask = ASSIST_TASKS[name];
      const controller = new AbortController();
      assisting = controller;
      panel.running(true);

      const turn = panel.begin(task.label, name);
      const copy = (text: string) => ({
        label: 'Copy',
        run: () => navigator.clipboard?.writeText(text),
      });
      const again = { label: 'Try again', run: () => void runTask(name, instruction) };

      let raw = '';
      let thought = '';

      try {
        const output = await runAssist(
          name,
          contextFor(name),
          instruction,
          {
            onDelta: chunk => {
              raw += chunk;
              /* The one live target on this screen. Everything else is a
                 proposal and waits for a button. */
              if (task.live === 'resumeSummary') {
                const variant = openVariant();
                if (variant) {
                  variant.summary = raw;
                  $<HTMLTextAreaElement>('tv-summary').value = raw;
                  renderPreview();
                }
              } else {
                turn.answer(raw);
              }
            },
            onThinking: chunk => {
              thought += chunk;
              turn.thinking(chunk);
            },
            onTool: frame => turn.tool(frame),
          },
          controller.signal,
          /* The last entry is the message this call is *about*, and the route
             appends it itself. */
          name === 'chat' ? panel.history().slice(0, -1) : undefined,
          panel.runOptions(),
        );

        if (!output.trim()) {
          throw new Error(
            thought
              ? 'The model spent the whole token budget thinking and never wrote an answer. Open Thinking above to read it, then lower the effort in the toolbar or set this provider’s output ceiling on the AI screen.'
              : 'The model finished without writing anything.',
          );
        }

        if (task.live === 'resumeSummary') {
          persist();
          turn.status('Done — it is in this variant’s summary. Nothing is saved until you press Save.');
          turn.actions([...undoAction(), again]);
          turn.end(output);
          toast('Summary written into the variant.', { tone: 'success' });
          return;
        }

        if (name === 'resumeProjects') {
          turn.answer(output);
          turn.actions([
            {
              label: 'Add these projects',
              primary: true,
              run: () => {
                takeSnapshot('the project shortlist');
                const added = applyProjects(output);
                toast(
                  added ? `Added ${added} project${added === 1 ? '' : 's'}.` : 'None of those slugs matched a project.',
                  { tone: added ? 'success' : 'error' },
                );
              },
            },
            copy(output),
            again,
          ]);
          turn.end(output);
          return;
        }

        if (name === 'resumeVariant') {
          turn.answer(output);
          turn.actions([
            {
              label: 'Apply this variant',
              primary: true,
              run: () => {
                takeSnapshot('the generated variant');
                const applied = applyVariant(output);
                if (applied === null) {
                  toast('The reply was not in the expected format, so nothing changed.', { tone: 'error' });
                } else if (applied.length) {
                  toast(`Applied ${applied.join(', ')}. Check it in Preview.`, { tone: 'success' });
                } else {
                  /* Parsed, matched nothing. Almost always a model that wrote a
                     resume instead of choosing from this one — the ids and
                     slugs it needed were in front of it and it wrote prose. */
                  toast(
                    'None of that matched a role, skill group or project you have. Try again, or run it on a stronger model.',
                    { tone: 'error' },
                  );
                }
              },
            },
            copy(output),
            again,
          ]);
          turn.end(output);
          return;
        }

        if (name === 'resumeBullet') {
          const target = lastLine;
          turn.answer(output);
          turn.actions([
            {
              label: 'Replace the line',
              primary: true,
              run: () => {
                if (!target) return;
                takeSnapshot('the rewritten line');
                target.value = output.trim();
                target.dispatchEvent(new Event('input', { bubbles: true }));
                toast('Line replaced.', { tone: 'success' });
              },
            },
            copy(output),
            again,
          ]);
          turn.end(output);
          return;
        }

        /* `chat`, and anything added later that only answers. */
        turn.answer(output);
        turn.actions([copy(output), again]);
        turn.end(output);
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') {
          turn.status(raw ? 'Stopped.' : 'Stopped before anything arrived.');
          turn.actions([...undoAction(), again]);
        } else {
          const text = error instanceof Error ? error.message : 'The assistant failed.';
          turn.note(text, 'error');
          turn.actions([again]);
          toast(text, { tone: 'error' });
        }
        turn.end(raw);
      } finally {
        panel.running(false);
        if (assisting === controller) assisting = null;
      }
    }

    const panel = mountAssistPanel({
      surface: 'resume',
      docSlug: () => openId,
      stop: () => assisting?.abort(),
      run: (item, instruction) => runTask(item ? item.name : 'chat', instruction),
      blocked: (item: AssistMenuItem, instruction: string) => {
        if (item.name === 'resumeBullet' && !lastLine) {
          return 'Click into a highlight, a description or a project line first — that is what this rewrites.';
        }
        if (item.name !== 'resumeVariant' && item.surface === 'resume' && !openVariant()) {
          return 'Open a variant first. These tailor one resume; the master is what they all share.';
        }
        if (item.needsTopic && !instruction.trim()) {
          return `${item.label} needs an instruction — type it after the command.`;
        }
        return null;
      },
    });

    $<HTMLButtonElement>('assist-open').addEventListener('click', () => {
      if (panel.isOpen()) panel.close();
      else panel.open();
    });

    if (!signedIn) {
      const why = 'Sign in with GitHub to use the assistant.';
      const button = $<HTMLButtonElement>('assist-open');
      button.disabled = true;
      button.title = why;
    }

    /* Nothing here reads `ASSIST_MENU` directly — the panel builds its own list
       from it, filtered by surface — but importing it is what makes the
       typecheck fail if the resume tasks are ever removed from the table. */
    void ASSIST_MENU;

    /* ---------- restore ---------- */

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved && Array.isArray(saved.experience)) {
        /* Normalised on the way in, exactly like a stored row: a draft written
           before variants existed comes back as a document that has them. */
        state = normaliseResume(saved as ResumeDocument);
        openId = state.publicVariant || state.variants[0]?.id || '';
        $('resume-stamp').textContent = '[ status: editing // draft restored from this browser ]';
      }
    } catch {
      /* ignore a corrupt draft */
    }

    renderAll();
  });
</script>

<style>
  /* Capped and centred, once, around the whole screen. A form is only as good
     as its measure — but a cap with no `margin-inline` is a column pinned to
     the left edge of a very wide screen. */
  .re-wrap { max-width: var(--wrap-mid); margin-inline: auto; }

  .editor-col { display: flex; flex-direction: column; gap: var(--space-4); }
  .re-hint { margin: 0 0 var(--space-1); }
  .summary-input { min-height: 100px; }
  .jd-input { min-height: 140px; font-size: 13px; }

  /* — which resume is open — */
  .rv-bar { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-4); }
  .rv-row { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .rv-caption { margin-bottom: 0; flex: none; }
  .rv-list { display: flex; gap: 6px; flex-wrap: wrap; flex: 1; min-width: 0; }
  .rv-row-settings { align-items: flex-end; padding-top: var(--space-3); border-top: 1px dashed var(--color-divider); }
  .rv-field { flex: 1; min-width: 180px; margin: 0; }
  .rv-field-narrow { flex: 0 1 200px; }
  .rv-danger { display: flex; gap: 6px; }

  /* — collapsible sections —

     `.card` is a flex column; a `<details>` is not one, and making it one is a
     fight with the UA's disclosure machinery for no gain. */
  .ed-section { display: block; }

  .ed-summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    list-style: none;
  }

  .ed-summary::-webkit-details-marker { display: none; }
  .ed-summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* The section label is still an `h6`, so it keeps whatever the active theme
     does to an eyebrow — Blueprint's `§` included. `<summary>` allows exactly
     one heading as its content, which is why the count rides inside it. */
  .ed-legend { flex: 1; margin: 0; min-width: 0; }
  .ed-count { margin-left: var(--space-2); text-transform: none; letter-spacing: 0; }

  /* Drawn rather than iconised: it has to rotate, and an inlined SVG in the
     markup would be a third thing inside a `<summary>` that may hold one. */
  .ed-summary::after {
    content: '▾';
    flex: none;
    color: var(--color-accent);
    font-size: 11px;
    transition: transform 0.15s;
  }

  .ed-section[open] > .ed-summary::after { transform: rotate(180deg); }

  .ed-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-divider);
  }

  .entry-list { display: flex; flex-direction: column; gap: var(--space-3); }
  .skill-groups { display: flex; flex-direction: column; gap: var(--space-4); }
  .cert-rows { display: flex; flex-direction: column; gap: 6px; }

  /* — the preview — */
  .pv-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .pv-label { margin-bottom: 0; }
  .pv-scroll { overflow-x: auto; padding-bottom: var(--space-2); }
  .preview-note { margin-top: var(--space-3); max-width: 70ch; }
  .export-note { margin-top: var(--space-4); max-width: 70ch; }
  .export-note code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }
</style>
