---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/800.css';
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Access</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#f3f2f2" />
</head>
<body class="login-body">
  <div class="login-panel">
    <div class="login-mark">
      <h1 class="login-wordmark">[dev.identity]</h1>
    </div>

    <div>
      <h6 class="login-eyebrow">Admin Access</h6>
      <p class="login-copy">Sign in with the owner's GitHub account to manage projects, the journal, and resume content.</p>
    </div>

    <a class="btn btn-primary btn-block login-cta" href="/admin/dashboard">Sign in with GitHub</a>

    <p class="text-muted login-disclaimer">
      This site is statically hosted, so there is no server to authenticate against — the
      admin screens are an authoring surface that runs entirely in your browser and never
      publishes on its own. Everything you write here is exported as files you commit.
    </p>

    <a class="login-back" href="/">← Back to the public site</a>
  </div>
</body>
</html>
<style>
  .login-body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
  }
  .login-panel {
    width: min(380px, 90vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
  }
  .login-mark {
    border-bottom: 2px solid var(--color-divider);
    padding-bottom: var(--space-4);
    width: 100%;
  }
  .login-wordmark {
    font-size: 26px;
    font-family: var(--font-mono);
    background: var(--color-neutral-900);
    color: var(--color-bg);
    padding: 10px 18px;
    display: inline-block;
    margin: 0;
  }
  .login-eyebrow { color: var(--color-accent-700); margin-bottom: var(--space-2); }
  .login-copy { opacity: 0.8; font-size: 14px; margin: 0; }
  .login-cta { max-width: 260px; }
  .login-disclaimer { font-size: 12px; line-height: 1.5; margin: 0; text-align: left; }
  .login-back { font-size: 13px; }
</style>
