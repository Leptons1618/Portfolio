---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/global.css';
import Illustration from '../../components/Illustration.astro';
import ThemeHead from '../../components/ThemeHead.astro';
// import { grantAccessUrl } from '../../lib/github';
import { site } from '../../lib/site';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Access</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <ThemeHead />
</head>
<body class="login-body">
  <div class="login-panel">
    <div class="login-mark">
      <h1 class="login-wordmark">{site.name}</h1>
    </div>

    <div class="login-art"><Illustration name="github-profile" /></div>

    <div>
      <p class="login-eyebrow">Admin Access</p>
      <!-- <p class="login-copy">Sign in with @{site.githubUser} to manage projects, the journal, and resume content.</p> -->
       <p class="login-copy">Sign in with authenticated GitHub to manage projects, the journal, and resume content.</p>
    </div>

    <button type="button" class="btn btn-primary btn-block login-cta" id="gh-signin">
      Sign in with GitHub
    </button>

    {/* The wait row: dots carry "something is happening", the text names what.
        `data-busy` is what shows the dots — errors and plain notices hide them. */}
    <p class="login-status" id="gh-status" hidden aria-live="polite">
      <span class="login-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span id="gh-status-text"></span>
    </p>

    <!-- <p class="text-muted login-disclaimer">
      Signing in uses a GitHub App. The token is held in this browser tab only, never on
      disk, and expires after 8 hours. Content lives in this site's own database, and the
      token is what proves to the write endpoint who is asking — nothing here writes to a
      repository. <code>/admin</code> is public HTML, so this gate hides the editors
      rather than protecting them; what is protected is the endpoint, which asks GitHub
      whose token it is and admits one account.
    </p> -->

    {/* Signing in and granting repository access are two different grants, and
        only the first one has a button on this page. Nothing here can tell
        whether the second has happened — that needs a token — so rather than
        guess, say where it lives and let it be a no-op for anyone already set
        up. Without it the first run dead-ends on a screen full of 403s. */}
    <!-- <p class="text-muted login-disclaimer">
      Repository access is separate, and it is only about the import screen: listing your
      repositories comes from <em>installing</em> the App, not from signing in. Pick which
      ones it can see — all of them, or a few — under
      <a href={grantAccessUrl()} target="_blank" rel="noopener">the App's installation ↗</a>.
      Read-only is enough; nothing on this site needs more.
    </p> -->

    <a class="login-back" href="/">← Back to the public site</a>
  </div>

  <script>
    import { GitHubError, beginSignIn, completeSignIn, getUser, isConfigured } from '../../lib/github';

    const button = document.getElementById('gh-signin') as HTMLButtonElement;
    const status = document.getElementById('gh-status') as HTMLParagraphElement;
    const statusText = document.getElementById('gh-status-text') as HTMLSpanElement;

    function show(message: string, tone: 'error' | 'info', busy = false) {
      statusText.textContent = message;
      status.dataset.tone = tone;
      /* Busy is a state of the row, not of the words: the dots say "working",
         the words name the work. */
      status.toggleAttribute('data-busy', busy);
      status.hidden = false;
    }

    function toDashboard() {
      // `replace`, so the browser back button does not land on the callback URL.
      window.location.replace('/admin/dashboard');
    }

    button.addEventListener('click', () => {
      button.disabled = true;
      show('Redirecting to GitHub…', 'info', true);
      try {
        beginSignIn();
      } catch (error) {
        button.disabled = false;
        show(error instanceof GitHubError ? error.message : 'Could not start sign-in.', 'error');
      }
    });

    (async () => {
      if (!isConfigured()) {
        button.disabled = true;
        show(
          'Sign-in is not configured for this build: PUBLIC_GITHUB_CLIENT_ID and PUBLIC_GITHUB_OAUTH_WORKER are unset.',
          'error'
        );
        return;
      }

      /* The callback lands back on this page with `?code=…` in the URL, and
         exchanging it is a network round trip to the OAuth worker. Without this
         the page sits fully silent for that whole window — the exact "did it
         work?" moment. The button goes too: sign-in is in flight, not on offer. */
      const params = new URLSearchParams(window.location.search);
      if (params.has('code') || params.has('error')) {
        button.disabled = true;
        show('Signing you in…', 'info', true);
      }

      try {
        if (await completeSignIn()) {
          show('Signed in. Redirecting…', 'info', true);
          toDashboard();
          return;
        }
      } catch (error) {
        show(error instanceof GitHubError ? error.message : 'Sign-in failed.', 'error');
        /* The gate is usable again — a retry should be one click away. */
        button.disabled = false;
        return;
      }

      if (getUser()) toDashboard();
    })();
  </script>
</body>
</html>
<style>
  .login-body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
  }
  .login-panel {
    width: min(380px, 90vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
  }
  /* The gate's arrival: one short rise for the whole panel, the same
     invitation grammar the Ask launcher and skip link use. Static sheet
     stays the default under reduced motion or a failed bundle. */
  @media (prefers-reduced-motion: no-preference) {
    .login-panel { animation: login-panel-in var(--dur-base) var(--ease-out) backwards; }
  }
  @keyframes login-panel-in {
    from { opacity: 0; translate: 0 8px; }
  }
  .login-mark {
    border-bottom: 2px solid var(--color-divider);
    padding-bottom: var(--space-4);
    width: 100%;
  }
  .login-wordmark {
    font-size: 26px;
    font-family: var(--font-mono);
    background: var(--color-neutral-900);
    color: var(--color-bg);
    padding: 10px 18px;
    display: inline-block;
    margin: 0;
  }
  .login-art { width: min(220px, 60vw); }
  .login-eyebrow { color: var(--color-accent-700); margin-bottom: var(--space-2); }
  .login-copy { opacity: 0.8; font-size: 14px; margin: 0; }
  .login-cta { max-width: 260px; }
  .login-status { font-size: 13px; margin: 0; }
  .login-status[data-tone='error'] { color: var(--color-accent-700); }
  .login-status[data-tone='info'] { color: var(--color-text-muted); }

  /* The wait signal. Squares, not a spinner — nothing else in this theme has
     a border radius, and the Ask widget's wait row established this exact
     grammar. Staggered pulse so it reads as working, not blinking. */
  .login-dots { display: inline-flex; gap: 3px; margin-right: var(--space-2); vertical-align: middle; }
  .login-dots i {
    width: 4px;
    height: 4px;
    background: currentColor;
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .login-dots i { animation: login-pulse 1.1s ease-in-out infinite; }
    .login-dots i:nth-child(2) { animation-delay: 0.15s; }
    .login-dots i:nth-child(3) { animation-delay: 0.3s; }
  }
  @keyframes login-pulse {
    0%, 65%, 100% { opacity: 0.2; }
    30% { opacity: 1; }
  }
  /* Errors and plain notices carry words only — the dots belong to waits. */
  .login-status:not([data-busy]) .login-dots { display: none; }
  .login-disclaimer { font-size: 12px; line-height: 1.5; margin: 0; text-align: left; }
  .login-disclaimer code { font-size: 11px; }
  .login-back { font-size: 13px; }
</style>
