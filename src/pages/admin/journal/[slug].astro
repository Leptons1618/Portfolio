---
/**
 * One journal entry, open for editing.
 *
 * Read from D1 per request, every status included — `getPost(db, slug, true)`,
 * the same rule the entries list and the dashboard follow, because managing the
 * two states the public site never renders is what this surface exists for.
 *
 * Frontmatter *and* body come from the same row the public page renders, so
 * the editor opens on exactly what a reader would see and there is no build in
 * between for the two to drift across.
 *
 * An unpublished post stops resolving on the *public* side, so `/journal/<slug>`
 * 404s — but this page still finds it, which is the point: withdrawing a post
 * must not also take away the screen that could bring it back. That is what the
 * `true` argument buys.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import JournalEditor from '../../../components/JournalEditor.astro';
import { getPost } from '../../../lib/content';
import type { PostFields } from '../../../lib/content-store';

export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const { slug } = Astro.params;
const post = slug ? await getPost(DB, slug, true) : undefined;
if (!post) return new Response(null, { status: 404 });

const fields: PostFields = {
  title: post.data.title,
  summary: post.data.summary,
  date: post.data.date,
  tags: post.data.tags,
  readTime: post.data.readTime,
  videoDuration: post.data.videoDuration,
  heroImage: post.data.heroImage,
  status: post.data.status,
};

const today = new Date().toISOString().slice(0, 10);
---
<AdminLayout title={`Editing ${post.data.title}`}>
  <JournalEditor slug={slug!} fields={fields} body={post.body} today={today} />
</AdminLayout>
