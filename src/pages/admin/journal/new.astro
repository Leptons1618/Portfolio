---
/**
 * A blank journal entry.
 *
 * Nothing here but the editor with no post behind it — `slug: null` is what
 * tells `JournalEditor` to build a whole file on commit rather than patch one,
 * and to let the filename follow the title until it does. The entries list at
 * `/admin/journal` is the way in; `/admin/journal/<slug>` is the same component
 * pointed at a file that already exists.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import JournalEditor from '../../../components/JournalEditor.astro';

const today = new Date().toISOString().slice(0, 10);
---
<AdminLayout title="New Journal Entry">
  <JournalEditor slug={null} fields={null} body="" today={today} />
</AdminLayout>
