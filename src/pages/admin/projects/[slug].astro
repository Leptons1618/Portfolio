---
/**
 * One project, in full — and the case study attached to it.
 *
 * The list screen at `/admin/projects` is a manifest: twenty cards, a
 * visibility switch each, and a modal for the fields. That modal was doing two
 * jobs badly — it is where an *imported* repository gets its missing fields
 * filled in, which is a short one-off form, and it was also the only way to
 * edit a project that has been in the portfolio for a year, which is not. This
 * page is the second job: room for every field, the repository's live state
 * beside them, and the case study in the same place rather than behind a
 * select that only ever said "linked".
 *
 * Read from D1 per request, hidden ones included — `getProject(db, slug, true)`,
 * the same rule the list screen follows. Everything it writes goes through
 * `content-store.ts`, and every write is live on the site as it returns.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Illustration from '../../../components/Illustration.astro';
import { Icon } from 'astro-icon/components';
import { getCaseStudies, getProject } from '../../../lib/content';
import {
  PROJECT_CATEGORIES,
  PROJECT_STATUSES,
  caseStudyPath,
  projectPath,
  type CaseStudyFields,
  type ProjectFields,
} from '../../../lib/content-store';
import { parseRepoUrl } from '../../../lib/github';
import AssistPanel from '../../../components/AssistPanel.astro';

export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const slug = Astro.params.slug ?? '';
const project = slug ? await getProject(DB, slug, true) : undefined;
if (!project) return new Response(null, { status: 404 });

/* The whole list, not just the linked one: the select below offers every case
   study, and a page that only knew its own could not re-point. */
const caseStudies = await getCaseStudies(DB);
const fields = project.data;

const { owner, name: repoName } = parseRepoUrl(fields.repoUrl);
const linked = caseStudies.find(entry => entry.slug === fields.caseStudySlug);

/* Both forms prefill from the real frontmatter rather than from what the page
   happens to display, so a field neither form shows still round-trips.
   `<` is escaped because this lands inside a script element. Never write that
   tag literally in a comment: Vite's dependency scanner matches it in the raw
   `.astro` source and parses the markup after it as JavaScript. */
const seed = {
  slug,
  project: fields as ProjectFields,
  caseStudy: linked
    ? { slug: linked.slug, data: linked.data as CaseStudyFields, body: linked.body }
    : null,
};
const seedJson = JSON.stringify(seed).replace(/</g, '\\u003c');

const STATUS_VARIANT: Record<string, string> = {
  active: 'tag-accent-2',
  stable: 'tag-accent-2',
  wip: 'tag-accent',
  archived: 'tag-neutral',
};

---
<AdminLayout title={`Project · ${fields.title}`}>
  <div class="admin-main-wide" id="admin-project-detail">
    <a class="btn btn-ghost btn-sm pd-back" href="/admin/projects">
      <Icon name="lucide:arrow-left" class="admin-nav-icon" />All projects
    </a>

    <div class="admin-head pd-head">
      <div class="pd-id">
        <p class="admin-eyebrow-mono">MODULE: PROJECT_DETAIL</p>
        <h1 class="admin-title">{fields.title}</h1>
        <p class="pd-paths">
          <code>{projectPath(slug)}</code>
          {linked && <> · <code>{caseStudyPath(linked.slug)}</code></>}
        </p>
        <div class="pd-flags">
          <span class={`tag ${STATUS_VARIANT[fields.status] ?? 'tag-neutral'}`}>{fields.status}</span>
          <span class="tag tag-neutral">{fields.year}</span>
          {fields.featuredRank !== undefined && (
            <span class="tag tag-accent">featured · rank {fields.featuredRank}</span>
          )}
          <span class="tag tag-neutral" id="pd-visibility-flag">{fields.hidden ? 'hidden' : 'visible'}</span>
        </div>
      </div>

      <div class="pd-head-actions">
        <div class="pm-visibility">
          <span class="pm-field-label">Visibility</span>
          <button
            type="button"
            class="toggle"
            role="switch"
            id="pd-toggle"
            data-slug={slug}
            aria-checked={fields.hidden ? 'false' : 'true'}
            aria-label={`Toggle visibility for ${fields.title}`}
          ><span></span></button>
        </div>
        <div class="admin-actions">
          <button type="button" class="btn btn-secondary btn-sm" id="assist-open">
            <Icon name="lucide:sparkles" class="admin-nav-icon" />Assistant
          </button>
          <a class="btn btn-secondary btn-sm" href={fields.repoUrl} target="_blank" rel="noopener">
            <Icon name="lucide:github" class="admin-nav-icon" />{owner}/{repoName}
          </a>
          {/* A hidden project's public page 404s, so the link would be a dead
              one — say so instead of handing it out. */}
          {fields.hidden
            ? <span class="text-muted cell-mono pd-nopage">no public page</span>
            : (
              <a class="btn btn-secondary btn-sm" href={`/projects/${slug}`} target="_blank" rel="noopener">
                <Icon name="lucide:external-link" class="admin-nav-icon" />/projects/{slug}
              </a>
            )}
        </div>
      </div>
    </div>

    <p class="admin-note pd-message" id="pd-message"></p>

    {/* Two forms, one column, and stacked they were a very long scroll with the
        case study's Save button somewhere below the fold — the two halves are
        siblings rather than a hierarchy, so a tablist is the honest shape.
        `pd-message` stays *above* the bar on purpose: visibility, the fetch and
        the delete all report there, and those controls belong to the project
        rather than to either tab. */}
    <div class="tab-bar" role="tablist" aria-label="Project sections" id="pd-tabs">
      <button
        type="button"
        class="tab"
        role="tab"
        id="pd-tab-fields"
        aria-controls="pd-panel-fields"
        aria-selected="true"
      >
        <Icon name="lucide:list" class="admin-nav-icon" />Frontmatter
      </button>
      <button
        type="button"
        class="tab"
        role="tab"
        id="pd-tab-case"
        aria-controls="pd-panel-case"
        aria-selected="false"
      >
        <Icon name="lucide:book-open" class="admin-nav-icon" />Case study
        <span class="tab-badge">{linked ? linked.slug : 'none'}</span>
      </button>
    </div>

    {/* The layout is on a child rather than on the panel itself: Astro's scoping
        adds an attribute to `.pd-grid`, which would then outrank
        `.tab-panel[hidden]` and leave a "hidden" panel on screen. */}
    <div class="tab-panel" id="pd-panel-fields" role="tabpanel" aria-labelledby="pd-tab-fields">
    <div class="pd-grid">
      <section class="card elev-sm">
        <p class="admin-eyebrow">Project Frontmatter</p>
        <p class="text-muted admin-note">
          Fields left blank are removed when they are optional. Visibility is the switch
          above, not a field here.
        </p>
        <hr class="rule pd-rule" />

        <div class="pf-grid">
          <div class="field pf-wide">
            <label for="pf-title">Title</label>
            <input class="input" id="pf-title" />
          </div>
          <div class="field pf-wide">
            <label for="pf-summary">Summary</label>
            <textarea class="input pf-summary" id="pf-summary" data-grow></textarea>
          </div>
          <div class="field">
            <label for="pf-category">Category</label>
            <select class="input" id="pf-category">
              {PROJECT_CATEGORIES.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="pf-status">Status</label>
            <select class="input" id="pf-status">
              {PROJECT_STATUSES.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="pf-year">Year</label>
            <input class="input" id="pf-year" type="number" min="1990" max="2100" />
          </div>
          <div class="field">
            <label for="pf-rank">Featured rank (blank = not featured)</label>
            <input class="input" id="pf-rank" type="number" min="1" max="99" />
          </div>
          <div class="field pf-wide">
            <label for="pf-tags">Tags (comma separated)</label>
            <input class="input" id="pf-tags" />
          </div>
          <div class="field pf-wide">
            <label for="pf-stack">Stack (comma separated)</label>
            <input class="input" id="pf-stack" />
          </div>
          <div class="field pf-wide">
            <label for="pf-repo">Repository URL</label>
            <input class="input" id="pf-repo" />
          </div>
          <div class="field pf-wide">
            <label for="pf-demo">Demo URL (optional)</label>
            <input class="input" id="pf-demo" />
          </div>
          <div class="field pf-wide">
            <label for="pf-hero">Hero image (optional)</label>
            <input class="input" id="pf-hero" placeholder="/images/project.jpg" />
          </div>
          <div class="field pf-wide">
            <label for="pf-highlights">Highlights (one per line)</label>
            <textarea class="input pf-highlights" id="pf-highlights" data-grow></textarea>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="pf-reset">Revert</button>
          <button type="button" class="btn btn-primary" id="pf-save">Save changes</button>
        </div>
      </section>

      <aside class="pd-side">
        <section class="card elev-sm">
          <p class="admin-eyebrow">Repository</p>
          <dl class="pd-facts">
            <div><dt>Mapped</dt><dd><a href={fields.repoUrl} target="_blank" rel="noopener">{owner}/{repoName} ↗</a></dd></div>
            <div><dt>Branch</dt><dd id="pd-branch">not fetched</dd></div>
            <div><dt>Last push</dt><dd id="pd-push">not fetched</dd></div>
            <div><dt>Stars</dt><dd id="pd-stars">—</dd></div>
          </dl>
          <button type="button" class="btn btn-secondary btn-sm btn-block" id="pd-fetch">
            <Icon name="lucide:refresh-cw" class="admin-nav-icon" />Fetch from GitHub
          </button>
          <p class="text-muted admin-note">
            A public read — this one works signed out.
          </p>
          {/* Beside the facts it reads from, because that is what it is: the
              same repository, read for its README instead of its branch name.
              One press opens the panel and runs the task. */}
          <button
            type="button"
            class="btn btn-secondary btn-sm btn-block"
            data-assist-task="project"
          >
            <Icon name="lucide:sparkles" class="admin-nav-icon" />Write the frontmatter from it
          </button>
          <p class="text-muted admin-note">
            Reads the README and fills the fields on the left. Undo puts them back.
          </p>
        </section>

        <section class="card elev-sm">
          <p class="admin-eyebrow">Danger Zone</p>
          <p class="text-muted admin-note">
            Deleting removes the row <code>{projectPath(slug)}</code> outright. There is no
            history holding a copy, so nothing brings it back — hide it with the switch
            above if you only want it off the site. A linked case study is left alone, and
            the database refuses the delete while one still points here.
          </p>
          <button type="button" class="btn btn-secondary btn-block pm-danger" id="pd-delete">
            <Icon name="lucide:trash-2" class="admin-nav-icon" />Delete this project
          </button>
        </section>
      </aside>
    </div>
    </div>

    <div class="tab-panel" id="pd-panel-case" role="tabpanel" aria-labelledby="pd-tab-case" hidden>
    {linked ? (
      <section class="card elev-sm" id="pd-case-study" data-slug={linked.slug}>
        <div class="pd-cs-bar">
          <div>
            <h3 class="pd-cs-title">{linked.data.title}</h3>
            <p class="text-muted admin-note">
              <code>{caseStudyPath(linked.slug)}</code> — the structured half. Saving any
              of it is live on <code>/case-studies/{linked.slug}</code> immediately.
            </p>
          </div>
          <div class="admin-actions">
            <a class="btn btn-secondary btn-sm" href={`/case-studies/${linked.slug}`} target="_blank" rel="noopener">
              <Icon name="lucide:external-link" class="admin-nav-icon" />Read it
            </a>
            <button type="button" class="btn btn-secondary btn-sm" data-assist-task="casestudy">
              <Icon name="lucide:sparkles" class="admin-nav-icon" />Write the fields
            </button>
            <button type="button" class="btn btn-secondary btn-sm" data-assist-task="casestudybody">
              <Icon name="lucide:sparkles" class="admin-nav-icon" />Write the prose
            </button>
            <button type="button" class="btn btn-secondary btn-sm" id="cs-unlink">Unlink</button>
          </div>
        </div>

        <hr class="rule pd-rule" />

        <div class="pf-grid">
          <div class="field pf-wide">
            <label for="cs-title">Title</label>
            <input class="input" id="cs-title" />
          </div>
          <div class="field pf-wide">
            <label for="cs-subtitle">Subtitle</label>
            <input class="input" id="cs-subtitle" />
          </div>
          <div class="field pf-wide">
            <label for="cs-problem">Problem</label>
            <textarea class="input pf-summary" id="cs-problem" data-grow></textarea>
          </div>
          <div class="field pf-wide">
            <label for="cs-solution">Solution</label>
            <textarea class="input pf-summary" id="cs-solution" data-grow></textarea>
          </div>
          <div class="field pf-wide">
            <label for="cs-achievements">Achievements (one per line)</label>
            <textarea class="input pf-highlights" id="cs-achievements" data-grow></textarea>
          </div>
          <div class="field pf-wide">
            <label for="cs-stack">Stack (comma separated)</label>
            <input class="input" id="cs-stack" />
          </div>
          <div class="field">
            <label for="cs-date">Date</label>
            <input class="input" id="cs-date" type="date" />
          </div>
          <div class="field">
            <label for="cs-readtime">Read time (optional)</label>
            <input class="input" id="cs-readtime" placeholder="8 min" />
          </div>
          <div class="field">
            <label for="cs-repo">Repository URL (optional)</label>
            <input class="input" id="cs-repo" />
          </div>
          <div class="field">
            <label for="cs-demo">Demo URL (optional)</label>
            <input class="input" id="cs-demo" />
          </div>
          <div class="field">
            <label for="cs-hero">Hero image (optional)</label>
            <input class="input" id="cs-hero" placeholder="/images/case.jpg" />
          </div>
          <div class="field">
            <label for="cs-arch">Architecture image (optional)</label>
            <input class="input" id="cs-arch" placeholder="/images/arch.svg" />
          </div>
          {/* The write-up itself. It had no field until now, which is why every
              case study on the site was a header over the one paragraph
              `createCaseStudy` scaffolds — the body column was writable and
              nothing on any screen wrote it. Markdown in, HTML derived on the
              way into D1, same as a post. */}
          <div class="field pf-wide">
            <label for="cs-body">The write-up (markdown)</label>
            <textarea class="input pd-cs-body" id="cs-body" spellcheck="true"></textarea>
            <p class="text-muted admin-note">
              Rendered under the header on <code>/case-studies/{linked.slug}</code>. No title
              line — the title is the field above, and repeating it prints it twice.
            </p>
          </div>
        </div>

        <p class="admin-note pd-message" id="cs-message"></p>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="cs-reset">Revert</button>
          <button type="button" class="btn btn-primary" id="cs-save">Save changes</button>
        </div>
      </section>
    ) : (
      <section class="card elev-sm" id="pd-case-study">
        <div class="admin-empty">
          <div class="admin-empty-art admin-empty-art-sm"><Illustration name="code-inspection" /></div>
          <h3 class="admin-empty-title">No case study yet</h3>
          <p class="admin-empty-copy">
            Scaffolding writes <code>{caseStudyPath(slug)}</code> with the structured fields
            filled in from this project and a placeholder body, then links the two. Or point
            at one that already exists.
          </p>
          <div class="admin-empty-actions">
            <button type="button" class="btn btn-primary btn-sm" id="cs-scaffold">
              <Icon name="lucide:file-plus-2" class="admin-nav-icon" />Scaffold one from this project
            </button>
            <select class="input is-auto pd-cs-pick" id="cs-pick" aria-label="Link an existing case study">
              <option value="">— link an existing one —</option>
              {caseStudies.map(entry => <option value={entry.slug}>{entry.data.title} ({entry.slug})</option>)}
            </select>
          </div>
          <p class="admin-note pd-message" id="cs-message"></p>
        </div>
      </section>
    )}
    </div>
  </div>


  {/* The same dock as the journal editor's, and the same reasoning behind it:
      `show()` rather than `showModal()`, because the point of this panel is
      watching the form fill in, and a modal is a sheet pulled over the only
      thing worth looking at. Decision 28.

      The assistant, which is the same panel the journal editor renders. What
      used to be a steer box and two shelved buttons is a conversation with
      commands in it — `/write-frontmatter` is the same table entry `project`
      always was, and `task.surface` is still what decides which commands
      appear here. Decision 31. */}
  <AssistPanel
    surface="project"
    sub="Writes into the fields. Nothing is saved until you press Save changes."
  />

  <script is:inline type="application/json" id="project-detail-seed" set:html={seedJson}></script>
</AdminLayout>

<script>
  import {
    onAdminPage,
    setBusy,
    setLabel,
    toast,
    undoRing,
    wireTabs,
    type UndoEntry,
  } from '../../../lib/admin';
  import { copyText } from '../../../lib/clipboard';
  import { relativeTime } from '../../../lib/format';
  import { runAssist } from '../../../lib/ai-store';
  import { mountAssistPanel } from '../../../lib/assist-panel';
  import {
    ASSIST_MENU,
    ASSIST_TASKS,
    CASE_STUDY_KEYS,
    PROJECT_KEYS,
    isAssistTask,
    parseEdit,
    parseFields,
    type AssistTask,
    type AssistTaskName,
    type FieldShape,
    type ParsedFields,
    type ProjectTarget,
  } from '../../../lib/assist-tasks';
  import {
    createCaseStudy,
    patchCaseStudy,
    patchProject,
    projectPath,
    removeProject,
    type CaseStudyFields,
    type ProjectFields,
  } from '../../../lib/content-store';
  import {
    canWriteContent,
    fetchRepoLanguages,
    fetchRepoMeta,
    fetchRepoReadme,
    getToken,
    getUser,
    parseRepoUrl,
    repoFacts,
  } from '../../../lib/github';
  import { attachImageUpload } from '../../../lib/image-upload';

  onAdminPage('#admin-project-detail', () => {
    interface Seed {
      slug: string;
      project: ProjectFields;
      caseStudy: { slug: string; data: CaseStudyFields; body: string } | null;
    }

    const seed: Seed = JSON.parse(document.getElementById('project-detail-seed')!.textContent || '{}');
    const signedIn = Boolean(getToken() && getUser());
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const message = (error: unknown) => (error instanceof Error ? error.message : 'Request failed.');
    const csv = (value: string) => value.split(',').map(part => part.trim()).filter(Boolean);
    const lines = (value: string) => value.split('\n').map(part => part.trim()).filter(Boolean);

    function say(host: HTMLElement, text: string, tone: 'info' | 'error' = 'info') {
      host.dataset.tone = tone;
      host.textContent = text;
    }

    /* The URL a save returns is the live page, not a commit: there is no commit
       and no build between pressing the button and the page changing. */
    function sayLink(host: HTMLElement, text: string, url: string) {
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.target = '_blank';
      anchor.rel = 'noopener';
      anchor.textContent = 'view live ↗';
      host.dataset.tone = 'info';
      host.replaceChildren(document.createTextNode(`${text} — `), anchor);
    }

    /* Wired before anything else: a throw further down would otherwise leave a
       tablist where both panels are showing at once. `#case-study` in the URL
       opens the second tab, so the case-study half is linkable — the empty
       state's "scaffold one" is a place people arrive at from elsewhere. */
    const tabs = wireTabs($('pd-tabs'));
    if (window.location.hash === '#case-study') tabs.select('pd-panel-case');

    const pageMessage = $('pd-message');
    if (!signedIn) {
      say(
        pageMessage,
        'Signed out: this screen reads fine, but every button on it writes to the live site. Sign in from the rail to use them.'
      );
    } else {
      /* What decides a write is who the token belongs to — `requireOwner()` on
         the endpoint admits one account and refuses everything else. Asking the
         same question here beats discovering the answer one failed save at a
         time. */
      canWriteContent().then(allowed => {
        if (allowed || pageMessage.textContent) return;
        const text =
          'GitHub does not report this session as the owner of this site, so saving, ' +
          'visibility and delete will all be refused. Sign out and back in with the ' +
          'account this site belongs to.';
        say(pageMessage, text, 'error');
        toast(text, { tone: 'error' });
      });
    }

    // -------------------------------------------------------------- project

    const project = {
      title: $<HTMLInputElement>('pf-title'),
      summary: $<HTMLTextAreaElement>('pf-summary'),
      category: $<HTMLSelectElement>('pf-category'),
      status: $<HTMLSelectElement>('pf-status'),
      year: $<HTMLInputElement>('pf-year'),
      rank: $<HTMLInputElement>('pf-rank'),
      tags: $<HTMLInputElement>('pf-tags'),
      stack: $<HTMLInputElement>('pf-stack'),
      repo: $<HTMLInputElement>('pf-repo'),
      demo: $<HTMLInputElement>('pf-demo'),
      hero: $<HTMLInputElement>('pf-hero'),
      highlights: $<HTMLTextAreaElement>('pf-highlights'),
    };

    function fillProject(fields: ProjectFields) {
      project.title.value = fields.title ?? '';
      project.summary.value = fields.summary ?? '';
      project.category.value = fields.category ?? 'other';
      project.status.value = fields.status ?? 'active';
      project.year.value = String(fields.year ?? new Date().getFullYear());
      project.rank.value = fields.featuredRank === undefined ? '' : String(fields.featuredRank);
      project.tags.value = (fields.tags ?? []).join(', ');
      project.stack.value = (fields.stack ?? []).join(', ');
      project.repo.value = fields.repoUrl ?? '';
      project.demo.value = fields.demoUrl ?? '';
      project.hero.value = fields.heroImage ?? '';
      project.highlights.value = (fields.highlights ?? []).join('\n');
    }

    /** The form as schema-shaped fields, or a sentence saying what is wrong. */
    function readProject(): ProjectFields | string {
      const title = project.title.value.trim();
      const summary = project.summary.value.trim();
      const repoUrl = project.repo.value.trim();
      const year = Number(project.year.value);

      if (!title) return 'A title is required — it is the card heading and the page title.';
      if (!summary) return 'A summary is required: it is the card body and the meta description.';
      try {
        new URL(repoUrl);
      } catch {
        return 'The repository URL has to be an absolute URL.';
      }
      if (!Number.isInteger(year)) return 'Year has to be a whole number.';

      const rank = project.rank.value.trim();
      return {
        title,
        summary,
        category: project.category.value as ProjectFields['category'],
        tags: csv(project.tags.value),
        stack: csv(project.stack.value),
        repoUrl,
        demoUrl: project.demo.value.trim() || undefined,
        featuredRank: rank === '' ? undefined : Number(rank),
        status: project.status.value as ProjectFields['status'],
        year,
        heroImage: project.hero.value.trim() || undefined,
        highlights: lines(project.highlights.value),
      };
    }

    /* Attached before the first fill so the preview is right on arrival — the
       control overrides the input's `value` setter, and a fill that ran first
       would land before it was listening. */
    attachImageUpload(project.hero, { dir: 'images/projects', name: () => `${seed.slug}-hero` });

    fillProject(seed.project);
    $<HTMLButtonElement>('pf-reset').addEventListener('click', () => {
      fillProject(seed.project);
      say(pageMessage, 'Reverted to what is saved.');
    });

    const saveProject = $<HTMLButtonElement>('pf-save');
    saveProject.addEventListener('click', async () => {
      if (!signedIn) return say(pageMessage, 'Sign in with GitHub to save.', 'error');

      const fields = readProject();
      if (typeof fields === 'string') return say(pageMessage, fields, 'error');

      setBusy(saveProject, true, 'Saving…');
      say(pageMessage, 'Saving…');
      const pending = toast('Saving the project…', { tone: 'pending' });
      try {
        /* `hidden` and `caseStudySlug` are deliberately not in this patch: the
           first belongs to the switch above, the second to the section below.
           A patch writes only the columns handed to it, which is what keeps a
           field this form has never heard of from being cleared by it. */
        const result = await patchProject(seed.slug, fields);
        sayLink(pageMessage, 'Saved. Live now', result.url);
        pending.update('Project saved and live.', {
          tone: 'success',
          action: { label: 'view live ↗', href: result.url },
        });
        seed.project = { ...fields, hidden: seed.project.hidden, caseStudySlug: seed.project.caseStudySlug };
      } catch (error) {
        say(pageMessage, message(error), 'error');
        pending.update(message(error), { tone: 'error' });
      } finally {
        setBusy(saveProject, false);
      }
    });

    // ----------------------------------------------------------- visibility

    const toggle = $<HTMLButtonElement>('pd-toggle');
    const visibilityFlag = $('pd-visibility-flag');

    if (!signedIn) {
      toggle.disabled = true;
      toggle.title = 'Sign in with GitHub to change visibility.';
    } else {
      toggle.addEventListener('click', async () => {
        const visible = toggle.getAttribute('aria-checked') !== 'true';
        toggle.setAttribute('aria-checked', String(visible));
        toggle.disabled = true;
        say(pageMessage, visible ? 'Publishing…' : 'Hiding…');
        const pending = toast(visible ? 'Publishing…' : 'Hiding…', { tone: 'pending' });
        try {
          const result = await patchProject(seed.slug, { hidden: !visible });
          seed.project.hidden = !visible;
          visibilityFlag.textContent = visible ? 'visible' : 'hidden';
          if (visible) {
            sayLink(pageMessage, 'Visible now', result.url);
            pending.update('The project is visible.', {
              tone: 'success',
              action: { label: 'view live ↗', href: result.url },
            });
          } else {
            say(pageMessage, 'Hidden — its page now 404s.');
            pending.update('The project is hidden. Its page now 404s.', { tone: 'success' });
          }
        } catch (error) {
          toggle.setAttribute('aria-checked', String(!visible));
          say(pageMessage, message(error), 'error');
          pending.update(message(error), { tone: 'error' });
        } finally {
          toggle.disabled = false;
        }
      });
    }

    // ----------------------------------------------------------- repository

    const fetchButton = $<HTMLButtonElement>('pd-fetch');
    fetchButton.addEventListener('click', async () => {
      setBusy(fetchButton, true, 'Reading…');
      say(pageMessage, 'Reading the repository…');
      try {
        const { owner, name } = parseRepoUrl(seed.project.repoUrl);
        const meta = await fetchRepoMeta(owner, name);
        $('pd-branch').textContent = meta.defaultBranch;
        $('pd-push').textContent = relativeTime(meta.pushedAt);
        $('pd-stars').textContent = meta.archived ? `${meta.stars} ★ · archived on GitHub` : `${meta.stars} ★`;
        say(pageMessage, `Read ${meta.fullName}.`);
      } catch (error) {
        say(pageMessage, message(error), 'error');
        toast(message(error), { tone: 'error' });
      } finally {
        setBusy(fetchButton, false);
      }
    });

    /* Two clicks, because the first one is the one people mean to take back.
       Nothing holds a copy of the row, so the confirm is the only thing between
       a mis-click and a project that is simply gone — and `setLabel` rather
       than `textContent`, because this button carries an inlined trash icon
       that writing over would delete for good. */
    const deleteButton = $<HTMLButtonElement>('pd-delete');
    let armed = false;
    let disarm: ReturnType<typeof setTimeout>;

    deleteButton.addEventListener('click', async () => {
      if (!signedIn) return say(pageMessage, 'Sign in to delete a project.', 'error');

      if (!armed) {
        armed = true;
        setLabel(deleteButton, 'Confirm delete');
        say(
          pageMessage,
          `This deletes ${projectPath(seed.slug)} for good — nothing restores it. ` +
            'Use the visibility switch instead if you only want it off the site. ' +
            'Click again to confirm.',
          'error'
        );
        disarm = setTimeout(() => {
          armed = false;
          setLabel(deleteButton, null);
          say(pageMessage, '');
        }, 5000);
        return;
      }

      clearTimeout(disarm);
      armed = false;
      setBusy(deleteButton, true, 'Deleting…');
      say(pageMessage, 'Deleting…');
      const pending = toast(`Deleting ${seed.slug}…`, { tone: 'pending' });
      try {
        await removeProject(seed.slug);
        /* The row this page renders from is gone, so this URL now 404s — there
           is nowhere useful to stay. */
        pending.update(`${seed.slug} is deleted.`, { tone: 'success' });
        window.location.assign('/admin/projects');
      } catch (error) {
        setBusy(deleteButton, false);
        say(pageMessage, message(error), 'error');
        pending.update(message(error), { tone: 'error' });
      }
    });

    // ---------------------------------------------------------- case study

    const csMessage = $('cs-message');
    const linkedSlug = document.getElementById('pd-case-study')!.dataset.slug;

    /* Both halves of this section write `caseStudySlug` on the *project*, and
       this page renders from that row — the editor below the pointer is
       server-rendered from `linked`, so nothing in the DOM can show a case
       study that did not exist when the page was built. Reloading is what shows
       the result, and it is a reload rather than a rebuild now, which is the
       whole point.

       Done here rather than asked of the reader: "scaffold, then press F5" is
       an instruction nobody should have to follow, and the scaffold was
       invisible until they did. The hash is what puts them back on this tab —
       the tab strip reads it on mount — and it is set before the reload so the
       new document opens with it. */
    async function relink(next: string | undefined, verb: string) {
      await patchProject(seed.slug, { caseStudySlug: next });
      say(csMessage, `Saved (${verb}). Reloading…`);
      window.location.hash = 'case-study';
      window.location.reload();
    }

    if (linkedSlug) {
      const study = {
        title: $<HTMLInputElement>('cs-title'),
        subtitle: $<HTMLInputElement>('cs-subtitle'),
        problem: $<HTMLTextAreaElement>('cs-problem'),
        solution: $<HTMLTextAreaElement>('cs-solution'),
        achievements: $<HTMLTextAreaElement>('cs-achievements'),
        stack: $<HTMLInputElement>('cs-stack'),
        date: $<HTMLInputElement>('cs-date'),
        readTime: $<HTMLInputElement>('cs-readtime'),
        repo: $<HTMLInputElement>('cs-repo'),
        demo: $<HTMLInputElement>('cs-demo'),
        hero: $<HTMLInputElement>('cs-hero'),
        architecture: $<HTMLInputElement>('cs-arch'),
        body: $<HTMLTextAreaElement>('cs-body'),
      };

      function fillCaseStudy(data: CaseStudyFields, body: string) {
        study.body.value = body;
        study.title.value = data.title ?? '';
        study.subtitle.value = data.subtitle ?? '';
        study.problem.value = data.problem ?? '';
        study.solution.value = data.solution ?? '';
        study.achievements.value = (data.achievements ?? []).join('\n');
        study.stack.value = (data.stack ?? []).join(', ');
        study.date.value = (data.date ?? '').slice(0, 10);
        study.readTime.value = data.readTime ?? '';
        study.repo.value = data.repoUrl ?? '';
        study.demo.value = data.demoUrl ?? '';
        study.hero.value = data.heroImage ?? '';
        study.architecture.value = data.architectureImage ?? '';
      }

      attachImageUpload(study.hero, {
        dir: 'images/case-studies',
        name: () => `${linkedSlug}-hero`,
      });
      attachImageUpload(study.architecture, {
        dir: 'images/case-studies',
        name: () => `${linkedSlug}-architecture`,
      });

      fillCaseStudy(seed.caseStudy!.data, seed.caseStudy!.body);
      $<HTMLButtonElement>('cs-reset').addEventListener('click', () => {
        fillCaseStudy(seed.caseStudy!.data, seed.caseStudy!.body);
        say(csMessage, 'Reverted to what is saved.');
      });

      const saveStudy = $<HTMLButtonElement>('cs-save');
      saveStudy.addEventListener('click', async () => {
        if (!signedIn) return say(csMessage, 'Sign in with GitHub to save.', 'error');

        /* Every column `case_studies` declares NOT NULL, checked here rather
           than left to the database. It does refuse them — but it refuses them
           as `NOT NULL constraint failed: case_studies.problem`, which names
           the column and not the field, and reads as a fault rather than as an
           empty textarea further up this same panel. Problem and solution were
           missing from this list, which is how an emptied one got as far as
           D1. Keep it in step with the migration. */
        const title = study.title.value.trim();
        const subtitle = study.subtitle.value.trim();
        const problem = study.problem.value.trim();
        const solution = study.solution.value.trim();

        const missing = !title
          ? ['Title', study.title] as const
          : !subtitle
            ? ['Subtitle', study.subtitle] as const
            : !problem
              ? ['Problem', study.problem] as const
              : !solution
                ? ['Solution', study.solution] as const
                : !study.date.value
                  ? ['Date', study.date] as const
                  : null;

        if (missing) {
          const [label, field] = missing;
          const why = `${label} is required by the schema, and is empty.`;
          say(csMessage, why, 'error');
          toast(why, { tone: 'error' });
          field.focus();
          return;
        }

        setBusy(saveStudy, true, 'Saving…');
        say(csMessage, 'Saving…');
        const pending = toast('Saving the case study…', { tone: 'pending' });
        try {
          const changes: Partial<CaseStudyFields> = {
            title,
            subtitle,
            problem,
            solution,
            achievements: lines(study.achievements.value),
            stack: csv(study.stack.value),
            date: study.date.value,
            readTime: study.readTime.value.trim() || undefined,
            repoUrl: study.repo.value.trim() || undefined,
            demoUrl: study.demo.value.trim() || undefined,
            heroImage: study.hero.value.trim() || undefined,
            architectureImage: study.architecture.value.trim() || undefined,
          };

          /* Fields and prose in one write. The endpoint renders the markdown to
             HTML on the way in, so what the public page shows is a function of
             this textarea and never of anything the browser rendered. */
          const body = study.body.value;
          const result = await patchCaseStudy(linkedSlug, changes, body);
          sayLink(csMessage, 'Saved. Live now', result.url);
          pending.update('Case study saved and live.', {
            tone: 'success',
            action: { label: 'view live ↗', href: result.url },
          });
          seed.caseStudy = { slug: linkedSlug, data: { ...seed.caseStudy!.data, ...changes }, body };
        } catch (error) {
          say(csMessage, message(error), 'error');
          pending.update(message(error), { tone: 'error' });
        } finally {
          setBusy(saveStudy, false);
        }
      });

      const unlink = $<HTMLButtonElement>('cs-unlink');
      unlink.addEventListener('click', async () => {
        if (!signedIn) return say(csMessage, 'Sign in with GitHub to save.', 'error');
        setBusy(unlink, true, 'Unlinking…');
        say(csMessage, 'Unlinking…');
        try {
          /* The case-study row is left where it is. Removing the pointer is
             recoverable in one click; deleting prose is not. */
          await relink(undefined, 'unlink case study from');
          seed.project.caseStudySlug = undefined;
        } catch (error) {
          say(csMessage, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          setBusy(unlink, false);
        }
      });
    } else {
      const scaffold = $<HTMLButtonElement>('cs-scaffold');
      const pick = $<HTMLSelectElement>('cs-pick');

      scaffold.addEventListener('click', async () => {
        if (!signedIn) return say(csMessage, 'Sign in with GitHub to save.', 'error');
        setBusy(scaffold, true, 'Scaffolding…');
        say(csMessage, 'Scaffolding…');
        try {
          await createCaseStudy(seed.slug, {
            title: seed.project.title,
            subtitle: seed.project.summary,
            problem: 'Describe the problem this project set out to solve.',
            solution: 'Describe the approach that solved it.',
            achievements: seed.project.highlights.length ? seed.project.highlights : ['Add an achievement.'],
            stack: seed.project.stack,
            repoUrl: seed.project.repoUrl,
            demoUrl: seed.project.demoUrl,
            date: new Date().toISOString().slice(0, 10),
          });
          await relink(seed.slug, 'link case study to');
          seed.project.caseStudySlug = seed.slug;
        } catch (error) {
          say(csMessage, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          setBusy(scaffold, false);
        }
      });

      pick.addEventListener('change', async () => {
        if (!pick.value) return;
        if (!signedIn) {
          pick.value = '';
          return say(csMessage, 'Sign in with GitHub to save.', 'error');
        }
        const chosen = pick.value;
        pick.disabled = true;
        say(csMessage, 'Linking…');
        try {
          await relink(chosen, 'link case study to');
          seed.project.caseStudySlug = chosen;
        } catch (error) {
          pick.value = '';
          say(csMessage, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          pick.disabled = false;
        }
      });
    }

    // ------------------------------------------------------------ assistant

    /* The project assistant, which is the journal editor's one with a
       different field map.

       **No new route.** `/api/ai/assist` takes a task name and a context
       object; a second surface is two more entries in `ASSIST_TASKS` and a page
       that renders the menu filtered to its own name. That is what decision 24
       buys — the table is closed, so adding a surface adds two prompts to what
       a stolen session is worth rather than adding an endpoint.

       Both tasks here are `live`: they write into the form as the response
       arrives, and Undo is what makes that reasonable rather than reckless.
       Three runs back, not one — see `undoRing()` in `admin.ts`.

       Neither task saves. `patchProject` and `patchCaseStudy` are still the
       only things that write a row, and both are still behind the Save buttons
       above. An assistant that could save would be an assistant that could
       publish. */

    const assistOpen = $<HTMLButtonElement>('assist-open');

    /**
     * Which shape each live target's response is read against.
     *
     * `null` is prose: the whole answer is the field's value. The write-up is
     * the one target here like that, and every function below branches on this
     * being absent rather than on the target's name.
     */
    const TARGET_SHAPES: Record<ProjectTarget, FieldShape | null> = {
      project: PROJECT_KEYS,
      caseStudy: CASE_STUDY_KEYS,
      caseStudyBody: null,
    };

    type AnyField = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

    /**
     * The inputs a target writes into, keyed by the parser's key.
     *
     * `null` for `caseStudy` when there is no case study linked — the fields
     * are not on the page at all in that state, and the task is blocked before
     * it runs rather than writing into nothing.
     *
     * Looked up by id rather than closed over the `study` object above, because
     * that object only exists inside `if (linkedSlug)` and hoisting it out to
     * reach it from here would restructure a section this change has no other
     * business in.
     */
    function targetInputs(target: ProjectTarget): Record<string, AnyField> | null {
      if (target === 'project') {
        return {
          title: project.title,
          summary: project.summary,
          category: project.category,
          tags: project.tags,
          stack: project.stack,
          highlights: project.highlights,
        };
      }

      if (!linkedSlug) return null;

      if (target === 'caseStudyBody') {
        const body = document.getElementById('cs-body');
        return body ? { body: body as AnyField } : null;
      }

      const byId = {
        title: document.getElementById('cs-title'),
        subtitle: document.getElementById('cs-subtitle'),
        problem: document.getElementById('cs-problem'),
        solution: document.getElementById('cs-solution'),
        stack: document.getElementById('cs-stack'),
        readTime: document.getElementById('cs-readtime'),
        achievements: document.getElementById('cs-achievements'),
      };
      const found = Object.entries(byId).filter(([, node]) => node !== null);
      if (found.length !== Object.keys(byId).length) return null;
      return Object.fromEntries(found) as Record<string, AnyField>;
    }

    /** One item per line, with any bullet or numbering the model added stripped. */
    const asLines = (text: string) =>
      text
        .split('\n')
        .map(line => line.replace(/^\s*(?:[-*]|\d+[.)])\s*/, '').trim())
        .filter(Boolean)
        .join('\n');

    /**
     * Write a partially-arrived response into the fields it belongs to.
     *
     * Called on every animation frame while a task streams, and once more when
     * it finishes. Every branch is guarded on a *parsed* value, which is what
     * makes a response that recognised nothing write nothing — there is no
     * half-applied state to unpick, and no path by which text the parser did
     * not understand reaches a field. Decision 29.
     */
    function applyLive(target: ProjectTarget, raw: string) {
      const inputs = targetInputs(target);
      if (!inputs) return;

      const shape = TARGET_SHAPES[target];

      /* Prose: the answer *is* the value. Guarded on it being non-empty, and
         that guard is not a tidiness: this runs on every frame including the
         first, and a run stopped in its opening moment would otherwise assign
         `''` over the write-up that was already there. */
      if (!shape) {
        if (raw) inputs.body.value = raw;
        return;
      }

      const { values, tailStarted } = parseFields(raw, shape);

      for (const [key, input] of Object.entries(inputs)) {
        const value = values[key] ?? '';

        /* The tail is the one field that may legitimately be empty mid-stream
           — it is written from the moment its label lands, so the textarea
           fills line by line rather than appearing whole at the end. */
        if (key === shape.tail.key) {
          if (tailStarted) input.value = asLines(value);
          continue;
        }

        if (!value) continue;

        if (input instanceof HTMLSelectElement) {
          /* A model handed a closed list still answers outside it now and
             then, and assigning an unknown value to a `<select>` does not
             leave the previous one in place — it clears the selection. So the
             option list is checked first, and an unrecognised category is
             simply not applied. `select.ts` overrides the `value` setter, so
             this also updates the custom dropdown's visible label. */
          const wanted = value.trim().toLowerCase();
          if (Array.from(input.options).some(option => option.value === wanted)) {
            input.value = wanted;
          }
          continue;
        }

        input.value = value;
      }
    }

    /** A short, honest description of how far a run has got, from the shape. */
    function liveProgress(target: ProjectTarget, raw: string): string {
      const shape = TARGET_SHAPES[target];
      /* A word count, because the one prose target here is the longest thing
         the assistant writes and "Writing…" for ninety seconds reads as stuck. */
      if (!shape) {
        const words = raw.trim() ? raw.trim().split(/\s+/).length : 0;
        return words ? `Writing… ${words} words.` : 'Writing…';
      }

      const { values, tailStarted } = parseFields(raw, shape);
      const landed = shape.head.filter(spec => values[spec.key]).map(spec => spec.key);
      if (tailStarted) landed.push(shape.tail.key);
      return landed.length ? `Writing… ${landed.join(', ')}.` : 'Writing…';
    }

    /* — undo —

       Which inputs a target touches decides what its snapshot covers, and it
       has to: generating the case study's fields must not revert the summary
       being edited beside it. */
    const undos = undoRing();

    /* Which target each snapshot belongs to. A `WeakMap` rather than a field on
       the entry, because `UndoEntry` is the shared shape in `admin.ts` and this
       page's need to know which form an entry restores is this page's business
       alone. */
    const snapshotTargets = new WeakMap<UndoEntry, ProjectTarget>();

    function takeSnapshot(target: ProjectTarget, label: string) {
      const inputs = targetInputs(target);
      if (!inputs) return;
      const values: Record<string, string> = {};
      for (const [key, input] of Object.entries(inputs)) values[key] = input.value;
      const entry: UndoEntry = { label, values };
      snapshotTargets.set(entry, target);
      undos.push(entry);
    }

    /**
     * Drop the snapshot the current run took, if that run changed nothing.
     *
     * The snapshot is taken before the first token, because by the time
     * anything is known about the response the fields have been written to. A
     * run that then failed, or answered outside the format, would otherwise
     * leave an Undo that does nothing while pushing a real snapshot off the end
     * of a three-deep ring.
     */
    function dropUnusedSnapshot() {
      const entry = undos.peek();
      if (!entry) return;
      const target = snapshotTargets.get(entry);
      const inputs = target ? targetInputs(target) : null;
      if (!inputs) return;
      const untouched = Object.entries(entry.values).every(
        ([key, value]) => inputs[key]?.value === value,
      );
      if (untouched) undos.pop();
    }

    function undoAssist() {
      const entry = undos.pop();
      if (!entry) return;
      const target = snapshotTargets.get(entry);
      const inputs = target ? targetInputs(target) : null;
      if (!inputs) return;

      for (const [key, value] of Object.entries(entry.values)) {
        const input = inputs[key];
        if (input) input.value = value;
      }

      const left = undos.depth;
      panel.say(
        left
          ? `Put back the way it was before “${entry.label}”. ${left} more step${left === 1 ? '' : 's'} back.`
          : `Put back the way it was before “${entry.label}”.`,
      );
      toast('Reverted.', { tone: 'success' });
    }

    /* — the repository, read once —

       Both tasks want the same two things and neither is cheap: three GitHub
       calls, one of which can return twenty kilobytes. Keyed by the URL in the
       field rather than by nothing, so re-pointing the project at a different
       repository is not answered out of the last one's cache. */
    let repoCache: { url: string; repo: string; readme: string } | null = null;

    async function repoContext(): Promise<{ repo: string; readme: string }> {
      const url = project.repo.value.trim() || seed.project.repoUrl;
      if (repoCache?.url === url) return repoCache;

      const { owner, name } = parseRepoUrl(url);
      const [meta, languages, readme] = await Promise.all([
        /* Metadata is the optional half. A repository that cannot be read
           still has a README worth having, and the other way round. */
        fetchRepoMeta(owner, name).catch(() => null),
        fetchRepoLanguages(owner, name),
        fetchRepoReadme(owner, name),
      ]);

      /* Everything the one metadata call already answered — topics, licence,
         homepage, the two dates — rather than the four fields this used to
         pick out of it. `repoFacts` is shared with the import modal so a
         project drafted there and the same project edited here describe the
         repository to the model in exactly the same words. */
      const facts = meta
        ? repoFacts(meta, languages)
        : [
            `Repository: ${owner}/${name}`,
            `URL: ${url}`,
            languages.length ? `Languages GitHub detected, largest first: ${languages.join(', ')}` : '',
          ]
            .filter(Boolean)
            .join('\n');

      repoCache = { url, repo: facts, readme };
      return repoCache;
    }

    /**
     * A task name this page may run.
     *
     * `isAssistTask` alone is not enough: the table holds the journal's ten as
     * well, and a `data-assist-task` naming one of them would reach a `live`
     * target this page has no fields for. `chat` is `both` and is allowed —
     * it writes into nothing. The surface is on the task, so the check is one
     * property rather than a second list to keep in step.
     */
    const isProjectTask = (name: string): name is AssistTaskName =>
      isAssistTask(name) &&
      (ASSIST_TASKS[name].surface === 'project' || ASSIST_TASKS[name].surface === 'both');

    /**
     * Why this command cannot run yet, or `null`.
     *
     * The sentence rather than a boolean, because "that command did nothing"
     * tells the author neither what is wrong nor which of the two fixes it.
     * Conversation is exempt: asking a question about a project needs neither
     * a repository nor a linked case study.
     */
    function blockedBecause(name: AssistTaskName): string | null {
      if (name === 'chat') return null;
      const url = project.repo.value.trim() || seed.project.repoUrl;
      try {
        new URL(url);
      } catch {
        return 'This project needs a valid repository URL before the assistant can read it.';
      }
      if ((name === 'casestudy' || name === 'casestudybody') && !linkedSlug) {
        return 'There is no case study linked yet — scaffold or link one on the Case study tab, then run this.';
      }
      if (name === 'casestudybody') {
        const problem = (document.getElementById('cs-problem') as HTMLTextAreaElement | null)?.value.trim();
        if (!problem) {
          return 'Write the case study’s fields first — the prose continues from the problem and solution above it, and would otherwise write its own.';
        }
      }
      return null;
    }

    /** Undo, as a button on a message, while there is anything to undo. */
    const undoAction = () => {
      const entry = undos.peek();
      if (!entry) return [];
      return [{ label: undos.depth > 1 ? `Undo (${undos.depth})` : 'Undo', run: undoAssist }];
    };

    let assisting: AbortController | null = null;

    /**
     * One command, from the composer to the fields.
     *
     * Both of this screen's commands write straight into the form as they
     * stream — that is the feature, and it is why the panel is non-modal. The
     * conversational task writes into nothing and is handled first, because
     * every line below it assumes a live target.
     */
    async function runTask(name: AssistTaskName, instruction: string) {
      const task: AssistTask = ASSIST_TASKS[name];
      const item = ASSIST_MENU.find(entry => entry.name === name) ?? null;

      const blocked = blockedBecause(name);
      if (blocked) {
        panel.say(blocked, 'error');
        return;
      }

      const turn = panel.begin(task.label, item?.command ?? null);
      panel.running(true);

      assisting?.abort();
      const controller = new AbortController();
      assisting = controller;

      const again = { label: 'Try again', run: () => void runTask(name, instruction) };
      const copy = (text: string) => ({
        label: 'Copy',
        run: () => void copyText(text).then(() => toast('Copied.', { tone: 'success' })),
      });

      /* — conversation —

         No repository read, no snapshot, no live target: an answer to a
         question is not a draft, and there is deliberately no Insert. */
      if (name === 'chat') {
        /* The conversation sees both halves of the screen when there is a
           case study behind it: its framing fields are what an edit to the
           write-up has to agree with, and they are the difference between
           "update the case study" landing in the form and landing nowhere. */
        const value = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';
        const source: Record<string, string> = {
          title: project.title.value,
          summary: project.summary.value,
          tags: project.tags.value,
          stack: project.stack.value,
          highlights: project.highlights.value,
          ...(linkedSlug
            ? { problem: value('cs-problem'), solution: value('cs-solution') }
            : {}),
        };
        const context: Record<string, string> = {};
        for (const key of ASSIST_TASKS.chat.context) context[key] = source[key] ?? '';

        let said = '';
        let thought = '';
        try {
          const answer = await runAssist(
            name,
            context,
            instruction,
            {
              onDelta: chunk => {
                said += chunk;
                turn.answer(said);
              },
              onThinking: chunk => {
                thought += chunk;
                turn.thinking(chunk);
              },
              onTool: frame => turn.tool(frame),
            },
            controller.signal,
            /* The last entry is the message this call is *about*, and the route
               appends it itself. */
            panel.history().slice(0, -1),
            panel.runOptions(),
          );
          if (!answer.trim()) {
            throw new Error(
              thought
                ? 'The model spent the whole token budget thinking and never wrote an answer. Open Thinking above to read it.'
                : 'The model finished without writing anything.',
            );
          }
          /* A reply that opens with a labelled field is an *edit*, not an
             answer: they asked for a shorter summary and this is the shorter
             summary. It goes into the form with a snapshot behind it, exactly
             as a command's output would — `turn.status` overwrites the
             labelled text that streamed into the bubble, because what they
             want to read now is which fields moved. Same rule, same reader, in
             the journal editor's panel.

             Both shapes are tried. The project's fields and the case study's
             share `TITLE`, so the one with more labelled content wins, and
             the case study takes ties when the request named it — "update the
             case study title" arrives as `TITLE:` alone, and the words that
             asked for it are the only way to tell which title that is. */
          const projectEdit = parseEdit(answer, PROJECT_KEYS);
          const studyEdit = linkedSlug ? parseEdit(answer, CASE_STUDY_KEYS) : null;

          /** Head fields a parse actually wrote, tail included only once started. */
          const writtenKeys = (shape: FieldShape, parsed: ParsedFields): string[] =>
            [...shape.head, shape.tail]
              .filter(spec =>
                spec.key === shape.tail.key ? parsed.tailStarted : Boolean(parsed.values[spec.key]),
              )
              .map(spec => spec.key);

          const studyNamesake = /case[\s-]?stud/i.test(instruction || '');
          const studyScore = studyEdit
            ? writtenKeys(CASE_STUDY_KEYS, studyEdit).length +
              (studyNamesake ? 0.5 : 0)
            : -1;
          const projectScore = projectEdit ? writtenKeys(PROJECT_KEYS, projectEdit).length : -1;

          let target: ProjectTarget | null = null;
          let parsed: ParsedFields | null = null;
          if (studyEdit && studyScore > projectScore) {
            target = 'caseStudy';
            parsed = studyEdit;
          } else if (projectEdit) {
            target = 'project';
            parsed = projectEdit;
          }

          /* Labels with nothing under them are recognised and edit nothing —
             `applyLive` would write none of them — so that reads as an answer
             rather than as a run that emptied the form. */
          const editing = target && parsed
            ? writtenKeys(TARGET_SHAPES[target]!, parsed)
            : [];

          if (target && editing.length) {
            takeSnapshot(target, 'Chat edit');
            applyLive(target, answer);
            /* Covers the model that "changed" a field to what it already said,
               which would otherwise offer an Undo that does nothing. */
            dropUnusedSnapshot();
            const where = target === 'caseStudy' ? 'the case study' : 'the project';
            turn.status(`Updated ${editing.join(', ')} in ${where}. Nothing is saved until you press Save changes.`);
            turn.actions([...undoAction(), again]);
            turn.end(answer);
            toast(`Updated ${editing.join(', ')}.`, { tone: 'success' });
            return;
          }

          turn.actions([copy(answer), again]);
          turn.end(answer);
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') {
            turn.status(said ? 'Stopped.' : 'Stopped before anything arrived.');
          } else {
            turn.note(error instanceof Error ? error.message : 'The assistant failed.', 'error');
          }
          turn.actions([again]);
          turn.end(said);
        } finally {
          panel.running(false);
          if (assisting === controller) assisting = null;
        }
        return;
      }

      const live = task.live as ProjectTarget;
      const shape = TARGET_SHAPES[live];

      let raw = '';
      let thought = '';
      /* Set from the `done` frame's `stopReason`. `length` means the model was
         cut off by this task's ceiling rather than having finished, which is
         otherwise indistinguishable from a short answer — and on a frontmatter
         run it is the difference between five highlights and three. */
      let truncated = false;
      let queued = false;
      /* A frame can still be queued when the last chunk lands, and it would run
         *after* the completion handler below, repainting the fields from a
         non-final parse. The abort signal does not cover it: a run that
         finished normally was never aborted. */
      let settled = false;

      const paint = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (settled || controller.signal.aborted) return;
          applyLive(live, raw);
          turn.status(liveProgress(live, raw));
        });
      };

      try {
        turn.status('Reading the repository…');
        const { repo, readme } = await repoContext();
        /* `repoContext` does not take the signal — three GitHub reads that are
           already in flight are not worth threading one through — so a stop
           pressed while it was out lands here rather than as an AbortError. */
        if (controller.signal.aborted) {
          turn.status('Stopped before anything was written. Nothing changed.');
          turn.end('');
          return;
        }

        /* Only the fields this task declares. `context` on the task is an
           allowlist, and the endpoint's copy of it is what actually enforces
           the cap — this just avoids sending what will be dropped. */
        const value = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';

        /* The write-up is written *about the case study*, so its title and
           subtitle are the ones that matter — a body introduced by the
           project's one-line summary reads as a second, shorter case study on
           top of the one it is inside. Every other task on this screen starts
           from the project. */
        const aboutBody = live === 'caseStudyBody';

        const source: Record<string, string> = {
          repo,
          readme,
          title: aboutBody ? value('cs-title') : project.title.value,
          summary: aboutBody ? value('cs-subtitle') : project.summary.value,
          stack: aboutBody ? value('cs-stack') : project.stack.value,
          highlights: aboutBody ? value('cs-achievements') : project.highlights.value,
          problem: value('cs-problem'),
          solution: value('cs-solution'),
        };
        const context: Record<string, string> = {};
        for (const key of task.context) context[key] = source[key] ?? '';

        /* Taken here rather than before the GitHub reads: a run abandoned while
           waiting on the network has written nothing, and a snapshot for it
           would push a real one off the end of the ring. */
        takeSnapshot(live, task.label);
        turn.status('Writing…');

        const output = await runAssist(
          name,
          context,
          instruction,
          {
            onDelta: chunk => {
              raw += chunk;
              paint();
            },
            /* The model is deliberating rather than the request having stalled.
               The text goes into the message's own disclosure and nowhere else
               — `raw` is the answer, and only the answer reaches a field.
               Decision 29. */
            onThinking: chunk => {
              thought += chunk;
              turn.thinking(chunk);
            },
            onTool: frame => turn.tool(frame),
            onDone: reason => {
              truncated = reason === 'length';
            },
          },
          controller.signal,
          undefined,
          /* Read at the start of the run, so changing the model between two
             runs is what the control on the panel actually does. */
          panel.runOptions(),
        );

        settled = true;

        /* Names the cause, because there is exactly one that produces this and
           it is not obvious: a reasoning model that spent the task's whole
           token ceiling thinking and stopped before writing a word. */
        if (!output.trim()) {
          throw new Error(
            thought
              ? 'The model spent the whole token budget thinking and never wrote an answer. Open Thinking above to read it, then set this provider’s output ceiling on the AI screen, lower the effort in the toolbar above, or pick a model that deliberates less.'
              : 'The model finished without writing anything. Try again, or pick a different model on the AI screen.',
          );
        }

        /* A response carrying none of the labels the task asked for is not a
           result in the wrong shape, it is usually a model deliberating out
           loud. Nothing was written — every branch of `applyLive` is guarded on
           a parsed value — so it stays in the message with Copy and Try again
           rather than reaching a field. Decision 29. */
        if (shape && !parseFields(output, shape).recognised) {
          dropUnusedSnapshot();
          turn.answer(output);
          turn.actions([copy(output), again]);
          turn.note(
            'The model answered without using the field format, so nothing was written.',
            'error',
          );
          turn.end(output);
          toast('Nothing written: the reply was not in the expected format.', { tone: 'error' });
          return;
        }

        applyLive(live, output);
        turn.status(
          `Done — it is in the fields. Nothing is saved until you press Save changes.${
            truncated ? ' It hit this task’s token ceiling, so the end may be cut off.' : ''
          }`,
        );
        turn.actions([...undoAction(), again]);
        turn.end(output);
        toast(
          live === 'project'
            ? 'Frontmatter written into the fields.'
            : live === 'caseStudy'
              ? 'Case study fields written.'
              : 'Write-up written into the case study.',
          { tone: 'success' },
        );
      } catch (error) {
        settled = true;

        if (error instanceof DOMException && error.name === 'AbortError') {
          /* Stopped on purpose. Whatever arrived stays where it was written —
             that is what "live" means — and Undo is still the way back. A run
             stopped before anything arrived wrote nothing, so its snapshot goes
             rather than sitting in the ring as an Undo that does nothing. */
          if (raw) {
            applyLive(live, raw);
            turn.status(
              `Stopped. ${raw.length.toLocaleString()} characters were written; Undo puts it back.`,
            );
            turn.actions([...undoAction(), again]);
          } else {
            dropUnusedSnapshot();
            turn.status('Stopped before anything was written. Nothing changed.');
            turn.actions([again]);
          }
          turn.end(raw);
          return;
        }

        const text = error instanceof Error ? error.message : 'The assistant failed.';
        /* A run that failed part-way has already written into the fields, so
           its snapshot is the only way out and has to stay. One that failed
           before writing anything has nothing to offer, and
           `dropUnusedSnapshot` is what tells the two apart. */
        dropUnusedSnapshot();
        turn.note(text, 'error');
        turn.actions([...undoAction(), again]);
        turn.end(raw);
        toast(text, { tone: 'error' });
      } finally {
        panel.running(false);
        if (assisting === controller) assisting = null;
      }
    }

    /* — the panel —

       Mounted last, because everything above is what it calls. The same module
       the journal editor mounts, with the same contract: it decides *that* a
       command was asked for, this decides what it does to the fields. */
    const panel = mountAssistPanel({
      surface: 'project',
      docSlug: () => seed.slug,
      stop: () => assisting?.abort(),
      run: (item, instruction) => runTask(item ? item.name : 'chat', instruction),
    });

    assistOpen.addEventListener('click', () => {
      if (panel.isOpen()) panel.close();
      else panel.open();
    });

    /* Every per-section button on this page: open the panel with that section's
       command and run it. `data-assist-task` is still the whole wiring. */
    document.querySelectorAll<HTMLButtonElement>('[data-assist-task]').forEach(button => {
      button.addEventListener('click', () => {
        const name = button.dataset.assistTask ?? '';
        if (!isProjectTask(name)) return;
        const item = ASSIST_MENU.find(entry => entry.name === name);
        if (!item) return;
        panel.open();
        panel.send(`/${item.command}`);
      });
    });

    /* Same rule as the save buttons: the endpoint asks GitHub who is calling,
       so a signed-out screen says so rather than offering a button that 401s. */
    if (!signedIn) {
      const why = 'Sign in with GitHub to use the assistant.';
      assistOpen.disabled = true;
      assistOpen.title = why;
      document.querySelectorAll<HTMLButtonElement>('[data-assist-task]').forEach(button => {
        button.disabled = true;
        button.title = why;
      });
    }
  });
</script>

