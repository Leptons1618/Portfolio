---
/**
 * One project, in full — and the case study attached to it.
 *
 * The list screen at `/admin/projects` is a manifest: twenty cards, a
 * visibility switch each, and a modal for the fields. That modal was doing two
 * jobs badly — it is where an *imported* repository gets its missing fields
 * filled in, which is a short one-off form, and it was also the only way to
 * edit a project that has been in the portfolio for a year, which is not. This
 * page is the second job: room for every field, the repository's live state
 * beside them, and the case study in the same place rather than behind a
 * select that only ever said "linked".
 *
 * Read from D1 per request, hidden ones included — `getProject(db, slug, true)`,
 * the same rule the list screen follows. Everything it writes goes through
 * `content-store.ts`, and every write is live on the site as it returns.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Illustration from '../../../components/Illustration.astro';
import { Icon } from 'astro-icon/components';
import { getCaseStudies, getProject } from '../../../lib/content';
import {
  PROJECT_CATEGORIES,
  PROJECT_STATUSES,
  caseStudyPath,
  projectPath,
  type CaseStudyFields,
  type ProjectFields,
} from '../../../lib/content-store';
import { parseRepoUrl } from '../../../lib/github';

export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const slug = Astro.params.slug ?? '';
const project = slug ? await getProject(DB, slug, true) : undefined;
if (!project) return new Response(null, { status: 404 });

/* The whole list, not just the linked one: the select below offers every case
   study, and a page that only knew its own could not re-point. */
const caseStudies = await getCaseStudies(DB);
const fields = project.data;

const { owner, name: repoName } = parseRepoUrl(fields.repoUrl);
const linked = caseStudies.find(entry => entry.slug === fields.caseStudySlug);

/* Both forms prefill from the real frontmatter rather than from what the page
   happens to display, so a field neither form shows still round-trips.
   `<` is escaped because this lands inside a script element. Never write that
   tag literally in a comment: Vite's dependency scanner matches it in the raw
   `.astro` source and parses the markup after it as JavaScript. */
const seed = {
  slug,
  project: fields as ProjectFields,
  caseStudy: linked ? { slug: linked.slug, data: linked.data as CaseStudyFields } : null,
};
const seedJson = JSON.stringify(seed).replace(/</g, '\\u003c');

const STATUS_VARIANT: Record<string, string> = {
  active: 'tag-accent-2',
  stable: 'tag-accent-2',
  wip: 'tag-accent',
  archived: 'tag-neutral',
};
---
<AdminLayout title={`Project · ${fields.title}`}>
  <div class="admin-main-wide" id="admin-project-detail">
    <a class="pd-back" href="/admin/projects">
      <Icon name="lucide:arrow-left" class="admin-nav-icon" />All projects
    </a>

    <div class="admin-head pd-head">
      <div class="pd-id">
        <h6 class="admin-eyebrow-mono">MODULE: PROJECT_DETAIL</h6>
        <h1 class="admin-title">{fields.title}</h1>
        <p class="pd-paths">
          <code>{projectPath(slug)}</code>
          {linked && <> · <code>{caseStudyPath(linked.slug)}</code></>}
        </p>
        <div class="pd-flags">
          <span class={`tag ${STATUS_VARIANT[fields.status] ?? 'tag-neutral'}`}>{fields.status}</span>
          <span class="tag tag-neutral">{fields.year}</span>
          {fields.featuredRank !== undefined && (
            <span class="tag tag-accent">featured · rank {fields.featuredRank}</span>
          )}
          <span class="tag tag-neutral" id="pd-visibility-flag">{fields.hidden ? 'hidden' : 'visible'}</span>
        </div>
      </div>

      <div class="pd-head-actions">
        <div class="pm-visibility">
          <span class="pm-field-label">Visibility</span>
          <button
            type="button"
            class="toggle"
            role="switch"
            id="pd-toggle"
            data-slug={slug}
            aria-checked={fields.hidden ? 'false' : 'true'}
            aria-label={`Toggle visibility for ${fields.title}`}
          ><span></span></button>
        </div>
        <div class="admin-actions">
          <a class="btn btn-secondary btn-sm" href={fields.repoUrl} target="_blank" rel="noopener">
            <Icon name="lucide:github" class="admin-nav-icon" />{owner}/{repoName}
          </a>
          {/* A hidden project's public page 404s, so the link would be a dead
              one — say so instead of handing it out. */}
          {fields.hidden
            ? <span class="text-muted cell-mono pd-nopage">no public page</span>
            : (
              <a class="btn btn-secondary btn-sm" href={`/projects/${slug}`} target="_blank" rel="noopener">
                <Icon name="lucide:external-link" class="admin-nav-icon" />/projects/{slug}
              </a>
            )}
        </div>
      </div>
    </div>

    <p class="admin-note pd-message" id="pd-message"></p>

    {/* Two forms, one column, and stacked they were a very long scroll with the
        case study's Save button somewhere below the fold — the two halves are
        siblings rather than a hierarchy, so a tablist is the honest shape.
        `pd-message` stays *above* the bar on purpose: visibility, the fetch and
        the delete all report there, and those controls belong to the project
        rather than to either tab. */}
    <div class="tab-bar" role="tablist" aria-label="Project sections" id="pd-tabs">
      <button
        type="button"
        class="tab"
        role="tab"
        id="pd-tab-fields"
        aria-controls="pd-panel-fields"
        aria-selected="true"
      >
        <Icon name="lucide:list" class="admin-nav-icon" />Frontmatter
      </button>
      <button
        type="button"
        class="tab"
        role="tab"
        id="pd-tab-case"
        aria-controls="pd-panel-case"
        aria-selected="false"
      >
        <Icon name="lucide:book-open" class="admin-nav-icon" />Case study
        <span class="tab-badge">{linked ? linked.slug : 'none'}</span>
      </button>
    </div>

    {/* The layout is on a child rather than on the panel itself: Astro's scoping
        adds an attribute to `.pd-grid`, which would then outrank
        `.tab-panel[hidden]` and leave a "hidden" panel on screen. */}
    <div class="tab-panel" id="pd-panel-fields" role="tabpanel" aria-labelledby="pd-tab-fields">
    <div class="pd-grid">
      <section class="card elev-sm">
        <h6 class="admin-eyebrow">Project Frontmatter</h6>
        <p class="text-muted admin-note">
          Fields left blank are removed when they are optional. Visibility is the switch
          above, not a field here.
        </p>
        <hr class="rule pd-rule" />

        <div class="pf-grid">
          <div class="field pf-wide">
            <label for="pf-title">Title</label>
            <input class="input" id="pf-title" />
          </div>
          <div class="field pf-wide">
            <label for="pf-summary">Summary</label>
            <textarea class="input pf-summary" id="pf-summary"></textarea>
          </div>
          <div class="field">
            <label for="pf-category">Category</label>
            <select class="input" id="pf-category">
              {PROJECT_CATEGORIES.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="pf-status">Status</label>
            <select class="input" id="pf-status">
              {PROJECT_STATUSES.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="pf-year">Year</label>
            <input class="input" id="pf-year" type="number" min="1990" max="2100" />
          </div>
          <div class="field">
            <label for="pf-rank">Featured rank (blank = not featured)</label>
            <input class="input" id="pf-rank" type="number" min="1" max="99" />
          </div>
          <div class="field pf-wide">
            <label for="pf-tags">Tags (comma separated)</label>
            <input class="input" id="pf-tags" />
          </div>
          <div class="field pf-wide">
            <label for="pf-stack">Stack (comma separated)</label>
            <input class="input" id="pf-stack" />
          </div>
          <div class="field pf-wide">
            <label for="pf-repo">Repository URL</label>
            <input class="input" id="pf-repo" />
          </div>
          <div class="field pf-wide">
            <label for="pf-demo">Demo URL (optional)</label>
            <input class="input" id="pf-demo" />
          </div>
          <div class="field pf-wide">
            <label for="pf-hero">Hero image (optional)</label>
            <input class="input" id="pf-hero" placeholder="/images/project.jpg" />
          </div>
          <div class="field pf-wide">
            <label for="pf-highlights">Highlights (one per line)</label>
            <textarea class="input pf-highlights" id="pf-highlights"></textarea>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="pf-reset">Revert</button>
          <button type="button" class="btn btn-primary" id="pf-save">Save changes</button>
        </div>
      </section>

      <aside class="pd-side">
        <section class="card elev-sm">
          <h6 class="admin-eyebrow">Repository</h6>
          <dl class="pd-facts">
            <div><dt>Mapped</dt><dd><a href={fields.repoUrl} target="_blank" rel="noopener">{owner}/{repoName} ↗</a></dd></div>
            <div><dt>Branch</dt><dd id="pd-branch">not fetched</dd></div>
            <div><dt>Last push</dt><dd id="pd-push">not fetched</dd></div>
            <div><dt>Stars</dt><dd id="pd-stars">—</dd></div>
          </dl>
          <button type="button" class="btn btn-secondary btn-sm btn-block" id="pd-fetch">
            <Icon name="lucide:refresh-cw" class="admin-nav-icon" />Fetch from GitHub
          </button>
          <p class="text-muted admin-note">
            A public read — this one works signed out.
          </p>
        </section>

        <section class="card elev-sm">
          <h6 class="admin-eyebrow">Danger Zone</h6>
          <p class="text-muted admin-note">
            Deleting removes the row <code>{projectPath(slug)}</code> outright. There is no
            history holding a copy, so nothing brings it back — hide it with the switch
            above if you only want it off the site. A linked case study is left alone, and
            the database refuses the delete while one still points here.
          </p>
          <button type="button" class="btn btn-secondary btn-block pm-danger" id="pd-delete">
            <Icon name="lucide:trash-2" class="admin-nav-icon" />Delete this project
          </button>
        </section>
      </aside>
    </div>
    </div>

    <div class="tab-panel" id="pd-panel-case" role="tabpanel" aria-labelledby="pd-tab-case" hidden>
    {linked ? (
      <section class="card elev-sm" id="pd-case-study" data-slug={linked.slug}>
        <div class="pd-cs-bar">
          <div>
            <h3 class="pd-cs-title">{linked.data.title}</h3>
            <p class="text-muted admin-note">
              <code>{caseStudyPath(linked.slug)}</code> — the structured half. Saving any
              of it is live on <code>/case-studies/{linked.slug}</code> immediately.
            </p>
          </div>
          <div class="admin-actions">
            <a class="btn btn-secondary btn-sm" href={`/case-studies/${linked.slug}`} target="_blank" rel="noopener">
              <Icon name="lucide:external-link" class="admin-nav-icon" />Read it
            </a>
            <button type="button" class="btn btn-secondary btn-sm" id="cs-unlink">Unlink</button>
          </div>
        </div>

        <hr class="rule pd-rule" />

        <div class="pf-grid">
          <div class="field pf-wide">
            <label for="cs-title">Title</label>
            <input class="input" id="cs-title" />
          </div>
          <div class="field pf-wide">
            <label for="cs-subtitle">Subtitle</label>
            <input class="input" id="cs-subtitle" />
          </div>
          <div class="field pf-wide">
            <label for="cs-problem">Problem</label>
            <textarea class="input pf-summary" id="cs-problem"></textarea>
          </div>
          <div class="field pf-wide">
            <label for="cs-solution">Solution</label>
            <textarea class="input pf-summary" id="cs-solution"></textarea>
          </div>
          <div class="field pf-wide">
            <label for="cs-achievements">Achievements (one per line)</label>
            <textarea class="input pf-highlights" id="cs-achievements"></textarea>
          </div>
          <div class="field pf-wide">
            <label for="cs-stack">Stack (comma separated)</label>
            <input class="input" id="cs-stack" />
          </div>
          <div class="field">
            <label for="cs-date">Date</label>
            <input class="input" id="cs-date" type="date" />
          </div>
          <div class="field">
            <label for="cs-readtime">Read time (optional)</label>
            <input class="input" id="cs-readtime" placeholder="8 min" />
          </div>
          <div class="field">
            <label for="cs-repo">Repository URL (optional)</label>
            <input class="input" id="cs-repo" />
          </div>
          <div class="field">
            <label for="cs-demo">Demo URL (optional)</label>
            <input class="input" id="cs-demo" />
          </div>
          <div class="field">
            <label for="cs-hero">Hero image (optional)</label>
            <input class="input" id="cs-hero" placeholder="/images/case.jpg" />
          </div>
          <div class="field">
            <label for="cs-arch">Architecture image (optional)</label>
            <input class="input" id="cs-arch" placeholder="/images/arch.svg" />
          </div>
        </div>

        <p class="admin-note pd-message" id="cs-message"></p>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="cs-reset">Revert</button>
          <button type="button" class="btn btn-primary" id="cs-save">Save changes</button>
        </div>
      </section>
    ) : (
      <section class="card elev-sm" id="pd-case-study">
        <div class="admin-empty">
          <div class="admin-empty-art admin-empty-art-sm"><Illustration name="code-inspection" /></div>
          <h3 class="admin-empty-title">No case study yet</h3>
          <p class="admin-empty-copy">
            Scaffolding writes <code>{caseStudyPath(slug)}</code> with the structured fields
            filled in from this project and a placeholder body, then links the two. Or point
            at one that already exists.
          </p>
          <div class="admin-empty-actions">
            <button type="button" class="btn btn-primary btn-sm" id="cs-scaffold">
              <Icon name="lucide:file-plus-2" class="admin-nav-icon" />Scaffold one from this project
            </button>
            <select class="input is-auto pd-cs-pick" id="cs-pick" aria-label="Link an existing case study">
              <option value="">— link an existing one —</option>
              {caseStudies.map(entry => <option value={entry.slug}>{entry.data.title} ({entry.slug})</option>)}
            </select>
          </div>
          <p class="admin-note pd-message" id="cs-message"></p>
        </div>
      </section>
    )}
    </div>
  </div>

  <script is:inline type="application/json" id="project-detail-seed" set:html={seedJson}></script>
</AdminLayout>

<script>
  import { onAdminPage, setBusy, setLabel, toast, wireTabs } from '../../../lib/admin';
  import { relativeTime } from '../../../lib/format';
  import {
    createCaseStudy,
    patchCaseStudy,
    patchProject,
    projectPath,
    removeProject,
    type CaseStudyFields,
    type ProjectFields,
  } from '../../../lib/content-store';
  import {
    canWriteContent,
    fetchRepoMeta,
    getToken,
    getUser,
    parseRepoUrl,
  } from '../../../lib/github';
  import { attachImageUpload } from '../../../lib/image-upload';

  onAdminPage('#admin-project-detail', () => {
    interface Seed {
      slug: string;
      project: ProjectFields;
      caseStudy: { slug: string; data: CaseStudyFields } | null;
    }

    const seed: Seed = JSON.parse(document.getElementById('project-detail-seed')!.textContent || '{}');
    const signedIn = Boolean(getToken() && getUser());
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const message = (error: unknown) => (error instanceof Error ? error.message : 'Request failed.');
    const csv = (value: string) => value.split(',').map(part => part.trim()).filter(Boolean);
    const lines = (value: string) => value.split('\n').map(part => part.trim()).filter(Boolean);

    function say(host: HTMLElement, text: string, tone: 'info' | 'error' = 'info') {
      host.dataset.tone = tone;
      host.textContent = text;
    }

    /* The URL a save returns is the live page, not a commit: there is no commit
       and no build between pressing the button and the page changing. */
    function sayLink(host: HTMLElement, text: string, url: string) {
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.target = '_blank';
      anchor.rel = 'noopener';
      anchor.textContent = 'view live ↗';
      host.dataset.tone = 'info';
      host.replaceChildren(document.createTextNode(`${text} — `), anchor);
    }

    /* Wired before anything else: a throw further down would otherwise leave a
       tablist where both panels are showing at once. `#case-study` in the URL
       opens the second tab, so the case-study half is linkable — the empty
       state's "scaffold one" is a place people arrive at from elsewhere. */
    const tabs = wireTabs($('pd-tabs'));
    if (window.location.hash === '#case-study') tabs.select('pd-panel-case');

    const pageMessage = $('pd-message');
    if (!signedIn) {
      say(
        pageMessage,
        'Signed out: this screen reads fine, but every button on it writes to the live site. Sign in from the rail to use them.'
      );
    } else {
      /* What decides a write is who the token belongs to — `requireOwner()` on
         the endpoint admits one account and refuses everything else. Asking the
         same question here beats discovering the answer one failed save at a
         time. */
      canWriteContent().then(allowed => {
        if (allowed || pageMessage.textContent) return;
        const text =
          'GitHub does not report this session as the owner of this site, so saving, ' +
          'visibility and delete will all be refused. Sign out and back in with the ' +
          'account this site belongs to.';
        say(pageMessage, text, 'error');
        toast(text, { tone: 'error' });
      });
    }

    // -------------------------------------------------------------- project

    const project = {
      title: $<HTMLInputElement>('pf-title'),
      summary: $<HTMLTextAreaElement>('pf-summary'),
      category: $<HTMLSelectElement>('pf-category'),
      status: $<HTMLSelectElement>('pf-status'),
      year: $<HTMLInputElement>('pf-year'),
      rank: $<HTMLInputElement>('pf-rank'),
      tags: $<HTMLInputElement>('pf-tags'),
      stack: $<HTMLInputElement>('pf-stack'),
      repo: $<HTMLInputElement>('pf-repo'),
      demo: $<HTMLInputElement>('pf-demo'),
      hero: $<HTMLInputElement>('pf-hero'),
      highlights: $<HTMLTextAreaElement>('pf-highlights'),
    };

    function fillProject(fields: ProjectFields) {
      project.title.value = fields.title ?? '';
      project.summary.value = fields.summary ?? '';
      project.category.value = fields.category ?? 'other';
      project.status.value = fields.status ?? 'active';
      project.year.value = String(fields.year ?? new Date().getFullYear());
      project.rank.value = fields.featuredRank === undefined ? '' : String(fields.featuredRank);
      project.tags.value = (fields.tags ?? []).join(', ');
      project.stack.value = (fields.stack ?? []).join(', ');
      project.repo.value = fields.repoUrl ?? '';
      project.demo.value = fields.demoUrl ?? '';
      project.hero.value = fields.heroImage ?? '';
      project.highlights.value = (fields.highlights ?? []).join('\n');
    }

    /** The form as schema-shaped fields, or a sentence saying what is wrong. */
    function readProject(): ProjectFields | string {
      const title = project.title.value.trim();
      const summary = project.summary.value.trim();
      const repoUrl = project.repo.value.trim();
      const year = Number(project.year.value);

      if (!title) return 'A title is required — it is the card heading and the page title.';
      if (!summary) return 'A summary is required: it is the card body and the meta description.';
      try {
        new URL(repoUrl);
      } catch {
        return 'The repository URL has to be an absolute URL.';
      }
      if (!Number.isInteger(year)) return 'Year has to be a whole number.';

      const rank = project.rank.value.trim();
      return {
        title,
        summary,
        category: project.category.value as ProjectFields['category'],
        tags: csv(project.tags.value),
        stack: csv(project.stack.value),
        repoUrl,
        demoUrl: project.demo.value.trim() || undefined,
        featuredRank: rank === '' ? undefined : Number(rank),
        status: project.status.value as ProjectFields['status'],
        year,
        heroImage: project.hero.value.trim() || undefined,
        highlights: lines(project.highlights.value),
      };
    }

    /* Attached before the first fill so the preview is right on arrival — the
       control overrides the input's `value` setter, and a fill that ran first
       would land before it was listening. */
    attachImageUpload(project.hero, { dir: 'images/projects', name: () => `${seed.slug}-hero` });

    fillProject(seed.project);
    $<HTMLButtonElement>('pf-reset').addEventListener('click', () => {
      fillProject(seed.project);
      say(pageMessage, 'Reverted to what is saved.');
    });

    const saveProject = $<HTMLButtonElement>('pf-save');
    saveProject.addEventListener('click', async () => {
      if (!signedIn) return say(pageMessage, 'Sign in with GitHub to save.', 'error');

      const fields = readProject();
      if (typeof fields === 'string') return say(pageMessage, fields, 'error');

      setBusy(saveProject, true, 'Saving…');
      say(pageMessage, 'Saving…');
      const pending = toast('Saving the project…', { tone: 'pending' });
      try {
        /* `hidden` and `caseStudySlug` are deliberately not in this patch: the
           first belongs to the switch above, the second to the section below.
           A patch writes only the columns handed to it, which is what keeps a
           field this form has never heard of from being cleared by it. */
        const result = await patchProject(seed.slug, fields);
        sayLink(pageMessage, 'Saved. Live now', result.url);
        pending.update('Project saved and live.', {
          tone: 'success',
          action: { label: 'view live ↗', href: result.url },
        });
        seed.project = { ...fields, hidden: seed.project.hidden, caseStudySlug: seed.project.caseStudySlug };
      } catch (error) {
        say(pageMessage, message(error), 'error');
        pending.update(message(error), { tone: 'error' });
      } finally {
        setBusy(saveProject, false);
      }
    });

    // ----------------------------------------------------------- visibility

    const toggle = $<HTMLButtonElement>('pd-toggle');
    const visibilityFlag = $('pd-visibility-flag');

    if (!signedIn) {
      toggle.disabled = true;
      toggle.title = 'Sign in with GitHub to change visibility.';
    } else {
      toggle.addEventListener('click', async () => {
        const visible = toggle.getAttribute('aria-checked') !== 'true';
        toggle.setAttribute('aria-checked', String(visible));
        toggle.disabled = true;
        say(pageMessage, visible ? 'Publishing…' : 'Hiding…');
        const pending = toast(visible ? 'Publishing…' : 'Hiding…', { tone: 'pending' });
        try {
          const result = await patchProject(seed.slug, { hidden: !visible });
          seed.project.hidden = !visible;
          visibilityFlag.textContent = visible ? 'visible' : 'hidden';
          if (visible) {
            sayLink(pageMessage, 'Visible now', result.url);
            pending.update('The project is visible.', {
              tone: 'success',
              action: { label: 'view live ↗', href: result.url },
            });
          } else {
            say(pageMessage, 'Hidden — its page now 404s.');
            pending.update('The project is hidden. Its page now 404s.', { tone: 'success' });
          }
        } catch (error) {
          toggle.setAttribute('aria-checked', String(!visible));
          say(pageMessage, message(error), 'error');
          pending.update(message(error), { tone: 'error' });
        } finally {
          toggle.disabled = false;
        }
      });
    }

    // ----------------------------------------------------------- repository

    const fetchButton = $<HTMLButtonElement>('pd-fetch');
    fetchButton.addEventListener('click', async () => {
      setBusy(fetchButton, true, 'Reading…');
      say(pageMessage, 'Reading the repository…');
      try {
        const { owner, name } = parseRepoUrl(seed.project.repoUrl);
        const meta = await fetchRepoMeta(owner, name);
        $('pd-branch').textContent = meta.defaultBranch;
        $('pd-push').textContent = relativeTime(meta.pushedAt);
        $('pd-stars').textContent = meta.archived ? `${meta.stars} ★ · archived on GitHub` : `${meta.stars} ★`;
        say(pageMessage, `Read ${meta.fullName}.`);
      } catch (error) {
        say(pageMessage, message(error), 'error');
        toast(message(error), { tone: 'error' });
      } finally {
        setBusy(fetchButton, false);
      }
    });

    /* Two clicks, because the first one is the one people mean to take back.
       Nothing holds a copy of the row, so the confirm is the only thing between
       a mis-click and a project that is simply gone — and `setLabel` rather
       than `textContent`, because this button carries an inlined trash icon
       that writing over would delete for good. */
    const deleteButton = $<HTMLButtonElement>('pd-delete');
    let armed = false;
    let disarm: ReturnType<typeof setTimeout>;

    deleteButton.addEventListener('click', async () => {
      if (!signedIn) return say(pageMessage, 'Sign in to delete a project.', 'error');

      if (!armed) {
        armed = true;
        setLabel(deleteButton, 'Confirm delete');
        say(
          pageMessage,
          `This deletes ${projectPath(seed.slug)} for good — nothing restores it. ` +
            'Use the visibility switch instead if you only want it off the site. ' +
            'Click again to confirm.',
          'error'
        );
        disarm = setTimeout(() => {
          armed = false;
          setLabel(deleteButton, null);
          say(pageMessage, '');
        }, 5000);
        return;
      }

      clearTimeout(disarm);
      armed = false;
      setBusy(deleteButton, true, 'Deleting…');
      say(pageMessage, 'Deleting…');
      const pending = toast(`Deleting ${seed.slug}…`, { tone: 'pending' });
      try {
        await removeProject(seed.slug);
        /* The row this page renders from is gone, so this URL now 404s — there
           is nowhere useful to stay. */
        pending.update(`${seed.slug} is deleted.`, { tone: 'success' });
        window.location.assign('/admin/projects');
      } catch (error) {
        setBusy(deleteButton, false);
        say(pageMessage, message(error), 'error');
        pending.update(message(error), { tone: 'error' });
      }
    });

    // ---------------------------------------------------------- case study

    const csMessage = $('cs-message');
    const linkedSlug = document.getElementById('pd-case-study')!.dataset.slug;

    /* Both halves of this section write `caseStudySlug` on the *project*, and
       this page renders from that row — so reloading is what shows the result.
       It is a reload rather than a rebuild now, which is the whole point. */
    async function relink(next: string | undefined, verb: string) {
      const result = await patchProject(seed.slug, { caseStudySlug: next });
      sayLink(csMessage, `Saved (${verb}). Reload to see this page catch up`, result.url);
      toast(`Saved — ${verb}. Reload this screen to see it catch up.`, {
        tone: 'success',
        action: { label: 'view live ↗', href: result.url },
      });
    }

    if (linkedSlug) {
      const study = {
        title: $<HTMLInputElement>('cs-title'),
        subtitle: $<HTMLInputElement>('cs-subtitle'),
        problem: $<HTMLTextAreaElement>('cs-problem'),
        solution: $<HTMLTextAreaElement>('cs-solution'),
        achievements: $<HTMLTextAreaElement>('cs-achievements'),
        stack: $<HTMLInputElement>('cs-stack'),
        date: $<HTMLInputElement>('cs-date'),
        readTime: $<HTMLInputElement>('cs-readtime'),
        repo: $<HTMLInputElement>('cs-repo'),
        demo: $<HTMLInputElement>('cs-demo'),
        hero: $<HTMLInputElement>('cs-hero'),
        architecture: $<HTMLInputElement>('cs-arch'),
      };

      function fillCaseStudy(data: CaseStudyFields) {
        study.title.value = data.title ?? '';
        study.subtitle.value = data.subtitle ?? '';
        study.problem.value = data.problem ?? '';
        study.solution.value = data.solution ?? '';
        study.achievements.value = (data.achievements ?? []).join('\n');
        study.stack.value = (data.stack ?? []).join(', ');
        study.date.value = (data.date ?? '').slice(0, 10);
        study.readTime.value = data.readTime ?? '';
        study.repo.value = data.repoUrl ?? '';
        study.demo.value = data.demoUrl ?? '';
        study.hero.value = data.heroImage ?? '';
        study.architecture.value = data.architectureImage ?? '';
      }

      attachImageUpload(study.hero, {
        dir: 'images/case-studies',
        name: () => `${linkedSlug}-hero`,
      });
      attachImageUpload(study.architecture, {
        dir: 'images/case-studies',
        name: () => `${linkedSlug}-architecture`,
      });

      fillCaseStudy(seed.caseStudy!.data);
      $<HTMLButtonElement>('cs-reset').addEventListener('click', () => {
        fillCaseStudy(seed.caseStudy!.data);
        say(csMessage, 'Reverted to what is saved.');
      });

      const saveStudy = $<HTMLButtonElement>('cs-save');
      saveStudy.addEventListener('click', async () => {
        if (!signedIn) return say(csMessage, 'Sign in with GitHub to save.', 'error');

        const title = study.title.value.trim();
        const subtitle = study.subtitle.value.trim();
        if (!title || !subtitle) return say(csMessage, 'Title and subtitle are both required by the schema.', 'error');
        if (!study.date.value) return say(csMessage, 'A date is required — it is what orders the listing.', 'error');

        setBusy(saveStudy, true, 'Saving…');
        say(csMessage, 'Saving…');
        const pending = toast('Saving the case study…', { tone: 'pending' });
        try {
          const changes: Partial<CaseStudyFields> = {
            title,
            subtitle,
            problem: study.problem.value.trim(),
            solution: study.solution.value.trim(),
            achievements: lines(study.achievements.value),
            stack: csv(study.stack.value),
            date: study.date.value,
            readTime: study.readTime.value.trim() || undefined,
            repoUrl: study.repo.value.trim() || undefined,
            demoUrl: study.demo.value.trim() || undefined,
            heroImage: study.hero.value.trim() || undefined,
            architectureImage: study.architecture.value.trim() || undefined,
          };

          const result = await patchCaseStudy(linkedSlug, changes);
          sayLink(csMessage, 'Saved. Live now', result.url);
          pending.update('Case study saved and live.', {
            tone: 'success',
            action: { label: 'view live ↗', href: result.url },
          });
          seed.caseStudy = { slug: linkedSlug, data: { ...seed.caseStudy!.data, ...changes } };
        } catch (error) {
          say(csMessage, message(error), 'error');
          pending.update(message(error), { tone: 'error' });
        } finally {
          setBusy(saveStudy, false);
        }
      });

      const unlink = $<HTMLButtonElement>('cs-unlink');
      unlink.addEventListener('click', async () => {
        if (!signedIn) return say(csMessage, 'Sign in with GitHub to save.', 'error');
        setBusy(unlink, true, 'Unlinking…');
        say(csMessage, 'Unlinking…');
        try {
          /* The case-study row is left where it is. Removing the pointer is
             recoverable in one click; deleting prose is not. */
          await relink(undefined, 'unlink case study from');
          seed.project.caseStudySlug = undefined;
        } catch (error) {
          say(csMessage, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          setBusy(unlink, false);
        }
      });
    } else {
      const scaffold = $<HTMLButtonElement>('cs-scaffold');
      const pick = $<HTMLSelectElement>('cs-pick');

      scaffold.addEventListener('click', async () => {
        if (!signedIn) return say(csMessage, 'Sign in with GitHub to save.', 'error');
        setBusy(scaffold, true, 'Scaffolding…');
        say(csMessage, 'Scaffolding…');
        try {
          await createCaseStudy(seed.slug, {
            title: seed.project.title,
            subtitle: seed.project.summary,
            problem: 'Describe the problem this project set out to solve.',
            solution: 'Describe the approach that solved it.',
            achievements: seed.project.highlights.length ? seed.project.highlights : ['Add an achievement.'],
            stack: seed.project.stack,
            repoUrl: seed.project.repoUrl,
            demoUrl: seed.project.demoUrl,
            date: new Date().toISOString().slice(0, 10),
          });
          await relink(seed.slug, 'link case study to');
          seed.project.caseStudySlug = seed.slug;
        } catch (error) {
          say(csMessage, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          setBusy(scaffold, false);
        }
      });

      pick.addEventListener('change', async () => {
        if (!pick.value) return;
        if (!signedIn) {
          pick.value = '';
          return say(csMessage, 'Sign in with GitHub to save.', 'error');
        }
        const chosen = pick.value;
        pick.disabled = true;
        say(csMessage, 'Linking…');
        try {
          await relink(chosen, 'link case study to');
          seed.project.caseStudySlug = chosen;
        } catch (error) {
          pick.value = '';
          say(csMessage, message(error), 'error');
          toast(message(error), { tone: 'error' });
        } finally {
          pick.disabled = false;
        }
      });
    }
  });
</script>

