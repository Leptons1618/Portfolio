---
/**
 * Providers, keys, and the switch that lets strangers spend money.
 *
 * The one screen on this surface that configures a *credential* rather than
 * content, which changes two things about how it is built:
 *
 *   - **It never renders a key.** The server does not send one. The key field
 *     is empty with the stored fingerprint as its placeholder, and an untouched
 *     field is omitted from the save — `src/lib/ai-store.ts` holds that rule,
 *     because "the form did not clear the credential" is not something to
 *     re-derive per screen.
 *   - **It reads over the network, not from frontmatter.** Every other admin
 *     screen server-renders its rows. This one cannot: the response would then
 *     be HTML containing whatever the query selected, on a page that is public
 *     (`/admin/*` is public HTML — see the rule file), and the safest way to
 *     guarantee a key is never in that HTML is for the page not to have asked
 *     for one. So the shell is static and `GET /api/ai/providers` — owner-only,
 *     masked — fills it in.
 *
 * The public switch is deliberately the last thing on the page and says what it
 * costs. Turning it on is the moment this site starts paying a third party for
 * requests it did not initiate.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
import { SETTINGS_CEILINGS, THINKING_HEADROOM } from '../../lib/ai';
import {
  EFFORT_LEVELS,
  MAX_OUTPUT_CEILING,
  MIN_OUTPUT_CEILING,
  PARAM_SPECS,
  PROVIDER_PRESETS,
} from '../../lib/ai-catalog';
---
<AdminLayout title="AI Assistant">
  <div class="admin-main-wide" id="admin-ai">
    <div class="admin-head">
      <div>
        <p class="admin-eyebrow-mono">MODULE: ASSISTANT</p>
        <h1 class="admin-title">AI Assistant</h1>
        <span class="text-muted admin-stamp" id="ai-stamp">Reading providers…</span>
      </div>
      <div class="admin-actions">
        <button type="button" class="btn btn-secondary" id="ai-add">
          <Icon name="lucide:plus" class="admin-nav-icon" />Add provider
        </button>
        <button type="button" class="btn btn-primary" id="ai-save-settings">Save settings</button>
      </div>
    </div>

    <p class="admin-note ai-message" id="ai-message"></p>

    {/* Two halves, and they are two different jobs done at two different times.
        Configuring an endpoint is a thing you do once, with a key in the
        clipboard; deciding whether strangers may spend it — and how much — is a
        thing you come back to. They were one column and one rail, so the switch
        that bills the account sat beside a provider dialog and the limits sat
        under a list of models, and neither read as the decision it is.

        The initially-selected tab is marked on the server, so the right panel
        shows before `wireTabs` runs — the same contract every other tablist on
        this surface has. */}
    <div class="tab-bar" role="tablist" aria-label="Assistant settings" id="ai-tabs">
      <button type="button" class="tab" role="tab" id="ai-tab-providers" aria-controls="ai-panel-providers" aria-selected="true">
        <Icon name="lucide:plug" class="admin-nav-icon" />Providers
      </button>
      <button type="button" class="tab" role="tab" id="ai-tab-public" aria-controls="ai-panel-public" aria-selected="false">
        <Icon name="lucide:globe" class="admin-nav-icon" />Public assistant
      </button>
    </div>

    <div class="tab-panel" id="ai-panel-providers" role="tabpanel" aria-labelledby="ai-tab-providers">
      <div class="ai-grid">
      <div class="ai-col">
        <section class="card elev-sm">
          <p class="admin-eyebrow">Providers</p>
          <p class="text-muted admin-note">
            Any endpoint that speaks the OpenAI chat-completions shape — OpenRouter,
            OpenAI, Groq, Together, DeepSeek, a local server. The first
            <strong>active</strong> provider holding a key answers; a second one is
            tried only if the first fails, which is what makes more than one worth
            having.
          </p>
          <hr class="rule ai-rule" />

          <div id="ai-providers" class="ai-list">
            <div class="ai-skeleton" aria-hidden="true"></div>
            <div class="ai-skeleton" aria-hidden="true"></div>
          </div>
        </section>
      </div>

      <aside class="ai-side">
        <section class="card elev-sm">
          <p class="admin-eyebrow">How one gets picked</p>
          <ol class="ai-steps">
            <li>The <strong>active</strong> rows are tried in priority order, lowest first.</li>
            <li>Within a row, the model is tried and then each fallback in turn — a retired model id or a 429 falls through on the same key.</li>
            <li>The first row that answers wins. Everything after it is never called, so a second provider costs nothing until the first one breaks.</li>
          </ol>
          <hr class="rule ai-rule" />
          <p class="text-muted admin-note">
            The key is stored once and never sent back — this screen only ever sees a
            fingerprint of it. Leaving the field empty on an edit keeps the stored key;
            removing one is its own button.
          </p>
        </section>

        <section class="card elev-sm">
          <p class="admin-eyebrow">Both assistants, one key</p>
          <p class="text-muted admin-note">
            These rows answer the public assistant <em>and</em> the writing assistant in
            the editors. The switch on the next tab governs only the first — turning
            visitors off never takes your own tools away.
          </p>
        </section>
      </aside>
      </div>
    </div>

    <div class="tab-panel" id="ai-panel-public" role="tabpanel" aria-labelledby="ai-tab-public" hidden>
      <div class="ai-grid">
      <div class="ai-col">
        {/* The switch, and the sentence about what it means, first — every other
            toggle on this surface changes what a reader sees; this one changes
            what the owner is billed, so it is the first thing on the panel
            rather than the top of a rail beside something else. */}
        <section class="card elev-sm ai-switch-card">
          <p class="admin-eyebrow">Public assistant</p>
          <label class="ai-switch">
            <input type="checkbox" id="ai-enabled" />
            <span>Answer questions from visitors</span>
          </label>
          <p class="text-muted admin-note">
            While this is on, anyone on the public site can ask questions and each
            answer is billed to the provider's account. Off, the chat launcher does
            not appear at all and <code>/api/ai/chat</code> refuses. The writing
            assistant in the journal editor is unaffected either way — it is behind
            your sign-in.
          </p>
        </section>

        <section class="card elev-sm">
          <p class="admin-eyebrow">Scope and voice</p>
          <div class="field">
            <label for="ai-persona">House style notes</label>
            <textarea
              class="input ai-persona"
              id="ai-persona"
              placeholder="e.g. Prefer British spelling. Never claim I am 'passionate' about anything."
            ></textarea>
            <p class="text-muted admin-note">
              Appended to both assistants' instructions. It adds character; it cannot
              remove the rules — the public assistant still answers only from this
              site's published content, and still refuses everything else.
            </p>
          </div>
          <div class="field">
            <label for="ai-greeting">Opening line</label>
            <input class="input" id="ai-greeting" placeholder="Ask me anything about…" />
          </div>
          <div class="field">
            <label for="ai-suggestions">Starter questions (one per line, up to four)</label>
            <textarea class="input ai-suggestions" id="ai-suggestions"></textarea>
          </div>
        </section>
      </div>

      <aside class="ai-side">
        <section class="card elev-sm">
          <p class="admin-eyebrow">Limits</p>
          <p class="text-muted admin-note">
            The only thing standing between an unauthenticated endpoint and someone
            else's bill. Each is capped again on the server, so nothing typed here
            can lift the ceiling.
          </p>
          <div class="ai-limits">
            <div class="field">
              <label for="ai-perhour">Questions per visitor, per hour</label>
              <input class="input" type="number" id="ai-perhour" min="1" max={SETTINGS_CEILINGS.perIpPerHour} />
              <span class="text-muted ai-cap">max {SETTINGS_CEILINGS.perIpPerHour}</span>
            </div>
            <div class="field">
              <label for="ai-perday">Answers per day, site-wide</label>
              <input class="input" type="number" id="ai-perday" min="1" max={SETTINGS_CEILINGS.perDayTotal} />
              <span class="text-muted ai-cap">max {SETTINGS_CEILINGS.perDayTotal}</span>
            </div>
            <div class="field">
              <label for="ai-maxchars">Question length</label>
              <input class="input" type="number" id="ai-maxchars" min="1" max={SETTINGS_CEILINGS.maxQuestionChars} />
              <span class="text-muted ai-cap">characters, max {SETTINGS_CEILINGS.maxQuestionChars}</span>
            </div>
            <div class="field">
              <label for="ai-maxturns">Conversation depth</label>
              <input class="input" type="number" id="ai-maxturns" min="1" max={SETTINGS_CEILINGS.maxTurns} />
              <span class="text-muted ai-cap">messages kept, max {SETTINGS_CEILINGS.maxTurns}</span>
            </div>
            <div class="field">
              <label for="ai-maxout">Answer length</label>
              <input class="input" type="number" id="ai-maxout" min="1" max={SETTINGS_CEILINGS.maxOutputTokens} />
              <span class="text-muted ai-cap">
                tokens, max {SETTINGS_CEILINGS.maxOutputTokens.toLocaleString()}. A model that thinks
                before it writes spends this on <em>both</em>, so it has to clear the thinking. A
                provider row naming a larger ceiling raises this to {THINKING_HEADROOM.toLocaleString()}
                and no further — it says what the model accepts, not what you want to pay for.
              </span>
            </div>
            <div class="field">
              <label for="ai-effort">Thinking</label>
              <select class="input" id="ai-effort">
                <option value="">Leave it to the provider</option>
                {EFFORT_LEVELS.map(level => (
                  <option value={level}>{level[0].toUpperCase() + level.slice(1)}</option>
                ))}
              </select>
              <span class="text-muted ai-cap">
                The only setting here that acts on thinking rather than on the total. Answer
                length bounds reasoning and prose together and cannot say how the model splits
                them; this can. <strong>Low</strong> is the default and the right one for a
                question answered out of an index — anything more is billed deliberation that
                ends up in a disclosure nobody opens.
              </span>
            </div>
          </div>
        </section>

        <section class="card elev-sm">
          <p class="admin-eyebrow">What it knows</p>
          <p class="text-muted admin-note" id="ai-corpus">Measuring…</p>
          <p class="text-muted admin-note">
            Published posts, visible projects, case studies and the resume. Hidden
            projects, drafts and unpublished posts are never included — not in the
            index and not through a lookup — and neither are your email, phone or
            address.
          </p>
          <hr class="rule ai-rule" />
          <p class="admin-eyebrow">Today</p>
          <p class="text-muted admin-note" id="ai-usage">—</p>
        </section>
      </aside>
      </div>
    </div>
  </div>

  {/* Creation and editing share one dialog, and the only difference is whether
      the slug is editable. Native `<dialog>`, styled by `.modal*` in admin.css
      like every other one here.

      Three of these fields used to be free text holding a model id, which made
      each of them a spelling test whose only feedback was a 404 in front of a
      visitor. They are still free text — a model that exists is not always a
      model the vendor lists — but Browse asks the provider what it serves and
      fills them in. */}
  <dialog class="modal ai-modal" id="ai-dialog">
    <form method="dialog" class="modal-head">
      <h3 class="modal-title" id="ai-dialog-title">Add a provider</h3>
      <button class="btn btn-icon" value="cancel" aria-label="Close">
        <Icon name="lucide:x" class="admin-nav-icon" />
      </button>
    </form>

    <div class="modal-body">
      {/* The preset fills the three fields under it and is not itself stored:
          the row holds a URL, so a vendor nobody has heard of is one paste into
          "Something else" away and does not need a release. */}
      <div class="field">
        <label for="ai-f-preset">Provider</label>
        <select class="input" id="ai-f-preset">
          {PROVIDER_PRESETS.map(preset => <option value={preset.id}>{preset.label}</option>)}
        </select>
        <p class="text-muted admin-note" id="ai-f-preset-note"></p>
      </div>

      <div class="field">
        <label for="ai-f-slug">Key</label>
        <input class="input" id="ai-f-slug" placeholder="openrouter" />
        <p class="text-muted admin-note">
          Lowercase words joined by hyphens. It is the row's primary key and cannot
          be changed later.
        </p>
      </div>
      <div class="field">
        <label for="ai-f-label">Name</label>
        <input class="input" id="ai-f-label" placeholder="OpenRouter" />
      </div>
      <div class="field">
        <label for="ai-f-baseurl">Base URL</label>
        <input class="input" id="ai-f-baseurl" placeholder="https://openrouter.ai/api/v1" />
        <p class="text-muted admin-note">
          No trailing slash. <code>/chat/completions</code> is appended.
        </p>
      </div>
      <div class="field">
        <label for="ai-f-key">API key</label>
        <input class="input" type="password" id="ai-f-key" autocomplete="off" spellcheck="false" />
        <p class="text-muted admin-note" id="ai-f-key-note">
          Stored in the database and never sent back to this screen. Leave it empty
          to keep the key already stored.
        </p>
      </div>

      <div class="field">
        <label for="ai-f-model">Model</label>
        <div class="ai-pick">
          <input class="input" id="ai-f-model" placeholder="anthropic/claude-3.5-haiku" />
          <button type="button" class="btn btn-secondary btn-sm" data-pick="model">Browse</button>
        </div>
        <p class="text-muted admin-note">Answers visitors' questions.</p>
      </div>
      <div class="field">
        <label for="ai-f-assist">Writing model (optional)</label>
        <div class="ai-pick">
          <input class="input" id="ai-f-assist" placeholder="leave empty to use the same one" />
          <button type="button" class="btn btn-secondary btn-sm" data-pick="assist">Browse</button>
        </div>
        <p class="text-muted admin-note">
          Used by the writing assistant. Drafting a post and answering a question
          rarely want the same price.
        </p>
      </div>
      <div class="field">
        <label for="ai-f-fallbacks">Fallback models (optional)</label>
        <div class="ai-pick">
          <input class="input" id="ai-f-fallbacks" placeholder="one per line, or comma separated" />
          <button type="button" class="btn btn-secondary btn-sm" data-pick="fallbacks">Browse</button>
        </div>
        <p class="text-muted admin-note">
          Tried in order when the model above will not answer — a 429, a 5xx, a
          timeout, or a model that was retired overnight. Same key, same base URL.
        </p>
      </div>

      {/* — what a run may spend, and how it may think —

          The three fields that answer the reported failure: a reasoning model
          spent a task's whole 2,000-token ceiling narrating a plan and never
          wrote the post. The ceiling is filled in from the vendor's own listing
          the moment a model is picked above, so "use the model's maximum" is
          the default rather than something to look up. */}
      <div class="field field-row">
        <div>
          <label for="ai-f-maxout">Output ceiling</label>
          <input
            class="input"
            type="number"
            id="ai-f-maxout"
            min={MIN_OUTPUT_CEILING}
            max={MAX_OUTPUT_CEILING}
            placeholder="from the model"
          />
          <p class="text-muted admin-note">
            The largest completion this model will be asked for. It <strong>raises</strong>
            every writing task's own ceiling, so a model that thinks before it writes has
            room for both. Empty means each task keeps its own number. Nothing is billed
            for an unused ceiling.
          </p>
          {/* A second paragraph rather than rewriting the one above: that one
              carries markup, and `textContent` over it would delete the emphasis
              for good — the same trap `setLabel()` exists for on buttons. */}
          <p class="text-muted admin-note ai-cap" id="ai-f-maxout-note" hidden></p>
        </div>
        <div>
          <label for="ai-f-effort">Reasoning effort</label>
          <select class="input" id="ai-f-effort">
            <option value="">Don't send one</option>
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
          <p class="text-muted admin-note">
            Where the vendor implements it. Low is the dial to reach for when a model
            deliberates for a page before answering.
          </p>
        </div>
      </div>

      <div class="field">
        <label class="ai-switch ai-switch-inline">
          <input type="checkbox" id="ai-f-tools" />
          <span>Let it look content up</span>
        </label>
        <p class="text-muted admin-note">
          On, both assistants get an index of this site and fetch the posts and projects
          they need. Off, the whole index still goes in the prompt and nothing is fetched
          — which is the right setting for a model with no tool support, though a refused
          tool call already falls back to it on its own.
        </p>
      </div>

      <div class="field">
        <label class="ai-switch ai-switch-inline">
          <input type="checkbox" id="ai-f-cache" />
          <span>Mark cacheable prompts</span>
        </label>
        <p class="text-muted admin-note">
          The rules and the content index are identical from one question to the next, so
          they can be sent as a cache breakpoint and charged once rather than every time.
          Only ever sent to OpenRouter and Anthropic, which are the two APIs that read
          one; everywhere else it is dropped and the field is ignored.
        </p>
      </div>

      {/* Closed by default. These are the fields nobody needs on the day they
          add a provider and somebody needs on the day a model will not behave. */}
      <details class="ai-params">
        <summary class="ai-params-summary">Sampling parameters</summary>
        <p class="text-muted admin-note">
          Left empty, the field is <strong>not sent at all</strong> and the
          provider's own default applies — which is not the same as sending that
          default, because several providers refuse parameters they do not
          implement. Anything set here applies to every request to this provider,
          including the temperature each writing task asks for.
        </p>
        <p class="text-muted admin-note ai-param-support" id="ai-param-support"></p>
        <div class="ai-params-grid">
          {PARAM_SPECS.map(spec => (
            <div class="field ai-param" data-param={spec.key}>
              <label for={`ai-p-${spec.key}`}>{spec.label}</label>
              <input
                class="input"
                type="number"
                id={`ai-p-${spec.key}`}
                min={spec.min}
                max={spec.max}
                step={spec.step}
                placeholder={spec.fallback}
              />
              <span class="text-muted ai-cap">{spec.hint}</span>
            </div>
          ))}
        </div>
      </details>

      <div class="field field-row">
        <div>
          <label for="ai-f-priority">Priority</label>
          <input class="input" type="number" id="ai-f-priority" value="10" min="0" />
          <p class="text-muted admin-note">Lower runs first.</p>
        </div>
        <div>
          <label class="ai-switch ai-switch-inline">
            <input type="checkbox" id="ai-f-active" />
            <span>Active</span>
          </label>
        </div>
      </div>
    </div>

    <div class="modal-foot">
      <button type="button" class="btn btn-secondary" id="ai-dialog-cancel">Cancel</button>
      <button type="button" class="btn btn-primary" id="ai-dialog-save">Save provider</button>
    </div>
  </dialog>

  {/* The model browser.

      One dialog for all three fields, in two modes: the fallback list picks
      several and the other two pick one. The rows are built in script, so their
      rules hang off `#ai-model-list` with `:global()` — a scoped selector never
      reaches DOM that did not come from this template. */}
  <dialog class="modal modal-fixed ai-modal" id="ai-models">
    <form method="dialog" class="modal-head">
      <h3 class="modal-title" id="ai-models-title">Choose a model</h3>
      <button class="btn btn-icon" value="cancel" aria-label="Close">
        <Icon name="lucide:x" class="admin-nav-icon" />
      </button>
    </form>

    <div class="modal-body">
      <div class="ai-model-tools">
        <input
          class="input"
          id="ai-model-search"
          type="search"
          placeholder="Filter by id, name or description"
          autocomplete="off"
          spellcheck="false"
        />
        <div class="ai-model-filters" id="ai-model-filters">
          <button type="button" class="ai-chip" data-filter="all" aria-pressed="true">All</button>
          <button type="button" class="ai-chip" data-filter="free" aria-pressed="false">Free</button>
          <button type="button" class="ai-chip" data-filter="long" aria-pressed="false">128k+ context</button>
        </div>
      </div>
      <p class="text-muted admin-note" id="ai-model-status">Asking the provider…</p>
      <div class="ai-model-list" id="ai-model-list"></div>
    </div>

    <div class="modal-foot">
      <span class="text-muted ai-model-count" id="ai-model-count"></span>
      <button type="button" class="btn btn-secondary" id="ai-models-cancel">Cancel</button>
      <button type="button" class="btn btn-primary" id="ai-models-use">Use selected</button>
    </div>
  </dialog>

</AdminLayout>

<script>
  import { onAdminPage, setBusy, setLabel, toast, wireTabs } from '../../lib/admin';
  import {
    clearKey,
    createProvider,
    loadOverview,
    listModels,
    removeProvider,
    saveAiSettings,
    saveProvider,
    setProviderActive,
    testProvider,
    type AiOverview,
    type ProviderSummary,
  } from '../../lib/ai-store';
  import { DEFAULTS, type AiSettings } from '../../lib/ai';
  import {
    PARAM_SPECS,
    PROVIDER_PRESETS,
    clampEffort,
    clampOutputCeiling,
    clampParams,
    presetFor,
    presetForUrl,
    type ModelInfo,
  } from '../../lib/ai-catalog';
  import { getToken } from '../../lib/github';

  onAdminPage('#admin-ai', () => {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const message = $('ai-message');
    const stamp = $('ai-stamp');
    const list = $('ai-providers');
    const dialog = $<HTMLDialogElement>('ai-dialog');

    /* The two head actions belong to one panel each — "Add provider" to the
       first, "Save settings" to the second — and showing both on both is how a
       screen ends up with a Save that saves something you cannot see. Hiding
       rather than disabling: a greyed-out button invites the question of what
       would un-grey it, and the answer here is "a tab", which the tab already
       says. */
    const addBtn = $<HTMLButtonElement>('ai-add');
    const saveBtn = $<HTMLButtonElement>('ai-save-settings');

    wireTabs($('ai-tabs'), id => {
      addBtn.hidden = id !== 'ai-panel-providers';
      saveBtn.hidden = id !== 'ai-panel-public';
    });

    const say = (text: string, tone: 'info' | 'error' = 'info') => {
      message.dataset.tone = tone;
      message.textContent = text;
    };

    /* The settings inputs, as one map, because they are read and written
       together and naming them twice is how a field ends up saved but not
       restored. */
    const settingsFields = {
      enabled: $<HTMLInputElement>('ai-enabled'),
      persona: $<HTMLTextAreaElement>('ai-persona'),
      greeting: $<HTMLInputElement>('ai-greeting'),
      suggestions: $<HTMLTextAreaElement>('ai-suggestions'),
      perIpPerHour: $<HTMLInputElement>('ai-perhour'),
      perDayTotal: $<HTMLInputElement>('ai-perday'),
      maxQuestionChars: $<HTMLInputElement>('ai-maxchars'),
      maxTurns: $<HTMLInputElement>('ai-maxturns'),
      maxOutputTokens: $<HTMLInputElement>('ai-maxout'),
      reasoningEffort: $<HTMLSelectElement>('ai-effort'),
    };

    /* — settings —

       These live in the same `documents` row the server reads, and the server
       clamps them again on the way back in. The form is therefore free to be
       lenient: `number()` falls back rather than validating, because a blank
       field meaning "the default" is friendlier than a red outline and the
       ceiling is enforced somewhere it cannot be edited. */
    const number = (input: HTMLInputElement, fallback: number) => {
      const value = Number(input.value);
      return Number.isFinite(value) && value > 0 ? Math.floor(value) : fallback;
    };

    function readSettings(): AiSettings {
      return {
        enabled: settingsFields.enabled.checked,
        persona: settingsFields.persona.value,
        greeting: settingsFields.greeting.value || DEFAULTS.greeting,
        suggestions: settingsFields.suggestions.value
          .split('\n')
          .map(line => line.trim())
          .filter(Boolean)
          .slice(0, 4),
        perIpPerHour: number(settingsFields.perIpPerHour, DEFAULTS.perIpPerHour),
        perDayTotal: number(settingsFields.perDayTotal, DEFAULTS.perDayTotal),
        maxQuestionChars: number(settingsFields.maxQuestionChars, DEFAULTS.maxQuestionChars),
        maxTurns: number(settingsFields.maxTurns, DEFAULTS.maxTurns),
        maxOutputTokens: number(settingsFields.maxOutputTokens, DEFAULTS.maxOutputTokens),
        /* Empty is a real choice — "send no effort field" — and not a missing
           one, so it is passed through rather than falling back to the default
           the way the numbers above do. `clampSettings` turns anything that is
           not one of the three levels into `null`, which is the same thing. */
        reasoningEffort: clampEffort(settingsFields.reasoningEffort.value),
      };
    }

    function fillSettings(settings: AiSettings) {
      settingsFields.enabled.checked = settings.enabled;
      settingsFields.persona.value = settings.persona;
      settingsFields.greeting.value = settings.greeting;
      settingsFields.suggestions.value = settings.suggestions.join('\n');
      settingsFields.perIpPerHour.value = String(settings.perIpPerHour);
      settingsFields.perDayTotal.value = String(settings.perDayTotal);
      settingsFields.maxQuestionChars.value = String(settings.maxQuestionChars);
      settingsFields.maxTurns.value = String(settings.maxTurns);
      settingsFields.maxOutputTokens.value = String(settings.maxOutputTokens);
      /* `null` is the empty option, which is what "leave it to the provider"
         is stored as. `?? ''` rather than a branch, because `select.value = ''`
         on a select that has an empty option selects it. */
      settingsFields.reasoningEffort.value = settings.reasoningEffort ?? '';
    }

    /* — the provider rows —

       Built with `createElement`, so none of these nodes carries this page's
       `data-astro-cid` and none of the scoped rules below would reach them. The
       styles live in `src/styles/admin.css`, which is global — the same door
       the upload control and the media library go through. Nothing here goes
       near an HTML parser either: a label and a base URL are author-supplied,
       and the fingerprint is derived from a secret. */
    function providerRow(provider: ProviderSummary): HTMLElement {
      const row = document.createElement('div');
      row.className = 'ai-provider';
      row.dataset.slug = provider.slug;
      if (provider.active) row.dataset.state = 'active';

      const head = document.createElement('div');
      head.className = 'ai-provider-head';

      const name = document.createElement('p');
      name.className = 'ai-provider-name';
      name.textContent = provider.label;

      const badge = document.createElement('span');
      badge.className = 'ai-badge';
      /* Three states, not two. "Active but keyless" is the one that would
         otherwise look like it was working, and it is the single most likely
         thing to be wrong on this screen. */
      badge.dataset.tone = provider.active ? (provider.hasKey ? 'on' : 'warn') : 'off';
      badge.textContent = provider.active
        ? provider.hasKey
          ? 'active'
          : 'active · no key'
        : 'off';

      head.append(name, badge);

      const meta = document.createElement('p');
      meta.className = 'ai-provider-meta';
      const tuned = Object.entries(provider.params ?? {});
      meta.textContent = [
        provider.model,
        provider.fallbackModels.length ? `then ${provider.fallbackModels.join(', ')}` : '',
        provider.assistModel ? `writing: ${provider.assistModel}` : '',
        provider.maxOutputTokens ? `${provider.maxOutputTokens.toLocaleString()} out` : '',
        provider.reasoningEffort ? `effort ${provider.reasoningEffort}` : '',
        /* Only when it is *off*, which is the state worth reading: on is the
           default and a row saying so nine times is nine things that say
           nothing happened — the same rule the params line follows. */
        provider.toolsEnabled ? '' : 'no lookups',
        /* Only when something is set. A row listing nine defaults is nine
           things to read that say nothing happened. */
        tuned.length ? tuned.map(([key, value]) => `${key} ${value}`).join(', ') : '',
        provider.keyHint ? `key ${provider.keyHint}` : 'no key stored',
        `priority ${provider.priority}`,
      ]
        .filter(Boolean)
        .join(' · ');

      const url = document.createElement('p');
      url.className = 'ai-provider-url';
      url.textContent = provider.baseUrl;

      const result = document.createElement('p');
      result.className = 'ai-provider-result';
      result.hidden = true;

      const actions = document.createElement('div');
      actions.className = 'ai-provider-actions';

      const button = (label: string, variant: string, onClick: (btn: HTMLButtonElement) => void) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `btn ${variant} btn-sm`;
        b.textContent = label;
        b.addEventListener('click', () => onClick(b));
        return b;
      };

      const toggle = button(
        provider.active ? 'Deactivate' : 'Activate',
        'btn-secondary',
        async btn => {
          setBusy(btn, true, '…');
          try {
            await setProviderActive(provider.slug, !provider.active);
            toast(
              `${provider.label} is ${provider.active ? 'no longer answering' : 'now answering'}.`,
              { tone: 'success' },
            );
            await refresh();
          } catch (error) {
            fail(error, btn);
          }
        },
      );

      const test = button('Test', 'btn-secondary', async btn => {
        setBusy(btn, true, 'Testing…');
        result.hidden = false;
        result.dataset.tone = 'pending';
        result.textContent = 'Sending one short request…';
        try {
          const outcome = await testProvider(provider.slug);
          result.dataset.tone = outcome.ok ? 'ok' : 'error';
          result.textContent = outcome.message;
          toast(outcome.ok ? `${provider.label} works.` : `${provider.label} refused.`, {
            tone: outcome.ok ? 'success' : 'error',
          });
        } catch (error) {
          result.dataset.tone = 'error';
          result.textContent = error instanceof Error ? error.message : 'Test failed.';
        } finally {
          setBusy(btn, false);
        }
      });

      const edit = button('Edit', 'btn-secondary', () => openDialog(provider));

      /* Two-click confirm, the same shape the delete buttons elsewhere on this
         surface use, and `setLabel` rather than `textContent` so an icon added
         to this button later is not silently deleted by the arming step. */
      let armed = false;
      const remove = button('Delete', 'btn-ghost', async btn => {
        if (!armed) {
          armed = true;
          setLabel(btn, 'Confirm delete');
          setTimeout(() => {
            armed = false;
            setLabel(btn, null);
          }, 4000);
          return;
        }
        setBusy(btn, true, 'Deleting…');
        try {
          await removeProvider(provider.slug);
          toast(`${provider.label} removed.`, { tone: 'success' });
          await refresh();
        } catch (error) {
          fail(error, btn);
        }
      });

      actions.append(toggle, test, edit);
      if (provider.hasKey) {
        actions.append(
          button('Clear key', 'btn-ghost', async btn => {
            setBusy(btn, true, '…');
            try {
              await clearKey(provider.slug);
              toast(`${provider.label}'s key is gone. It will not answer until a new one is set.`, {
                tone: 'info',
              });
              await refresh();
            } catch (error) {
              fail(error, btn);
            }
          }),
        );
      }
      actions.append(remove);

      row.append(head, meta, url, actions, result);
      return row;
    }

    function fail(error: unknown, button?: HTMLButtonElement) {
      const text = error instanceof Error ? error.message : 'That did not work.';
      say(text, 'error');
      toast(text, { tone: 'error' });
      if (button) setBusy(button, false);
    }

    /* — the dialog —

       One dialog for both create and edit; `editing` is which. The key field is
       always empty on open, including when editing, because there is nothing to
       put in it — the server never sends a key back. The placeholder carries
       the fingerprint so the field is not mistaken for "no key stored". */
    let editing: ProviderSummary | null = null;

    const dialogFields = {
      preset: $<HTMLSelectElement>('ai-f-preset'),
      slug: $<HTMLInputElement>('ai-f-slug'),
      label: $<HTMLInputElement>('ai-f-label'),
      baseUrl: $<HTMLInputElement>('ai-f-baseurl'),
      key: $<HTMLInputElement>('ai-f-key'),
      model: $<HTMLInputElement>('ai-f-model'),
      assist: $<HTMLInputElement>('ai-f-assist'),
      fallbacks: $<HTMLInputElement>('ai-f-fallbacks'),
      maxOut: $<HTMLInputElement>('ai-f-maxout'),
      effort: $<HTMLSelectElement>('ai-f-effort'),
      tools: $<HTMLInputElement>('ai-f-tools'),
      cache: $<HTMLInputElement>('ai-f-cache'),
      priority: $<HTMLInputElement>('ai-f-priority'),
      active: $<HTMLInputElement>('ai-f-active'),
    };

    /* One input per spec, looked up by key rather than named nine times. A knob
       added to `PARAM_SPECS` gets a field in the markup and a line here for
       free; naming them individually is how one ends up saved but not
       restored, which is the same reason `settingsFields` above is a map. */
    const paramFields = new Map<string, HTMLInputElement>(
      PARAM_SPECS.map(spec => [spec.key, $<HTMLInputElement>(`ai-p-${spec.key}`)]),
    );

    /** Only the knobs that were actually set. Blank means "send nothing". */
    function readParams(): Record<string, number> {
      const raw: Record<string, unknown> = {};
      for (const [key, input] of paramFields) {
        if (input.value.trim()) raw[key] = Number(input.value);
      }
      /* Clamped here as well as on the server. The ranges are the same table
         either side, and a form that sends a value it knows is out of range
         only to have it silently corrected is a form that lies about what it
         saved. */
      return clampParams(raw);
    }

    function fillParams(params: Record<string, number> | undefined) {
      for (const [key, input] of paramFields) {
        const value = params?.[key];
        input.value = value === undefined ? '' : String(value);
      }
    }

    /* — presets —

       The dropdown is not stored. It fills three fields and then has no further
       say: the row holds a base URL, so the vendor list is a convenience rather
       than a gate, and "Something else" is what keeps it that way. */
    function applyPreset(id: string, { force }: { force: boolean }) {
      const preset = presetFor(id);
      $('ai-f-preset-note').textContent = preset?.note ?? '';

      const keyNote = $('ai-f-key-note');
      keyNote.dataset.preset = preset?.keyUrl ? 'linked' : '';

      if (!preset || preset.id === 'custom') return;
      /* `force` is a deliberate change of the dropdown. Opening the dialog on
         an existing row is not, and must not overwrite what is stored — the
         preset is *derived* from the URL there, and writing it back would be
         the screen editing a row nobody asked it to edit. */
      if (!force) return;

      dialogFields.baseUrl.value = preset.baseUrl;
      if (!dialogFields.label.value.trim()) dialogFields.label.value = preset.label;
      if (!dialogFields.slug.disabled && !dialogFields.slug.value.trim()) {
        dialogFields.slug.value = preset.id;
      }
      dialogFields.model.placeholder = preset.sample || 'model id';
      /* A different vendor serves a different catalogue, so anything cached
         from the last one is not an answer to this one. */
      catalogue = null;
    }

    dialogFields.preset.addEventListener('change', () => {
      applyPreset(dialogFields.preset.value, { force: true });
    });

    function openDialog(provider: ProviderSummary | null) {
      editing = provider;
      $('ai-dialog-title').textContent = provider ? `Edit ${provider.label}` : 'Add a provider';

      dialogFields.slug.value = provider?.slug ?? '';
      dialogFields.slug.disabled = Boolean(provider);
      dialogFields.label.value = provider?.label ?? '';
      dialogFields.baseUrl.value = provider?.baseUrl ?? 'https://openrouter.ai/api/v1';
      dialogFields.model.value = provider?.model ?? '';
      dialogFields.assist.value = provider?.assistModel ?? '';
      dialogFields.fallbacks.value = (provider?.fallbackModels ?? []).join(', ');
      dialogFields.maxOut.value = provider?.maxOutputTokens ? String(provider.maxOutputTokens) : '';
      /* A stored number belongs to whoever saved it. Clearing the flag is what
         stops the picker overwriting it the next time a model is browsed. */
      delete dialogFields.maxOut.dataset.auto;
      /* Says what to do, for the case this field exists to fix: a row written
         before it did, on a model that thinks. The picker fills it in, and a
         row that never opens the picker would otherwise sit on each task's own
         ceiling with nothing on screen suggesting there was a better number. */
      ceilingHint(
        provider && !provider.maxOutputTokens
          ? 'Empty, so every writing task keeps its own ceiling. Press Browse above and pick your model again to fill this in from what the vendor says it accepts — that is the fix for a model that spends the whole budget thinking and never writes a word.'
          : '',
      );
      dialogFields.effort.value = provider?.reasoningEffort ?? '';
      /* Both default on for a new row, which is what the migration's DEFAULT
         does for one written any other way. */
      dialogFields.tools.checked = provider?.toolsEnabled ?? true;
      dialogFields.cache.checked = provider?.promptCache ?? true;
      dialogFields.priority.value = String(provider?.priority ?? 10);
      dialogFields.active.checked = provider?.active ?? false;
      fillParams(provider?.params);

      /* Derived from the stored URL when editing, so Edit opens on the vendor
         the row actually points at rather than on whatever was picked last. */
      const preset = provider ? presetForUrl(provider.baseUrl) : PROVIDER_PRESETS[0];
      dialogFields.preset.value = preset.id;
      applyPreset(preset.id, { force: !provider });
      catalogue = null;
      $('ai-param-support').textContent = '';

      dialogFields.key.value = '';
      dialogFields.key.placeholder = provider?.keyHint ?? 'sk-…';
      $('ai-f-key-note').textContent = provider?.hasKey
        ? `A key ending ${provider.keyHint} is stored. Leave this empty to keep it, or paste a new one to replace it.`
        : 'Stored in the database and never sent back to this screen.';

      dialog.showModal();
    }

    $<HTMLButtonElement>('ai-add').addEventListener('click', () => openDialog(null));
    $<HTMLButtonElement>('ai-dialog-cancel').addEventListener('click', () => dialog.close());

    /* Backdrop click, the one dismissal a `<dialog>` does not give for free. */
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });

    $<HTMLButtonElement>('ai-dialog-save').addEventListener('click', async event => {
      const button = event.currentTarget as HTMLButtonElement;
      const slug = dialogFields.slug.value.trim();

      if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
        toast('The key must be lowercase words joined by hyphens.', { tone: 'error' });
        dialogFields.slug.focus();
        return;
      }
      if (!dialogFields.label.value.trim() || !dialogFields.baseUrl.value.trim() || !dialogFields.model.value.trim()) {
        toast('Name, base URL and model are all required.', { tone: 'error' });
        return;
      }

      const fields = {
        label: dialogFields.label.value.trim(),
        baseUrl: dialogFields.baseUrl.value.trim().replace(/\/+$/, ''),
        model: dialogFields.model.value.trim(),
        assistModel: dialogFields.assist.value.trim(),
        fallbackModels: dialogFields.fallbacks.value
          .split(/[,\n]/)
          .map(m => m.trim())
          .filter(Boolean),
        params: readParams(),
        /* `null` rather than omitted when it is blank: an emptied field means
           "go back to each task's own ceiling", and omitting it on a patch
           would leave the old number in place — the same trap the key field
           has, with the opposite resolution, because this one is readable. */
        maxOutputTokens: clampOutputCeiling(dialogFields.maxOut.value),
        reasoningEffort: dialogFields.effort.value,
        toolsEnabled: dialogFields.tools.checked,
        promptCache: dialogFields.cache.checked,
        active: dialogFields.active.checked,
        priority: Number(dialogFields.priority.value) || 10,
        apiKey: dialogFields.key.value,
      };

      setBusy(button, true, 'Saving…');
      try {
        if (editing) await saveProvider(editing.slug, fields);
        else await createProvider(slug, fields);
        dialog.close();
        toast(`${fields.label} saved.`, { tone: 'success' });
        await refresh();
      } catch (error) {
        fail(error, button);
        return;
      }
      setBusy(button, false);
    });

    /* — the model browser —

       Three fields on the dialog hold a model id and all three used to be
       spelling tests: the only feedback for a typo was a 404 in front of a
       visitor, and the only way to know what a vendor served was the vendor's
       own website. This asks the provider.

       One dialog in two modes. `fallbacks` picks several; the other two pick
       one. The mode is the target field rather than a flag, because the three
       differ in more than arity — what "Use selected" writes, and whether an
       empty selection is meaningful, are both per field.

       The listing is cached per base URL for as long as the dialog is open.
       OpenRouter's is several hundred rows and roughly a megabyte before this
       endpoint trims it, and re-fetching it to reopen the same list twice is
       the kind of thing that makes a screen feel slow for no reason. It is
       dropped whenever the base URL changes, which is the only thing that can
       make it wrong. */
    type PickTarget = 'model' | 'assist' | 'fallbacks';

    const modelsDialog = $<HTMLDialogElement>('ai-models');
    const modelList = $('ai-model-list');
    const modelSearch = $<HTMLInputElement>('ai-model-search');
    const modelStatus = $('ai-model-status');
    const modelCount = $('ai-model-count');

    let catalogue: ModelInfo[] | null = null;
    let picking: PickTarget = 'model';
    let filter: 'all' | 'free' | 'long' = 'all';
    const chosen = new Set<string>();

    /** Rendered rows, capped. Six hundred `<div>`s is a scrollbar, not a list. */
    const RENDER_CAP = 250;
    const LONG_CONTEXT = 128_000;

    /**
     * The wait, as rows rather than a sentence over an empty box.
     *
     * The import modal's pattern, mirrored: same grid as a real model row
     * (id + badges, then the note line), same `.skeleton` sweep from
     * admin.css — so the list does not reflow when the response replaces it,
     * and the dialog reads as working from the frame it opens.
     */
    function renderModelSkeleton() {
      const rows = Array.from({ length: 6 }, () => {
        const row = document.createElement('div');
        row.className = 'ai-model-skeleton';
        row.setAttribute('aria-hidden', 'true');

        const head = document.createElement('div');
        head.className = 'ai-model-skeleton-head';
        const id = document.createElement('div');
        id.className = 'skeleton skeleton-line-sm ai-model-skeleton-id';
        const badges = document.createElement('div');
        badges.className = 'ai-model-skeleton-badges';
        for (const width of ['34px', '44px', '28px']) {
          const badge = document.createElement('div');
          badge.className = 'skeleton ai-model-skeleton-badge';
          badge.style.width = width;
          badges.append(badge);
        }
        head.append(id, badges);

        const note = document.createElement('div');
        note.className = 'skeleton skeleton-line-sm ai-model-skeleton-note';

        row.append(head, note);
        return row;
      });
      modelList.replaceChildren(...rows);
    }

    const price = (value: number | null) =>
      value === null ? '' : value === 0 ? 'free' : `$${value < 1 ? value.toFixed(3) : value.toFixed(2)}/M`;

    function matches(model: ModelInfo, needle: string): boolean {
      if (filter === 'free' && !model.free) return false;
      if (filter === 'long' && (model.contextLength ?? 0) < LONG_CONTEXT) return false;
      if (!needle) return true;
      /* Every term has to appear somewhere, in any order — "claude haiku"
         should find `anthropic/claude-3.5-haiku` and typing the vendor first is
         the natural way to narrow a list of three hundred. */
      const haystack = `${model.id} ${model.name} ${model.description}`.toLowerCase();
      return needle.split(/\s+/).filter(Boolean).every(term => haystack.includes(term));
    }

    function modelRow(model: ModelInfo): HTMLElement {
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'ai-model-row';
      row.dataset.id = model.id;
      if (chosen.has(model.id)) row.dataset.chosen = '';
      row.setAttribute('aria-pressed', String(chosen.has(model.id)));

      const name = document.createElement('span');
      name.className = 'ai-model-id';
      name.textContent = model.id;

      const badges = document.createElement('span');
      badges.className = 'ai-model-badges';
      const badge = (text: string, tone?: string) => {
        if (!text) return;
        const b = document.createElement('span');
        b.className = 'ai-model-badge';
        if (tone) b.dataset.tone = tone;
        b.textContent = text;
        badges.append(b);
      };
      if (model.free) badge('free', 'on');
      if (model.contextLength) badge(`${Math.round(model.contextLength / 1000)}k ctx`);
      /* The number the output ceiling is filled in from, shown where the choice
         is made. It is the difference between two models that look identical on
         price and context and then behave differently on a task that thinks. */
      if (model.maxOutput) badge(`${model.maxOutput.toLocaleString()} out`);
      if (model.tools) badge('tools');
      if (model.reasoning) badge('reasoning');
      if (!model.free) {
        const p = price(model.promptPrice);
        const c = price(model.completionPrice);
        if (p || c) badge([p, c].filter(Boolean).join(' → '));
      }
      if (model.modality && model.modality !== 'text->text') badge(model.modality);

      const note = document.createElement('span');
      note.className = 'ai-model-note';
      note.textContent = model.description || model.name;

      row.append(name, badges, note);

      row.addEventListener('click', () => {
        if (picking === 'fallbacks') {
          if (chosen.has(model.id)) chosen.delete(model.id);
          else chosen.add(model.id);
        } else {
          chosen.clear();
          chosen.add(model.id);
        }
        paintModels();
      });

      return row;
    }

    function paintModels() {
      const needle = modelSearch.value.trim().toLowerCase();
      const all = catalogue ?? [];
      const hits = all.filter(model => matches(model, needle));

      modelList.replaceChildren();
      for (const model of hits.slice(0, RENDER_CAP)) modelList.append(modelRow(model));

      if (all.length && !hits.length) {
        const empty = document.createElement('p');
        empty.className = 'admin-empty';
        empty.textContent = 'Nothing matches that. Clear the filter, or type the id in by hand.';
        modelList.append(empty);
      }

      const capped = hits.length > RENDER_CAP ? ` · showing the first ${RENDER_CAP}` : '';
      modelCount.textContent = all.length
        ? `${hits.length} of ${all.length}${capped}${chosen.size ? ` · ${chosen.size} chosen` : ''}`
        : '';
    }

    async function openPicker(target: PickTarget) {
      picking = target;
      chosen.clear();
      modelSearch.value = '';

      const field =
        target === 'model'
          ? dialogFields.model
          : target === 'assist'
            ? dialogFields.assist
            : dialogFields.fallbacks;

      /* Pre-select what is already in the field, so reopening the browser on a
         configured provider shows what it is configured with rather than a
         blank list — and so adding a fourth fallback is one click. */
      for (const id of field.value.split(/[,\n]/).map(m => m.trim()).filter(Boolean)) {
        chosen.add(id);
      }

      $('ai-models-title').textContent =
        target === 'fallbacks' ? 'Choose fallback models' : 'Choose a model';

      modelsDialog.showModal();
      modelStatus.hidden = false;
      modelStatus.dataset.tone = 'pending';
      modelStatus.textContent = 'Asking the provider what it serves…';
      renderModelSkeleton();
      modelCount.textContent = '';

      if (!catalogue) {
        try {
          const result = await listModels({
            /* The saved row where there is one — it has the key, and several
               vendors list more to an authenticated caller. Otherwise the URL
               as typed, because picking a model is something the owner wants to
               do before pressing Save. */
            slug: editing?.slug,
            baseUrl: dialogFields.baseUrl.value.trim(),
          });
          catalogue = result.models;
          modelStatus.dataset.tone = result.error ? 'error' : 'ok';
          modelStatus.textContent =
            result.error ??
            `${result.models.length} model${result.models.length === 1 ? '' : 's'} available.`;
          modelStatus.hidden = !result.error && result.models.length > 0;
        } catch (error) {
          catalogue = [];
          modelStatus.dataset.tone = 'error';
          modelStatus.textContent =
            error instanceof Error ? error.message : 'Could not read the model list.';
          /* The skeleton promised rows. When they are not coming, it comes
             down — shimmering placeholders over a failure message is the
             worst of both, the import modal's own rule. */
          modelList.replaceChildren();
        }
      } else {
        modelStatus.hidden = true;
      }

      paintModels();
      modelSearch.focus();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach(button => {
      button.addEventListener('click', () => {
        void openPicker((button.dataset.pick ?? 'model') as PickTarget);
      });
    });

    modelSearch.addEventListener('input', paintModels);

    $('ai-model-filters').addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;
      filter = (button.dataset.filter ?? 'all') as typeof filter;
      $('ai-model-filters')
        .querySelectorAll<HTMLButtonElement>('[data-filter]')
        .forEach(chip => chip.setAttribute('aria-pressed', String(chip === button)));
      paintModels();
    });

    modelsDialog.addEventListener('click', event => {
      if (event.target === modelsDialog) modelsDialog.close();
    });
    $<HTMLButtonElement>('ai-models-cancel').addEventListener('click', () => modelsDialog.close());

    $<HTMLButtonElement>('ai-models-use').addEventListener('click', () => {
      const picked = [...chosen];
      if (picking === 'fallbacks') {
        dialogFields.fallbacks.value = picked.join(', ');
      } else if (picked.length) {
        const field = picking === 'model' ? dialogFields.model : dialogFields.assist;
        field.value = picked[0];
        /* Which knobs this model actually accepts, where the vendor said. It is
           a note rather than a set of disabled fields: `supported_parameters`
           is OpenRouter's, most listings do not carry it, and greying out a
           field because a vendor was quiet would be worse than saying nothing. */
        const info = (catalogue ?? []).find(model => model.id === picked[0]);
        $('ai-param-support').textContent = info?.supported.length
          ? `${info.id} accepts: ${info.supported.join(', ')}.`
          : '';
        if (info) applyModelCeiling(info);
      }
      modelsDialog.close();
    });

    /**
     * Fill the output ceiling from the model that was just picked.
     *
     * This is the whole point of the field. A ceiling is not a budget — a
     * vendor bills tokens generated, not tokens permitted — so the right
     * default is *the largest completion this model will accept*, and the model
     * listing is the only place that number honestly exists. Typing it in from
     * memory is how it ends up at 2,000 on a model that thinks for 4,000.
     *
     * Three sources, in descending order of honesty:
     *
     *   1. `maxOutput`, which the vendor stated. Used as-is.
     *   2. A quarter of the context window, for the listings that report only
     *      that — most of them outside OpenRouter. A guess, and the note says
     *      so, because prompt and completion share the context and a completion
     *      the size of the window is a 400 everywhere that checks.
     *   3. Nothing, and the field is left alone rather than cleared: a number
     *      the author typed is worth more than this function's silence.
     *
     * It only ever writes into an *empty* field or one this function last
     * wrote, tracked by `data-auto`. Overwriting a deliberate number because
     * somebody reopened the browser to check a spelling would be the screen
     * editing a row nobody asked it to edit — the same rule `applyPreset` has.
     */
    /** The extra line under the ceiling field, or nothing. Hidden by the attribute. */
    function ceilingHint(text: string) {
      const note = $('ai-f-maxout-note');
      note.textContent = text;
      note.hidden = !text;
    }

    function applyModelCeiling(model: ModelInfo) {
      const field = dialogFields.maxOut;
      const mine = 'auto' in field.dataset;
      if (field.value.trim() && !mine) return;

      const stated = model.maxOutput;
      const guessed = model.contextLength ? Math.round(model.contextLength / 4) : null;
      const ceiling = clampOutputCeiling(stated ?? guessed);

      if (ceiling === null) {
        delete field.dataset.auto;
        return;
      }

      field.value = String(ceiling);
      field.dataset.auto = '';
      ceilingHint(stated
        ? `${ceiling.toLocaleString()} tokens — the largest completion ${model.id} accepts, as its listing reports it.`
        : `${ceiling.toLocaleString()} tokens — a quarter of ${model.id}'s ${(model.contextLength ?? 0).toLocaleString()}-token context, because the listing does not state a completion limit. Lower it if the vendor refuses.`);
    }

    /* A number the author types is theirs, and this screen stops filling it in. */
    dialogFields.maxOut.addEventListener('input', () => {
      delete dialogFields.maxOut.dataset.auto;
    });

    /* A different endpoint serves a different catalogue. */
    dialogFields.baseUrl.addEventListener('input', () => {
      catalogue = null;
    });

    $<HTMLButtonElement>('ai-save-settings').addEventListener('click', async event => {
      const button = event.currentTarget as HTMLButtonElement;
      const settings = readSettings();
      setBusy(button, true, 'Saving…');
      try {
        await saveAiSettings(settings);
        say(
          settings.enabled
            ? 'Saved. The assistant is answering visitors now.'
            : 'Saved. The public assistant is off; the journal assistant still works.',
        );
        toast('Settings saved.', { tone: 'success' });
      } catch (error) {
        fail(error, button);
        return;
      }
      setBusy(button, false);
    });

    /* — loading —

       Everything on this screen comes from one request, so there is one loader
       and one failure path. The skeleton in the markup is what is showing until
       this returns. */
    /* The settings form is filled once, on the first load, and never again.
       `refresh()` runs after *every* provider write — activating one, clearing a
       key — and re-filling from the server each time would throw away whatever
       the author had typed into the persona box or the limit fields but not yet
       saved. The provider list is server state and is redrawn; the settings
       form is the author's in-progress edit and is not. */
    let settingsFilled = false;

    function paint(data: AiOverview) {
      if (!settingsFilled) {
        fillSettings(data.settings);
        settingsFilled = true;
      }
      list.replaceChildren();
      if (!data.providers.length) {
        const empty = document.createElement('p');
        empty.className = 'admin-empty';
        empty.textContent =
          'No providers yet. Add one with its base URL, model and API key, then activate it.';
        list.append(empty);
      } else {
        for (const provider of data.providers) list.append(providerRow(provider));
      }

      /* Two numbers, because the interesting one is the difference. The index
         is what every question carries; the corpus is what it used to carry,
         and what it still would if lookups were switched off on the provider. */
      $('ai-corpus').textContent =
        `About ${data.index.approxTokens.toLocaleString()} tokens go into every question — a line per project, post ` +
        `and case study. The writing itself (${data.corpus.approxTokens.toLocaleString()} tokens) is fetched a page at a time, ` +
        'only when a question needs it.';

      $('ai-usage').textContent =
        data.usage.answered === 0
          ? 'No questions answered today.'
          : `${data.usage.answered} answered today, across ${data.usage.activeCallers} visitor${data.usage.activeCallers === 1 ? '' : 's'} in the last hour.`;

      const active = data.providers.filter(p => p.active && p.hasKey).length;
      stamp.textContent = active
        ? `${active} provider${active === 1 ? '' : 's'} ready.`
        : 'No provider is ready — nothing will answer.';
    }

    async function refresh() {
      try {
        const data = await loadOverview();
        paint(data);
      } catch (error) {
        list.replaceChildren();
        const text = error instanceof Error ? error.message : 'Could not read the AI settings.';
        stamp.textContent = text;
        say(text, 'error');
      }
    }

    if (!getToken()) {
      say('Sign in with GitHub to configure the assistant.', 'error');
      stamp.textContent = 'Signed out.';
      list.replaceChildren();
      for (const button of ['ai-add', 'ai-save-settings']) {
        const el = $<HTMLButtonElement>(button);
        el.disabled = true;
        el.title = 'Sign in with GitHub to configure the assistant.';
      }
    } else {
      void refresh();
    }
  });
</script>

<style>
  /* The three-step explanation in the providers rail. A real `<ol>`, because
     the order is the whole content — a list of bullets would say the same
     words and none of the meaning. */
  .ai-steps {
    margin: 0;
    padding-left: 1.2em;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-text-muted);
    display: grid;
    gap: var(--space-2);
    list-style: decimal;
  }

  .ai-message { min-height: 18px; font-size: 12px; margin: 0 0 var(--space-4); }
  .ai-message[data-tone='error'] { color: var(--color-accent-700); }

  .ai-grid { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4); align-items: start; }
  .ai-col, .ai-side { display: flex; flex-direction: column; gap: var(--space-4); }
  .ai-rule { margin: var(--space-3) 0; }

  .ai-persona { min-height: 96px; }
  .ai-suggestions { min-height: 72px; }

  .ai-limits { display: flex; flex-direction: column; gap: var(--space-3); }
  .ai-cap { font-size: 11px; }

  .ai-switch-card { border-color: var(--color-accent-400); }

  code { font-size: 12px; background: var(--color-surface); padding: 1px 5px; }

  /* — the dialogs —

     `.modal` is 760px, which is right for six fields and cramped for a list of
     three hundred models beside their prices. */
  .ai-modal { width: min(860px, 94vw); }

  .ai-pick { display: flex; gap: var(--space-2); align-items: stretch; }
  .ai-pick .input { flex: 1; min-width: 0; }
  .ai-pick .btn { flex: none; white-space: nowrap; }

  .ai-params { border-top: 1px solid var(--color-divider); padding-top: var(--space-3); }
  .ai-params-summary {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--color-text-muted);
  }
  .ai-params-summary::-webkit-details-marker { display: none; }
  .ai-params-summary::before { content: '+ '; }
  .ai-params[open] .ai-params-summary::before { content: '\2212 '; }
  .ai-params-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .ai-param-support { font-family: var(--font-mono); font-size: 11px; }

  .ai-model-tools {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .ai-model-tools .input { flex: 1; min-width: 200px; }
  .ai-model-filters { display: flex; gap: var(--space-1); }

  .ai-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 10px;
    border: 1px solid var(--color-divider);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .ai-chip[aria-pressed='true'] {
    border-color: var(--color-accent-500);
    color: var(--color-accent-700);
  }

  /* Every row below is built by the script, so it carries no `data-astro-cid`
     and a plain scoped selector would never reach it. Hung off the
     server-rendered list instead, the way `#import-list` is.
     `modal-fixed` above pins the dialog's height, so the list fills whatever
     band is left rather than sizing the frame — three hundred rows and three
     hits open the same window, the way the import modal behaves. */
  .ai-model-list {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    border: 1px solid var(--color-divider);
  }
  .ai-model-list :global(.ai-model-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'id badges' 'note note';
    gap: 2px var(--space-2);
    text-align: left;
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-bottom: 1px solid var(--color-divider);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .ai-model-list :global(.ai-model-row:hover) { background: var(--color-surface); }
  .ai-model-list :global(.ai-model-row[data-chosen]) {
    background: color-mix(in srgb, var(--color-accent-500) 10%, transparent);
    box-shadow: inset 3px 0 0 var(--color-accent-500);
  }
  .ai-model-list :global(.ai-model-id) {
    grid-area: id;
    font-family: var(--font-mono);
    font-size: 12px;
    word-break: break-all;
  }
  .ai-model-list :global(.ai-model-badges) {
    grid-area: badges;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .ai-model-list :global(.ai-model-badge) {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    padding: 1px 5px;
    border: 1px solid var(--color-divider);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .ai-model-list :global(.ai-model-badge[data-tone='on']) {
    border-color: var(--color-accent-500);
    color: var(--color-accent-700);
  }
  .ai-model-list :global(.ai-model-note) {
    grid-area: note;
    font-size: 11px;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ai-model-count { font-size: 11px; margin-right: auto; }

  /* The loading rows. Same grid and padding as a real `.ai-model-row`, so the
     list does not reflow when the response replaces them — the import
     modal's rule, mirrored here. `pointer-events: none` because a skeleton
     is not pressable, and `aria-hidden` in the builder keeps it out of the
     tree. */
  .ai-model-list :global(.ai-model-skeleton) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'id badges' 'note note';
    gap: 2px var(--space-2);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-divider);
    pointer-events: none;
  }
  .ai-model-list :global(.ai-model-skeleton-head) {
    display: contents;
  }
  .ai-model-list :global(.ai-model-skeleton-id) {
    grid-area: id;
    height: 12px;
    width: 58%;
    max-width: 300px;
  }
  .ai-model-list :global(.ai-model-skeleton-badges) {
    grid-area: badges;
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }
  .ai-model-list :global(.ai-model-skeleton-badge) {
    height: 14px;
  }
  .ai-model-list :global(.ai-model-skeleton-note) {
    grid-area: note;
    height: 11px;
    width: 72%;
    max-width: 420px;
    margin-top: 6px;
  }

  @media (max-width: 1000px) {
    .ai-grid { grid-template-columns: 1fr; }
  }
</style>
