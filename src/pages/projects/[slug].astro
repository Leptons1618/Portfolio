---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { categoryLabel, getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { title, summary, category, tags, stack, status, year, highlights, repoUrl, demoUrl, caseStudySlug } = project.data;

const related = (await getProjects())
  .filter(p => p.slug !== project.slug && p.data.tags.some(t => tags.includes(t)))
  .slice(0, 8);
---
<BaseLayout title={title} description={summary}>
  <div class="container detail">
    <a class="btn btn-ghost back-link" href="/projects">← Back to Projects</a>

    <header class="detail-head">
      <div class="detail-chips">
        <span class="tag tag-neutral">{categoryLabel(category)}</span>
        <span class="tag tag-neutral">{year}</span>
        <span class="tag tag-neutral">{status}</span>
      </div>
      <h1>{title}</h1>
      <p class="detail-summary">{summary}</p>
    </header>
    <hr class="rule detail-head-rule" />

    <div class="detail-grid">
      <div class="detail-main">
        {highlights.length > 0 && (
          <section class="detail-section">
            <div class="section-head-rule detail-section-head">
              <h3>Highlights</h3>
              <hr class="rule" />
            </div>
            <div class="card elev-sm">
              <ul class="highlight-list">
                {highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
          </section>
        )}

        {related.length > 0 && (
          <section class="detail-section">
            <div class="section-head-rule detail-section-head">
              <h3>Related Projects</h3>
              <hr class="rule" />
            </div>
            <div class="related-list">
              {related.map(r => (
                <a href={`/projects/${r.slug}`} class="card elev-sm related-card">
                  <span class="card-kicker">{r.data.year}</span>
                  <h4 class="card-title">{r.data.title}</h4>
                  <p class="card-body">{r.data.summary}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="detail-sidebar">
        <div class="card sidebar-card">
          <h6>Links</h6>
          <div class="link-list">
            <a href={repoUrl} class="btn btn-secondary btn-block" target="_blank" rel="noopener">Repository ↗</a>
            {demoUrl && <a href={demoUrl} class="btn btn-primary btn-block" target="_blank" rel="noopener">Live Demo ↗</a>}
            {caseStudySlug && <a href={`/case-studies/${caseStudySlug}`} class="btn btn-primary btn-block">Read Case Study →</a>}
          </div>
        </div>
        <div class="card sidebar-card">
          <h6>Tags</h6>
          <div class="tag-list">{tags.map(tag => <Tag text={tag} variant="neutral" />)}</div>
        </div>
        <div class="card sidebar-card">
          <h6>Stack</h6>
          <div class="tag-list">{stack.map(s => <Tag text={s} variant="outline" />)}</div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .detail { padding-top: var(--space-6); padding-bottom: var(--space-8); }
  .back-link { padding-inline: 0; margin-bottom: var(--space-3); }
  .detail-grid { display: grid; grid-template-columns: 1fr 280px; gap: var(--space-8); }
  .detail-main { min-width: 0; }

  .detail-head { margin-bottom: var(--space-4); }
  .detail-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-3); }
  h1 { margin-bottom: var(--space-2); }
  .detail-summary { font-size: 18px; line-height: 1.6; opacity: 0.85; max-width: 62ch; margin: 0; }
  .detail-head-rule { margin-bottom: var(--space-6); }

  .detail-section { margin-bottom: var(--space-6); }
  .detail-section-head { margin-bottom: var(--space-3); }
  .detail-section-head h3 { margin: 0; }
  .highlight-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .highlight-list li { padding-left: var(--space-4); position: relative; opacity: 0.85; font-size: 14px; }
  .highlight-list li::before { content: '→'; position: absolute; left: 0; color: var(--color-accent); }

  .related-list { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .related-card { text-decoration: none; color: inherit; }
  .related-card:hover { color: inherit; }
  .related-card:hover .card-title { color: var(--color-accent); }

  .detail-sidebar { display: flex; flex-direction: column; gap: var(--space-3); }
  .sidebar-card h6 { color: var(--color-accent-700); margin-bottom: var(--space-1); }
  .link-list { display: flex; flex-direction: column; gap: var(--space-2); }
  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; }

  @media (max-width: 860px) {
    .detail-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .related-list { grid-template-columns: 1fr; }
  }
</style>
