{
  "name": "portfolio",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/check-content.mjs && node scripts/test-content-schema.mjs && node workers/github-oauth/test.mjs && astro check",
    "check:content": "node scripts/check-content.mjs",
    "check:schema": "node scripts/test-content-schema.mjs",
    "check:worker": "node workers/github-oauth/test.mjs",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply portfolio-content --remote",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-content --local",
    "db:console": "wrangler d1 execute portfolio-content --remote --command",
    "seed:d1": "node scripts/seed-d1.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@iconify-json/lucide": "^1.2.123",
    "astro": "^5.0.0",
    "astro-icon": "^1.1.5",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.0.0",
    "wrangler": "^4.123.0"
  }
}
