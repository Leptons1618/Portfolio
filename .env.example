# Admin GitHub sign-in. Copy to `.env` for local work; in CI these come from
# repository variables (see .github/workflows/deploy.yml).
#
# Both values are public — they identify the app, they do not authorise
# anything. The only secret is the GitHub App's client secret, which lives in
# the Cloudflare Worker. Setup: workers/github-oauth/README.md
#
# Leave them unset and the admin screens stay reachable at
# http://localhost:4321/admin/dashboard, ungated and export-only — the sidebar
# reads "local · export only". Fill them in and `/admin` requires a real
# GitHub sign-in, and commits from localhost go to the real repository.
#
# Astro reads this at startup: restart `npm run dev` after changing it.

PUBLIC_GITHUB_CLIENT_ID=
PUBLIC_GITHUB_OAUTH_WORKER=

# Optional, and only used to build a link. The App's slug is the last segment
# of the URL of its settings page — github.com/settings/apps/<slug> — and it is
# not the client ID. With it, "Repository access" in the admin opens GitHub's
# repository picker directly; without it you land on the list of Apps you own
# and pick yours first.
PUBLIC_GITHUB_APP_SLUG=

# The D1 database this checkout talks to. `npm run config` substitutes it into
# wrangler.jsonc, which is generated and gitignored — see wrangler.example.jsonc.
# Create your own with `npx wrangler d1 create portfolio-content`; the id it
# prints goes here. Without it, dev/build/deploy have no database to bind.
D1_DATABASE_ID=
