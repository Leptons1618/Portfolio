# Admin GitHub sign-in. Copy to `.env` for local work; in CI these come from
# repository variables (see .github/workflows/deploy.yml).
#
# Both values are public — they identify the app, they do not authorise
# anything. The only secret is GITHUB_CLIENT_SECRET, which lives in the
# Cloudflare Worker. Setup: workers/github-oauth/README.md
#
# Leave them unset and the admin screens stay export-only, ungated.

PUBLIC_GITHUB_CLIENT_ID=
PUBLIC_GITHUB_OAUTH_WORKER=
